DAT
id=qid::label=str::text=lstr::
45239::$$$message_0411_0000_0000$$$::"Há mesmo um onsen à frente?"::
45240::$$$message_0411_0000_0001$$$::"Há. Minha intuição, ou algo assim, diz isso. Acho que sim."::
45241::$$$message_0411_0000_0002$$$::"A intuição deveria ser tão vaga assim?"::
45242::$$$message_0411_0000_0003$$$::"Alguém está à frente."::
45243::$$$message_0411_0000_0004$$$::"Hmm?"::
45244::$$$message_0411_0000_0005$$$::"Oh?"::
45245::$$$message_0411_0000_0006$$$::"Ah, ingredientes."::
45246::$$$message_0411_0000_0007$$$::"Ahhh!"::
45247::$$$message_0411_0000_0008$$$::"I-Illia?"::
45248::$$$message_0411_0000_0009$$$::"Ai, isso dói, moleque. É rude gritar só por ver a cara de um cara."::
45249::$$$message_0411_0000_0010$$$::"Acredito que seja esse o tipo de situação em que você usaria a frase: "E aí, o que seus pais pensariam?"::
45250::$$$message_0411_0000_0011$$$::"Desculpe! É só... uh... seu rosto é assustador..."::
45251::$$$message_0411_0000_0012$$$::"Não há motivo para se preocupar, Ryunosuke."::
45252::$$$message_0411_0000_0013$$$::"Mesmo que sua estrutura facial cause crianças a emitirem gritos agudos, eu gosto."::
45253::$$$message_0411_0000_0014$$$::"Obrigado, cara. ...Hehe, você me deixou vermelho."::
45254::$$$message_0411_0000_0015$$$::(Ele não é o que me fez gritar, embora!)::
45255::$$$message_0411_0000_0016$$$::"Meu... minha intuição está agora gritando que há algo definitivamente errado com esses cara!"::
45256::$$$message_0411_0000_0017$$$::"Eu sinto que acabamos de nos deparar com as últimas pessoas com quem deveríamos nos encontrar!"::
45257::$$$message_0411_0000_0018$$$::"Ei, cara. Eu estava pensando, e aí, o que tem com aquela garota?"::
45258::$$$message_0411_0000_0019$$$::"Hmm? M-me?"::
45259::$$$message_0411_0000_0020$$$::"Ela não tem cor nem voz. Ela está mesmo viva?"::
45260::$$$message_0411_0000_0021$$$::"Ah, uma garota monocromática... [wvl canskip=false time=200][hffgchg2 chara=キャスター4th face=喜 pos=center time=300][hfsigh layer=2] Nunca vi uma antes. Hehe. Temos sorte, Ryunosuke."::
45261::$$$message_0411_0000_0022$$$::"Eh? Huh?"::
45262::$$$message_0411_0000_0023$$$::"Que achado raro! Estou ansioso para ver se seu interior também é preto e branco...!"::
45263::$$$message_0411_0000_0024$$$::"E-essas pessoas aí são quem?!":��K