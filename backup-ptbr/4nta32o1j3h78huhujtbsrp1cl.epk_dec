DAT
id=qid::label=str::text=lstr::
43167::$$$message_0361_0000_0000$$$::"Souichirou..."::
43168::$$$message_0361_0000_0001$$$::"Mrg."::
43169::$$$message_0361_0000_0002$$$::"Ah, finalmente, ninguém vai se interpor entre nós..."::
43170::$$$message_0361_0000_0003$$$::"Ei, Kotomine. Você tem certeza de que está aqui?"::
43171::$$$message_0361_0000_0004$$$::"Hahahahaha. Meu erro.[lr]::
43172::$$$message_0361_0000_0005$$$::Fui atraído pelo odor da felicidade."::
43173::$$$message_0361_0000_0006$$$::"Ah..."::
43174::$$$message_0361_0000_0007$$$::"Hmm. Vamos seguir em frente. Não tem sentido ficar aqui."::
43175::$$$message_0361_0000_0008$$$::"Assassino! Venha cá! E mate esses vermes!"::
43176::$$$message_0361_0000_0009$$$::"(bocejo) Espera[line len=2][hffacechg chara=ランサー face=驚 time=200][hfangry layer=0]CARALHOO, QUASE MORRI!"::
43177::$$$message_0361_0000_0010$$$::"Ah, aquele golpe falhou em te eliminar?"::
43178::$$$message_0361_0000_0011$$$::"Que saudação selvagem."::
43179::$$$message_0361_0000_0012$$$::"I-[hfchance layer=1]não é assim que se trata convidados não solicitados?"::
43180::$$$message_0361_0000_0013$$$::"Meu, que coincidência completa e total."::
43181::$$$message_0361_0000_0014$$$::"Então, por que você parece tão feliz?"::
43182::$$$message_0361_0000_0015$$$::"Hahahahaha.[lr]::
43183::$$$message_0361_0000_0016$$$::Você não entende, Lancer."::
43184::$$$message_0361_0000_0017$$$::"Você não acha que eu vou deixar você sair daqui vivo?"::
43185::$$$message_0361_0000_0018$$$::"Você me desafiaria, palhaço?"::
43186::$$$message_0361_0000_0019$$$::"Eu digo, eu acho que qualquer um estaria chateado."::
43187::$$$message_0361_0000_0020$$$::"Heh. É culpa sua por estar no meu caminho. Não é a postura natural do homem se prostrar e fazer espaço para o rei?"::
43188::$$$message_0361_0000_0021$$$::"Meu, isso certamente não é algo que um ladrão diz."::

