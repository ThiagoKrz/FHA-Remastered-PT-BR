DAT
id=qid::label=str::text=lstr::
45726::$$$message_0437_0000_0000$$$::"Hmm."::
45727::$$$message_0437_0000_0001$$$::"Oh?"::
45728::$$$message_0437_0000_0002$$$::"Alguém que você conhece, cara grande?"::
45729::$$$message_0437_0000_0003$$$::"Não. Ele parece ser um mágico."::
45730::$$$message_0437_0000_0004$$$::"Encontrei vocês, o Mestre e Servo corruptos que continuam quebrando as regras da taumaturgia!"::
45731::$$$message_0437_0000_0005$$$::"Eu, a nona cabeça da linhagem Archibald, conhecido também como "Big Ben" Kayneth El-Melloi, serei..."::
45732::$$$message_0437_0000_0006$$$::"...entregue! [wvl canskip=false time=200] Sua Capital! [wvl canskip=false time=200] Castigo!::
45733::$$$message_0437_0000_0007$$$::(Alguém já chamou ele de Big Ben...?)::
45734::$$$message_0437_0000_0008$$$::Heh. Acertei.::
45735::$$$message_0437_0000_0009$$$::"(olhar fixo)"::
45736::$$$message_0437_0000_0010$$$::"Hmm?"::
45737::$$$message_0437_0000_0011$$$::"(olhar fixo)..."::
45738::$$$message_0437_0000_0012$$$::"E-é?"::
45739::$$$message_0437_0000_0013$$$::"Ah, desculpe. Eu estava pensando nos ingredientes."::
45740::$$$message_0437_0000_0014$$$::"Hmm, ingredientes?"::
45741::$$$message_0437_0000_0015$$$::"O material é flexível, então talvez seja melhor envolvê-lo em um esqueleto interno."::
45742::$$$message_0437_0000_0016$$$::"Parece que ele também tem bastante gordura."::
45743::$$$message_0437_0000_0017$$$::"Você está falando de mim!?"::
45744::$$$message_0437_0000_0018$$$::"Recule, Senhora Sola-Ui! Caster e seu Mestre são feras que fizeram coisas inimagináveis a crianças!"::
45745::$$$message_0437_0000_0019$$$::"Se algo acontecesse com você, Senhor Kayneth choraria!"::
45746::$$$message_0437_0000_0020$$$::"Lancer...[heart]"::
45747::$$$message_0437_0000_0021$$$::"...Dizia eu [font italic=true]Senhor Kayneth[font italic=false] choraria!"::
45748::$$$message_0437_0000_0022$$$::"Hehehe. Obrigado, Lancer. Você está arriscando sua vida por mim! [font italic=true]Por mim![font italic=false]"::
45749::$$$message_0437_0000_0023$$$::[delay speed=25]"Para meu senhor! [delay speed=user][wvl]Pônei tudo se for preciso... [wait canskip=false time=40]bo[wait canskip=false time=40]d[wait canskip=false time=40]y[wait canskip=false time=40] e[wait canskip=false time=40] s[wait canskip=false time=40]ul[hfangry layer=0]!::
45750::$$$message_0437_0000_0024$$$::"...Parece que as coisas estão bastante complicadas para eles."::
45751::$$$message_0437_0000_0025$$$::"Devo dizer, não sou muito fã de relações tão depravadas."::
45752::$$$message_0437_0000_0026$$$::"...Ah![wvl canskip=false time=300][hffgchg2 chara=ケイネス face=怒3 pos=right time=300 twno=1][hfangry layer=1] O que você está fazendo, Lancer!? Apresse-se e elimine esse Servo!"::
45753::$$$message_0437_0000_0027$$$::"Pela tua vontade!"::
45754::$$$message_0437_0000_0028$$$::"Boa sorte, Lancer!"::
45755::$$$message_0437_0000_0029$$$::"..."::
45756::$$$message_0437_0000_0030$$$::"Vamos começar, Caster!"::
45757::$$$message_0437_0000_0031$$$::"Agora, Ryunosuke, ou qualquer que seja o seu nome. Eu, Kayneth El-Melloi Archibald, darei a justiça que você merece!"::
45758::$$$message_0437_0000_0032$$$::"Você vai saber as consequências por olhar para minha noiva com olhos de luta!"::
45759::$$$message_0437_0000_0033$$$::"...Eu não estava a olhar para ela, embora."::
45760::$$$message_0437_0000_0034$$$::"Se algo, era mais como olhos cobiçosos."::
�