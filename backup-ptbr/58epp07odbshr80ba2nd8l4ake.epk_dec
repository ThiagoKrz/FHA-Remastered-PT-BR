DAT
id=qid::label=str::text=lstr::
43078::$$$message_0357_0000_0000$$$::"Rin, lá estão elas! É a Caster!"::
43079::$$$message_0357_0000_0001$$$::"Bom olho, Archer! Aqui vai a Clairvoyance pra você!"::
43080::$$$message_0357_0000_0002$$$::"Hmm, parece que há algum tipo de movimento."::
43081::$$$message_0357_0000_0003$$$::"Tohsaka."::
43082::$$$message_0357_0000_0004$$$::"Nada pessoal, Caster, mas você vem comigo."::
43083::$$$message_0357_0000_0005$$$::"Pelo menos me diga por quê?"::
43084::$$$message_0357_0000_0006$$$::"Bem, eu também não sei."::
43085::$$$message_0357_0001_0000$$$::"Mas preciso que você venha comigo, porque não se sabe o que Saber pode fazer se não fizermos isso."::
43086::$$$message_0357_0001_0001$$$::"O que você fez, Caster?[lr]::
43087::$$$message_0357_0001_0002$$$::Saber está incomumente furiosa."::
43088::$$$message_0357_0001_0003$$$::"Serio... Ela disse que Excaliblastaria a casa se não fizessemos o que ela dissesse, e que nem mesmo veríamos isso vindo da Campo Limitado."::
43089::$$$message_0357_0001_0004$$$::"Falando nisso, Sakura e Rider também saíram correndo pela porta... Ela deve ter ameaçado elas também, de alguma forma."::
43090::$$$message_0357_0001_0005$$$::"Fico impressionado com a Rainha dos Cavaleiros. Ela não hesitará em nada para alcançar seus objetivos... contrário às aparências."::
43091::$$$message_0357_0001_0006$$$::"Responda, Caster. O que você fez com a Saber?"::
43092::$$$message_0357_0001_0007$$$::"Por que não pergunta diretamente a ela?"::
43093::$$$message_0357_0001_0008$$$::"Eu fiz! Mas então ela me encarou com um olhar feroz. Shirou parecia ter uma ideia, mas ele estava ao lado dela tremendo."::
43094::$$$message_0357_0001_0009$$$::"Ele parecia um pouco desnutrido."::
43095::$$$message_0357_0001_0010$$$::"Heh. Oh, pequena Saber. Ela realmente iria tão longe por um ressentimento?"::
43096::$$$message_0357_0001_0011$$$::"...Então foi você que fez isso no fim das contas."::
43097::$$$message_0357_0001_0012$$$::"Bah! Isso não importa![lr]::
43098::$$$message_0357_0001_0013$$$::Lide com isso, Assassino!"::
43099::$$$message_0357_0001_0014$$$::"...Que bondade."::
�