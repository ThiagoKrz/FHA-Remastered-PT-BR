DAT
id=qid::label=str::text=lstr::
45105::$$$message_0405_0000_0000$$$::"ARR...URRR...!!!"::
45106::$$$message_0405_0000_0001$$$::"Hei!"::
45107::$$$message_0405_0000_0002$$$::"Ngh!"::
45108::$$$message_0405_0000_0003$$$::"Berserker!? Atacou assim que nos viu... Está ignorando a regra sobre as partidas de hanafuda só?"::
45109::$$$message_0405_0000_0004$$$::"E se o choque te fizesse [font italic=true]receder[font italic=false] ainda mais?"::
45110::$$$message_0405_0000_0005$$$::"W- por que você está se referindo à minha cabeça, Sola-Ui!?"::
45111::$$$message_0405_0000_0006$$$::"Você deve recuar, Mestre!"::
45112::$$$message_0405_0000_0007$$$::"Não há nada [font italic=true]recuando[font italic=false] em mim!"::
45113::$$$message_0405_0000_0008$$$::"Derrubem eles, Berserker."::
45114::$$$message_0405_0000_0009$$$::"...rr.......ur?"::
45116::$$$message_0405_0000_0011$$$::"Desculpe, Mestre do Lancer. Ele só fica assim sempre que vê alguém de cabelo loiro..."::
45117::$$$message_0405_0000_0012$$$::"Ele tem um caso ainda pior de identidade errada do que o Caster?"::
45118::$$$message_0405_0000_0013$$$::"Ha. Entendi. Então foi você... Makiri."::
45119::$$$message_0405_0000_0014$$$::"E você está falando do quê, Mestre do Lancer?"::
45120::$$$message_0405_0000_0015$$$::"Não jogue de bobo. Só os mestres de Makiri de Fuyuki seriam tão astutos e brutais para queimarem meu estúdio."::
45121::$$$message_0405_0000_0016$$$::"...Você está apontando dedos para todo mundo que você encontra?"::
45122::$$$message_0405_0000_0017$$$::"É. Ele é um saco. Tem algum indício para nos dar?"::
45123::$$$message_0405_0000_0018$$$::"...Eu posso. Posso te dizer também, se você estiver disposto a abandonar o onsen."::
45124::$$$message_0405_0000_0019$$$::"Nonsense. Eu [font italic=true]reconstruirei[font italic=false] minha oficina."::
45125::$$$message_0405_0000_0020$$$::"Isso mesmo. Além do workshop, vamos tomar aquele onsen!"::
45126::$$$message_0405_0000_0021$$$::"Tio Kariya... Ele está fazendo uma oficina?"::
45127::$$$message_0405_0000_0022$$$::"Sakura...[wvl canskip=false time=200][hffgchg2 chara=雁夜 face=喜2 pos=right time=300 twno=1][hfsigh layer=1] Está tudo bem. Não deixarei que mais ninguém sofra como você!"::
45128::$$$message_0405_0000_0023$$$::"Ele vai ser como o avô?"::
45129::$$$message_0405_0000_0024$$$::"Não aponte para minha testa! Pare de arrancar!"::
45130::$$$message_0405_0000_0025$$$::"HAAAAAIRRROOOOO!"::
45131::$$$message_0405_0000_0026$$$::"S-só preciso vencer. Vou fazer você dizer o nome do meu inimigo. E claro, vou tomar o onsen também."::
45132::$$$message_0405_0000_0027$$$::"Você é um fiend."::
45133::$$$message_0405_0000_0028$$$::"Você não é o que trouxe uma criança para o campo de batalha? Quem aqui é o verdadeiro demônio?"::
45134::$$$message_0405_0000_0029$$$::"Você é só um mágico. Nunca entenderia os valores humanos."::
