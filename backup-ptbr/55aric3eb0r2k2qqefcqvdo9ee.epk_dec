DAT
id=qid::label=str::text=lstr::
45146::$$$message_0407_0000_0000$$$::"Kiritsugu Emiya! Finalmente você ousa se mostrar diante de mim, imunda! Nunca vou permitir que você tenha o concededor de desejos! Isso é por queimá-lo meu estúdio!"::
45147::$$$message_0407_0000_0001$$$::"Você pode apenas pedir um novo."::
45148::$$$message_0407_0000_0002$$$::"Vai se foder! [wvl canskip=false time=400][hffgchg2 chara=ケイネス face=怒2 pos=left time=400 twno=2][hfangry layer=0]Como ousas! Lixo como você não merece ganhar! Provarei para você, com esse hanafuda, que sou o melhor!"::
45149::$$$message_0407_0000_0003$$$::"Obrigado por ter saído do seu caminho. Desculpe, Iri."::
45150::$$$message_0407_0000_0004$$$::"Eu sei, Kiritsugu. Vamos começar destruindo o Marble Fantasma na testa dele."::
45151::$$$message_0407_0000_0005$$$::"REEEEEE!"::
45152::$$$message_0407_0000_0006$$$::"Kayneth, o inimigo tem cabelo longo! Quero dizer, alcance longo! Um movimento errado, e suas folículos, quero dizer, seu couro cabeludo, hã, er..."::
45153::$$$message_0407_0000_0007$$$::"Não você também, Sola-Ui!"::
45154::$$$message_0407_0000_0008$$$::"Estava ansioso por esse momento... Somos os últimos dois Servants! É hora de resolver isso, Lancer!"::
45155::$$$message_0407_0000_0009$$$::"Nada me faria mais feliz, Saber!"::
45156::$$$message_0407_0000_0010$$$::"Espere, Lancer. Seu papel aqui terminou. Eu disse que vou ser quem luta."::
45157::$$$message_0407_0000_0011$$$::"Mas, meu lord!"::
45158::$$$message_0407_0000_0012$$$::"Se Lancer não usar suas lanças, então não tenho razão para levantar minha espada."::
45159::$$$message_0407_0000_0013$$$::"O que...? [wvl canskip=false time=400][hffgchg2 chara=切嗣 face=笑顔 pos=center time=300 twno=1][hfsigh layer=2] Tá bom. Vou usar um Selo de Mando para que você termine com ele."::
45160::$$$message_0407_0000_0014$$$::"Kiritsugu! Não acredito que você fez isso!"::
45161::$$$message_0407_0000_0015$$$::"Hmm, não tenho certeza se os Selo de Mando funcionam nesse jogo, mas não temos mais."::
45162::$$$message_0407_0000_0016$$$::"Oh?"::
45163::$$$message_0407_0000_0017$$$::"Estávamos em um restaurante com tudo que se pode comer: sushi, churrasco e coxas de caranguejo, então tive que usar tudo para puxar Saber para longe. A comida estava boa, no entanto."::
45164::$$$message_0407_0000_0018$$$::"Ma..."::
45165::$$$message_0407_0000_0019$$$::"Maiya! Preciso que você esteja aqui, Maiya!"::
45166::$$$message_0407_0000_0020$$$::"Senhor Kayneth, por favor, reconsidere!"::
45167::$$$message_0407_0000_0021$$$::"Hmm. Qual é o uso de cavalaria vazia? Meus feitos provaram para você que sou digno de ser seu Mestre?"::
45168::$$$message_0407_0000_0022$$$::"Senhor Kayneth..."::
45169::$$$message_0407_0000_0023$$$::"Você me serviu bem, Diarmuid Ua Duibhne. Agora é minha vez de retribuir sua lealdade. Um nobre deve suportar o peso de todos que o servem, lutando nas primeiras linhas."::
45170::$$$message_0407_0000_0024$$$::"Não me peça para renunciar à minha cavalaria."::
45171::$$$message_0407_0000_0025$$$::"Senhor..."::
45172::$$$message_0407_0000_0026$$$::"...Não posso me submeter, meu senhor. Nada é mais importante para mim do que minha promessa de lhe trazer a vitória."::
45173::$$$message_0407_0000_0027$$$::"Perdoe minha insolência por lutar ao seu lado!"::
45174::$$$message_0407_0000_0028$$$::"Você, idiota cego. Faça o que quiser."::
45175::$$$message_0407_0000_0029$$$::"Que alegria inesperada. Você escolheu o homem errado para servir, Saber!"::
45176::$$$message_0407_0000_0030$$$::"Eu já sei disso! Então o que!?"::
45177::$$$message_0407_0000_0031$$$::"Estou dizendo que sua cavalaria trágica não tem mérito para enfrentar minha lança. Este molar será suficiente."::
45178::$$$message_0407_0000_0032$$$::"Aww..."::

