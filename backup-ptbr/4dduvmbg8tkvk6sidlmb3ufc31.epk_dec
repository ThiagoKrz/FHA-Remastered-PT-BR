DAT
id=qid::label=str::text=lstr::
42177::$$$message_0329_0000_0000$$$::"De acordo com o convite, há um resort de águas quentes perto daqui..."::
42178::$$$message_0329_0000_0001$$$::"...?[lr]::
42179::$$$message_0329_0000_0002$$$::Sella, algo está errado.[lr]::
42180::$$$message_0329_0000_0003$$$::Há uma força mágica que parece Illyaa[line len=2]"[nolr]::
42181::$$$message_0329_0000_0004$$$::"Hehe. Procurando por algo, belas senhoras?[lr]::
42182::$$$message_0329_0000_0005$$$::Também tenho uma dor de estômago."::
42183::$$$message_0329_0000_0006$$$::"Quem é lá!?"::
42184::$$$message_0329_0000_0007$$$::"...Oh, se não é o filho dos Makiri."::
42185::$$$message_0329_0001_0000$$$::"Estamos apressados, nem temos tempo nem disposição para brincar com você."::
42186::$$$message_0329_0001_0001$$$::"Sim. Temos que chegar ao onsen."::
42187::$$$message_0329_0001_0002$$$::"Hahaha. A primeira coisa que você menciona é um onsen?"[lr]::
42188::$$$message_0329_0001_0003$$$::"Então, vamos ver se eu entendi direito.[lr]::
42189::$$$message_0329_0001_0004$$$::Você é um par de idiotas vestidos de criadas?[lr]::
42190::$$$message_0329_0001_0005$$$::E você está tentando abrir um resort de onsen temático de criada no meio do nada?"::
42191::$$$message_0329_0001_0006$$$::"Ah, não consigo mais, meu estômago dói de rir tanto! Não tem nenhum banho quente nestas montanhas sombrias!"::
42192::$$$message_0329_0002_0000$$$::"Você está sendo enganado, [hfchance layer=0], assim como eu!"::
42193::$$$message_0329_0002_0001$$$::"...Sella. Posso esmagá-la?"::
42194::$$$message_0329_0002_0002$$$::"Apenas um momento.[lr]::
42195::$$$message_0329_0002_0003$$$::...Filho preguiçoso da Makiri. O que você quer dizer, estamos sendo enganados?"::
42196::$$$message_0329_0002_0004$$$::"Acabei de dizer que não tem onsen por aqui!"::
42197::$$$message_0329_0002_0005$$$::"Maldição, essa noite livre de hospedagem é um lixo! Não tem harem, não importa onde eu olhe!"::
42198::$$$message_0329_0002_0006$$$::"Argh, meus lados doem tanto! A dor no estômago está me matando![lr]::
42199::$$$message_0329_0002_0007$$$::Estou perdido! Quero voltar pra casa!"::
42200::$$$message_0329_0002_0008$$$::"...Leysritt."::
42201::$$$message_0329_0002_0009$$$::"É. É hora de uma punição pesada."::

