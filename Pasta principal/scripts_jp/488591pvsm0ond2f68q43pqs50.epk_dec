DAT
id=qid::label=str::text=lstr::
45199::$$$message_0410_0000_0000$$$::「行くよ……！　[ruby text=フォイア char=2]放射！」[wvs]::
45200::$$$message_0410_0000_0001$$$::「弾が大きすぎる。今のイリヤの出力だと、もっと魔力を収束させないと」::
45201::$$$message_0410_0000_0002$$$::「…………」::
45202::$$$message_0410_0000_0003$$$::「分かった！　[wvl][hffgchg2 chara=イリヤpzm face=真剣 pos=left time=300]えっと……しっかりイメージして……放射！」[wvs]::
45203::$$$message_0410_0000_0004$$$::「うん、だいぶ良くなったと思う。あとは貫通力を持たせるために回転のイメージを付けられれば……」::
45204::$$$message_0410_0000_0005$$$::「………………ねぇ」::
45205::$$$message_0410_0000_0006$$$::「回転かぁ……。右回り？　左回り？」::
45206::$$$message_0410_0000_0007$$$::「それはどっちでも良いけど、回転軸を射出方向にあわせて……」::
45207::$$$message_0410_0000_0008$$$::「ちょっと！」::
45208::$$$message_0410_0000_0009$$$::「ん？　なに、クロ」::
45209::$$$message_0410_0000_0010$$$::「イリヤの新技開発に何か意見が？」::
45210::$$$message_0410_0000_0011$$$::「弱っちぃイリヤの小手先開発なんて興味ないわ。それよりも！　なにかおかしくない！？」::
45211::$$$message_0410_0000_0012$$$::「おかしくない」::
45212::$$$message_0410_0000_0013$$$::「おかしくないね」::
45213::$$$message_0410_0000_0014$$$::「てきとうに即答するなーッ！[wait time=400 canskip=0]　[hfwww layer=2]どう見てもおかしいでしょ！？　気付きなさいよあなたたち！」::
45214::$$$message_0410_0000_0015$$$::「…………それは……」::
45215::$$$message_0410_0000_0016$$$::「……えっと。いちおう朝から気付いてはいたんだけど見ないフリしてたって言うか、その……。色のこと？」::
45216::$$$message_0410_0000_0017$$$::「見ないフリしてたんかい」::
45217::$$$message_0410_0000_0018$$$::「それに声が……なんというか、言語を超越している」::
45218::$$$message_0410_0000_0019$$$::「そうよ！　なんでか知らないけどわたしの色と声が無くなっちゃったのよ！[wait time=400 canskip=0]　[hfwww layer=2]意味わかんない！　なにこれ！　バグじゃない！？」::
45219::$$$message_0410_0000_0020$$$::「ううっ、耳に聞こえる音はポポポポなのに、言葉の意味が分かるのって気持ち悪い……」::
45220::$$$message_0410_0000_0021$$$::「……もしかして、また魔力が不足して存在が不安定になっているの？」::
45221::$$$message_0410_0000_0022$$$::「ま、一番に考えられるのはそれよね。……しょうがない。不本意だけどいっちょやりますか」::
45222::$$$message_0410_0000_0023$$$::「へ？　なにクロ。どうしてガッシリとわたしの肩をつかむのかな？　[wvl][hffgchg2 chara=イリヤpzm face=驚き2 pos=left time=300][hfangry layer=0]ど、どうしてトロンとした表情で近づいてくるのかなっ！？」::
45223::$$$message_0410_0000_0024$$$::「いただきまーす……」::
45224::$$$message_0410_0000_0025$$$::「……………………濃厚」::
45225::$$$message_0410_0000_0026$$$::「ハァッ……ハァッ……！　ひっ……ひどい！　また乱暴に乙女の唇を奪われた……っ！」::
45226::$$$message_0410_0000_0027$$$::「ふぅ。わたしだって別に好きでこんな魔力供給の方法取ってるわけじゃないわよ。恨み言なら設定考えた人に言いなさい」::
45227::$$$message_0410_0000_0028$$$::「でも、クロ」::
45228::$$$message_0410_0000_0029$$$::「効果なし……みたいね。まぁ魔力は足りてたし、ダメもとだったけど」::
45229::$$$message_0410_0000_0030$$$::「ダメもとでちゅーされたのわたし！？」::
45230::$$$message_0410_0000_0031$$$::「……それならどうするの？　こんな非常識な症状、原因も治療法も見当がつかない」::
45231::$$$message_0410_0000_0032$$$::「非常識、ね……。[wait time=400 canskip=0][se storage=se04015.wav]だったら治す手段も、常識外のものから選びましょうか」::
45232::$$$message_0410_0000_0033$$$::「ん、その封筒なに？　……招待状？」::
45233::$$$message_0410_0000_0034$$$::「今朝ウチに届いてた温泉の招待状。なんでも願いが叶う魔法の温泉らしいわ」::
45234::$$$message_0410_0000_0035$$$::「魔法の温泉……？」::
45235::$$$message_0410_0000_0036$$$::「うさんくさー……。それにこれ、差出人も書いてないし……[wvl canskip=false time=200][hffgchg2 chara=イリヤpzm face=驚き pos=left time=300][hfchance layer=0]わっ、消印が１０年前だよ！？」::
45236::$$$message_0410_0000_0037$$$::「信憑性が高いわね」::
45237::$$$message_0410_0000_0038$$$::「どのへんが！？」::
45238::$$$message_0410_0000_0039$$$::「とにかく！　温泉に行くわよ！　わたしの色と声を取り戻すために！」:{}