DAT
id=qid::label=str::text=lstr::
43992::$$$message_0376_0000_0000$$$::「７のツーペア。ローマ」::
43993::$$$message_0376_0000_0001$$$::「ローマァ？　イヤな繋がりだなそりゃ。んじゃマンゴーで８のペアな」::
43994::$$$message_0376_0000_0002$$$::「２のペア。ゴールドで我の勝ちだ。[lr]::
43995::$$$message_0376_0000_0003$$$::　[hfsigh layer=0]次は[ruby text=スリーカード char=3]三枚組でいくか。６から始めるぞ。お題はセイバーが好きそうなもの」::
43996::$$$message_0376_0000_0004$$$::「９の[ruby text=スリーカード char=3]三枚組。美少年」::
43997::$$$message_0376_0000_0005$$$::「ち、[hfchance layer=0]どいつもこいつも景気よく出しやがって。オレだけ[ruby text=パス o2o=1]撤退できねえじゃねえか」::
43998::$$$message_0376_0000_0006$$$::「[line len=3]ジャックの[ruby text=スリーカード char=3]三枚組。んで、どっかの誰かさんの趣味とは正反対の、質素ながら品のいいショートソード」::
43999::$$$message_0376_0000_0007$$$::「異議あり。セイバーが好むものはすべからく装飾華美である筈だ。今のは無効だ、やり直せ」::
44000::$$$message_0376_0000_0008$$$::「いや、私はランサーを支持する。セイバーの好みそうなもの、というのであれば間違ってはいまい」::
44001::$$$message_0376_0000_0009$$$::「ハ、笑わせるなコトミネ。貴様にセイバーの何がわかる」::
44002::$$$message_0376_0000_0010$$$::「ことヤツの生態において、我以上に熟知した者はおらぬ。どれほどの根拠をもって断言するか」::
44003::$$$message_0376_0000_0011$$$::「先日、凛に突っ返された夜会服を譲ったのだが、目の前で破かれた。純粋な厚意だったのだが、残念だ」::
44004::$$$message_0376_0000_0012$$$::「はははははは！　たわけめ、あのセイバーが貢ぎ物など受け取るものか！」::
44005::$$$message_0376_0001_0000$$$::「我でさえ一日に一度は断られるのだ、当然であろう！」::
44006::$$$message_0376_0001_0001$$$::「よかろう、痛快なので許す。根拠としては弱いが、明日から我も控え目な贈り物を選ぶとしよう」::
44007::$$$message_0376_0001_0002$$$::「ところで１の[ruby text=スリーカード char=3]三枚組。ドル箱。続くものはいるか？」::
44008::$$$message_0376_0001_0003$$$::「パスだ」::
44009::$$$message_0376_0001_0004$$$::「右に同じ。あるワケねえだろ、１を上回る２はおまえが二枚も使いやがったんだから」::
44010::$$$message_0376_0001_0005$$$::「そうか、強すぎるというのも考え物だな。[lr]::
44011::$$$message_0376_0001_0006$$$::　[hffacechg chara=ギルガメッシュ face=楽 layer=0 time=200]……ふむ。仕方あるまい、おまえたちにも刃向かうチャンスをやろう」::
44012::$$$message_0376_0001_0007$$$::「そら、ハートの３だ。一枚だけならば抵抗しようもあろう。お題はセイバーに似合いそうなもの」::
44013::$$$message_0376_0001_0008$$$::「ハートの６。イヌミミフード」::
44014::$$$message_0376_0001_0009$$$::「（ようやく小さい数で始まったな。ヤロウは残り一枚……、残る絵札はコトミネのヤロウが隠し持っているだろうが……）」::
44015::$$$message_0376_0001_0010$$$::「くそ、みすみす勝たせられるか！　虎の子のエースを食らいやがれ！　で、えーと[stopmove][hfchance layer=0]ドラ焼き！」::
44016::$$$message_0376_0001_0011$$$::「く、なんだその矮小さは！　虎の子というからには最強の札を持ってこい雑兵！」::
44017::$$$message_0376_0001_0012$$$::「そら、ハートの２、金ピカと慕われる我！　勝負あったな、これであがりだぞ！」::
44018::$$$message_0376_0001_0013$$$::「はぁ！？　なにいってやがる、おまえ大富豪のルール知らねえのか！」::
44019::$$$message_0376_0002_0000$$$::「２あがりは厳禁、[hfchance layer=0]無条件でドベだって言っただろうが！」::
44020::$$$message_0376_0002_0001$$$::「なにを言ってるのかねキミは。[lr]::
44021::$$$message_0376_0002_0002$$$::　我の２の勝ちだ。最強の札を使って敗れるワケないであろ」::
44022::$$$message_0376_0002_0003$$$::「ふざけてんのはそっちだバカ金！[lr]::
44023::$$$message_0376_0002_0004$$$::　ああもう、ビリだビリ！　勝負するまでもねえ、[hfwww layer=0]偵察はテメェが行ってこい！」::
44024::$$$message_0376_0002_0005$$$::「……哀れな。どこの地方ルールかは知らんが、自らの敗北を認められぬとは」::
44025::$$$message_0376_0003_0000$$$::「だが、我の国では２あがり超オッケーなのだ」::
44026::$$$message_0376_0003_0001$$$::「そもそもなぜ２であがってはいかんのだ。大本になった原典があるのか？」::
44027::$$$message_0376_0004_0000$$$::「説明できるのなら聞いてやらんコトもないぞランサー？」::
44028::$$$message_0376_0004_0001$$$::「そりゃねえけどよ。逆転要素の一つと言うか、ワンサイドゲームを防ぐ為の足枷と言うか」::
44029::$$$message_0376_0004_0002$$$::「ともかく、一位のヤツを独走させないためのルールなんだよ、それは」::
44030::$$$message_0376_0004_0003$$$::「コトミネー。ここの青いの、自分でもわかってないルールで偉そうにしゃべってたのだぞー」::
44031::$$$message_0376_0005_0000$$$::「その尊大さに我もビックリ」::
44032::$$$message_0376_0005_0001$$$::「はっはっは。まあ許してやれギルガメッシュ」::
44033::$$$message_0376_0006_0000$$$::「七連続のドベだからな、ランサーもイチャモンの一つもつけねばやりきれないのだろう」::
44034::$$$message_0376_0006_0001$$$::「イチャモンじゃねー！　明確なルールの話をしてるんですよー！」::
44035::$$$message_0376_0006_0002$$$::「つーかそれぐらい守れ！　まっとうなルールなしで、毎回絵札と１と２を独占しているそこの金ボケに勝てるかっていうの！」::
44036::$$$message_0376_0006_0003$$$::「私に言われてもな。私とて、おまえと同じようなカードで戦っているのだが」::
44037::$$$message_0376_0006_0004$$$::「常に二番手しか狙ってねえヤツは黙ってろ！」::
44038::$$$message_0376_0007_0000$$$::「[hfchance layer=1][line len=3]くそ、いい機会だ、いい加減ここでハッキリさせようじゃねえか」::
44039::$$$message_0376_0007_0001$$$::「便利に使いやがって、オレは戦う為に呼ばれたんだっつーの！」::
44040::$$$message_0376_0007_0002$$$::「金にあかして日々食っちゃ寝の自称王様と、」::
44041::$$$message_0376_0008_0000$$$::「用事を全部人に押しつけるぐうたら神父の世話をする為に召喚されたんじゃねえですよー！」::
44042::$$$message_0376_0008_0001$$$::「心外だな。私なりに各々の長所を生かしているつもりなのだが」::
44043::$$$message_0376_0008_0002$$$::「ははは。いいではないか、我たち楽しいし」::
44044::$$$message_0376_0008_0003$$$::「よくねーんだよオレは！　[se storage=se181.wav]オマエらそこに座れ、オレが性根たたき直してやる！」::
44045::$$$message_0376_0008_0004$$$::「オラ、しみったれたカードなんざしまえしまえ。男だったらコレだろコレ」::
44046::$$$message_0376_0008_0005$$$::「ほう、バックギャモンか。[line len=3]それにはちとうるさいぞ私は」::
44047::$$$message_0376_0008_0006$$$::「むう、何やらまだるっこしそうなものを」::
44048::$$$message_0376_0009_0000$$$::「我的に、始めから沢山貰えるゲームがいいのだが。まあよい、ルールを教えるがいい雑兵」::
44049::$$$message_0376_0010_0000$$$::「……ランサーの気配を辿ってみれば、こんな事になってるなんて……」::
44050::$$$message_0376_0010_0001$$$::「コトミネが怪しいのはあからさまだったけど、あんなサーヴァントまでいるなんて[l][br][line len=3][hfchance layer=1][say storage=HSTR7_BIR_0030 _name=ブルマイリヤ]どうする、タイガ？」::
44051::$$$message_0376_0010_0002$$$::「どうするって、どうすればいいのイリヤちゃん……！？」::
44052::$$$message_0376_0011_0000$$$::[se storage=se023.wav][movefg textoff=0 opacity=200 left=0 top=0 time=100 accel=0 storage=08魔術・電撃][lquake layer=2 wait=0 hmax=0 vmax=25 interval=0][wm canskip=0][wait canskip=0 time=100][movefg textoff=0 opacity=0 left=0 top=0 time=600 accel=0 storage=08魔術・電撃]「ひぃぃ、怖すぎるわ……！[lr]::
44053::$$$message_0376_0011_0001$$$::　なんであんなところで大富豪やってるのあの人たち……！」[wm canskip=0][hfstopquake layer=2]::
44054::$$$message_0376_0011_0002$$$::「あ、驚くのそっちッスか師しょー」::
44055::$$$message_0376_0011_0003$$$::「なんてコト[line len=3]コココ怖ぇ、正直勝てる気がしねぇ」::
44056::$$$message_0376_0012_0000$$$::「とくにあの金色。なんか、一歩間違えればわたしと同じ芸風な気がして寒気しまくり」::
44057::$$$message_0376_0012_0001$$$::「あー……そっか、タイガって天然系の人と戦うのは初めてだもんね。ただでさえ三対二だし、ここは様子を見る？」::
44058::$$$message_0376_0012_0002$$$::「なんか、ほっとけば仲間割れしそうだし」::
44059::$$$message_0376_0012_0003$$$::「う。んー、漁夫の利という言葉はタイヘン美味しそうなのですが、わたしゃ魚より肉が好き」::
44060::$$$message_0376_0012_0004$$$::「難しいコト考える前に、[l][hfchance layer=0][say storage=HSTR7_TIG_0080 _name=藤ねえ]とりあえず戦ってみましょう！」::
44061::$$$message_0376_0012_0005$$$::「だと思った。[l][hfsigh layer=1][say storage=HSTR7_BIR_0090 _name=ブルマイリヤ]ほーんと無鉄砲なんだから」::
44062::$$$message_0376_0012_0006$$$::「む。マスターとして撤退命令だす？　イリヤちゃん」::
44063::$$$message_0376_0012_0007$$$::「まさか。それがタイガだもの。地獄の底まで付き合ってあげるわ」::
44064::$$$message_0376_0013_0000$$$::「タイガがおバカであるうちは、誰が相手でも戦っていけるものね」::
44065::$$$message_0376_0013_0001$$$::「う、なんという健気な弟子なのか。[br]::
44066::$$$message_0376_0013_0002$$$::ちょっとラブ」::
44067::$$$message_0376_0013_0003$$$::「……けど、そのわりにはこう、なんつーかイリヤちゃん覇気がないような」::
44068::$$$message_0376_0013_0004$$$::「……うーん、実はそうなんスよ師しょー」::
44069::$$$message_0376_0013_0005$$$::「あの金色を見てるだけで心臓のあたりがきゅーっと来るんすけど、これってもしかすると恋なのかな……？」::
44070::$$$message_0376_0013_0006$$$::「なんつーかこー、アイツの心臓えぐりとりてぇ」::
44071::$$$message_0376_0013_0007$$$::「そりゃ微妙に違うっていうか、もしかして新手の吊り橋効果？」[nolr][p]::
44072::$$$message_0376_0013_0008$$$::「うう、やはり改心しようと残虐ロリっ娘からは抜け出せぬか……まさに聖杯戦争は殺し愛、愛情イコールキリングよのぅ……」::
44073::$$$message_0376_0014_0000$$$::「はいはい、そこまでよ愉快な三人組！[lr]::
44074::$$$message_0376_0014_0001$$$::　聖杯戦争もこれで最後、さっさと星をよこしなさい！」::
44075::$$$message_0376_0014_0002$$$::「……？　おいコトミネ、なんだアイツら。オマエ、また悪趣味な副業始めたんじゃなかろうな」::
44076::$$$message_0376_0014_0003$$$::「いや、彼女たちは私たちの同業だよランサー。先日マスターになった少女とそのサーヴァントだ」::
44077::$$$message_0376_0014_0004$$$::「大方マスター権を放棄し、保護してほしいという相談だろうが[line len=3]」::
44078::$$$message_0376_0014_0005$$$::「残念ながらその逆よコトミネ」::
44079::$$$message_0376_0014_0006$$$::「わたしたちはここまで勝ち残ってきたの。[lr]::
44080::$$$message_0376_0014_0007$$$::　逃げ込んできたんじゃなくて、最後まで隠れてた貴方たちを倒しに来たのよ」::
44081::$$$message_0376_0014_0008$$$::「こらこら。物事はもっとわかりやすく言うものだ」::
44082::$$$message_0376_0015_0000$$$::「今の言いようでは、『わたしたちは他の五組を倒してきたワ』と聞こえてしまう」::
44083::$$$message_0376_0015_0001$$$::「そのような結果はあり得ないだろう？[lr]::
44084::$$$message_0376_0015_0002$$$::　すまないが、もう一度言い直してくれたまえ」::
44085::$$$message_0376_0015_0003$$$::「だーかーらー。もう他のマスターは全員やっつけて、残りはアンタたちだけって言ってるのよ」::
44086::$$$message_0376_0016_0000$$$::「ほれ、ちゃんと星六つあるでしょ」::
44087::$$$message_0376_0016_0001$$$::「[line len=6]」::
44088::$$$message_0376_0016_0002$$$::「はあ！？　[hfchance layer=1]なんだそりゃ、話が違うぞコトミネ！」::
44089::$$$message_0376_0017_0000$$$::「おまえ、始まったばかりで戦いは起きねえって言ったじゃねえか！？」::
44090::$$$message_0376_0017_0001$$$::「[line len=12]」::
44091::$$$message_0376_0017_0002$$$::「魂が抜けておる……！」::
44092::$$$message_0376_0017_0003$$$::「おーい、帰ってこーいコトミネー。[lr]::
44093::$$$message_0376_0017_0004$$$::　ショックなのはわかるが、そりゃ毎日遊んでいればこうなるのだぞー」::
44094::$$$message_0376_0017_0005$$$::「[line len=6]ハ！？」::
44095::$$$message_0376_0017_0006$$$::「…………………………[hfchance layer=0]フ、なるほど。[lr]::
44096::$$$message_0376_0017_0007$$$::　君たちが勝ち残る事は予測済みだったが、まさかこれほど早く辿り着くとはな」::
44097::$$$message_0376_0017_0008$$$::「まずは見事と言っておこうイリヤスフィール。だが所詮は我が思惑の内だ」::
44099::$$$message_0376_0017_0010$$$::「オッケー。すべてオッケー。問題なし。[lr]::
44100::$$$message_0376_0017_0011$$$::　さあ、消耗した体でどこまで戦えるか、存分に楽しませてもらおうか……！」::
44101::$$$message_0376_0017_0012$$$::「……ランサー。我な、唐突にやり残しのＲＰＧをやりたくなってきたのだが」::
44102::$$$message_0376_0017_0013$$$::「……初めて気があったな。オレも、ほったらかしにしていた屋根裏の掃除をしたくなった」::
44103::$$$message_0376_0017_0014$$$::「ハハハ。それ死亡フラグっぽいぞ雑兵」::
44104::$$$message_0376_0017_0015$$$::「テメェも一緒だよ！」::
44105::$$$message_0376_0017_0016$$$::[nr]「何をしている、ランサー！　アーチャー！[lr]::
44106::$$$message_0376_0017_0017$$$::　敵は得体の知れぬサーヴァント一人、おまえたちの敵ではあるまい！」::
44107::$$$message_0376_0017_0018$$$::「予定通り、我らの完勝で聖杯戦争の幕を下ろすのだ！」::
44108::$$$message_0376_0017_0019$$$::「何が予定通りか。[lr]::
44109::$$$message_0376_0017_0020$$$::　[line len=3]が、契約者の失策を立て直すのも我の務めだ。気が乗らぬが手を組むか雑兵！」::
44110::$$$message_0376_0017_0021$$$::「そりゃこっちのセリフだ。出遅れんなよ放蕩王子！」[nolr][p]::
44111::$$$message_0376_0017_0022$$$::「っ……！　なんか色々必死なコトミネだけど、後ろの二人は本物よ……！[lr]::
44112::$$$message_0376_0017_0023$$$::　[hffacechg chara=ブルマイリヤ face=真剣 layer=1 left=7 top=397 time=200][hfchance layer=1]タイガ、気をつけて……！」::
44113::$$$message_0376_0017_0024$$$::「わかってる[line len=3]この三人組、決死でかからないと倒せない……！[l]　[hffacechg chara=藤ねえ face=真剣3 index=4000 layer=0 time=200][say storage=HSTR7_TIG_0200 _name=藤ねえ]行くわよイリヤちゃん、背中の守りは任せたわ！」::
44114::$$$message_0376_0017_0025$$$::「オーケー、回復は任せてタイガ！[lr]::
44115::$$$message_0376_0017_0026$$$::　大丈夫、どんなにボロボロになっても令呪で無理矢理戦わせてあげるから！」::
44116::$$$message_0376_0017_0027$$$::「ひぃー、背中も油断ならねぇ！？[lr]::
44117::$$$message_0376_0017_0028$$$::　や、やはりこのロリっ娘根っからの悪魔ですよ！？」[nolr][p]::
