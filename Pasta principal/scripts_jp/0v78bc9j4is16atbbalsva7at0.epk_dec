DAT
id=qid::label=str::text=lstr::
45726::$$$message_0437_0000_0000$$$::「ぬ」::
45727::$$$message_0437_0000_0001$$$::「おや？」::
45728::$$$message_0437_0000_0002$$$::「旦那、知り合い？」::
45729::$$$message_0437_0000_0003$$$::「いえ。どうやら魔術師のようですね」::
45730::$$$message_0437_0000_0004$$$::「見つけたぞ、魔術師の[ruby text=ルール char=2]規則に反する薄汚いマスターとサーヴァントめ！」::
45731::$$$message_0437_0000_0005$$$::「このアーチボルト家九代目頭首、人呼んで『ザ・ビッグベン』ケイネス・エルメロイが貴様たちを[line len=2]」::
45732::$$$message_0437_0000_0006$$$::「誅！　[wvl canskip=false time=200]伐！　[wvl canskip=false time=200]してくれよう！」::
45733::$$$message_0437_0000_0007$$$::（……ザ・ビッグベンなんて呼ばれていたかしら……）::
45734::$$$message_0437_0000_0008$$$::（フッ。決まった）::
45735::$$$message_0437_0000_0009$$$::「……じーっ」::
45736::$$$message_0437_0000_0010$$$::「？」::
45737::$$$message_0437_0000_0011$$$::「じーっ……」::
45738::$$$message_0437_0000_0012$$$::「な、何よアナタたち」::
45739::$$$message_0437_0000_0013$$$::「ああ、ゴメンゴメン。いや、材料にどうかなって思っただけ」::
45740::$$$message_0437_0000_0014$$$::「は、材料？」::
45741::$$$message_0437_0000_0015$$$::「柔軟な材質なので、骨組みよりは表面のコーティングに回した方がいいでしょう」::
45742::$$$message_0437_0000_0016$$$::「脂肪多そうだしなぁ」::
45743::$$$message_0437_0000_0017$$$::「この私に向かって……！」::
45744::$$$message_0437_0000_0018$$$::「ソラウ様、お下がりあれ！　このキャスターとマスターは、いたいけな少年少女に、蛮行を繰り広げた救いようのない外道ども」::
45745::$$$message_0437_0000_0019$$$::「御身に何かあれば、ケイネス殿が哀しみます……！」::
45746::$$$message_0437_0000_0020$$$::「ランサー……[heart]」::
45747::$$$message_0437_0000_0021$$$::「……ケイネス殿が！　哀しみます故に！」::
45748::$$$message_0437_0000_0022$$$::「ふふふ、ありがとうランサー。私の為に！　私の為に！　身を挺してくれるなんて！」::
45749::$$$message_0437_0000_0023$$$::[delay speed=25]「あ・[wait canskip=false time=40]る・[wait canskip=false time=40]じ・[wait canskip=false time=40]の・[wait canskip=false time=40]た・[wait canskip=false time=40]め・[wait canskip=false time=40]に！　[delay speed=user][wvl][hfangry layer=0]このランサー、粉骨砕身致しますとも！」::
45750::$$$message_0437_0000_0024$$$::「……何だか、複雑な人間関係が垣間見えるなぁ、旦那」::
45751::$$$message_0437_0000_0025$$$::「イヤですね、こういう生臭い人間関係は」::
45752::$$$message_0437_0000_0026$$$::「……はっ！　[wvl canskip=false time=300][hffgchg2 chara=ケイネス face=怒3 pos=right time=300 twno=1][hfangry layer=1]ええい、何をしておるランサー！　さっさとサーヴァントを片付けろ！」::
45753::$$$message_0437_0000_0027$$$::「御意！」::
45754::$$$message_0437_0000_0028$$$::「頑張ってね、ランサー！」::
45755::$$$message_0437_0000_0029$$$::「……」::
45756::$$$message_0437_0000_0030$$$::「征くぞ、キャスター！」::
45757::$$$message_0437_0000_0031$$$::「そして、リュウノスケとやら。貴様は直々に、このケイネス・エルメロイ・アーチボルトが誅伐をくれてやろう」::
45758::$$$message_0437_0000_0032$$$::「我が婚約者に、色目を使ったことへの恐ろしさ、とくと見せてくれよう！」::
45759::$$$message_0437_0000_0033$$$::「……色目なんて使ってねーのに」::
45760::$$$message_0437_0000_0034$$$::「どちらかというと、欲目でしょうね」::
