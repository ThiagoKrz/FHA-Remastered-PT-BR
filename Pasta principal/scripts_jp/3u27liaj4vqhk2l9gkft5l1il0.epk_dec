DAT
id=qid::label=str::text=lstr::
45267::$$$message_0413_0000_0000$$$::「！　あなたは……」::
45268::$$$message_0413_0000_0001$$$::「あら？」::
45269::$$$message_0413_0000_0002$$$::「ママ！？」::
45270::$$$message_0413_0000_0003$$$::「む……」::
45271::$$$message_0413_0000_0004$$$::「パパ！」::
45272::$$$message_0413_0000_0005$$$::「どうしてここに……！？　ママはともかく、おとーさんは外国でお仕事してるんじゃなかったの？」::
45273::$$$message_0413_0000_0006$$$::「それに二人とも、なんかちょっと若いような……」::
45274::$$$message_0413_0000_0007$$$::「誰かと勘違いしているのかしら？　ごめんね、お嬢さんたち。私たちはママとパパじゃないわ」::
45275::$$$message_0413_0000_0008$$$::「絶縁された！？」::
45276::$$$message_0413_0000_0009$$$::「口調がいつものおバカっぽい感じじゃないわ！　冗談にしてもひどいわよママ！」::
45277::$$$message_0413_0000_0010$$$::「だから勘違いよ。確かに私には娘がいるけど、もっと小さい子なの。大切な……世界一かわいい娘よ」::
45278::$$$message_0413_0000_0011$$$::「ええー……？　こ、これ、怒るべきなの？照れるべきなの……？」::
45279::$$$message_0413_0000_0012$$$::「ちょっとママ！　いい加減に……」::
45280::$$$message_0413_0000_0013$$$::「止まりなさい。それ以上の接近は許しません」::
45281::$$$message_0413_0000_0014$$$::「わっ！？」::
45282::$$$message_0413_0000_0015$$$::「イリヤ下がって！　あの人……強い！」::
45283::$$$message_0413_0000_0016$$$::「もー、なんなのよママ！　わたしたちのことが分からないの！？」::
45284::$$$message_0413_0000_0017$$$::「ママ、おとーさん！　わたしだよ、イリヤだよー！」::
45285::$$$message_0413_0000_0018$$$::「イリヤ……？　た、確かに面影はあるけど、まさかそんな……」::
45286::$$$message_0413_0000_0019$$$::「惑わされるなアイリ。これは敵の霍乱だ。あれは……イリヤではない」::
45287::$$$message_0413_0000_0020$$$::「そ、そうよね。ここにイリヤがいるわけないし……。[wvl canskip=false time=400][hffgchg2 chara=アイリ face=喜 pos=right time=400 twno=1]それに、よく見たら全然イリヤに似てないわ」::
45288::$$$message_0413_0000_0021$$$::「ちょっと！？」::
45289::$$$message_0413_0000_0022$$$::「ああ、似ても似つかない。ましてや、ウチの娘があんなふざけた恥ずかしい格好をするはずがない」::
45290::$$$message_0413_0000_0023$$$::「確かにイリヤたちの格好は恥ずかしいけど、ひどい言い草じゃないパパ！？」::
45291::$$$message_0413_0000_0024$$$::「わたしだって好きで恥ずかしい格好してるんじゃないんですけどー！？」::
45292::$$$message_0413_0000_0025$$$::（恥ずかしい格好……だったんだ……）::
45293::$$$message_0413_0000_0026$$$::「どこのマスターかは知らぬが、姿を子息に似せるとは姑息な手を使う……。正体を現すが良い！」::
45294::$$$message_0413_0000_0027$$$::「イリヤ、来る！」::
45295::$$$message_0413_0000_0028$$$::「はうー！　家庭崩壊の危機ーッ！？」::
45296::$$$message_0413_0000_0029$$$::「そっちがその気なら……本気の反抗期、見せてあげるわ！」�2�