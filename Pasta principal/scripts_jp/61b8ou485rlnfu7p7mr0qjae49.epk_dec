DAT
id=qid::label=str::text=lstr::
45763::$$$message_0439_0000_0000$$$::「……うわぁ」::
45764::$$$message_0439_0000_0001$$$::「うわぁ……」::
45765::$$$message_0439_0000_0002$$$::「……」::
45766::$$$message_0439_0000_0003$$$::[nr]「おお……おお、おお、おおおおおおおっ！」::
45767::$$$message_0439_0000_0004$$$::「さん、はい」::
45768::$$$message_0439_0000_0005$$$::「ジャンヌゥゥゥゥッ！　ジャンヌ、ジャンヌ、ジャンヌジャンヌ、[wvl][hfangry layer=0]ジャアアアアアアアアアアンヌ！」::
45769::$$$message_0439_0000_0006$$$::「だから、ジャンヌではないと[line len=2]」::
45770::$$$message_0439_0000_0007$$$::「無駄よ、セイバー。彼の精神汚染は手の施しようがないわ」::
45771::$$$message_0439_0000_0008$$$::（Ａランクだからな……人の言うことを聞いてはいるが理解していない）::
45772::$$$message_0439_0000_0009$$$::（だが、指示に従う程度の知力は残っているだろう）::
45773::$$$message_0439_0000_0010$$$::「何と！　まさか、まさか御身も願い事を叶えに、この温泉にやってきたというのですか！？　おお、何ということだ！」::
45774::$$$message_0439_0000_0011$$$::「神に祈りこそすれ、願うことなどついぞ無かった貴女が我欲を持つとは……何と、何と！」::
45775::$$$message_0439_0000_0012$$$::「前々から言っているように、私が望むのは故国ブリテンの[line len=2]」::
45776::$$$message_0439_0000_0013$$$::「素晴らしいことでしょう！　さあジャンヌ、貴女を裏切った神を、人間を！　討ち滅ぼすというその願い[line len=2]」::
45777::$$$message_0439_0000_0014$$$::「このジル・ド・レェが叶えて差し上げましょう！[wvl canskip=false time=200][hffgchg2 chara=キャスター4th face=笑顔3 pos=left time=300 twno=1][hfangry layer=0]　さあ、ふんぐるいむぐるうなふくとぅ[line len=2]」::
45778::$$$message_0439_0000_0015$$$::「キャー！　こんな場所でそんなトンデモ邪神の召喚はやめてー！」::
45779::$$$message_0439_0000_0016$$$::（情報通り、キャスターはセイバーを崇拝している……上手くコントロールすれば、駒として活用できるか……？）::
45780::$$$message_0439_0000_0017$$$::（アイリの説得が厄介だが……どうせ、切り捨てるサーヴァントだ。結果的にそうなれば文句もあるまい）::
45781::$$$message_0439_0000_0018$$$::「ともかく！　私も娘を持つ母としてお前たちの蛮行は許し難く[line len=2]」::
45783::$$$message_0439_0000_0020$$$::「え！？　そこのお姉さん、娘さんがいるの！？ 　歳いくつ！？ 　お姉さんに似てる！？　紹介して！」::
45784::$$$message_0439_0000_0021$$$::「……」::
45785::$$$message_0439_0000_0022$$$::「ふむ。彼女の娘ならば、どこの美術館に展示されてもおかしくない芸術品として賞賛されるでしょうね」::
45786::$$$message_0439_0000_0023$$$::「……」::
45787::$$$message_0439_0000_0024$$$::「……舞弥。悪いが、旧ソ連の軍人と話をつけてくれ。[wvl canskip=false time=300][hffgchg2 chara=切嗣 face=怒 pos=center time=300 twno=2][hfburstblood layer=2 ox=-80 oy=40][hfchance layer=2]原潜のＳＬＢＭで、冬木市諸共キャスターを吹き飛ばす！」::
45788::$$$message_0439_0000_0025$$$::「アイリスフィール！　なんかトンデモないことを呟いているんですけど、貴女の夫！」::
45789::$$$message_0439_0000_0026$$$::「うふふふふ。こういう時、どう言えばいいか。この間道で出会ったツインテニーソの女の子に教えて貰ったわ」::
45790::$$$message_0439_0000_0027$$$::「[line len=2][ruby text=ぶっちぎる char=7]殴ッ血ＫＩＬＬ！」::
45791::$$$message_0439_0000_0028$$$::「あーもー！　よくもこの二人の地雷を踏んでくれたな、貴様等！」::
45792::$$$message_0439_0000_0029$$$::「うーん、よく分からないけど恨まれたみたいだね、オレたち」::
45793::$$$message_0439_0000_0030$$$::「致し方ありません。ジャンヌ、貴女の願い事を叶える前に[line len=2]まずは」::
45794::$$$message_0439_0000_0031$$$::「オレたちが先に願い事を叶えることにしようか。イッツ、ショウタイムッ！！」::
