DAT
id=qid::label=str::text=lstr::
43045::$$$message_0356_0000_0000$$$::「……宗一郎様、どこに居るのかしら」::
43046::$$$message_0356_0000_0001$$$::「ふふ、それにしても、急にお出かけしましょうなんて言ったら驚くかしら」::
43047::$$$message_0356_0000_0002$$$::「……いえ、宗一郎様に限って驚いたりはしないでしょうね。[lr]::
43048::$$$message_0356_0000_0003$$$::　[hffacechg chara=キャスター face=楽 layer=0 time=200]あ、宗一郎……様？」::
43049::$$$message_0356_0001_0000$$$::「[line len=3]」::
43050::$$$message_0356_0001_0001$$$::「[line len=3]」::
43051::$$$message_0356_0001_0002$$$::『い、一体なにが……宗一郎様とあの役たたず、睨み合って……！？』::
43052::$$$message_0356_0001_0003$$$::「[line len=3]王手だ」::
43053::$$$message_0356_0001_0004$$$::「[line len=3]ふむ、どうやら詰みのようだ。なかなか勝てはせんな」::
43054::$$$message_0356_0001_0005$$$::「……ちょ、[hfchance layer=0]ちょっと何をしてるのアサシン！」::
43055::$$$message_0356_0001_0006$$$::「む？　知り合いだったのかキャスター」::
43056::$$$message_0356_0001_0007$$$::「知り合いも何も……どういう事かしらコレは」::
43057::$$$message_0356_0001_0008$$$::「どういうもなにも、見ての通り私と宗一郎殿はこのような関係だが？」::
43058::$$$message_0356_0001_0009$$$::「うむ。最近の言葉を使うのならばマブという奴だ」::
43059::$$$message_0356_0001_0010$$$::「……そう（後で絞めるわ）……それはそうと宗一郎様、お出かけいたしませんか？」::
43060::$$$message_0356_0001_0011$$$::「かまわん。何処だ」::
43061::$$$message_0356_0001_0012$$$::「ええ、ご住職から良い温泉宿を紹介していただきました」::
43062::$$$message_0356_0001_0013$$$::「温泉か。風情がありますな宗一郎殿」::
43063::$$$message_0356_0001_0014$$$::「風情か。……私には難しいものだが」::
43064::$$$message_0356_0001_0015$$$::「あらアサシン、貴方も温泉に興味があって？」::
43065::$$$message_0356_0001_0016$$$::「この国に生まれついて、湯の事に気が向かぬというのは不幸としか言い様が無いな」::
43066::$$$message_0356_0001_0017$$$::「なら、貴方も来るかしら？」::
43067::$$$message_0356_0001_0018$$$::「む？　一体どういう風の吹き回しだ。お主は主と過ごす時間を邪魔される事を嫌っていると覚えていたが？」::
43068::$$$message_0356_0001_0019$$$::「たまにはそういう気が向く事くらいあるわ…………[wait canskip=0 time=400][hffacechg chara=キャスター face=不満 layer=0 time=200]もしかしてセイバーが襲撃してくるかもしれないし」::
43069::$$$message_0356_0001_0020$$$::「[line len=2]何か言ったか？」::
43070::$$$message_0356_0001_0021$$$::「いえ、何も」::
43071::$$$message_0356_0001_0022$$$::「しかし忘れた訳ではあるまい。私はこの山門から離れる事はまかりならんのだぞ」::
43072::$$$message_0356_0001_0023$$$::「ああ、そんな事？　[wait canskip=0 time=400][se storage=se042.wav][hffacechg chara=キャスター face=喜 time=200][hfchance layer=0][line len=2]えい」::
43073::$$$message_0356_0001_0024$$$::「[line len=2]む？」::
43074::$$$message_0356_0001_0025$$$::「貴方の主を山門から宗一郎様の眼鏡に移しました。帰るまで、宗一郎様をお守りなさい」::
43075::$$$message_0356_0001_0026$$$::「守る、とは穏やかでは無いな[line len=2]」::
43076::$$$message_0356_0001_0027$$$::「では、参りましょうか宗一郎様？」::
43077::$$$message_0356_0001_0028$$$::「うむ」::
