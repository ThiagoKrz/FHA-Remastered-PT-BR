id=qid::label=str::text=lstr::
45797::$$$message_0441_0000_0000$$$::「ふーん、ふーん、ふ～ん♪」::
45798::$$$message_0441_0000_0001$$$::「アトリエの移転も何とかなりそうだし、これで夢の管弦楽団に向けての第一歩を踏み出せた」::
45799::$$$message_0441_0000_0002$$$::「おまけに、この血の池温泉も最ッ高にＣＯＯＬだね！　あー人生充実してるなー、オレ！」::
45800::$$$message_0441_0000_0003$$$::「……ん？　温泉なのにＣＯＯＬっておかしいかな？　ＨＯＴ？」::
45801::$$$message_0441_0000_0004$$$::「ま、いっか。そういや、旦那は温泉初体験だったよね？　どう？」::
45802::$$$message_0441_0000_0005$$$::「おお……あのジャンヌが、これほど小さく、そして精密に再現されるとは！」::
45803::$$$message_0441_0000_0006$$$::「この顔！　この肌！　このうなじ！　まさに、あの日あの時あの場所で出会ったジャンヌそのままではないか！」::
45804::$$$message_0441_0000_0007$$$::「退廃の象徴たる資本主義とやらも侮るべからず、というところですか……ふむ」::
45805::$$$message_0441_0000_0008$$$::「おーい、旦那ー！」::
45806::$$$message_0441_0000_0009$$$::「っと失礼、リュウノスケ。どうしました？」::
45807::$$$message_0441_0000_0010$$$::「いや、湯加減どうかなーって」::
45808::$$$message_0441_0000_0011$$$::「おお、温泉のことですか。ふむ……湯に浸かる、という慣習は我々の文化についぞ根付きませんでしたが……」::
45809::$$$message_0441_0000_0012$$$::「これはなかなか趣があってよろしいですねぇ」::
45810::$$$message_0441_0000_0013$$$::「だろー？　温かい湯に浸かって、心身共にリフレッシュ。明日からまた頑張ろうって気になるんだよなぁ」::
45812::$$$message_0441_0000_0015$$$::「おおおぉぉぉぉぉ！？」::
45813::$$$message_0441_0000_0016$$$::「だ、旦那！？」::
45814::$$$message_0441_0000_0017$$$::「ジャンヌ！　ジャンヌが！　私のジャンヌの白魚のように細く可憐な指先がポッキンとぉぉ！？」::
45815::$$$message_0441_0000_0018$$$::「あー……さっきからいじくり回してるから。フィギュアは人間より壊れやすいよ、旦那…………あ」::
45816::$$$message_0441_0000_0019$$$::「こ、今度は同量の黄金すら比較にならない価値を誇るはずの髪の毛がァァァッ！！」::
45817::$$$message_0441_0000_0020$$$::「おのれェェッ！　神はどこまで私を玩弄すれば気が済むのかッ……！」::
45818::$$$message_0441_0000_0021$$$::「我らが神を求めしときは応えず、求めず我が道を行くときは邪魔立てする……何とおぞましく腐り果てた性根なのか！」::
45819::$$$message_0441_0000_0022$$$::「『人の嫌がることをやってはいけない』など、幼子でも分かる理屈であろうに……！」::
45820::$$$message_0441_0000_0023$$$::「うん。まあでもフィギュアをいじるときは、その爪を何とかした方がいいと思うよ」::
45821::$$$message_0441_0000_0024$$$::「今度は塗料がハゲたーーーーっ！����