DAT
id=qid::label=str::text=lstr::
19273::$$$message_0153_0000_0000$$$::「へえ、意外……って程でもねえか。[lr]::
19274::$$$message_0153_0000_0001$$$::　セイバーを打ち倒してここに着いたのがお前らだとはな……」::
19275::$$$message_0153_0000_0002$$$::「で、坊主。なんでテメエまで居るんだ？」::
19276::$$$message_0153_0000_0003$$$::「いや、成り行きって奴か、な？」::
19277::$$$message_0153_0000_0004$$$::「ふうん、ランサーが最後の相手？　セイバーに比べて随分見劣りするわね」::
19278::$$$message_0153_0000_0005$$$::「言ったな、ガキ。[lr]::
19279::$$$message_0153_0000_0006$$$::　その言葉後悔させて[line len=3]」[wvs]::
19280::$$$message_0153_0000_0007$$$::「蹴散らしなさい、バーサーカー」::
19281::$$$message_0153_0000_0008$$$::「[wacky len=6][line len=3]！！！！」::
19282::$$$message_0153_0000_0009$$$::「うわ、いきなりかー」::
19283::$$$message_0153_0000_0010$$$::「へ、上等！　刺し穿つ[line len=4][wait canskip=0 time=2500][move textoff=0 opacity=255 base=hf_バーサーカー-怒 cx=88 layer=0 py=123 px=125 affine=(124,185,+0.0,1,255,88,88)(127,301,3.691,1,255,88,88)(132,374,24.146,1,255,88,88)(133,331,10.954,1,255,88,88)(136,348,13.57,1,255,88,88) time=300 cy=88 mag=1 deg=+0.0 accel=0][se storage=se115.wav][wm canskip=0][se storage=se290.wav][hffacechg chara=ランサー face=驚 layer=1 time=200][hfchance layer=1]ぐぁ！」::
19284::$$$message_0153_0000_0011$$$::「あーあ、やっぱランサーじゃこの程度ね」::
19285::$$$message_0153_0001_0000$$$::「さてと、邪魔も居なくなったし、行こうかお兄ちゃん？　あ、バーサーカー、もういいわよ」::
19286::$$$message_0153_0001_0001$$$::「[line len=4]」::
19287::$$$message_0153_0001_0002$$$::「まあ、ランサーもあのぐらいじゃ死なないだろう……[wait canskip=0 time=500][l][hffacechg chara=士郎 face=悩 layer=1 time=200][say storage=HIRI6_SHI_0040 _name=士郎]たぶん」::
19288::$$$message_0153_0001_0003$$$::「ふん。斥候の役割も果たせぬとはな。雑兵ではその程度か」::
19289::$$$message_0153_0001_0004$$$::「うわ」::
19290::$$$message_0153_0001_0005$$$::「人形風情が、あの程度のパシリを倒して何を喜んでいるか」::
19291::$$$message_0153_0002_0000$$$::「ランサーなど我らの中では下の下。基本的な人権すら認められてはおらん」::
19510::$$$message_0153_0002_0001$$$::「……いや、認めてやれよ。そんくらい」::
19511::$$$message_0153_0002_0002$$$::「シロウ、わたしアイツ嫌い。ネコとか黒害虫と同じぐらい嫌い。どうにかして」::
19512::$$$message_0153_0002_0003$$$::「え、ええええ！？[hfsweat layer=1]　どうにかしろって言われても」::
19513::$$$message_0153_0002_0004$$$::「前に一回勝ってるんでしょ」::
19514::$$$message_0153_0002_0005$$$::「あ、あれは遠坂の援護があったからでだね」::
19515::$$$message_0153_0002_0006$$$::「何よ、リンとラブラブな事しないとアイツに勝てないっていうの！？」::
19516::$$$message_0153_0002_0007$$$::「あ、あんまりそういう事を大声で言うなって！」::
19517::$$$message_0153_0002_0008$$$::「ふーんだ、魔力だったらわたしが幾らでもあげるから、はやくアイツをどうにかしてよ」::
19518::$$$message_0153_0002_0009$$$::「うわ、イリヤ自分が何言ってるか分かってるのか！？」::
19519::$$$message_0153_0002_0010$$$::「……むう。驚いたな、貴様そこまで守備範囲が広いとは。[lr]::
19520::$$$message_0153_0002_0011$$$::　セイバー好きの我もビックリ」::
19521::$$$message_0153_0002_0012$$$::「どういう意味だそりゃあ！[lr]::
19522::$$$message_0153_0002_0013$$$::　[hfsweat layer=1]……くそ、こうなったらやるしかないのか！？」::
19523::$$$message_0153_0002_0014$$$::「そう死に急ぐな雑種。今、言峰がランサーを拾いに行っている」::
19524::$$$message_0153_0002_0015$$$::「ふうん、英雄王とか呼ばれてる癖に、一人じゃ私たちの相手も出来ないの？」::
19525::$$$message_0153_0002_0016$$$::「何を言っているのだ？　よもや貴様、我に札を持てと言うのではあるまいな」::
19526::$$$message_0153_0002_0017$$$::「……ランサーを待ってるのはその為か？」::
19527::$$$message_0153_0002_0018$$$::「なんだ、他に何かあるのか」::
19528::$$$message_0153_0002_0019$$$::「……ランサーも結構苦労してるのね」::
19529::$$$message_0153_0002_0020$$$::「待たせたなギルガメッシュ」::
19530::$$$message_0153_0002_0021$$$::「くそ、次はこうはいかねえ……」::
19531::$$$message_0153_0002_0022$$$::「ランサー、それって結構負け台詞だぞ」::
19532::$$$message_0153_0002_0023$$$::「ふむ。では格の違いというものを見せ付けてやろう。[hffacechg chara=ギルガメッシュ face=喜 layer=0 time=200][l][say storage=HIRI6_GIL_0100 _name=ギルガメッシュ]この我、自らがな！」::
