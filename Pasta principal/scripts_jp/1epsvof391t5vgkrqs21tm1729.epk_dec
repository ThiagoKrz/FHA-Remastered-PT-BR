DAT
id=qid::label=str::text=lstr::
45105::$$$message_0405_0000_0000$$$::「……ａｒ……ｅｒ……ッ！！！」::
45106::$$$message_0405_0000_0001$$$::「おわー！」::
45107::$$$message_0405_0000_0002$$$::「ぬっ！」::
45108::$$$message_0405_0000_0003$$$::「バーサーカーのサーヴァント！？　出会い頭に斬りかかるとは……花札勝負の縛りも眼中に無しか！？」::
45109::$$$message_0405_0000_0004$$$::「ショックでこれ以上ケイネスが後退したらどうするの？」::
45110::$$$message_0405_0000_0005$$$::「なぜ私の頭髪をかばうんだソラウ！」::
45111::$$$message_0405_0000_0006$$$::「お退りください、マスター！」::
45112::$$$message_0405_0000_0007$$$::「退がってないと云っている！」::
45113::$$$message_0405_0000_0008$$$::「ここは抑えろ、バーサーカー」::
45114::$$$message_0405_0000_0009$$$::「……ｒ…………う……？」::
45116::$$$message_0405_0000_0011$$$::「すまないランサーのマスター。金髪の相手をみると発作的に[line len=3]」::
45117::$$$message_0405_0000_0012$$$::「キャスターよりもさらに人違いの症状が進行しているのでは……」::
45118::$$$message_0405_0000_0013$$$::「ハッ。なるほど、貴様たちだったというわけだな[line len=3]マキリよ」::
45119::$$$message_0405_0000_0014$$$::「ランサーのマスター？　何を言っているんだ」::
45120::$$$message_0405_0000_0015$$$::「とぼけるな。我が工房を灰燼とせしめた、老獪で陰湿な手口。冬木の重鎮であるマキリの仕業に相違ない」::
45121::$$$message_0405_0000_0016$$$::「……対戦相手全員に容疑をかけてまわってるのか？」::
45122::$$$message_0405_0000_0017$$$::「そうなの。ほんと迷惑よねぇ。心当たりないかしら？」::
45123::$$$message_0405_0000_0018$$$::「……心当たりはあるさ。教えてもいい。だが、そのかわり温泉は諦めてくれ」::
45124::$$$message_0405_0000_0019$$$::「妄言を。我が魔術工房の再建は決して譲れない」::
45125::$$$message_0405_0000_0020$$$::「そうよ。工房はともかく、温泉は絶対よ！」::
45126::$$$message_0405_0000_0021$$$::「雁夜おじさん……あのひと、工房つくるの？」::
45127::$$$message_0405_0000_0022$$$::「桜ちゃん……。[wvl canskip=false time=200][hffgchg2 chara=雁夜 face=喜2 pos=right time=300 twno=1][hfsigh layer=1]大丈夫だ。もうきみのような犠牲者は出させはしない」::
45128::$$$message_0405_0000_0023$$$::「お爺さまみたいになるの？　あのひと？」::
45129::$$$message_0405_0000_0024$$$::「だから私の頭髪を指差すな！　やめろむしるなぁっ！」::
45130::$$$message_0405_0000_0025$$$::「……ｈａ……ｉｒ……ッ！！！」::
45131::$$$message_0405_0000_0026$$$::「よ、要は勝てばよいのだ。吐いて貰おうか。我が工房の仇の名を。無論、温泉の権利もこちらに頂く」::
45132::$$$message_0405_0000_0027$$$::「くっ、この外道め」::
45133::$$$message_0405_0000_0028$$$::「仮にも戦場に、きみは子供を連れ歩いてお遊戯かね？　いったいどちらが外道にふさわしいのかね？」::
45134::$$$message_0405_0000_0029$$$::「所詮は魔術師。人間の道理が通じるわけもない」:7m