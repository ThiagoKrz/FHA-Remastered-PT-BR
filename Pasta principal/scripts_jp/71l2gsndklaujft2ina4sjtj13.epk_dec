DAT
id=qid::label=str::text=lstr::
43874::$$$message_0374_0000_0000$$$::「しっかし深い森ねー。こんなところにバーサーカーがいるのかしら」::
43875::$$$message_0374_0000_0001$$$::「……近くにいるのは間違いないわ。あいつの気配を感じるもの」::
43876::$$$message_0374_0000_0002$$$::「そう？　ならこのままどこまでも真っ直ぐ行けばオッケーね」::
43877::$$$message_0374_0000_0003$$$::「今まで黙ってたけど、わたし方向感覚に自信がない人なのであったって、[wvs][hffacechg chara=藤ねえ face=うーん2 layer=1 left=7 top=397 time=200][se storage=se025.wav][hfchance layer=1][hfquake layer=message1 time=800 wait=0 hmax=5 vmax=15][say storage=HSTR6_TIG_0040 _name=藤ねえ]あ痛っ」::
43878::$$$message_0374_0000_0004$$$::「いったあ……[l][hfwww layer=1][say storage=HSTR6_TIG_0070 _name=藤ねえ]なによぅもう、道の真ん中に木なんか植えて、通行の邪魔に[line len=3]」::
43879::$$$message_0374_0000_0005$$$::「[line len=9]」::
43880::$$$message_0374_0000_0006$$$::「ぎゃあーーーーーーー！」[rf]::
43881::$$$message_0374_0001_0000$$$::「マッチョ！　マッスルオーラだけで半エーカーの作物を枯渇させるくらいのマッチョ！」::
43883::$$$message_0374_0001_0002$$$::「こここここれがウワサの、アインツベルンのロリっ娘マスターかぁ！！！！？」::
43884::$$$message_0374_0001_0003$$$::「そんなワケないでしょうバカタイガ！[lr]::
43885::$$$message_0374_0001_0004$$$::　まったく、サーヴァントになってもお脳はツルツルなんだから」::
43886::$$$message_0374_0001_0005$$$::「あれ？　どうしたのイリヤちゃん、いきなり着替えちゃって。[l][hffeelgood layer=1][say storage=HSTR6_TIG_0130 _name=藤ねえ]さっきまでの旧時代的な体操服はどこいったー？」::
43887::$$$message_0374_0001_0006$$$::「ストライク[hfchance layer=0]・バカ！　よく見なさい、わたしはこっち、[hfchance layer=0]偽物はそっちよ」::
43888::$$$message_0374_0001_0007$$$::「ほら、タイガの背中に隠れてないで出てきなさい、居場所をなくした負け犬さん」::
43889::$$$message_0374_0001_0008$$$::「[line len=6]」::
43890::$$$message_0374_0001_0009$$$::「あ、イリヤちゃん。[lr]::
43891::$$$message_0374_0001_0010$$$::　[hffeelgood layer=1]むむむ？　どういうコト、なんでイリヤちゃんが二人もいるの？」::
43892::$$$message_0374_0001_0011$$$::「つーか、さっきからそこで固まってる人間城塞は誰ぞなもし？」::
43893::$$$message_0374_0001_0012$$$::「[line len=6]」::
43894::$$$message_0374_0001_0013$$$::「う。今までの相手とは次元違いのこの迫力」::
43895::$$$message_0374_0002_0000$$$::「もしや……あまりの規格外ゆえ、Fate本編で立ち絵のなかったあのお方……？」::
43896::$$$message_0374_0002_0001$$$::「そうよ。わたしが正真正銘のイリヤスフィール・フォン・アインツベルン」::
43898::$$$message_0374_0003_0000$$$::「そしてこれがわたしのサーヴァント、バーサーカー」::
43899::$$$message_0374_0003_0001$$$::「人気だけで最強を騙っていたどっかのコンビとは違う、[l][hfchance layer=0][say storage=HSTR6_IRI_0110 _name=イリヤ]本当の最強コンビなんだから」::
43900::$$$message_0374_0003_0002$$$::「正真正銘……？　えーと、なんだ。今までの流れを察するとですね[fadebgm time=200 volume=40][seloop storage=se253 nowait=true][line len=3][wvl canskip=0 time=3300][nolr]::
43901::$$$message_0374_0003_0003$$$::イリヤちゃん、いま[ruby text=はやり char=2]流行の双子キャラ？」::
43902::$$$message_0374_0003_0004$$$::「…………タイガにしては弱いボケね」::
43903::$$$message_0374_0003_0005$$$::「ま、それもしょうがないか。そんな偽物がマスターになってるんだもん、サーヴァントとして精度が落ちるのも当然よね」::
43904::$$$message_0374_0003_0006$$$::「むう、私のスキルはボケだったのですか」::
43905::$$$message_0374_0003_0007$$$::「それはまあどうでもいいとして、[l][hfchance layer=1][say storage=HSTR6_TIG_0240 _name=藤ねえ]えっと、そっちのマジメな方のイリヤちゃん！」[hffacechg chara=イリヤ face=楽 layer=0 time=200]::
43906::$$$message_0374_0003_0008$$$::「こっちのイリヤちゃんが偽物ってどういうコト？　もしかして、こっちのイリヤちゃんは誰かが変装しているの？」::
43907::$$$message_0374_0003_0009$$$::「変装なんてしてないわ。わたしは本物のイリヤよ。……けど、こっちのイリヤとは通ってきた環境が違うというか……」::
43908::$$$message_0374_0003_0010$$$::「ようするに他の世界から呼ばれたわたしってコトよ、タイガ。時間軸を超越した英霊とは違う、完全に余所の世界の部外者なの」::
43909::$$$message_0374_0003_0011$$$::「そうよね偽物さん？　わたしが貴方の世界に行けば偽物はこっちだけど、ここはわたしたちの世界よ」::
43910::$$$message_0374_0003_0012$$$::「悪いけど、自分の世界から追い出された貴方に居場所なんてないわ。偽物は偽物らしく、ここで消え去ってしまいなさい」::
43911::$$$message_0374_0003_0013$$$::「むむ！？　ちょっと待った、イリヤちゃんはイリヤちゃんなのにイリヤちゃんを殺すというの？」::
43912::$$$message_0374_0003_0014$$$::「…………そうよ。一つの世界にイリヤが二人もいたら、いずれ世界そのものを二つに分けるコトになる」::
43913::$$$message_0374_0003_0015$$$::「貴方もわかっている筈よね。並行世界の自分が現れたら、その世界の自分は何を尊重すべきかって」::
43914::$$$message_0374_0003_0016$$$::「……自己の優先。[lr]::
43915::$$$message_0374_0003_0017$$$::　わたしはわたしである為に、他のわたしを許してはならない[line len=3]」::
43916::$$$message_0374_0003_0018$$$::「そうよね、この世界のイリヤは、余所のわたしを殺さないといけないよね……」::
43917::$$$message_0374_0003_0019$$$::「……良かった。[l][hffacechg chara=イリヤ face=楽 layer=0 time=200][say storage=HSTR6_IRI_0210 _name=イリヤ]わたしが、ちゃんと道理を重んじられる人間で」::
43918::$$$message_0374_0003_0020$$$::「貴方が自分の世界でどんな経験を積んで、どうやって外に出たかは聞かないわ」::
43919::$$$message_0374_0004_0000$$$::「秩序を維持する為、ここで消えなさいイリヤスフィール」::
43920::$$$message_0374_0004_0001$$$::「……はあ。なんとか誤魔化せると思ったけど、やっぱりこっちのわたしもマスターだったんだ」::
43921::$$$message_0374_0004_0002$$$::「ごめんねタイガ。わたしはここまで。聖杯は諦めて」::
43922::$$$message_0374_0004_0003$$$::「………………いいわ。やって、バーサーカー」::
43923::$$$message_0374_0004_0004$$$::「[line len=6]」::
43924::$$$message_0374_0005_0000$$$::「た、[l][hfchance layer=1][say storage=HSTR6_BIR_0100 _name=ブルマイリヤ]タイガ……！？」[nolr][p]::
43925::$$$message_0374_0005_0001$$$::「んー、なんかおかしくない？[l]　[hffacechg chara=藤ねえ face=うーん2 layer=1 time=200][say storage=HSTR6_TIG_0290 _name=藤ねえ]イリヤちゃんがやられるにしても、それってわたしたちが負けた場合でしょ？」::
43926::$$$message_0374_0005_0002$$$::「まだ勝負もしてないのにヘンよ、貴方たち」[nolr][p]::
43927::$$$message_0374_0005_0003$$$::「だ、[wait canskip=0 time=200][wvs][hfangry layer=0][say storage=HSTR6_IRI_0270 _name=イリヤ]だからそっちのイリヤは偽物だって言ってるじゃない！」::
43928::$$$message_0374_0005_0004$$$::「どのみちそっちのイリヤは長くは残れないし、タイガが知ってるイリヤじゃないのよ！？」::
43929::$$$message_0374_0006_0000$$$::[hfchance layer=0]「それとも、タイガは偽物がマスターでもいいの？」::
43930::$$$message_0374_0006_0001$$$::「……………………」::
43931::$$$message_0374_0006_0002$$$::「よくないっ！　バッタもんに興味なし！」::
43932::$$$message_0374_0006_0003$$$::「……………………」::
43933::$$$message_0374_0006_0004$$$::「でしょう？　なら大人しく[line len=3]」::
43934::$$$message_0374_0006_0005$$$::「でもそれとこれは別問題よ！[l]　[hfchance layer=0][say storage=HSTR6_TIG_0340 _name=藤ねえ]正直、本物とか偽物とかどうでもよろしい！」::
43935::$$$message_0374_0007_0000$$$::[hffacechg chara=藤ねえ face=まったく layer=0 time=200]「つーか、そんな難しいコトわたしに言われても困るのである！」::
43936::$$$message_0374_0007_0001$$$::「イリヤちゃんはイリヤちゃん！」::
43937::$$$message_0374_0007_0002$$$::「たとえ余所のイリヤちゃんでも、わたしを知っててわたしを呼んで、」::
43938::$$$message_0374_0008_0000$$$::「わたしをサーヴァントと言うのならそれでどうでもいいのです！」::
43939::$$$message_0374_0008_0001$$$::「ええ、全人類がイリヤちゃんでもわたしはあまり困りません！」[p][nolr]::
43940::$$$message_0374_0008_0002$$$::「なっ[line len=3][l][hfchance layer=0][say storage=HSTR6_BIR_0150 _name=ブルマイリヤ]タイガ、言ってるコトメチャクチャよ！？　そんなにまでしてわたしを庇うの！？」[hffacechg chara=ブルマイリヤ face=うーん layer=1 time=200]::
43941::$$$message_0374_0008_0003$$$::「だってそうしないとわたし消えちゃうからネ！」::
43942::$$$message_0374_0008_0004$$$::「あと、そっちのイリヤちゃんもイリヤちゃんよ！」::
43943::$$$message_0374_0009_0000$$$::「こっちだと偽物だっていうなら、聖杯の力でもう一人分ぐらい自分の席を作り上げなさい！」::
43944::$$$message_0374_0009_0001$$$::「で、でも……わたしじゃ、どうあっても本物には勝てないし……タイガ、負けちゃうよ……？」::
43945::$$$message_0374_0009_0002$$$::「だいじょうぶ、わたしは誰が相手でも気にしないから！」::
43946::$$$message_0374_0009_0003$$$::「ええ、どうせわたしはフツーには生きられない女！　それでいいなら付いてきなさい！」::
43947::$$$message_0374_0010_0000$$$::[hffacechg chara=藤ねえ face=まったく layer=0 time=200]「誰も真似したがらない生き方をさせてあげるわ！」::
43948::$$$message_0374_0010_0001$$$::「タ、タイガ……！　なんか[ruby text=こぶし]拳マスタードみたいな台詞だけど、ホントにわたしでいいの……？」::
43949::$$$message_0374_0010_0002$$$::「うむ！　むしろそのブルマがいい！」::
43950::$$$message_0374_0010_0003$$$::「露骨すぎる萌えパワーに憎しみを感じるほどに！」::
43951::$$$message_0374_0010_0004$$$::「……はは。[l][hfwww layer=1][say storage=HSTR6_BIR_0200 _name=ブルマイリヤ]バカ、すごいバカ！[lr]::
43952::$$$message_0374_0010_0005$$$::　でも感動したっす師しょー！　わたし弟子入りする！」::
43953::$$$message_0374_0010_0006$$$::「タイガはサーヴァントだけど、ずっと師しょーとして尊敬するっす！」::
43954::$$$message_0374_0010_0007$$$::「え、ほんと？[l]　[hfchance layer=0][say storage=HSTR6_TIG_0500 _name=藤ねえ]やった、ありがとうイリヤちゃーん！　タイガー道場を開いて幾数年、ようやく愛弟子ができたよう！」::
43955::$$$message_0374_0010_0008$$$::「[line len=9]」::
43956::$$$message_0374_0010_0009$$$::「……[hfchance layer=0]ちょっと。なに笑ってるの、バーサーカー」::
43957::$$$message_0374_0010_0010$$$::「[line len=6]」::
43958::$$$message_0374_0010_0011$$$::「……ふん。言ってなさい、そんなの貴方の勘違いなんだから」::
43959::$$$message_0374_0010_0012$$$::「そこの[hfchance layer=0]バカ二人！　茶番はそこまでよ、戦うっていうなら相手をしてあげるわ」::
43960::$$$message_0374_0010_0013$$$::「偽物のわたしとお笑いサーヴァントがどこまで戦えるか、確かめてあげる！」::
43961::$$$message_0374_0010_0014$$$::「く、来るっす師しょー！　準備はオッケーでありますか！？」::
43962::$$$message_0374_0010_0015$$$::「上等っ！　行くわよイリヤちゃん！[lr]::
43963::$$$message_0374_0010_0016$$$::　[hffacechg chara=藤ねえ face=怒 layer=1 time=200]ここでイリヤちゃんを倒して、ヒロインを一人減らしてくれるわ！」::
43964::$$$message_0374_0010_0017$$$::「……いやあ、どっちに転んでもヒロインは減らないような」[nolr][p{�