DAT
id=qid::label=str::text=lstr::
42345::$$$message_0334_0000_0000$$$::「ほい到着～♪[lr]::
42346::$$$message_0334_0000_0001$$$::　いや、途中よく分かんないトラブルがあったけど、大事なくて良かった良かった」::
42347::$$$message_0334_0000_0002$$$::「噂の温泉はこの奥だ。[lr]::
42348::$$$message_0334_0000_0003$$$::　[hfwww layer=1]さ、さくっと入って激戦の疲れをとろうじゃないかマイディアー」::
42349::$$$message_0334_0000_0004$$$::「………………」[lr]::
42350::$$$message_0334_0000_0005$$$::「………………」[lr]::
42351::$$$message_0334_0000_0006$$$::「な、なんだよその目！[lr]::
42352::$$$message_0334_0000_0007$$$::　[hfwww layer=1]い……言いたいコトがあるなら、秘書を通して言ってくれないかねチミィ！」::
42353::$$$message_0334_0000_0008$$$::「じゃあ言うけど……蒔ちゃん、なんで温泉の場所知ってたの？　ここまで一直線だったよね」::
42354::$$$message_0334_0000_0009$$$::「ああ。邪魔が入ったので道行きは長かったが、距離は最短だった」::
42355::$$$message_0334_0000_0010$$$::「蒔の字。おまえ、ここに来たコトがあるな？」::
42356::$$$message_0334_0000_0011$$$::「う、ぐ[line len=3]そ、そりゃああたしだって冬木の住民だし、柳洞寺にお参りに来るぐらいそう珍しいコトじゃあ……」[wvs]::
42357::$$$message_0334_0000_0012$$$::「ふふ、あんまりにも無様ね蒔寺さん。[lr]::
42358::$$$message_0334_0000_0013$$$::　[hfpop layer=0]なんなら、その続きはわたしが言ってあげましょうか？」::
42359::$$$message_0334_0000_0014$$$::「な[line len=3]ゆ、由紀香がもう一人……？」::
42360::$$$message_0334_0000_0015$$$::「ふ。少々違うぞ氷室鐘」::
42361::$$$message_0334_0000_0016$$$::「この私ですら目を覆いたくなるほど性悪な由紀香はそちらの由紀香とは別物であり、私も君とは似て非なるものだ氷室鐘」::
42362::$$$message_0334_0000_0017$$$::「あ、鐘ちゃんもいる。[lr]::
42363::$$$message_0334_0000_0018$$$::　……じゃあ、もしかして」::
42364::$$$message_0334_0000_0019$$$::「……うん。ごめんね、由紀香ちゃん、鐘ちゃん」::
42365::$$$message_0334_0000_0020$$$::「あた、あたしの身勝手で考えなしの思いつきのせいで、こんなコトになっちゃって……」::
42366::$$$message_0334_0000_0021$$$::「由紀香マネージャービンタ！」[wm canskip=0]::
42367::$$$message_0334_0001_0000$$$::「きゃぁあーーー！」[wm canskip=0][se storage=se556.wav]::
42368::$$$message_0334_0002_0000$$$::「まったく、本当に勘に障る子よね蒔は。昨日から口を開けば泣き言ばっかり」::
42369::$$$message_0334_0002_0001$$$::「いいこと？　次に可愛こぶったら、とりあえずにゃかうまで買い出しに行かせるわよ？」::
42370::$$$message_0334_0002_0002$$$::「うむ。蒔にはいい薬だ。[lr]::
42371::$$$message_0334_0002_0003$$$::　私が予測するに、一万円札を渡したのに千円札と誤認され、」::
42372::$$$message_0334_0002_0004$$$::「なんど説明しても聞いてもらえず泣くなく帰ってくるコトになるのだがネ！」::
42373::$$$message_0334_0002_0005$$$::「ふふ、ほーほっほっほ！」::
42374::$$$message_0334_0002_0006$$$::「あーはっは！」::
42375::$$$message_0334_0002_0007$$$::「ああ、どうしてこんなコトに……」::
42376::$$$message_0334_0003_0000$$$::「そ、それはこちらの台詞だー！」::
42377::$$$message_0334_0003_0001$$$::「なんだ、何がどうしてこんな事態になっている！？[lr]::
42378::$$$message_0334_0003_0002$$$::　[hfangry layer=1][se storage=se251.wav]はけ、白状しろこのマバカー！」::
42379::$$$message_0334_0003_0003$$$::「あ、いや、だから、そのですね？」::
42380::$$$message_0334_0003_0004$$$::「ふふ。この期におよんで黙秘とは、本当にどうしようもない女。[lr]::
42381::$$$message_0334_0003_0005$$$::　[hfwww layer=0]いいわ。説明してあげなさい、蒔」::
42382::$$$message_0334_0003_0006$$$::「え、あたしがですか……？[lr]::
42383::$$$message_0334_0003_0007$$$::　は、はい、分かりました、頑張ります。[lr]::
42384::$$$message_0334_0003_0008$$$::　[line len=3]あのですね、実は」::
42385::$$$message_0334_0003_0009$$$::「由紀香マネージャービンタ２！」[wm canskip=0]::
42386::$$$message_0334_0004_0000$$$::「ぐばぁ！？」::
42387::$$$message_0334_0005_0000$$$::「のろいのよのろいのよ、言動とか台詞とか仕草とか、もう全てがのろいのよ！[lr]::
42388::$$$message_0334_0005_0001$$$::　[hfstamp layer=0][se storage=se325.wav][ruby text=やれん o2o=1]可愛い、た[ruby text=みじょか char=3]まんないー！」::
42389::$$$message_0334_0005_0002$$$::「……失礼。蒔に代わって説明するとだな、私たちはそこの蒔の願掛けによって生まれた妄想かね」::
42390::$$$message_0334_0005_0003$$$::「そこの女は昨日ここの温泉につかりながら、生まれ変わるような刺激がほしい、いや、」::
42391::$$$message_0334_0005_0004$$$::「いっそ別人みたいな由紀香とか見てみたい、などと思ったのだよ氷室鐘」::
42392::$$$message_0334_0005_0005$$$::「[line len=6]」::
42393::$$$message_0334_0005_0006$$$::「っ……なるほど」::
42394::$$$message_0334_0005_0007$$$::「それで、おまえたちを目の当たりにした楓は何の責任もとらず、見なかったコトにして逃げ出した、と」::
42395::$$$message_0334_0005_0008$$$::「だ、だってしょうがないじゃん！[lr]::
42396::$$$message_0334_0005_0009$$$::　[hffacechg chara=蒔寺 face=哀 layer=1 time=200]勘違いするのはしょうがないけど、あたしは英雄ではなく一介の黒豹ですよ？」::
42397::$$$message_0334_0005_0010$$$::「そんな愛らしいアニマルにですね、こんなドッペるヤツラを退治できねーっての！」::
42398::$$$message_0334_0005_0011$$$::「……なるほど。みなが血相を変えて勝負をしにきたのは、既におまえたちと出会っていたからか」::
42399::$$$message_0334_0005_0012$$$::「正確には温泉に来て返り討ちにあった、よ。とくにアインツベルンのメイドたちはおかしかったわ」::
42400::$$$message_0334_0005_0013$$$::「同じ端役として平和的にいきましょう、ですって。隙だらけでイタズラし放題だったわ」::
42401::$$$message_0334_0005_0014$$$::「ほんとう、なんてお馬鹿さんだったのかしらね。[lr]::
42402::$$$message_0334_0005_0015$$$::　[hffacechg chara=黒由紀香 face=喜 layer=0 time=200][hfpop layer=0]ほほ。ほほほ。ほーにゃにゃにゃにゃ！」::
42403::$$$message_0334_0005_0016$$$::「ひいい……壊れていく、わたしたちの由紀香が壊れていく……」::
42404::$$$message_0334_0005_0017$$$::「壊れているのはおまえの頭だ！[lr]::
42405::$$$message_0334_0005_0018$$$::　[hfwww layer=1]なんだってあんな由紀香を想像した！」::
42406::$$$message_0334_0005_0019$$$::「いや、なんとなく。楽しいかなって」::
42407::$$$message_0334_0005_0020$$$::「[line len=3]仕方あるまい。[lr]::
42408::$$$message_0334_0005_0021$$$::　ここで待っていた、というコトは目的は同じだな黒由紀香」::
42409::$$$message_0334_0005_0022$$$::「ええ。貴女たちはタイガー道場にいって貰うわ。氷室さん。彼女たちとわたしたちの戦力差は？」::
42410::$$$message_0334_0005_0023$$$::「ふむ。うちの蒔は使い物にならんが、それはあちらも同じだ。となると私と君次第になるが[line len=3]」::
42411::$$$message_0334_0005_0024$$$::「私の計算によれば、十回中十回はこちらの勝利は動かんカネ」::
42412::$$$message_0334_0005_0025$$$::「なにしろこの天才博士、氷室鐘がいるのだからね。[wvl canskip=0 time=600]かね。[hfpop layer=0][wvl canskip=0 time=400]かねかね。かねかねかね……！」::
42413::$$$message_0334_0005_0026$$$::「（へ、ヘンな博士キャラだ……！）」::
42414::$$$message_0334_0005_0027$$$::「なんだ、鐘はまんまじゃん」::
42415::$$$message_0334_0005_0028$$$::[delay speed=60]「[se storage=se605.wav][quake time=500 vmax=20 hmax=10]目だ！[hffacechg chara=氷室 face=楽 layer=1 time=100][se storage=se606.wav][quake time=500 vmax=20 hmax=10]　耳だ！[hffacechg chara=氷室 face=怒 layer=1 time=100][se storage=se115.wav][quake time=500 vmax=20 hmax=10]　鼻だ！」[delay speed=user]::
42416::$$$message_0334_0005_0029$$$::「ぐぎゃああああ！？」::
42417::$$$message_0334_0006_0000$$$::「な、なんだよ、なにが不満だよ！？[lr]::
42418::$$$message_0334_0006_0001$$$::　[hfwww layer=1]すげえキャラ立ってるじゃんかあのメ鐘！」::
42419::$$$message_0334_0006_0002$$$::「やめさせろ！[lr]::
42420::$$$message_0334_0006_0003$$$::　[hfwww layer=1]あの語尾だけはやめさせろ！」::
42421::$$$message_0334_0006_0004$$$::「あ、キャラ的にはあってるんですね」::
42422::$$$message_0334_0006_0005$$$::「……………………。[lr]::
42423::$$$message_0334_0006_0006$$$::　なんか楽しそうね、貴女たち」[lr]::
