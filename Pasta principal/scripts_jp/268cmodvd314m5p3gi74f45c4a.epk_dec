DAT
id=qid::label=str::text=lstr::
45300::$$$message_0415_0000_0000$$$::「はい、一件落着ーっと」::
45301::$$$message_0415_0000_0001$$$::「まさか本当に温泉で治るとは思わなかったよ……」::
45302::$$$message_0415_0000_0002$$$::「願いをかなえる魔法の温泉……こんなものがあったなんて……」::
45303::$$$message_0415_0000_0003$$$::「わたしの直感に狂いは無かったってことね。ワタクシの美肌に見蕩れ、美声に聞き惚れなさい。[wvl][hfwww layer=2]オーッホッホッホ！」::
45304::$$$message_0415_0000_0004$$$::「それルヴィアさんのマネ？」::
45305::$$$message_0415_0000_0005$$$::「聞き苦しい」::
45306::$$$message_0415_0000_0006$$$::「んぐっ、似てないって反応は予想してたけど、まさか罵倒されるとは思わなかったわ」::
45307::$$$message_0415_0000_0007$$$::「でも、魔法がどうこうっての抜きにしても、良い温泉だよねこれ。なんだかお肌がつるつるになってる」::
45308::$$$message_0415_0000_0008$$$::「アルカリ泉……かな。だとしたら、肌がすべるように感じるのはアルカリ性のお湯が体の表面のたんぱく質を溶かしているからで……」::
45309::$$$message_0415_0000_0009$$$::「はいはーい。風情を楽しむ場に、無粋な解説持ち込まなーい」::
45310::$$$message_0415_0000_0010$$$::「ここは願いを叶える温泉。ついでに美肌の湯。それで良いじゃない」::
45311::$$$message_0415_0000_0011$$$::「そうそう、美肌びはだー。[wvl canskip=false time=400][hfsweat layer=2 ox=-130 oy=50]び…………、はだ？」::
45312::$$$message_0415_0000_0012$$$::「ク……クロ？」::
45313::$$$message_0415_0000_0013$$$::「だ、大丈夫クロ！？　のぼせたんじゃないの！？」::
45314::$$$message_0415_0000_0014$$$::「へ？　何言ってるの、全然ヘーキよ」::
45315::$$$message_0415_0000_0015$$$::「だ、だって身体が真っ赤に……！」::
45316::$$$message_0415_0000_0016$$$::「真っ赤？　どれどれ……なによちっとも赤くないじゃない。むしろ緑だわ」::
45317::$$$message_0415_0000_0017$$$::「ってなんで緑かーッ！？」::
45318::$$$message_0415_0000_0018$$$::「うわぁー！　どこかの星の人みたい！」::
45319::$$$message_0415_0000_0019$$$::「ど、どうなってるの……！？」::
45320::$$$message_0415_0000_0020$$$::「あっ、良かった……普通の色に戻っ……、って今度は声がおかしい！？」::
45321::$$$message_0415_0000_0021$$$::「声が何重にも重なってるんだけど……！？」::
45322::$$$message_0415_0000_0022$$$::「願いを叶える温泉のはずじゃなかったのー！？」::
45323::$$$message_0415_0000_0023$$$::「願いを叶える温泉……」::
45324::$$$message_0415_0000_0024$$$::「……クロ、あなたは何を願って温泉に入ったの？」::
45325::$$$message_0415_0000_0025$$$::「は？　決まってるじゃない。色と声が戻りますように、よ」::
45326::$$$message_0415_0000_0026$$$::「イリヤは？」::
45327::$$$message_0415_0000_0027$$$::「わ、わたしも、クロの色と声が元に戻るように……って」::
45328::$$$message_0415_0000_0028$$$::「うん、わたしもそう願いながら入った」::
45329::$$$message_0415_0000_0029$$$::「……ちょっと待ってよ。それじゃこれってまさか」::
45330::$$$message_0415_0000_0030$$$::「３人分の願いが重なって……その、過剰な感じに……？」::
45331::$$$message_0415_0000_0031$$$::「おそらくは」::
45332::$$$message_0415_0000_0032$$$::「そっ……」::
45333::$$$message_0415_0000_0033$$$::「そんなデタラメがあるかーッ！！」::
45334::$$$message_0415_0000_0034$$$::「その色と声で叫ぶとすっごい怖いよクロ！？」::
45335::$$$message_0415_0000_0035$$$::「まさに……オーガ……」::
45336::$$$message_0415_0000_0036$$$::「キャンセルよキャンセル！　願いごと２人分クーリングオフー！」::
45337::$$$message_0415_0000_0037$$$::「そ、そんな都合良く行くのかなぁ」::
45338::$$$message_0415_0000_0038$$$::「…………（なんだかめんどくさくなってきた）」::
45339::$$$message_0415_0000_0039$$$::「うあーん、なんでわたしがこんな目にあわなきゃならないのよー！」::
45340::$$$message_0415_0000_0040$$$::「まぁまぁ、泣かないで最長老さま」::
45341::$$$message_0415_0000_0041$$$::「誰が最長老さまか！」::
45342::$$$message_0415_0000_0042$$$::「…………（早く帰ってゴハンにしたいなぁ、と思ってる）」::
45343::$$$message_0415_0000_0043$$$::「もーやだー！　なんでわたしばっかこんな目にー！」::
45344::$$$message_0415_0000_0044$$$::「願いを叶えるのも一筋縄じゃ行かないんだよーって教訓！　……ってことでいいかな」::
45345::$$$message_0415_0000_0045$$$::「いいわけ……」::
45346::$$$message_0415_0000_0046$$$::「ないでしょーッ！！」::
45347::$$$message_0415_0000_0047$$$::「…………！（流れ星を見つけて、何ごとかを願っている）」::
