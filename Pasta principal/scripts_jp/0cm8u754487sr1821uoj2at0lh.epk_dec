DAT
id=qid::label=str::text=lstr::
45822::$$$message_0442_0000_0000$$$::「我ら群にして個[line len=3]個にして群[line len=3]」::
45823::$$$message_0442_0000_0001$$$::「松梅桜藤菖蒲、桐に鳳凰、坊主に月、みよしのあかよろし猪鹿蝶[line len=3]」::
45824::$$$message_0442_0000_0002$$$::「百の貌のハサンの中でも花札をそらんじれば最速のハサン、アサ子です」::
45825::$$$message_0442_0000_0003$$$::「皆様にはこのチュートリアルにて、花札のなんたるかと、この『とびたて！超時空トラぶる花札大作戦』独自のルールをお教えしたい」::
45826::$$$message_0442_0000_0004$$$::「少しばかり時間を頂くが、よろしくお付き合い願いたく」::
45827::$$$message_0442_0000_0005$$$::「ちなみに私のこれ[hfwww layer=2]は、ブラジル水着でも、大胸筋矯正サポーターでもなく、中東のベリーダンス衣装なのであしからず」::
45828::$$$message_0442_0000_0006$$$::「そしてアシスタントを務めるもう一人のハサンは、ちびアサシン」::
45829::$$$message_0442_0000_0007$$$::「……………………」::
45830::$$$message_0442_0000_0008$$$::「……このちびアサもまた、人が作った花札タワーを見るや、０秒で猫パンチという恐ろしきハサン」::
45831::$$$message_0442_0000_0009$$$::「いたましき過去から心を閉ざした彼女が言葉を発する事はなく……されど進行に支障はない。これまたあしからず」::
45832::$$$message_0442_0000_0010$$$::「……アサ子お姉ちゃん、おしっこ」::
45833::$$$message_0442_0000_0011$$$::「だから本番前に済ませなさい、って……[wvl][hffacechg2 chara=アサ子 face=哀 pos=winner time=400 textclear=0][hfsweat layer=2 ox=-150 oy=30]えー、いきなり喋りますかキャラ崩壊ですか？」::
45834::$$$message_0442_0000_0012$$$::「ま、まあいいでしょう。某はらペコ王のカンブリア大爆発に比べればこの程度の誤差は……」::
45835::$$$message_0442_0000_0013$$$::「お姉ちゃん……」::
45836::$$$message_0442_0000_0014$$$::「サッといってらっしゃい、サッと。お手々洗いなさいね。服で拭いちゃだめよ」::
45837::$$$message_0442_0000_0015$$$::「はぁい（ぽてぽてぽて）」::
45838::$$$message_0442_0000_0016$$$::「では、あらためて[line len=3]」::
45839::$$$message_0442_0000_0017$$$::「『花札』とは１月から12月の草花が描かれた、計48枚の札を使って遊ぶ、かるたの一種」::
45840::$$$message_0442_0000_0018$$$::「平安時代の遊戯『貝覆い』と、江戸時代に流行した天正かるたとが元になって作られたとか……」::
45841::$$$message_0442_0000_0019$$$::「まあこの辺はウィキでも読んで頂くということで」::
45842::$$$message_0442_0000_0020$$$::「うぃき？」::
45843::$$$message_0442_0000_0021$$$::「おかえりー、って早っ。[wvl][hfwww layer=2]じゃじゃじゃじゃあ続けますからね。いいね？」::
45844::$$$message_0442_0000_0022$$$::「うん」::
45845::$$$message_0442_0000_0023$$$::「当チュートリアルでは、まず代表的な遊び方の一つ『こいこい』について説明する。これが『とびたて！超時空トラぶる花札大作戦』の基本となる」::
45846::$$$message_0442_0000_0024$$$::「こいこいは２人で遊ぶゲーム。お互いに札を出し合い、複数の札を組み合わせて『役』を作る」::
45847::$$$message_0442_0000_0025$$$::「『役』にはそれぞれ得点があり、勝負を繰り返しながら、先に相手の持ち点すべてを奪った者が勝利する」::
45848::$$$message_0442_0000_0026$$$::「この程度の常識は昼寝しながらでも憶えていただきたい。よろしいか？」::
45849::$$$message_0442_0000_0027$$$::「（ぷるぷるぷる）」::
45850::$$$message_0442_0000_0028$$$::「うーんそっか。可愛いから許す。だいじょーぶ、やってるうちに解るからねー」::
45851::$$$message_0442_0000_0029$$$::「では、順を追って説明する」::
45852::$$$message_0442_0000_0030$$$::「まず、親を決める[line len=3]最初に札を１枚引き、早い月を引いた人が親。親は先攻になる」::
45853::$$$message_0442_0000_0031$$$::「はい、ちびアサ。５月と11月の札を引いたら、どっちが親かな？」::
45854::$$$message_0442_0000_0032$$$::「……アサ子お姉ちゃん」::
45855::$$$message_0442_0000_0033$$$::「いやいやいや私は親じゃないでしょ違うでしょ。５月と11月、どっちが先かなぁ？」::
45856::$$$message_0442_0000_0034$$$::「……５月ぅ？」::
45857::$$$message_0442_0000_0035$$$::「そーそーそーそ。５月の人が親で先攻になります」::
45858::$$$message_0442_0000_0036$$$::「親が決まれば、次に札を配る。配る枚数のうちわけは[line len=3]」::
45859::$$$message_0442_0000_0037$$$::「各人の手札として、８枚。場に表にして、８枚。残り24枚は裏のまま山札となる」::
45860::$$$message_0442_0000_0038$$$::「配り終えたら準備は完了……。ここまでは簡単」::
45861::$$$message_0442_0000_0039$$$::「たわいない」::
45862::$$$message_0442_0000_0040$$$::「たわいない」::
45863::$$$message_0442_0000_0041$$$::「ではゲーム開始。[br]　まずは先攻の親の番[line len=3]」::
45864::$$$message_0442_0000_0042$$$::「手札から１枚を選んで場に出す」::
45865::$$$message_0442_0000_0043$$$::「このとき同じ月の札があれば自分のものに。取った札は手札には戻らず、自分の脇におく」::
45866::$$$message_0442_0000_0044$$$::「続けて、さらに山札から１枚を引いて場に出す。[wvl canskip=false time=600][fg left=160 index=8000 top=5 time=500 storage=hf_tutorial_プレイヤーターン5 laye=4]やはり同じ月の札があれば、自分のものになる」::
45867::$$$message_0442_0000_0045$$$::「つまり運がよければ、１回の手番で合計４枚の札が自分のものになる。……が、運が悪ければ１枚も得られない」::
45868::$$$message_0442_0000_0046$$$::「出した手札、山札から引いた札、どちらも同じ月の札がなければ、場札となってそのまま残る」::
45869::$$$message_0442_0000_0047$$$::「……おしまい？」::
45870::$$$message_0442_0000_0048$$$::「いや。まだまだ」::
45871::$$$message_0442_0000_0049$$$::「じゃあ、こわす？」::
45872::$$$message_0442_0000_0050$$$::「相手を壊しても殺しても、得点にはなりませんよー」::
45873::$$$message_0442_0000_0051$$$::「札を自分のものにしても、それだけで得点にはならない。必ず『役』を作る必要がある」::
45874::$$$message_0442_0000_0052$$$::「役にはこれだけの種類が存在する」::
45875::$$$message_0442_0000_0053$$$::「いちらんひょう、です」::
45876::$$$message_0442_0000_0054$$$::「『役が揃ったもの』、および『あと１枚で揃うもの』については、下に役名が表示される」::
45877::$$$message_0442_0000_0055$$$::「取った札の中で、役が完成していれば『勝負』ができる」::
45878::$$$message_0442_0000_0056$$$::「……しょうぶしなくても、いいの？」::
45879::$$$message_0442_0000_0057$$$::「そう。しなくとも構わない。実は弱い役で勝負をかけると、かえって不利なことがある」::
45880::$$$message_0442_0000_0058$$$::「そんな時は、勝負をせず『こいこい』をする」::
45881::$$$message_0442_0000_0059$$$::「ちっちっちっち、こーいこいこいこいこい」::
45882::$$$message_0442_0000_0060$$$::「ぐるぐるにゃあーん（どたんばたんふーっ）」::
45883::$$$message_0442_0000_0061$$$::「で、ではなく[line len=3]」::
45884::$$$message_0442_0000_0062$$$::「より点数の高い役を狙い、相手に深手を負わせたい時には『こいこい』が有効だ」::
45885::$$$message_0442_0000_0063$$$::「役がそろわず勝負出来ない、あるいは『こいこい』をした場合は、子と順番を交代する。子の番でも、することは親と同じだ」::
45886::$$$message_0442_0000_0064$$$::「こうして、どちらかが勝負をかけるか、手札がすべて失くなるまで、交互に手番を繰り返す」::
45887::$$$message_0442_0000_0065$$$::「役が完成しないまま手札が失くなったら、札をくばりなおして再開する。両方にまだ得点が残っている時も同様にして再開する」::
45888::$$$message_0442_0000_0066$$$::「さて、このこいこいでは、持ち点を１文、２文……と数えるのが掟だ」::
45889::$$$message_0442_0000_0067$$$::「お互いに12文を持ってゲームを開始し、勝負を挑まれた側は、その役に応じた文数を失う」::
45890::$$$message_0442_0000_0068$$$::「どちらかの持ち点がゼロになるとゲームは終了。１文以上の得点を残したほうが勝者だ」::
45891::$$$message_0442_0000_0069$$$::「……仮に、子の立場で最後の１枚を取った時にちょうど役が完成したのなら、自動的に勝負となるので、そこは驚かれぬよう」::
45892::$$$message_0442_0000_0070$$$::「ご理解されたか？」::
45893::$$$message_0442_0000_0071$$$::「たわいない」::
45894::$$$message_0442_0000_0072$$$::「たわいない」::
45895::$$$message_0442_0000_0073$$$::「では札についてだ。札には『月』のほかに、４種類の札の区別がある」::
45896::$$$message_0442_0000_0074$$$::「コウ札、タネ札、タン札、カス札の４種類」::
45897::$$$message_0442_0000_0075$$$::「コウ札は５枚。１月、３月、８月、11月、12月に含まれる華やかな絵柄の札がそうだ」::
45898::$$$message_0442_0000_0076$$$::「このコウ札では、三光から五光までの、特に高得点の役が望める」::
45899::$$$message_0442_0000_0077$$$::「タネ札は、おもに動物などが描かれた札だ」::
45900::$$$message_0442_0000_0078$$$::「このタネ札では、タネや猪鹿蝶などの役が作れる」::
45901::$$$message_0442_0000_0079$$$::「ねこしかちょう？」::
45902::$$$message_0442_0000_0080$$$::「猫さんはありません。ごめんねー」::
45903::$$$message_0442_0000_0081$$$::「続いて[line len=3]タン札はその名の通り、赤青の短冊が描かれた札。たんや赤短、青短などの役が作れる」::
45904::$$$message_0442_0000_0082$$$::「青いタン札は３枚。だが、赤いタン札は文字の書かれた３枚と、書かれていない４枚の、計７枚あることに注意されたい」::
45905::$$$message_0442_0000_0083$$$::「以上のコウ札、タネ札、タン札のどれにもあてはまらない札が、すなわち、カス札」::
45906::$$$message_0442_0000_0084$$$::「あのふだは　われらのなかでも　とりたててとりえのないふだ……」::
45907::$$$message_0442_0000_0085$$$::「カス札でも『かす』という役がある」::
45908::$$$message_0442_0000_0086$$$::「１点を競う勝負では、なかなか馬鹿には……馬鹿に……[wvl canskip=false time=400][hffacechg2 chara=アサ子 face=哀 pos=winner time=400 textclear=0][hfsweat layer=2 ox=-150 oy=30][hfangry layer=2]ザイードさん……スンマセンホントスンマセン……」::
45909::$$$message_0442_0000_0087$$$::「以上で札の説明を終わる。気を取り直して、次は役について」::
45910::$$$message_0442_0000_0088$$$::「『こいこい』には12の役がある。基本的には同じ種類の札を集めれば役になる」::
45911::$$$message_0442_0000_0089$$$::「コウ札を集めれば、その枚数に応じて三光、四光、五光という役になる」::
45912::$$$message_0442_0000_0090$$$::「例外として雨は三光に入れることはできず、雨四光の場合は得点が８文から１文下がって７文となる」::
45913::$$$message_0442_0000_0091$$$::「また、このコウ札とタネ札を組み合わせて出来る役が、花見酒と月見酒。……見たままだな」::
45914::$$$message_0442_0000_0092$$$::「次に猪鹿蝶。これは他のタネ札が加わることで、さらに高得点の狙える役だ。狙っていくのはなかなか難しいが」::
45915::$$$message_0442_0000_0093$$$::「次に赤短、青短もやはり他のタン札が加わることで高得点になる」::
45916::$$$message_0442_0000_0094$$$::「赤短は字の書かれた札を集める必要があるので注意されたし。青短と赤短の両方を集めた時は、合計で10文になる」::
45917::$$$message_0442_0000_0095$$$::「タネ札を５枚集めるとたねという役になる」::
45918::$$$message_0442_0000_0096$$$::「また、赤短や青短の役にならずとも、とにかく５枚のタン札を集めればたんという役になる」::
45919::$$$message_0442_0000_0097$$$::「この役は、１枚ふえるごとに、１文プラス。６枚なら２文、７枚なら３文だね」::
45920::$$$message_0442_0000_0098$$$::「最後に、カス札を10枚あつめると『かす』という役になる。得点は１文……」::
45921::$$$message_0442_0000_0099$$$::「『こいこい』のルールは以上。ここからようやく本ゲーム『とびたて！超時空トラぶる花札大作戦』についての説明となる」::
45922::$$$message_0442_0000_0100$$$::「役の細かな成立条件は、タイトル画面の『ルール』から選択できる」::
45923::$$$message_0442_0000_0101$$$::「タイトル画面の『おぷしょん』を選ぶと、ゲームのプレイ環境を調整できる」::
45924::$$$message_0442_0000_0102$$$::「『役一覧』や『札一覧』もプレイの助けになることだろう」::
45925::$$$message_0442_0000_0103$$$::「さて、お待たせした。『とびたて！超時空トラぶる花札大作戦』最大の特徴が『宝具』の存在」::
45926::$$$message_0442_0000_0104$$$::「『宝具』とはすなわち、このゲームにおける、キャラクター固有の必殺技」::
45927::$$$message_0442_0000_0105$$$::「各チームはＭＰを保有している。このＭＰを消費することで、宝具を発動させ、戦況を大きく一変させることが可能となる」::
45928::$$$message_0442_0000_0106$$$::「ＭＰをふやすには、まずコウ札の獲得だ。手札に持っているだけではダメだ。一度場に出して取ること」::
45929::$$$message_0442_0000_0107$$$::「さらに加えて、チームごとにＭＰの増加する札というものがある。が、これは内密ということにしておこう」::
45930::$$$message_0442_0000_0108$$$::「『宝具』の効果範囲は広い。詳しくは『おぷしょん』内の『宝具詳細』を読まれたし」::
45932::$$$message_0442_0000_0110$$$::「ちびアサのはぁ？」::
45933::$$$message_0442_0000_0111$$$::「んー、我らの宝具はありません。ていうか今回の出番はこのチュートリアルだけかもです」::
45934::$$$message_0442_0000_0112$$$::「ふぇ……（じわぁ）なんでザイードさんすぐしんでしまうん……」::
45935::$$$message_0442_0000_0113$$$::「だ、第五次では！　第五次ではそれなりに大活躍しますんで！　Fate/stay night本編をどうかお楽しみください！」::
45936::$$$message_0442_0000_0114$$$::「では気を取り直して、仕上げの実践練習といこうか」::
45937::$$$message_0442_0000_0115$$$::「はぁい」::
