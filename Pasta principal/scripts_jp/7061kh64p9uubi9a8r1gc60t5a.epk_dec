DAT
id=qid::label=str::text=lstr::
45239::$$$message_0411_0000_0000$$$::「本当にこの先に温泉なんてあるの？」::
45240::$$$message_0411_0000_0001$$$::「あるわ。わたしの直感があるっぽい的なことを言ってる気がする」::
45241::$$$message_0411_0000_0002$$$::「直感ってそんな曖昧なものだっけ？」::
45242::$$$message_0411_0000_0003$$$::「待って、前に誰かいる」::
45243::$$$message_0411_0000_0004$$$::「ん？」::
45244::$$$message_0411_0000_0005$$$::「おや」::
45245::$$$message_0411_0000_0006$$$::「あ、材料だ」::
45246::$$$message_0411_0000_0007$$$::「きゃーーーッ！？」::
45247::$$$message_0411_0000_0008$$$::「イ、イリヤ！？」::
45248::$$$message_0411_0000_0009$$$::「ひどいなぁ、お嬢ちゃん。人の顔見て叫ぶなんて失礼だぜ？」::
45249::$$$message_0411_0000_0010$$$::「親の顔が見たい、とはこういう時に使う慣用句でしたかな」::
45250::$$$message_0411_0000_0011$$$::「ごご、ごめんなさい！　そのっ……ちょっと、お顔が怖かったもので……」::
45251::$$$message_0411_0000_0012$$$::「気に病むことはありませんリュウノスケ」::
45252::$$$message_0411_0000_0013$$$::「たとえ貴方の顔が少女に金切り声を上げられるような造作だったとしても、私は好ましく思っています」::
45253::$$$message_0411_0000_0014$$$::「サンキュー旦那。……へへ、なんか照れるな」::
45254::$$$message_0411_0000_0015$$$::（わたしがびっくりしたのはそっちの人じゃないんだけど！？）::
45255::$$$message_0411_0000_0016$$$::「わ……わたしの直感が全力で『こいつらぜったいおかしいよ』的なことを言ってる気がする！」::
45256::$$$message_0411_0000_0017$$$::「なんだか、一番出会ってはいけない人たちに出会ってしまったような……！」::
45257::$$$message_0411_0000_0018$$$::「ってかさぁ旦那。俺さっきから気になってんだけど、あの子なんなの？」::
45258::$$$message_0411_0000_0019$$$::「え。わ、わたし？」::
45259::$$$message_0411_0000_0020$$$::「色も声もなくてさぁ。なにあれ、生きてんの？」::
45260::$$$message_0411_0000_0021$$$::「おお、白黒の少女とは……[wvl canskip=false time=200][hffgchg2 chara=キャスター4th face=喜 pos=center time=300][hfsigh layer=2]私も初めて目にします。ふふ、我々は幸運ですよリュウノスケ」::
45261::$$$message_0411_0000_0022$$$::「え？　え？」::
45262::$$$message_0411_0000_0023$$$::「とびきりのレアモン、中まで白黒なのか楽しみっスねぇー……！」::
45263::$$$message_0411_0000_0024$$$::「な、なんなのよこいつらー！」::�