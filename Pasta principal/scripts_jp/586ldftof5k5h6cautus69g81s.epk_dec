DAT
id=qid::label=str::text=lstr::
43743::$$$message_0372_0000_0000$$$::「[line len=3]さてさて。[lr]::
43744::$$$message_0372_0000_0001$$$::　衛宮邸に潜む三人の鬼を打ちのめした我らがヒロイン、ブルマとタイガ」::
43745::$$$message_0372_0001_0000$$$::「サーヴァントは残り三人」::
43746::$$$message_0372_0002_0000$$$::「アサシン、ランサー、バーサーカーを倒す為、ブルマは柳洞宮最上階・若奥様の間を目指すのであった」::
43747::$$$message_0372_0003_0000$$$::「急げブルマ。凶弾に倒れた仲間を救う為！[lr]::
43748::$$$message_0372_0003_0001$$$::　日が沈むまであと三時間！[lr]::
43749::$$$message_0372_0003_0002$$$::　[hffacechg chara=ぞうけん face=哀 layer=1 time=200]ワシの命はあと三時間……！」::
43750::$$$message_0372_0004_0000$$$::「……ねえイリヤちゃん。なんか、横の林でブツブツ前回までのおさらいを解説しているお爺ちゃんがいるんだけど、知り合い？」[nolr][p]::
43751::$$$message_0372_0004_0001$$$::「いや、一ミクロンも存在知らないッス」::
43752::$$$message_0372_0004_0002$$$::「それより次のキリング・フィールドが見えてきたぞ！　油断するなよタイガ！」::
43753::$$$message_0372_0004_0003$$$::「任せておけブルマ。どんな相手だろうとこの虎竹刀で蹴散らすまでよ」::
43754::$$$message_0372_0004_0004$$$::「フーシュシュシュ（注・笑い）。[lr]::
43755::$$$message_0372_0004_0005$$$::　いざとなればパキーンと弾けてパワーアップだぜっ！」::
43756::$$$message_0372_0004_0006$$$::「フ、敵ながら頼もしいヤツ……！[l][br]　[hffacechg chara=ブルマイリヤ face=喜2 layer=1 time=200][hfwww layer=1][say storage=HSTR5_BIR_0040 _name=ブルマイリヤ]よぅし、この勢いでバカップルに殴り込みだぁー！」::
43757::$$$message_0372_0005_0000$$$::「待たれよ娘。そして野獣」::
43758::$$$message_0372_0005_0001$$$::「な、[wait canskip=0 time=300][l][hffacechg chara=藤ねえ face=真剣 layer=1 time=200][hfchance layer=1][say storage=HSTR5_TIG_0060 _name=藤ねえ]何ィお前は……！」::
43759::$$$message_0372_0005_0002$$$::「まさか……！」[nolr][p]::
43760::$$$message_0372_0005_0003$$$::「佐々木五四六ーッ！！」::
43761::$$$message_0372_0005_0004$$$::「それ佐々木誤字よーッ！！」[nolr][p]::
43762::$$$message_0372_0005_0005$$$::「………………全開だな。[lr]::
43763::$$$message_0372_0005_0006$$$::　まあよい。傾きモノよ、この門はおぬしらのような独り者が通るものではない」::
43764::$$$message_0372_0006_0000$$$::「遊んでいる閑があるなら、お見合いの一つでもするのだな」::
43765::$$$message_0372_0006_0001$$$::「うぎゃ、胸に痛いその言葉……！」::
43766::$$$message_0372_0006_0002$$$::「アンタいま口にしちゃあいけねぇコトを言ったよ！　もうどちらかが死ぬしかありえねー！」[nolr]::
43767::$$$message_0372_0007_0000$$$::「ま、待てタイガ、早まるなーー！[lr]::
43768::$$$message_0372_0007_0001$$$::　[nolr]少年漫画の法則その一、先に手を出した方が負けちゃう不思議ーーーーー！！！」::
43769::$$$message_0372_0007_0002$$$::「宗一郎様……お茶が入りました」[nolr]::
43770::$$$message_0372_0008_0000$$$::「[line len=6]（かすかに頷く）」::
43771::$$$message_0372_0008_0001$$$::「…………やはり、まだお口に合わないでしょうか？　一成くんに教わって煎れてみたのですけど……」::
43772::$$$message_0372_0008_0002$$$::「……。おまえの茶はおまえだけの味がある。他のものと比べる事はできない」::
43773::$$$message_0372_0008_0003$$$::「しかし……個人的な嗜好で言うのなら、この熱さは私好みだ」::
43774::$$$message_0372_0008_0004$$$::「……！」::
43775::$$$message_0372_0008_0005$$$::「（これよ！　求めていたのはこれなのよ！　ありがとうホトケさま、神々なんて嫌いだけど貴方たちは大好きよー！）」::
43776::$$$message_0372_0008_0006$$$::「ウケケケ、ならばお布施を払えぃ！[lr]::
43777::$$$message_0372_0008_0007$$$::　とりあえずその幸福、日本円に換算して豚丼並たまご付きーーー！」::
43778::$$$message_0372_0008_0008$$$::「安っ！」[nolr][p]::
43779::$$$message_0372_0008_0009$$$::「じゃなくて、いったい何事です……！」[nolr]::
43780::$$$message_0372_0009_0000$$$::「あっはっは。すまんキャスター、しくじったー」[nolr]::
43781::$$$message_0372_0010_0000$$$::「お前か佐々木ィィィ！！」[nolr]::
43782::$$$message_0372_0011_0000$$$::「ああ、せっかく煎れたお茶とお手製（失敗作）のマロンケーキが私の弟のように……！」::
43783::$$$message_0372_0011_0001$$$::「[line len=6]」::
43784::$$$message_0372_0011_0002$$$::「あぁ、お茶とケーキは宗一郎様に、いえ、宗一郎様がお茶とケーキにまみれ、て[line len=3][wait time=600][wvs][br]::
43785::$$$message_0372_0011_0003$$$::[line len=3][hfsigh layer=1]ぽ」::
43786::$$$message_0372_0011_0004$$$::「[line len=4]なぜ照れる？」::
43787::$$$message_0372_0011_0005$$$::「ぬぬ、日本円換算率さらにアップ……！[lr]::
43788::$$$message_0372_0011_0006$$$::　[se storage=se197.wav]待ちなそこのトンガリ耳、五百円以上の昼飯なんてこのあたいが許さねえぜ！」::
43789::$$$message_0372_0012_0000$$$::「なによ、さっきからうるさいわね。誰かと思えば聖杯もどきとダメ教師じゃない」::
43790::$$$message_0372_0013_0000$$$::「私、貴方たちを呼んだ覚えはありませんけど」::
43791::$$$message_0372_0013_0001$$$::「そっちになくてもこっちにはあるのよこれが」::
43792::$$$message_0372_0013_0002$$$::「……というより、[l][hfwww layer=1][say storage=HSTR5_TIG_0180 _name=藤ねえ]どうしちゃったのキャスターさん」::
43793::$$$message_0372_0014_0000$$$::「聖杯戦争が始まったのよ？[lr]::
43794::$$$message_0372_0014_0001$$$::　いつもみたいに裏から手を回して好き勝手やらないの？」::
43795::$$$message_0372_0014_0002$$$::「別に、そんなの興味ないわ」::
43796::$$$message_0372_0014_0003$$$::「奪ったり騙したり、そういうのはもう卒業したんですの」::
43797::$$$message_0372_0015_0000$$$::「幸福はここにあるんですから、もう無理をする必要はないでしょう？」::
43798::$$$message_0372_0015_0001$$$::「そもそも、聖杯戦争なんて私には合わないものだったし。星が欲しいのなら喜んで差し上げるわ」::
43799::$$$message_0372_0015_0002$$$::「は」::
43800::$$$message_0372_0015_0003$$$::「……なにかしらねアサシン。その、人の神経を逆なでしまくるイヤな笑いは」::
43801::$$$message_0372_0015_0004$$$::「いや、おぬしの苦労がいじらしくてな、つい微笑んでしまったのだ」::
43802::$$$message_0372_0015_0005$$$::「長年培った性格は頑丈だ。とかく、自我というものは永遠の仇敵である」::
43803::$$$message_0372_0016_0000$$$::「[line len=3]はは、齢二十ウン歳を越えての性根変えは辛かろう」::
43804::$$$message_0372_0017_0000$$$::「え、[l][hfchance layer=1][say storage=HSTR5_TIG_0230 _name=藤ねえ]うそ！？　キャスターさん二十ウン歳だったの！？　葛木先生より年上！？」[nolr]::
43805::$$$message_0372_0018_0000$$$::「きゃーーーーー！」[rf]::
43806::$$$message_0372_0019_0000$$$::「[large]佐々木[rf]ぃ、[large]歳[rf]の[large]コト[rf]は言うなーーーー！」::
43807::$$$message_0372_0019_0001$$$::「はっはっは。これはすまぬ、うっかり口を滑らせてしまった」[nolr]::
43808::$$$message_0372_0020_0000$$$::「だがそう気に病むなキャスター。[nolr]宗一郎はおぬしの歳など気にはすまい。姉さん女房というのも中々にいいものだぞ？」[p]::
43809::$$$message_0372_0020_0001$$$::「お、いま佐々木がいいコト言った！[lr]::
43810::$$$message_0372_0020_0002$$$::　[hfwww layer=1]そうそう、年の差なんてあんまし関係ないわよキャスターさん！」::
43811::$$$message_0372_0020_0003$$$::「葛木先生は毎日若い女の子たちに囲まれてるけど大丈夫！　年上は年上なりの戦い方を見せてちょうだい！」::
43812::$$$message_0372_0020_0004$$$::「まあ、二十ウン歳にもなっちゃ間違ってもヒロインにはなれないけどね！」::
43813::$$$message_0372_0020_0005$$$::「うむ。自慢の魔術で若作りに励むがよい。魔女としての面目躍如というところであろう」::
43814::$$$message_0372_0020_0006$$$::「ふ。[hfquake layer=message0 wait=0 hmax=0 vmax=3]ふふふふふ」::
43815::$$$message_0372_0021_0000$$$::「[line len=3]決めました。私、聖杯戦争に参加します」::
43816::$$$message_0372_0021_0001$$$::「へ？[l]　[hfwww layer=1][say storage=HSTR5_TIG_0310 _name=藤ねえ]なに、この異様な空気。暖かいのにピリピリするよ？」::
43817::$$$message_0372_0021_0002$$$::「別に願い事なんてありませんが、唐突に聖杯が欲しくなりました」::
43818::$$$message_0372_0022_0000$$$::「あと貴方たちをアインツベルンの森までふっ飛ばしてあげたくなりました」::
43819::$$$message_0372_0022_0001$$$::「さ、宗一郎様はお堂の方でお休みください。貴方に迷惑はかけません」::
43820::$$$message_0372_0022_0002$$$::「[line len=3]いや、休むのならおまえも一緒だ。事が聖杯戦争というのなら、私の役割は決まっている」::
43821::$$$message_0372_0022_0003$$$::「行くぞキャスター。少なくとも、茶と洋菓子の借りは返さねばなるまい」::
43822::$$$message_0372_0022_0004$$$::「宗一郎様……」::
43823::$$$message_0372_0022_0005$$$::「ふ、ふふ、[wm][l][hfwww layer=0][say storage=HSTR5_CAS_0280 _name=キャスター]ふふふふふふふふ！[lr]::
43824::$$$message_0372_0022_0006$$$::　さあ、覚悟はいいかしらおバカコンビ！　アサシン、とりあえずやっておしまい！」::
43825::$$$message_0372_0022_0007$$$::「そうこなくては。すまんな虎娘。先ほどは加減したが、今度は本気でやらせてもらうぞ」::
43826::$$$message_0372_0022_0008$$$::「キャスターが復活した以上、この後も戦いが控えているのでな」::
43827::$$$message_0372_0022_0009$$$::「……そう、利用されたってワケね。[lr]::
43828::$$$message_0372_0022_0010$$$::　三対二……どうしようタイガ、さすがに不利よ。ここは態勢を立て直して[line len=3]」::
43829::$$$message_0372_0022_0011$$$::「その必要はないわイリヤちゃん。相手が何人だろうとわたしは負けないし、イリヤちゃんを傷つけさせないから」::
43830::$$$message_0372_0022_0012$$$::「どどーんと、自分が選んだサーヴァントを信じなさいマスター」::
43831::$$$message_0372_0022_0013$$$::「タイガ[line len=3][l][hfchance layer=1][say storage=HSTR5_BIR_0130 _name=ブルマイリヤ]やば、ちょっと感動しちゃった」::
43833::$$$message_0372_0022_0015$$$::「ええ、これくらいのハンデ、わたしにはちょうどいいわ！　行くわよキャスター、歳の差ってヤツを思い知らせてあげる……！」::
43834::$$$message_0372_0022_0016$$$::「きぃぃぃいいーーーー！[lr]::
43835::$$$message_0372_0022_0017$$$::　歳は関係ないでしょ歳はーーー！」[nolr][p]::
