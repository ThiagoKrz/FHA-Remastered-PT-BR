DAT
id=qid::label=str::text=lstr::
42630::$$$message_0344_0000_0000$$$::「…………………………（フフッ）」::
42631::$$$message_0344_0000_0001$$$::「……………[wait canskip=0 time=300][se storage=se101.wav]……………（ニヤリ）」::
42632::$$$message_0344_0000_0002$$$::「………………[se storage=se044.wav]…………（ニカッ）」[se storage=se038.wav]::
42633::$$$message_0344_0000_0003$$$::「[line len=3]ふう、こんなところか」::
42634::$$$message_0344_0001_0000$$$::「いや、美男子はつらいね。[lr]::
42635::$$$message_0344_0001_0001$$$::　人目がない時もトレーニングをしなくちゃいけないんだから」::
42636::$$$message_0344_0001_0002$$$::「うむ、さすがじゃ慎二。[lr]::
42637::$$$message_0344_0001_0003$$$::　ワシの若い頃にそっくりじゃのう」::
42638::$$$message_0344_0001_0004$$$::「お、[hfchance layer=1]お爺さま……！？[lr]::
42639::$$$message_0344_0001_0005$$$::　い、いやだな、一体いつから見ていたのですかっ」::
42640::$$$message_0344_0001_0006$$$::「ずっとじゃ。おぬしのイメージトレーニングが始まってからずっとじゃ。[lr]::
42641::$$$message_0344_0001_0007$$$::　[ruby text=カカ o2o=1]呵々、どうにかなるかと思ったぞ？」::
42642::$$$message_0344_0001_0008$$$::「はっはっは。イヤだなあ、相変わらず人が悪い！」::
42643::$$$message_0344_0002_0000$$$::「それに、こんなのはまだ序の口ですよ。なんだったらフルセットをお見せするのも致し方なしですよ！」::
42644::$$$message_0344_0002_0001$$$::「…………姉の方がいいのぅ…………」::
42645::$$$message_0344_0002_0002$$$::「？　それでお爺さま」::
42646::$$$message_0344_0003_0000$$$::「貴方の事です、目的があって現れたのでしょう？　今日はいったい、僕にどんな頼み事を？」::
42647::$$$message_0344_0003_0001$$$::「うむ。[lr]::
42648::$$$message_0344_0003_0002$$$::　慎二よ、柳洞寺に眠る妄想温泉を知っておるか」::
42649::$$$message_0344_0004_0000$$$::「一年に一人しか入る事を許さず、入ったものの願望を叶えるというものでな。[ruby text=だい]原[ruby text=せい]子[ruby text=はい]炉から漏れた放射能のような物じゃ」::
42650::$$$message_0344_0004_0001$$$::「初耳です。ですが[line len=3][hfsigh layer=1]なるほど。お爺さまはこうおっしゃるのですね。[lr]::
42651::$$$message_0344_0004_0002$$$::　[line len=3]駅前のメイド喫茶に行け、と」::
42652::$$$message_0344_0004_0003$$$::「呵呵呵……！　おまえの耳はアレじゃな、アヴァロン級じゃな！」::
42653::$$$message_0344_0004_0004$$$::「いやあ、それほどでも。ははは！」::
42654::$$$message_0344_0004_0005$$$::「もっと分かりやすく言うとじゃな、温泉に行けばおぬしの望みは叶う、というコトじゃよ」::
42655::$$$message_0344_0005_0000$$$::「どうじゃ？　メイド喫茶などウタカタの夢。それよりも桃源郷を手に入れたいと思わぬか」::
42656::$$$message_0344_0006_0000$$$::「あれじゃ、成し遂げた暁には道中で倒したおなごは全ておぬしにメロメロぞ？」::
42657::$$$message_0344_0006_0001$$$::「そ、それは本当ですか、お爺さま！？」::
42658::$$$message_0344_0006_0002$$$::「本当じゃ。さっさと出て行ってくれ」::
42659::$$$message_0344_0006_0003$$$::「………………！」::
42660::$$$message_0344_0007_0000$$$::「…………ふぅ。[lr]::
42661::$$$message_0344_0007_0001$$$::　いったいどこで間違えたのかのぅ、儂んところは…………」::
