DAT
id=qid::label=str::text=lstr::
45105::$$$message_0405_0000_0000$$$::"ARR...URRR...!!!"::
45106::$$$message_0405_0000_0001$$$::"Whoa!"::
45107::$$$message_0405_0000_0002$$$::"Ngh!"::
45108::$$$message_0405_0000_0003$$$::"Berserker!? He attacked as soon as he saw us... Is he ignoring the rule about hanafuda matches only!?"::
45109::$$$message_0405_0000_0004$$$::"What if the shock makes you [font italic=true]recede[font italic=false] even more?"::
45110::$$$message_0405_0000_0005$$$::"W-why are you gesturing at my head, Sola-Ui!?"::
45111::$$$message_0405_0000_0006$$$::"You must retreat, Master!"::
45112::$$$message_0405_0000_0007$$$::"There's nothing [font italic=true]retreating[font italic=false] about me at all!"::
45113::$$$message_0405_0000_0008$$$::"Take them down, Berserker."::
45114::$$$message_0405_0000_0009$$$::"...rr.......ur?"::
45116::$$$message_0405_0000_0011$$$::"Sorry, Master of Lancer. He just gets like this whenever he sees a blond person..."::
45117::$$$message_0405_0000_0012$$$::"Does he have an even worse case of mistaken identity than Caster?"::
45118::$$$message_0405_0000_0013$$$::"Ha. I see. So it was you...Makiri."::
45119::$$$message_0405_0000_0014$$$::"What are you talking about, Master of Lancer?"::
45120::$$$message_0405_0000_0015$$$::"Don't play dumb. Only the Makiri masterminds of Fuyuki would be cunning and vicious enough to burn down my workshop."::
45121::$$$message_0405_0000_0016$$$::"...Are you pointing fingers at everyone you run into?"::
45122::$$$message_0405_0000_0017$$$::"Yeah. He's such a pain. Do you have any clues for us?"::
45123::$$$message_0405_0000_0018$$$::"...I do. I can tell you, too, if you're willing to give up on the onsen."::
45124::$$$message_0405_0000_0019$$$::"Nonsense. I [font italic=true]will[font italic=false] rebuild my workshop."::
45125::$$$message_0405_0000_0020$$$::"That's right. Workshop aside, we're taking that onsen!"::
45126::$$$message_0405_0000_0021$$$::"Uncle Kariya... Is he making a workshop?"::
45127::$$$message_0405_0000_0022$$$::"Sakura...[wvl canskip=false time=200][hffgchg2 chara=雁夜 face=喜2 pos=right time=300 twno=1][hfsigh layer=1] It's all right. I won't let there be any more victims like you!"::
45128::$$$message_0405_0000_0023$$$::"Is he going to be like Grandfather?"::
45129::$$$message_0405_0000_0024$$$::"Don't point at my hairline! Quit plucking at it!"::
45130::$$$message_0405_0000_0025$$$::"HAAAAAIRRRRR!"::
45131::$$$message_0405_0000_0026$$$::"S-so I just need to win. I'll make you spit out the name of my nemesis. And I'll be taking the onsen too, of course."::
45132::$$$message_0405_0000_0027$$$::"You fiend."::
45133::$$$message_0405_0000_0028$$$::"Aren't you the one who brought a child to the battlefield? Who here is the real fiend?"::
45134::$$$message_0405_0000_0029$$$::"You're just a mage. You'd never understand human morals."::
