DAT
id=qid::label=str::text=lstr::
43167::$$$message_0361_0000_0000$$$::"Souichirou..."::
43168::$$$message_0361_0000_0001$$$::"Mrgh."::
43169::$$$message_0361_0000_0002$$$::"Ahh, finally, there's no one to get between us..."::
43170::$$$message_0361_0000_0003$$$::"Hey, Kotomine. Are you sure it's here?"::
43171::$$$message_0361_0000_0004$$$::"Hahahahaha. My mistake.[lr]::
43172::$$$message_0361_0000_0005$$$::I was drawn to the odor of happiness."::
43173::$$$message_0361_0000_0006$$$::"Ah..."::
43174::$$$message_0361_0000_0007$$$::"Hmph. Then let's move on. There's no point staying here."::
43175::$$$message_0361_0000_0008$$$::"Assassin! Get over here! And slay these pests!"::
43176::$$$message_0361_0000_0009$$$::"(yawn) Wait[line len=2][hffacechg chara=ランサー face=驚 time=200][hfangry layer=0]HEY, THAT WAS GODDAMN CLOSE!"::
43177::$$$message_0361_0000_0010$$$::"Oh, that swing failed to dispatch you?"::
43178::$$$message_0361_0000_0011$$$::"What a savage greeting."::
43179::$$$message_0361_0000_0012$$$::"I-[hfchance layer=1]isn't that the normal way to deal with uninvited guests!?"::
43180::$$$message_0361_0000_0013$$$::"My, what a complete and total coincidence."::
43181::$$$message_0361_0000_0014$$$::"Then why do you look so happy?"::
43182::$$$message_0361_0000_0015$$$::"Hahahahaha.[lr]::
43183::$$$message_0361_0000_0016$$$::You misunderstand, Lancer."::
43184::$$$message_0361_0000_0017$$$::"Surely you don't think I'll let you leave this place alive."::
43185::$$$message_0361_0000_0018$$$::"You would defy me, jester?"::
43186::$$$message_0361_0000_0019$$$::"I mean, I think anyone'd be upset."::
43187::$$$message_0361_0000_0020$$$::"Heh. It's your fault for being in my way. Is it not the natural posture of man to prostrate himself and make way for the king?"::
43188::$$$message_0361_0000_0021$$$::"My, that is certainly not something a burglar says."::

