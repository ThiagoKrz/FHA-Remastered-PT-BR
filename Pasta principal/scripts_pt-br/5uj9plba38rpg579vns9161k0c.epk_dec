DAT
id=qid::label=str::text=lstr::
44950::$$$message_0398_0000_0000$$$::"WHAAAT!?"::
44951::$$$message_0398_0000_0001$$$::"Carai! O que está acontecendo!? Estamos sob ataque!?"::
44952::$$$message_0398_0000_0002$$$::"Olhe esse panfleto, garoto!"::
44953::$$$message_0398_0000_0003$$$::"Um, deixe-me ver... Todos os volumes de [font italic=true]Aventura Admirável: História da Tática Side Story - Shine Noir High School White Paper[font italic=false] já estão esgotados nas lojas..."::
44954::$$$message_0398_0000_0004$$$::"...Acho que vou arrepender de perguntar, mas o que é tão grande nisso?"::
44955::$$$message_0398_0000_0005$$$::"É o maior dos acordos! Me diga, garoto[line len=2]por que não fez o pré-pedido antes de me convocar!?"::
44956::$$$message_0398_0000_0006$$$::"Não seja absurdo! Como eu ia saber que um Servo se importaria com jogos de vídeo!?"::
44957::$$$message_0398_0000_0007$$$::"Você é um mágico!"::
44958::$$$message_0398_0000_0008$$$::"Mesmo um Mago não conseguiria saber o que você está pensando!"::
44959::$$$message_0398_0000_0009$$$::"Nnrgh... O que eu devo fazer... Talvez eu vá visitar o desenvolvedor do jogo com a Roda de Gordio..."::
44960::$$$message_0398_0000_0010$$$::(Deus, ele realmente está considerando.)::
44961::$$$message_0398_0000_0011$$$::"Um, hey. Eu vi isso ao lado do panfleto."::
44962::$$$message_0398_0000_0012$$$::"E agora? [wvl canskip=false time=100] Hmm... [wvl canskip=false time=100] "Você já ouviu falar do onsen que concede qualquer desejo? Visite o maior e mais antigo ponto quente de Fuyuki..."::
44963::$$$message_0398_0000_0013$$$::"Espera, o que!?"::
44964::$$$message_0398_0000_0014$$$::"Mas apenas o desejo do primeiro grupo que vier será realizado. Esteja preparado, caso venha nos visitar.[wvl canskip=false time=200] ...Entendi."::
44965::$$$message_0398_0000_0015$$$::(Soa incrivelmente suspeito. O que é isso, algum golpe da Tohsaka?)::
44966::$$$message_0398_0000_0016$$$::(ou talvez sejam os Einzbern...)::
44967::$$$message_0398_0000_0017$$$::Ainda não temos a total compreensão do terreno de Fuyuki. Se estão nos levando para seu território... Não, não, não, espera!::
44968::$$$message_0398_0000_0018$$$::Ninguém seria estúpido ao ponto de cair em um golpe como esse!::
44969::$$$message_0398_0000_0019$$$::"...Ei, o que estamos fazendo fora daí!?"::
44970::$$$message_0398_0000_0020$$$::"Finalmente percebi, viu? Você estava desatento, então joguei você na Roda de Gordius."::
44971::$$$message_0398_0000_0021$$$::"Por que eu estou aqui com você!"::
44972::$$$message_0398_0000_0022$$$::"Não é óbvio? Vamos visitar esse onsen que concede desejos para mudar o passado."::
44973::$$$message_0398_0000_0023$$$::"...Hmm?"::
44974::$$$message_0398_0000_0024$$$::"Nós simplesmente precisamos mudar a história para que você tenha de fato feito o pré-pedido pelo novo jogo Admirável Tática!"::
44975::$$$message_0398_0000_0025$$$::"Eu poderia comprá-lo normalmente, mas mudar o passado é mais meu estilo."::
44976::$$$message_0398_0000_0026$$$::"Isso é a mais idiota das promessas que já ouvi! E você está entrando em uma armadilha óbvia!"::
44977::$$$message_0398_0000_0027$$$::"Mesmo assim, vamos embora, garoto!"::
44978::$$$message_0398_0000_0028$$$::"Ah ha ha! Isso mesmo, [font italic=true]esse[font italic=false] cara seria bobo o suficiente para cair nisso! Quero voltar pra casa!"::

