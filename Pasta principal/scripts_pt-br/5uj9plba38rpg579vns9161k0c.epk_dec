DAT
id=qid::label=str::text=lstr::
44950::$$$message_0398_0000_0000$$$::"O QUÊÊÊ!?"::
44951::$$$message_0398_0000_0001$$$::"Uoou! O-o que está acontecendo!? Estamos sendo atacados!?"::
44952::$$$message_0398_0000_0002$$$::"Olhe este panfleto, rapaz!"::
44953::$$$message_0398_0000_0003$$$::"Hm, deixe-me ver... Todas as unidades de [font italic=true]Admirable Tactics Side Story: Shine Noir High School White Paper[font italic=false] já estão esgotadas nas lojas..."::
44954::$$$message_0398_0000_0004$$$::"...Acho que vou me arrepender de perguntar, mas qual é o drama?"::
44955::$$$message_0398_0000_0005$$$::"É o maior dos dramas! Diga-me, rapaz[line len=2]por que não fez a pré-venda disso antes de me invocar!?"::
44956::$$$message_0398_0000_0006$$$::"Não seja absurdo! Como eu ia imaginar que um Servo se importaria com videogames!?"::
44957::$$$message_0398_0000_0007$$$::"Você é um mago!"::
44958::$$$message_0398_0000_0008$$$::"Nem um Mago conseguiria adivinhar o que passa pela sua cabeça!"::
44959::$$$message_0398_0000_0009$$$::"Nnrgh... O que devo fazer... Talvez eu leve a Gordius Wheel para visitar o desenvolvedor do jogo..."::
44960::$$$message_0398_0000_0010$$$::(Meu Deus, ele está mesmo considerando isso.)::
44961::$$$message_0398_0000_0011$$$::"Hm, ei. Eu vi isto ao lado do panfleto."::
44962::$$$message_0398_0000_0012$$$::"E agora?[wvl canskip=false time=100] Hmm...[wvl canskip=false time=100] 'Já ouviu falar do onsen que realiza qualquer desejo? Visite o maior e mais antigo ponto quente de Fuyuki...'"::
44963::$$$message_0398_0000_0013$$$::"Espera, o quê!?"::
44964::$$$message_0398_0000_0014$$$::"'Mas apenas o desejo do primeiro grupo visitante se realizará. Prepare-se, caso venha nos visitar.'[wvl canskip=false time=200] ...Entendi."::
44965::$$$message_0398_0000_0015$$$::(Isso soa incrivelmente suspeito. O que é isto, algum plano da Tohsaka?)::
44966::$$$message_0398_0000_0016$$$::(Ou talvez dos Einzbern...)::
44967::$$$message_0398_0000_0017$$$::(Ainda não conhecemos todo o terreno de Fuyuki. Se eles estiverem nos atraindo para o território deles... Não, não, não, espera!)::
44968::$$$message_0398_0000_0018$$$::(Ninguém seria idiota o bastante para cair numa armadilha dessas!)::
44969::$$$message_0398_0000_0019$$$::"...Ei, o que estamos fazendo lá fora!?"::
44970::$$$message_0398_0000_0020$$$::"Finalmente percebeu? Você ficou viajando, então eu o joguei na Gordius Wheel."::
44971::$$$message_0398_0000_0021$$$::"Estou perguntando por que estou aqui fora com você!"::
44972::$$$message_0398_0000_0022$$$::"Não é óbvio? Vamos visitar esse onsen realizador de desejos para mudar o passado."::
44973::$$$message_0398_0000_0023$$$::"...Hã?"::
44974::$$$message_0398_0000_0024$$$::"Basta mudarmos a história para que você, de fato, tenha feito a pré-venda do novo Admirable Tactics!"::
44975::$$$message_0398_0000_0025$$$::"Eu poderia simplesmente comprá-lo normalmente, mas mudar o passado combina mais comigo."::
44976::$$$message_0398_0000_0026$$$::"Esse é o desejo mais idiota que eu já ouvi! E você está entrando numa armadilha óbvia!"::
44977::$$$message_0398_0000_0027$$$::"Ainda assim, partamos, rapaz!"::
44978::$$$message_0398_0000_0028$$$::"Ahh ha ha! Isso mesmo, [font italic=true]esse[font italic=false] cara seria idiota o bastante para cair! Quero ir para casa!"::
