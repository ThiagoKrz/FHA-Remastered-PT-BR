DAT
id=qid::label=str::text=lstr::
42579::$$$message_0342_0000_0000$$$::"Espere, Emiya Shirou."::
42580::$$$message_0342_0000_0001$$$::"Kotomine!? O que você está fazendo aqui?"::
42581::$$$message_0342_0000_0002$$$::"Eu também sou filho do homem. O que há de tão estranho em trazer Servos comigo para este onsen?"::
42582::$$$message_0342_0000_0003$$$::"...Hum, tudo."::
42583::$$$message_0342_0000_0004$$$::"Shirou, não temos tempo para lidar com ele. Vamos nos apressar."::
42584::$$$message_0342_0000_0005$$$::"Não me ouviu? Eu disse para esperar. Jamais disse que podia passar."::
42585::$$$message_0342_0000_0006$$$::"Por que todo mundo está tentando nos impedir!? Eu só quero comer ovos de onsen com a Saber!"::
42586::$$$message_0342_0000_0007$$$::"Ha ha ha.[lr]::
42587::$$$message_0342_0000_0008$$$::A razão é extremamente simples. Porque me divirto atrapalhando você."::
42588::$$$message_0342_0000_0009$$$::"Ele é podre até a medula."::
42589::$$$message_0342_0000_0010$$$::"Fico contente que entenda.[lr]::
42590::$$$message_0342_0000_0011$$$::Agora, perca-se nos poços da decepção!"::
42591::$$$message_0342_0000_0012$$$::"Você...[wvs][wait canskip=0 time=200][hfchance layer=1][say storage=HSHI6_SHI_0050 _name=士郎]seu sacerdote podre!"::
42592::$$$message_0342_0000_0013$$$::"Ha ha ha. Obrigado, de verdade."::
42593::$$$message_0342_0001_0000$$$::"É uma oportunidade rara ver o filho de Kiritsugu e o Rei dos Cavaleiros desistirem de seus sonhos e perderem a esperança. Vou saborear isto como o mais fino dos vinhos."::
42594::$$$message_0342_0001_0001$$$::"Não foi isso que combinamos, Kotomine."::
42595::$$$message_0342_0001_0002$$$::"Gilgamesh!"::
42596::$$$message_0342_0001_0003$$$::"Hm. Fique tranquilo, rapaz. Seu desejo não será desperdiçado."::
42597::$$$message_0342_0001_0004$$$::"O que isso quer dizer?"::
42598::$$$message_0342_0001_0005$$$::"Ainda não entendeu, vira-lata? Vou levar Saber comigo, e então servirei a ela os melhores ovos de onsen que este mundo já viu."::
42599::$$$message_0342_0001_0006$$$::"Quê..."::
42600::$$$message_0342_0001_0007$$$::"É assim que isto termina, vira-lata. Vou conduzi-la ao prazer que você não foi capaz de lhe dar. Agora seja um bom cão e suma."::
42601::$$$message_0342_0001_0008$$$::"Grr."::
42602::$$$message_0342_0001_0009$$$::"Você ouviu. Saber terá o que deseja, você ganhe ou perca. Não sei se é isso que [font italic=true]você[font italic=false] queria, porém."::
42603::$$$message_0342_0001_0010$$$::"...Ei. O garoto veio até aqui. Pelo menos deixe ele comer alguns ovos."::
42604::$$$message_0342_0001_0011$$$::"Cale a boca, Lancer, antes que eu lhe dê o mapo tofu de Kotomine de novo."::
42605::$$$message_0342_0001_0012$$$::"...Bem, você ouviu. Nada pessoal."::
42606::$$$message_0342_0001_0013$$$::"...C-certo."::
42607::$$$message_0342_0001_0014$$$::"Shirou, não temos motivo para aceitar este desafio."::
42608::$$$message_0342_0001_0015$$$::"Oh, já admitiu a derrota, Saber?"::
42609::$$$message_0342_0001_0016$$$::"Rrgh."::
42610::$$$message_0342_0001_0017$$$::"Não dá para resolver isso conversando, Saber. Temos que fazer!"::
42611::$$$message_0342_0001_0018$$$::"Parece que tem razão!":�)