DAT
id=qid::label=str::text=lstr::
42579::$$$message_0342_0000_0000$$$::"Espera, Shirou Emiya."::
42580::$$$message_0342_0000_0001$$$::"Kotomine!? O que você está fazendo aqui?"::
42581::$$$message_0342_0000_0002$$$::"Eu também sou filho do homem. O que há de estranho em levar Servants comigo para esse onsen?"::
42582::$$$message_0342_0000_0003$$$::"...Um, tudo."::
42583::$$$message_0342_0000_0004$$$::"Shirou, não temos tempo para lidar com ele. Vamos logo."::
42584::$$$message_0342_0000_0005$$$::"Você não me ouviu? Liguei para você esperar. Nunca disse que você podia passar."::
42585::$$$message_0342_0000_0006$$$::"Por que todo mundo está tentando nos impedir!? Eu só queria ir tomar onsen eggs com a Saber!"::
42586::$$$message_0342_0000_0007$$$::"Ha ha ha.[lr]::
42587::$$$message_0342_0000_0008$$$::O motivo é extremamente simples. Porque gosto de atrapalhar você."::
42588::$$$message_0342_0000_0009$$$::"Ele é podre na raiz."::
42589::$$$message_0342_0000_0010$$$::"Estou feliz que você entenda.[lr]::
42590::$$$message_0342_0000_0011$$$::Perca-se nos abismos da decepção!"::
42591::$$$message_0342_0000_0012$$$::"Você...[wvs][wait canskip=0 time=200][hfchance layer=1][say storage=HSHI6_SHI_0050 _name=士郎][diz storage=HSHI6_SHI_0050 _name=螢ｫ驛讃 você, sacerdote podre!"::
42592::$$$message_0342_0000_0013$$$::"Ha ha ha. Obrigado, de verdade."::
42593::$$$message_0342_0001_0000$$$::"É uma oportunidade rara de ver o filho de Kiritsugu e o Rei dos Cavaleiros abandonarem seus sonhos e perderem a esperança. Aproveitarei isso como se fosse o vinho mais fino."::
42594::$$$message_0342_0001_0001$$$::"Isso não é o que discutimos, Kotomine."::
42595::$$$message_0342_0001_0002$$$::"Gilgamesh!"::
42596::$$$message_0342_0001_0003$$$::"Hmm. Pode ficar tranquilo, jovem. Seu desejo não será em vão."::
42597::$$$message_0342_0001_0004$$$::"O que isso significa?"::
42598::$$$message_0342_0001_0005$$$::"Você ainda não entende, animal? Estou levando a Saber comigo, e depois vou tratá-la dos melhores ovos de onsen que este mundo já viu."::
42599::$$$message_0342_0001_0006$$$::"Que..."::
42600::$$$message_0342_0001_0007$$$::"Assim termina isso, cão imundo. Eu a levo ao prazer que você não conseguiu dar a ela. Agora, seja um bom cão e vá embora."::
42601::$$$message_0342_0001_0008$$$::"Tsc."::
42602::$$$message_0342_0001_0009$$$::"Você ouviu ele. Saber vai obter o que deseja, quer você ganhe ou perca. Não sei se é o que [font italic=true]você[font italic=false] queria, mesmo."::
42603::$$$message_0342_0001_0010$$$::"...Ei. O garoto veio até aqui. Pelo menos deixe que ele coma alguns ovos."::
42604::$$$message_0342_0001_0011$$$::"Calma a boca, Lancer, antes que eu te alimente com o mapo tofu de Kotomine de novo."::
42605::$$$message_0342_0001_0012$$$::"Bem, você ouviu ele. Nada pessoal."::
42606::$$$message_0342_0001_0013$$$::"...R-right."::
42607::$$$message_0342_0001_0014$$$::"Shirou, não temos razão para aceitar esse desafio."::
42608::$$$message_0342_0001_0015$$$::"Oh, já admitiu derrota, Saber?"::
42609::$$$message_0342_0001_0016$$$::"Rrgh."::
42610::$$$message_0342_0001_0017$$$::"Não podemos conversar com eles, Saber. Temos que fazer isso!"::
42611::$$$message_0342_0001_0018$$$::"Parece que você tem razão!":�)