DAT
id=qid::label=str::text=lstr::
45105::$$$message_0405_0000_0000$$$::"ARR...URRR...!!!"::
45106::$$$message_0405_0000_0001$$$::"Uau!"::
45107::$$$message_0405_0000_0002$$$::"Ngh!"::
45108::$$$message_0405_0000_0003$$$::"Berserker!? Ele atacou assim que nos viu... Está ignorando a regra de que só valem partidas de hanafuda!?"::
45109::$$$message_0405_0000_0004$$$::"E se o choque fizer você [font italic=true]recuar[font italic=false] ainda mais?"::
45110::$$$message_0405_0000_0005$$$::"P-por que está gesticulando para a minha cabeça, Sola-Ui!?"::
45111::$$$message_0405_0000_0006$$$::"Precisamos recuar, Mestre!"::
45112::$$$message_0405_0000_0007$$$::"Não há absolutamente nada [font italic=true]recuando[font italic=false] em mim!"::
45113::$$$message_0405_0000_0008$$$::"Derrube-os, Berserker."::
45114::$$$message_0405_0000_0009$$$::"...rr.......ur?"::
45116::$$$message_0405_0000_0011$$$::"Desculpe, Mestre de Lancer. Ele fica assim sempre que vê alguém loiro..."::
45117::$$$message_0405_0000_0012$$$::"O caso dele de identidade trocada é ainda pior que o de Caster?"::
45118::$$$message_0405_0000_0013$$$::"Ha. Entendo. Então foi você... Makiri."::
45119::$$$message_0405_0000_0014$$$::"Do que está falando, Mestre de Lancer?"::
45120::$$$message_0405_0000_0015$$$::"Não se faça de bobo. Só os conspiradores Makiri de Fuyuki seriam astutos e cruéis o bastante para incendiar minha oficina."::
45121::$$$message_0405_0000_0016$$$::"...Você acusa todo mundo que encontra?"::
45122::$$$message_0405_0000_0017$$$::"É. Ele é um saco. Tem alguma pista para nos dar?"::
45123::$$$message_0405_0000_0018$$$::"...Tenho. Posso contar, também, se estiver disposto a desistir do onsen."::
45124::$$$message_0405_0000_0019$$$::"Absurdo. Eu [font italic=true]vou[font italic=false] reconstruir minha oficina."::
45125::$$$message_0405_0000_0020$$$::"Isso mesmo. Oficina à parte, nós vamos tomar aquele onsen!"::
45126::$$$message_0405_0000_0021$$$::"Tio Kariya... Ele está montando uma oficina?"::
45127::$$$message_0405_0000_0022$$$::"Sakura-chan...[wvl canskip=false time=200][hffgchg2 chara=雁夜 face=喜2 pos=right time=300 twno=1][hfsigh layer=1] Está tudo bem. Não deixarei surgir outra vítima como você!"::
45128::$$$message_0405_0000_0023$$$::"Ele vai ficar igual ao vovô?"::
45129::$$$message_0405_0000_0024$$$::"Não aponte para a minha linha do cabelo! Pare de puxar!"::
45130::$$$message_0405_0000_0025$$$::"CABEEELOOOOO!"::
45131::$$$message_0405_0000_0026$$$::"E-então eu só preciso vencer. Vou fazê-lo cuspir o nome do meu inimigo. E, claro, também vou ficar com o onsen."::
45132::$$$message_0405_0000_0027$$$::"Seu canalha."::
45133::$$$message_0405_0000_0028$$$::"Você não foi quem trouxe uma criança ao campo de batalha? Quem aqui é o verdadeiro canalha?"::
45134::$$$message_0405_0000_0029$$$::"Você é apenas um mago. Jamais entenderia a moral humana."::

