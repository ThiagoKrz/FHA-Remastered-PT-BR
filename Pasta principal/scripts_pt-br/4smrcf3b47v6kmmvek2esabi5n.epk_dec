DAT
id=qid::label=str::text=lstr::
42728::$$$message_0349_0000_0000$$$::"Sakura... Se a Rider estiver com você vestida assim, então..."::
42729::$$$message_0349_0000_0001$$$::"O mesmo vale para você, Senpai, se Saber estiver com você."::
42730::$$$message_0349_0000_0002$$$::"Entendi. Compreendemos bem nossas situações mutuas."::
42731::$$$message_0349_0000_0003$$$::"Parece que sim. Desta vez, não será um duelo à morte.[lr]::
42732::$$$message_0349_0000_0004$$$::Podemos lutar para um resultado claro, sem reservas."::
42733::$$$message_0349_0000_0005$$$::"Não, Sakura... Temos que lutar?"::
42734::$$$message_0349_0000_0006$$$::"N-não, prefiro não lutar com você, Senpai.[line len=2]"::
42735::$$$message_0349_0000_0007$$$::"Sakura. Certamente você não pretende render-se a eles?"::
42736::$$$message_0349_0000_0008$$$::"Mas eu não posso lutar, Senpai..."::
42737::$$$message_0349_0000_0009$$$::"Sakura. Eu obedecerá as suas decisões. Mas quero que você me ouça primeiro."::
42738::$$$message_0349_0000_0010$$$::"O-[hfchance layer=0]okay. O que é, Rider?"::
42739::$$$message_0349_0000_0011$$$::"Hipoteticamente falando, se você desse passagem, então Shirou e Saber iriam ao onsen juntos."::
42740::$$$message_0349_0000_0012$$$::"..."::
42741::$$$message_0349_0000_0013$$$::"Saber provavelmente derrotará a maioria dos inimigos, e Shirou a respeitará por isso. Eles estarão sozinhos em uma casa de banho juntos... Você entende para onde estou querendo chegar?"::
42742::$$$message_0349_0000_0014$$$::"Estamos ganhando isso, Rider."[rf]::
42743::$$$message_0349_0000_0015$$$::"Shirou, Sakura parece que tem intenção de lutar."::
42744::$$$message_0349_0000_0016$$$::"S-[hfchance layer=1]Sakura!? Eu não quero realmente lutar com você."::
42745::$$$message_0349_0000_0017$$$::"Hehe. Lamento, Senpai. Se tem que culpar algo, então culpe o fato de você ser o Mestre de Saber."::

