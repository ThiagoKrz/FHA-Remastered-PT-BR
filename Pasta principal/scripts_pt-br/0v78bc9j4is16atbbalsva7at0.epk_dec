DAT
id=qid::label=str::text=lstr::
45726::$$$message_0437_0000_0000$$$::"Hmm."::
45727::$$$message_0437_0000_0001$$$::"Ah?"::
45728::$$$message_0437_0000_0002$$$::"Conhecido seu, grandão?"::
45729::$$$message_0437_0000_0003$$$::"Não. Ele parece ser um mago."::
45730::$$$message_0437_0000_0004$$$::"Encontrei vocês, Mestre e Servo corruptos que insistem em violar as regras da Magia!"::
45731::$$$message_0437_0000_0005$$$::"Eu, o nono chefe da linhagem Archibald, também conhecido como "Big Ben" Kayneth El-Melloi, irei..."::
45732::$$$message_0437_0000_0006$$$::"...aplicar![wvl canskip=false time=200] A sua pena![wvl canskip=false time=200] Capital!::
45733::$$$message_0437_0000_0007$$$::(Alguém já chamou ele de Big Ben...?)::
45734::$$$message_0437_0000_0008$$$::(Heh. Na mosca.)::
45735::$$$message_0437_0000_0009$$$::"(olhar fixo)"::
45736::$$$message_0437_0000_0010$$$::"Hm?"::
45737::$$$message_0437_0000_0011$$$::"(olhar fixo)..."::
45738::$$$message_0437_0000_0012$$$::"Q-quê?"::
45739::$$$message_0437_0000_0013$$$::"Ah, desculpe. Eu estava pensando nos ingredientes."::
45740::$$$message_0437_0000_0014$$$::"Hã, ingredientes?"::
45741::$$$message_0437_0000_0015$$$::"O material é flexível, então talvez seja melhor enrolá-lo em volta de um esqueleto interno."::
45742::$$$message_0437_0000_0016$$$::"Parece que ele também tem bastante gordura."::
45743::$$$message_0437_0000_0017$$$::"Você está falando de mim!?"::
45744::$$$message_0437_0000_0018$$$::"Afaste-se, Lady Sola-Ui! Caster e seu Mestre são demônios selvagens que fizeram coisas indizíveis a crianças!"::
45745::$$$message_0437_0000_0019$$$::"Se algo acontecesse com a senhora, Lorde Kayneth choraria!"::
45746::$$$message_0437_0000_0020$$$::"Lancer...[heart]"::
45747::$$$message_0437_0000_0021$$$::"...Eu disse que [font italic=true]Lorde Kayneth[font italic=false] choraria!"::
45748::$$$message_0437_0000_0022$$$::"Hehehe. Obrigada, Lancer. Você está arriscando a vida por mim! [font italic=true]Por mim![font italic=false]"::
45749::$$$message_0437_0000_0023$$$::[delay speed=25]"Por meu senhor! [delay speed=user][wvl]Darei tudo, se preciso... [wait canskip=false time=40]cor[wait canskip=false time=40]p[wait canskip=false time=40]o[wait canskip=false time=40] e[wait canskip=false time=40] al[wait canskip=false time=40]ma[hfangry layer=0]!::
45750::$$$message_0437_0000_0024$$$::"...Parece que as coisas estão bem complicadas para eles."::
45751::$$$message_0437_0000_0025$$$::"Devo dizer, não gosto muito de relações tão depravadas."::
45752::$$$message_0437_0000_0026$$$::"...Ah![wvl canskip=false time=300][hffgchg2 chara=ケイネス face=怒3 pos=right time=300 twno=1][hfangry layer=1] O que está fazendo, Lancer!? Depressa, livre-se desse Servo!"::
45753::$$$message_0437_0000_0027$$$::"Como desejar!"::
45754::$$$message_0437_0000_0028$$$::"Boa sorte, Lancer!"::
45755::$$$message_0437_0000_0029$$$::"..."::
45756::$$$message_0437_0000_0030$$$::"Vamos começar, Caster!"::
45757::$$$message_0437_0000_0031$$$::"Então, Ryunosuke, ou seja lá qual era o seu nome. Eu, Kayneth El-Melloi Archibald, aplicarei a justiça que você merece!"::
45758::$$$message_0437_0000_0032$$$::"Você conhecerá as consequências de lançar olhos lascivos sobre a minha noiva!"::
45759::$$$message_0437_0000_0033$$$::"...Mas eu nem estava secando ela."::
45760::$$$message_0437_0000_0034$$$::"No máximo, era um olhar de cobiça."::

