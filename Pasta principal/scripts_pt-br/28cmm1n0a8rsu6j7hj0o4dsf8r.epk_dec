DAT
id=qid::label=str::text=lstr::
34609::$$$message_0263_0000_0000$$$::Acordo de repente.[lr]::
34610::$$$message_0263_0000_0001$$$::Minha consciência e senso de si são vagos.[lr]::
34611::$$$message_0263_0000_0002$$$::Dormi em um quarto estranho.::
34612::$$$message_0263_0001_0000$$$::A única coisa que vejo é um véu brilhante.[lr]::
34613::$$$message_0263_0001_0001$$$::Além disso...[lr]::
34614::$$$message_0263_0001_0002$$$::...Olho e vejo nada.[lr]::
34615::$$$message_0263_0001_0003$$$::Eu tenho certeza de que não vejo nada, porque não há nada ali.[lr]::
34616::$$$message_0263_0001_0004$$$::Meu cérebro sujo percebe que é esse tipo de lugar.::
34617::$$$message_0263_0002_0000$$$::"..."[lr]::
34618::$$$message_0263_0002_0001$$$::Meu intelecto está meio petrificado.[lr]::
34619::$$$message_0263_0002_0002$$$::Onde estou e que horas são?[lr]::
34620::$$$message_0263_0002_0003$$$::Não há ponto em buscar um referencial concreto.[lr]::
34621::$$$message_0263_0002_0004$$$::O cheiro de mel fica preso na minha pele.[lr]::
34622::$$$message_0263_0002_0005$$$::Neste lugar, meus sentidos corporais também são vagos, e a única coisa que sei com certeza[lr]::
34623::$$$message_0263_0002_0006$$$::A doçura da pele contra pele.::
34624::$$$message_0263_0003_0000$$$::"...Hehe. Senpai."[fadein time=800 storage=black textoff=0][stopdash][lr]::
34625::$$$message_0263_0003_0001$$$::Viro-me ao som de uma voz calma.[lr]::
34626::$$$message_0263_0003_0002$$$::Não tenho certeza de qual lado a cama redonda está virada.[lr]::
34627::$$$message_0263_0003_0003$$$::"Shirou... Bem-vindo."[fadein time=800 storage=black textoff=0][stopdash][lr]::
34628::$$$message_0263_0003_0004$$$::Há duas vozes: [lr]::
34629::$$$message_0263_0003_0005$$$::Sakura e Rider.::
34630::$$$message_0263_0004_0000$$$::De repente, sinto um formigamento atrás dos olhos, uma sensação de algo errado.[lr]::
34631::$$$message_0263_0004_0001$$$::É como se tivesse encontrado a única falha nesta sala, neste reino onde tudo está errado.[lr]::
34632::$$$message_0263_0004_0002$$$::Pensando de volta, já entrei nesse mundo antes. Mas acho que nunca a vi aqui antes.::
34633::$$$message_0263_0005_0000$$$::"O que houve, Senpai?"[lr]::
34634::$$$message_0263_0005_0001$$$::Mas até isso é efêmero.[lr]::
34635::$$$message_0263_0005_0002$$$::A voz doce sussurra no meu ouvido, derretendo qualquer dúvida vaga que eu tivesse.::
34636::$$$message_0263_0006_0000$$$::"..."[lr]::
34637::$$$message_0263_0006_0001$$$::A minha consciência vaga só é tingida de luxúria.[lr]::
34638::$$$message_0263_0006_0002$$$::É uma visão suficiente para me fazer perder a razão.::
34639::$$$message_0263_0007_0000$$$::As pernas cheias e maciças de Sakura e seus olhos derretidos, carnais.::
34640::$$$message_0263_0008_0000$$$::O corpo da Rider também é maravilhosamente maduro. Suas linhas são mais apertadas que as de Sakura e seu cabelo roxo estimula meu tronco encefálico.::
34641::$$$message_0263_0009_0000$$$::"Hehehe. Está nos olhando?"[lr]::
34642::$$$message_0263_0009_0001$$$::O que você acha? Rider e eu somos lindos, né?"::
34643::$$$message_0263_0010_0000$$$::"Somos então suficientes para você, Shirou?"[lr]::
34644::$$$message_0263_0010_0001$$$::Como se não estivesse![lr]::
34645::$$$message_0263_0010_0002$$$::Mas eu não sei o que dizer diante de tanta exibição.::
34646::$$$message_0263_0011_0000$$$::A parte racional e moral de mim está selada.[lr]::
34647::$$$message_0263_0011_0001$$$::Antecipação agarra minha garganta. É sufocante.::
34648::$$$message_0263_0012_0000$$$::"Rider?[lr]::
34649::$$$message_0263_0012_0001$$$::Não faça o Senpai dizer algo assim.[lr]::
34650::$$$message_0263_0012_0002$$$::Você precisa fazer o seu melhor por ele hoje também., Senpai"[lr]::
34651::$$$message_0263_0012_0003$$$::"Eu sei, Sakura."::
34652::$$$message_0263_0013_0000$$$::O que eles vão fazer?[lr]::
34653::$$$message_0263_0013_0001$$$::Sakura sorri, rindo da pergunta idiota.::
34654::$$$message_0263_0014_0000$$$::"O que devemos fazer?[lr]::
34655::$$$message_0263_0014_0001$$$::O que quiser, Senpai."[lr]::
34656::$$$message_0263_0014_0002$$$::"O que você quer fazer, Shirou?"::
34657::$$$message_0263_0015_0000$$$::"Mas hoje, eu sei tudo o que você quer, Senpai.[lr]::
34658::$$$message_0263_0015_0001$$$::Você não precisa dizer nada. Vamos..."::
34659::$$$message_0263_0016_0000$$$::"Tudo por você."[wait canskip=0 time=800][fadein time=800 storage=white textoff=0]::
34660::$$$message_0263_0017_0000$$$::Eu nunca pedi por isso.[lr]::
34661::$$$message_0263_0017_0001$$$::Eu sinto aqueles olhos dobrando minha sanidade em pedaços cada vez menores.::
34662::$$$message_0263_0018_0000$$$::"Deixe-se ir.[lr]::
34663::$$$message_0263_0018_0001$$$::Vamos fazer tudo."::
34664::$$$message_0263_0019_0000$$$::"O que eu devo fazer, Sakura?"[lr]::
34665::$$$message_0263_0019_0001$$$::"Claro que ajudarei o Senpai também.[lr]::
34666::$$$message_0263_0019_0002$$$::Vamos desfrutar dele juntos, Senpai.[lr]::
34667::$$$message_0263_0019_0003$$$::Além disso, acho que ele vai ficar mais feliz se você[lr]::
34668::$$$message_0263_0019_0004$$$::Senpai, Tome a iniciativa."::
34669::$$$message_0263_0020_0000$$$::Sakura solta uma risada feliz e maliciosa.[lr]::
34670::$$$message_0263_0020_0001$$$::Suas palavras de provocação me atingem no coração.::
34671::$$$message_0263_0021_0000$$$::Um cheiro doce de incenso persiste no ar.[lr]::
34672::$$$message_0263_0021_0001$$$::A cama é tão macia que meus quadris se encaixam nela.[lr]::
34673::$$$message_0263_0021_0002$$$::Membros macios e cheios se inclinam sobre mim.[lr]::
34674::$$$message_0263_0021_0003$$$::Os olhos de Sakura estão quentes e úmidos. Os olhos de Rider ardem em silêncio.[lr]::
34675::$$$message_0263_0021_0004$$$::A língua lambe os lábios secos.::
34676::$$$message_0263_0022_0000$$$::"Você quer?"[wm canskip=0][se storage=se028 nowait=1]::
34677::$$$message_0263_0023_0000$$$::"Você quer que...?"[wm canskip=0][se storage=se028 nowait=1][lr]::
34678::$$$message_0263_0023_0001$$$::Eles nem precisam perguntar.::
34679::$$$message_0263_0024_0000$$$::Aceno com a cabeça.[lr]::
34680::$$$message_0263_0024_0001$$$::Quero entrar nos dois e nunca parar.::
34681::$$$message_0263_0025_0000$$$::"Sim... Então, vamos te deixar sentir algo muito bom, Senpai.[lr]::
34682::$$$message_0263_0025_0001$$$::Prepare-se."::
34683::$$$message_0263_0026_0000$$$::"Você pode acabar chorando.[lr]::
34684::$$$message_0263_0026_0001$$$::Shirou."[lr]::
34685::$$$message_0263_0026_0002$$$::"Hehe. Ah, Rider...[lr]::
34686::$$$message_0263_0026_0003$$$::Eu quero vê-lo pedir, Senpai.[lr]::
34687::$$$message_0263_0026_0004$$$::para eu parar, embora."::
34688::$$$message_0263_0027_0000$$$::Seu sorriso é como um perfume que me sufoca, tão denso que não consigo respirar.::
34689::$$$message_0263_0028_0000$$$::Meu cérebro vai colapsar antes do corpo.[lr]::
34690::$$$message_0263_0028_0001$$$::Estou enterrado nos almofados, o calor da excitação se espalhando pelo corpo, já deixando meu membro duro e tenso.[lr]::
34691::$$$message_0263_0028_0002$$$::"Vamos começar.[lr]::
34692::$$$message_0263_0028_0003$$$::Desista de tudo e se torne um comigo."::
34693::$$$message_0263_0029_0000$$$::Uma língua úmida acaricia minha pele.[lr]::
34694::$$$message_0263_0029_0001$$$::A língua fina e pontiaguda da Rider desliza pelo meu peito esquerdo. Meu braço abaixo do ombro está encaixado no corpo generoso dela.::
34695::$$$message_0263_0030_0000$$$::"Hmm... Haah... Delicioso..."[lr]::
34696::$$$message_0263_0030_0001$$$::Sakura lambe meu peito direito.[lr]::
34697::$$$message_0263_0030_0002$$$::Meu braço direito também está apoiado contra os seios macios de Sakura.[lr]::
34698::$$$message_0263_0030_0003$$$::Ambas as minhas mãos sentem o toque de cabelos púbicos macios.[lr]::
34699::$$$message_0263_0030_0004$$$::A língua de Sakura espalha sua saliva ao redor.::
34700::$$$message_0263_0031_0000$$$::"Hmm... O que devemos fazer, Sakura?"[lr]::
34701::$$$message_0263_0031_0001$$$::"Ahh, mm...[lr]::
34702::$$$message_0263_0031_0002$$$::Os homens também são sensíveis nos mamilos.[lr]::
34703::$$$message_0263_0031_0003$$$::Então, por que não nos divertimos um pouco com ele juntos?"[lr]::
34704::$$$message_0263_0031_0004$$$::Os lábios lambem meus mamilos vestigiais, da base à ponta.::
34705::$$$message_0263_0032_0000$$$::"Urgh... Ah..."[lr]::
34706::$$$message_0263_0032_0001$$$::Duas moças estão mordendo meus mamilos.[lr]::
34707::$$$message_0263_0032_0002$$$::Como crianças que mordem o peito da mãe, eles sugam com os lábios e rolam a língua, mesmo que nada saia.::
34708::$$$message_0263_0033_0000$$$::"Ngh... Haah..."[lr]::
34709::$$$message_0263_0033_0001$$$::Meu respirar vai ao caos.[lr]::
34710::$$$message_0263_0033_0002$$$::Não consigo me mover. Eles me seguram com suavidade, mas com firmeza.::
34711::$$$message_0263_0034_0000$$$::"Hehe. Viu isso, Rider?[lr]::
34712::$$$message_0263_0034_0001$$$::Senpai parece estar se sentindo bem.[lr]::
34713::$$$message_0263_0034_0002$$$::Olha, ele está... mm, [wait canskip=0 time=200]ofegante."[lr]::
34714::$$$message_0263_0034_0003$$$::"Tão adorável.[lr]::
34715::$$$message_0263_0034_0004$$$::Isso me faz querer fazer mais, assim..."::
34716::$$$message_0263_0035_0000$$$::Sua pele gelada e flexível arranha meu braço.[lr]::
34717::$$$message_0263_0035_0001$$$::Rider abraça meu braço, massageando-se com ele.::
34718::$$$message_0263_0036_0000$$$::"Não é justo, Rider...[lr]::
34719::$$$message_0263_0036_0001$$$::Também eu...[lr]::
34720::$$$message_0263_0036_0002$$$::Senpai, qual de nós você se sente melhor?"::
34721::$$$message_0263_0037_0000$$$::Sakura amassa-se contra meu outro braço.[lr]::
34722::$$$message_0263_0037_0001$$$::Está firmemente encaixado nos seus seios voluptuosos. Sua pele é macia e pesada, e meus dedos parecem mergulhar nela.::
34723::$$$message_0263_0038_0000$$$::"Hmm... Hehe, olha, Rider."[lr]::
34724::$$$message_0263_0038_0001$$$::Sakura sussurra, travessa.::
34725::$$$message_0263_0039_0000$$$::Eles dois olham para minha região pélvica.[lr]::
34726::$$$message_0263_0039_0001$$$::e veja meu órgão masculino tremer de prazer.[lr]::
34727::$$$message_0263_0039_0002$$$::Quatro olhos quentes me encaram. Mais e mais sangue flui para meus vasos.::
34728::$$$message_0263_0040_0000$$$::"Ele também parece estar se sentindo bem aqui.[lr]::
34729::$$$message_0263_0040_0001$$$::Senpai, Ele está tremendo aqui embaixo.[lr]Senpai, ::
34730::$$$message_0263_0040_0002$$$::como se quisesse tanto..."[lr]::
34731::$$$message_0263_0040_0003$$$::"Assim é seu pênis... está tão grosso."[lr]::
34732::$$$message_0263_0040_0004$$$::Os dedos deslizam pela minha pele.[lr]::
34733::$$$message_0263_0040_0005$$$::Eles fluem do meu peito até minha região abdominal inferior, convergindo na virilha.::
34734::$$$message_0263_0041_0000$$$::"Quente... Você está tão quente aqui, Senpai..."[lr]::
34735::$$$message_0263_0041_0001$$$::"Shirou, você está tão quente e inchado..."[lr]::
34736::$$$message_0263_0041_0002$$$::Mãos longas e elegantes deslizam sobre meu membro.[lr]::
34737::$$$message_0263_0041_0003$$$::Eles se enroscam ao redor do meu membro, brincando com meu escroto, e o apertam confortavelmente quando fica ereto.::
34738::$$$message_0263_0042_0000$$$::"Você é tão difícil.[lr]::
34739::$$$message_0263_0042_0001$$$::Isso é uma resposta para mim, ou para Rider?"::
34740::$$$message_0263_0043_0000$$$::"Sakura, estou certo."::
34741::$$$message_0263_0044_0000$$$::"Duvido...[lr]::
34742::$$$message_0263_0044_0001$$$::Mph, então vou eu primeiro, Senpai."[lr]::
34743::$$$message_0263_0044_0002$$$::Sakura beija meu peito e levanta a cabeça.[lr]::
34744::$$$message_0263_0044_0003$$$::Ela se move sobre meu pênis fervendo e arruma o cabelo para o lado.::
34745::$$$message_0263_0045_0000$$$::"Hmm..."[lr]::
34746::$$$message_0263_0045_0001$$$::Sua língua desliza ao redor do meu glântera nu.[lr]::
34747::$$$message_0263_0045_0002$$$::Sakura começa a lamber cuidadosamente, como se fosse um doce, como se estivesse limpando com sua língua.::
34748::$$$message_0263_0046_0000$$$::"Shirou, você parece sozinho por aqui."[lr]::
34749::$$$message_0263_0046_0001$$$::Enquanto gemo com a estimulação que escorre pela minha coluna, Rider se move sobre meu peito e brinca com meus mamilos com os dedos e a língua.::
34750::$$$message_0263_0047_0000$$$::"Mm, haah, ah...ngh..."[lr]::
34751::$$$message_0263_0047_0001$$$::Os lábios e dedos de Sakura envolvem e engolem a cabeça do meu pênis.[lr]::
34752::$$$message_0263_0047_0002$$$::Seus dedos deslizam pelo meu membro, apertando e endurecendo-o.[lr]::
34753::$$$message_0263_0047_0003$$$::Enquanto isso, os carinhos pegajosos de Rider cobrem meu corpo.::
34754::$$$message_0263_0048_0000$$$::"Aha...[lr]::
34755::$$$message_0263_0048_0001$$$::Senpai, você está tremendo.[lr]::
34756::$$$message_0263_0048_0002$$$::Você é tão difícil assim."[lr]::
34757::$$$message_0263_0048_0003$$$::Quando os dedos de Sakura seguram meu escroto, uma sensação dolorosamente agradável reverbera no meu cérebro. Ela rola e brinca com minha masculinidade, tocando novamente a ponta com sua língua.::
34758::$$$message_0263_0049_0000$$$::Escuto os sons lascivos que sai da boca dela.[lr]::
34759::$$$message_0263_0049_0001$$$::O longo cabelo da Rider cobre e gruda no meu peito.::
34760::$$$message_0263_0050_0000$$$::"Rider, venha cá.[lr]::
34761::$$$message_0263_0050_0001$$$::Faça o Senpai se sentir ainda melhor."[lr]::
34762::$$$message_0263_0050_0002$$$::"Sim, Sakura."::
34763::$$$message_0263_0051_0000$$$::Duas corpos femininos se acomodam lado a lado ao lado de um membro masculino úmido, encarando-o.::
34764::$$$message_0263_0052_0000$$$::"Ngh... Ngh!"[lr]::
34765::$$$message_0263_0052_0001$$$::Lábios e línguas de diferentes maciez envolvem-me.[lr]::
34766::$$$message_0263_0052_0002$$$::Eu agarro as cobertas e tento me impedir de rodar.::
34767::$$$message_0263_0053_0000$$$::"Ah... Haah, Rider, você vai ficar embaixo... Vou vir de cima, Senpai."[lr]::
34768::$$$message_0263_0053_0001$$$::"Entendi. Aqui, certo?"[lr]::
34769::$$$message_0263_0053_0002$$$::Rider abaixa o rosto e desliza pelo meu joelho. No instante em que me pergunto aonde ela vai...::
34770::$$$message_0263_0054_0000$$$::"Você também é fofo aqui, Shirou."[lr]::
34771::$$$message_0263_0054_0001$$$::O ar da sua respiração me toca, me faz apertar o traseiro.[lr]::
34772::$$$message_0263_0054_0002$$$::A língua úmida toca um órgão oculto, profundo dentro, que ninguém mais jamais viu ou tocou antes, muito menos lambeu.::
34773::$$$message_0263_0055_0000$$$::"Hmm...mmph.[lr]::
34774::$$$message_0263_0055_0001$$$::Senpai, você está ficando louco de novo.[lr]::
34775::$$$message_0263_0055_0002$$$::Aaaah, maravilhoso... Você é tão duro e delicioso, mm..."::
34776::$$$message_0263_0056_0000$$$::Minha metade inferior está imersa em um prazer que se torce.[lr]::
34777::$$$message_0263_0056_0001$$$::Sakura lê meu anus enquanto Sakura lê meu pênis.[lr]::
34778::$$$message_0263_0056_0002$$$::Os dedos deslizam livremente ao redor do meu corpo, rolando e acariciando sem restrição.::
34779::$$$message_0263_0057_0000$$$::"É a primeira vez que isso acontece com você. Seu anus está tremendo como o de uma garota, você sabe."::
34780::$$$message_0263_0058_0000$$$::"Senpai sempre faz o lamber.[lr]::
34781::$$$message_0263_0058_0001$$$::mas é a primeira vez que ele é lambido.[lr]::
34782::$$$message_0263_0058_0002$$$::Tão fofo, mm... ahh..."::
34783::$$$message_0263_0059_0000$$$::Sua palavra e língua acariciam minha parte inferior.[lr]::
34784::$$$message_0263_0059_0001$$$::A mistura de sensações me desorienta, e o prazer ardente me deixa sedeiro e desesperado por ar.::
34785::$$$message_0263_0060_0000$$$::Quero tirar isso de dentro.[lr]::
34786::$$$message_0263_0060_0001$$$::Seria fácil espalhar minha slime branca de prazer na boca de Sakura e na face de Rider. É muito doloroso continuar segurando isso dentro de mim por mais tempo.[lr]::
34787::$$$message_0263_0060_0002$$$::Mas...::
34788::$$$message_0263_0061_0000$$$::"Ah, ainda não, Senpai."[lr]::
34789::$$$message_0263_0061_0001$$$::Sakura ri e retira seus lábios.[lr]::
34790::$$$message_0263_0061_0002$$$::Ao mesmo tempo, os dedos da Rider pressionam meu quadril, bloqueando minha ejaculação.::
34791::$$$message_0263_0062_0000$$$::"Sakura... Ah, hah..."[lr]::
34792::$$$message_0263_0062_0001$$$::Não consigo formar palavras na cabeça.[lr]::
34793::$$$message_0263_0062_0002$$$::Seus toques são fortes e coloridos, até venenosos.[lr]::
34794::$$$message_0263_0062_0003$$$::...Memórias vagas surgem.[lr]::
34795::$$$message_0263_0062_0004$$$::...Fui submetido a incontáveis carícias neste reino... mas nada nunca me fez sentir isso tão real.[lr]::
34796::$$$message_0263_0062_0005$$$::O que mudou dessa vez?::
34797::$$$message_0263_0063_0000$$$::"Você parece estar sofrendo, Shirou."[lr]::
34798::$$$message_0263_0063_0001$$$::"Hehehe. Você parece estar tendo dificuldade em se sentir tão bem assim., Senpai[lr]::
34799::$$$message_0263_0063_0002$$$::Talvez você chore se fizermos mais, Senpai."::
34800::$$$message_0263_0064_0000$$$::"Vamos fazê-lo chorar, Sakura?"::
34801::$$$message_0263_0065_0000$$$::Eles se falam, o seu ar quente envolvendo meus genitais.[lr]::
34802::$$$message_0263_0065_0001$$$::Meus processos de pensamento ainda estão congelados, enquanto meu corpo anseia por mais prazer.::
34803::$$$message_0263_0066_0000$$$::Meus quadris tremem, pedindo para chegar até aquelas línguas e lábios.::
34804::$$$message_0263_0067_0000$$$::"Senpai... você pode chorar ou gritar.[lr]::
34805::$$$message_0263_0067_0001$$$::Vamos cuidar de você até o fim."[lr]::
34806::$$$message_0263_0067_0002$$$::"Hehe... Você é adorável, Shirou."::
34807::$$$message_0263_0068_0000$$$::Eles dançam.[lr]::
34808::$$$message_0263_0068_0001$$$::Seus lábios e línguas dançam em um vals sobre minha masculinidade.[lr]::
34809::$$$message_0263_0068_0002$$$::Eles são pegajosos e caóticos, como o enredo lascivo entre homem e mulher, entrelaçados em mel.::
34810::$$$message_0263_0069_0000$$$::"Ngh, nngh...!!!"[lr]::
34811::$$$message_0263_0069_0001$$$::Meus pulmões se contraem sozinhos e eu grito.::
34812::$$$message_0263_0070_0000$$$::"Aaaah, haah...[lr]::
34813::$$$message_0263_0070_0001$$$::A comida estava boa, Rider?"[lr]::
34814::$$$message_0263_0070_0002$$$::"Shirou...[lr]::
34815::$$$message_0263_0070_0003$$$::O sabor do seu semente está em todo o meu corpo.::
34816::$$$message_0263_0071_0000$$$::A voz misturada ao som de seus lábios estimula minha mente.[lr]::
34817::$$$message_0263_0071_0001$$$::Sakura alimenta o que tem na boca nos lábios de Rider.::
34818::$$$message_0263_0072_0000$$$::Cada vez que ela lambe a cabeça do meu pênis, suga minha abertura uretral e seus dedos se movem ao redor do meu ânus e escroto, fazendo com que meu pobre pênis quase grita.::
34819::$$$message_0263_0073_0000$$$::"Sakura... Você está molhada em fluidos de Shirou."[lr]::
34820::$$$message_0263_0073_0001$$$::"Aah... Eu também bebi, Rider... Mm, mph, os fluidos do Senpai estão espalhados por todo lugar."[lr]::
34821::$$$message_0263_0073_0002$$$::Os lábios limparam o líquido que escorria.[lr]::
34822::$$$message_0263_0073_0003$$$::É como se eu estivesse em chamas.[lr]::
34823::$$$message_0263_0073_0004$$$::A sensação agradável faz com que meus quadris comecem a tremer sozinhos.[lr]::
34824::$$$message_0263_0073_0005$$$::Meus olhos quase choraram com a alegria que atravessava meu cérebro.::
34825::$$$message_0263_0074_0000$$$::"Sakura... Rider..."[lr]::
34826::$$$message_0263_0074_0001$$$::Lágrimas escorrem por meus lábios secos.[lr]::
34827::$$$message_0263_0074_0002$$$::Não há como escapar do ofegar e do convulsar, e não sei até que ponto esse prazer doloroso vai.::
34828::$$$message_0263_0075_0000$$$::"Mm, aaaahhhh..."[lr]::
34829::$$$message_0263_0075_0001$$$::Os lábios de Sakura sugam longamente e com força.::
34830::$$$message_0263_0076_0000$$$::Sua língua escorregadia desliza, tentando acariciar meu membro e sentir o pulso.::
34831::$$$message_0263_0077_0000$$$::"Hehehe... Fizemos a Senpai chorar."[lr]::
34832::$$$message_0263_0077_0001$$$::Sakura riu. Solta um suspiro superficial e lambe os lábios, as bochechas coradas.[lr]::
34833::$$$message_0263_0077_0002$$$::Meus líquidos claros mancham seus lábios.::
34834::$$$message_0263_0078_0000$$$::"Ah. Ele está chorando mesmo."[lr]::
34835::$$$message_0263_0078_0001$$$::Rider limpa os seus lindos lábios com a língua também. Não consigo suportar pensar que o meu cheiro está preso em sua boca.::
34836::$$$message_0263_0079_0000$$$::"...Senpai? Você se sentiu tão bem que chorou.[lr]::
34837::$$$message_0263_0079_0001$$$::E aqui embaixo, você é tão duro.., Senpai."[lr]::
34838::$$$message_0263_0079_0002$$$::Os dedos arrancam meu membro rígido.[lr]::
34839::$$$message_0263_0079_0003$$$::Sakura agarra-o, e a pressão interna aumenta o suficiente para quase estourar. Ela o observa com euforia, espremendo-o.::
34840::$$$message_0263_0080_0000$$$::"Eu te espremo mais dentro de mim.[lr]::
34841::$$$message_0263_0080_0001$$$::Por favor, continue chorando. Aqui, e ali...[lr]::
34842::$$$message_0263_0080_0002$$$::Vou beber todos vocês. Hehehehe.., Senpai."::
34843::$$$message_0263_0081_0000$$$::Sakura não está agindo como costuma.[lr]::
34844::$$$message_0263_0081_0001$$$::Ela é quente, borrada e...errada, de alguma forma.::
34845::$$$message_0263_0082_0000$$$::"Mm, mph, aah..."[lr]::
34846::$$$message_0263_0082_0001$$$::Ela se senta sobre mim.[lr]::
34847::$$$message_0263_0082_0002$$$::O seu corpo mole e úmido pressiona o meu.[lr]::
34848::$$$message_0263_0082_0003$$$::Não posso esperar para que ela me engula, mas ela demora...::
34849::$$$message_0263_0083_0000$$$::"Senpai, você é tão difícil... Oof, aaah..."[lr]::
34850::$$$message_0263_0083_0001$$$::Sakura lambe-me com seu pubis molhado.[lr]::
34851::$$$message_0263_0083_0002$$$::como se sussurrasse que seus lábios são outro conjunto de lábios.::
34852::$$$message_0263_0084_0000$$$::"Sakura, apressa-se..."[lr]::
34853::$$$message_0263_0084_0001$$$::Quero que ela coloque. Quero que seu vulva quente envolva meu corpo."::
34854::$$$message_0263_0085_0000$$$::"Você quer isso?[lr]::
34855::$$$message_0263_0085_0001$$$::Você quer colocar dentro de mim?[lr]::
34856::$$$message_0263_0085_0002$$$::Você tem certeza, Senpai?[lr]::
34857::$$$message_0263_0085_0003$$$::Ela passa meu membro contra suas dobras. A abertura uretral fica grudada na pele do clitóris dela.[lr]::
34858::$$$message_0263_0085_0004$$$::É um prazer pouco convencional que atinge diretamente as meninges do meu cérebro.::
34859::$$$message_0263_0086_0000$$$::"Onde você quer colocar?[lr]::
34860::$$$message_0263_0086_0001$$$::Aqui?[lr]::
34861::$$$message_0263_0086_0002$$$::Isso é tão pervertido. Eu te subestimei, Senpai."[lr]::
34862::$$$message_0263_0086_0003$$$::Sakura levanta os quadris e coloca minha ponta contra seu anus.[lr]::
34863::$$$message_0263_0086_0004$$$::Então, ela repousa seu peso em mim.::
34864::$$$message_0263_0087_0000$$$::"Em... sua vag..."[lr]::
34865::$$$message_0263_0087_0001$$$::Dizer em voz alta me deixa louco.[lr]::
34866::$$$message_0263_0087_0002$$$::Sakura observa meus lábios com fascínio e ri, lasciva.::
34867::$$$message_0263_0088_0000$$$::"Hehe. Ainda não.[lr]::
34868::$$$message_0263_0088_0001$$$::Haverá tempo suficiente para isso.., Senpai.[lr]::
34869::$$$message_0263_0088_0002$$$::Hah, [wait canskip=0 time=200][fadein time=300 storage=fdh10b_桜ライダー04b textoff=0][shock vmax=20 time=300 count=2]mgh, [wait canskip=0 time=200][fadein time=300 storage=fdh10b_桜ライダー04b2 textoff=0][shock vmax=20 time=400 count=3][line len=3]ah...!::
34870::$$$message_0263_0089_0000$$$::Ela se arranha contra mim.::
34871::$$$message_0263_0090_0000$$$::Sakura passa os dedos pelo sexo contra o meu membro ereto.[lr]::
34872::$$$message_0263_0090_0001$$$::Ela me segura com as mãos como fez quando me lambeu, não, ela me acaricia ainda mais do que isso. Seus quadris se movem, e sua úmida e molhada abertura desliza de ponta a raiz.::
34873::$$$message_0263_0091_0000$$$::"Haah, kuah..."::
34874::$$$message_0263_0092_0000$$$::"Ah, Sakura está te moleque.[lr]::
34875::$$$message_0263_0092_0001$$$::Seria uma vergonha se você viesse desse lugar."[lr]::
34876::$$$message_0263_0092_0002$$$::A Rider sussurra para mim de algum lugar.::
34877::$$$message_0263_0093_0000$$$::O prazer de esfregar nossas partes íntimas, derramando suor de amor, já atingiu um nível crítico.::
34878::$$$message_0263_0094_0000$$$::"Nngah, aah, bom...[lr]::
34879::$$$message_0263_0094_0001$$$::Senpai, você está...[lr]::
34880::$$$message_0263_0094_0002$$$::Tão quente, tão duro...[lr]::
34881::$$$message_0263_0094_0003$$$::Hah, vou chegar...!"::
34882::$$$message_0263_0095_0000$$$::Sakura me esmaga com paixão.[lr]::
34883::$$$message_0263_0095_0001$$$::...Não consigo mais. Esqueço palavras como "paciência" e "resistência". Sakura grita comigo, me apressa, me leva ao clímax sem nunca conseguir penetrar.::
34884::$$$message_0263_0096_0000$$$::"Sakura, eu vou...!"[lr]::
34885::$$$message_0263_0096_0001$$$::Começo a mover os quadris de baixo para cima, rolando contra seus genitais.[lr]::
34886::$$$message_0263_0096_0002$$$::A fricção que teria acendido uma chama é aliviada pelos nossos mucos membranosos úmidos, e a sensação escorregadia faz meu pescoço arquear.::
34887::$$$message_0263_0097_0000$$$::"Ah... Não, está saindo,[lr]::
34888::$$$message_0263_0097_0001$$$::Senpai... você está se molhando...[lr]::
34889::$$$message_0263_0097_0002$$$::Huah, tão vergonhoso, você vai virar sozinho, não chore, mais, haah... [wait canskip=0 time=300][fadein time=300 storage=fdh10b_桜ライダー04b textoff=0][shock vmax=15 time=400 count-=2]Ngh, Senpai!"::
34890::$$$message_0263_0098_0000$$$::Levo a ponta do clitóris de Sakura.[lr]::
34891::$$$message_0263_0098_0001$$$::Membranas mucosas excessivamente sensíveis são estimuladas ao ponto de acúmulo.::
34892::$$$message_0263_0099_0000$$$::"Mm, [wait canskip=0 time=400]isso é sua punição, [wait canskip=0 time=200][shock vmax=15 time=400 count-=2][fadein time=300 storage=fdh10b_桜ライダー04d2 textoff=0]ahaaah!"::
34893::$$$message_0263_0100_0000$$$::Minha consciência se desfaz.[lr]::
34894::$$$message_0263_0100_0001$$$::Sakura aperta sua clitóris entre o osso púbico e meu pênis.[lr]::
34895::$$$message_0263_0100_0002$$$::A lasciviosidade disso me faz explodir em desejo, como se os nervos na minha parte inferior tivessem sido cortados. Calor sobe pela minha uretra, trazendo lágrimas aos meus olhos.::
34896::$$$message_0263_0101_0000$$$::"Haah, ngh, Senpaiiii...!"[lr]::
34897::$$$message_0263_0101_0001$$$::O fluido branco instantâneo jorra da ponta.[lr]::
34898::$$$message_0263_0101_0002$$$::O útero de Sakura desliza sobre mim e o engole tudo.[lr]::
34899::$$$message_0263_0101_0003$$$::Os fluidos que escorrem são engolidos pela sua vagina, como se ela tivesse envolvido meus lábios com a boca, sugando e sugando.::
34900::$$$message_0263_0102_0000$$$::"Aha... [wait canskip=0 time=100]Senpai, está tão quente...[lr]::
34901::$$$message_0263_0102_0001$$$::Você entrou em mim. [wait canskip=0 time=100] Hehe, seu fluido quente está escorrendo dentro... não posso deixar escapar, seria um desperdício... [wait canskip=0 time=100] Nngah.., Senpai."::
34902::$$$message_0263_0103_0000$$$::Sakura abaixa as nádegas.[lr]::
34903::$$$message_0263_0103_0001$$$::Suas paredes vaginais quentes deslizam para baixo, mantendo qualquer coisa de dentro.[lr]::
34904::$$$message_0263_0103_0002$$$::Durante o longo jato, eu afundo como um pau em um pântano.::
34905::$$$message_0263_0104_0000$$$::"Sakura...ah, [wait canskip=0 time=100]ngh..."[lr]::
34906::$$$message_0263_0104_0001$$$::Estou ainda dentro dela, ejaculando.[lr]::
34907::$$$message_0263_0104_0002$$$::Líquido quente que queimaria se derramado se acumula nas profundezas de Sakura, formando uma mistura desordenada.[lr]::
34908::$$$message_0263_0104_0003$$$::Meus plugues fálicos pararam seu vaso vaginal.::
34909::$$$message_0263_0105_0000$$$::"Hmm... Hehe, só começamos.[movefg opacity=255 time=3000 pos=c accel=0 storage=black textoff=0][lr]::
34910::$$$message_0263_0105_0001$$$::A punição acabou. Agora vamos aproveitar a companhia um do outro, Senpai.[lr]::
34911::$$$message_0263_0105_0002$$$::Estou de volta no quarto.[lr]::
34912::$$$message_0263_0105_0003$$$::O espaço da véu desapareceu como se nunca tivesse existido.[lr]::
34913::$$$message_0263_0105_0004$$$::Mais importante ainda, minha mão está tocando o peito de Sakura.::
34914::$$$message_0263_0106_0000$$$::"Ah... Hehe, você gosta dos meus seios?"[lr]::
34915::$$$message_0263_0106_0001$$$::Os seios da Sakura são macios e brancos, como marshmallows.[lr]::
34916::$$$message_0263_0106_0002$$$::Não quero só apertá-los. Se Sakura não parar de se mover, vou fazer algo que não poderei desfazer.::
34917::$$$message_0263_0107_0000$$$::"Ngh... kh..."[lr]::
34918::$$$message_0263_0107_0001$$$::Não consigo nem dedicar o esforço para tocar nela.[lr]::
34919::$$$message_0263_0107_0002$$$::Os quadris de Sakura começam a se mover enquanto ela se senta sobre mim, construindo meu sêmen. Ela ondula, minha masculinidade unida à sua.::
34920::$$$message_0263_0108_0000$$$::"Haah... Ngh, [wait canskip=0 time=150] vocês todos estão me enfiando dentro de mim, tocando-me... Aha, vocês ainda são duros, [wait canskip=0 time=200]Huaagh... Fantástico... Quantas vezes mais vão me enfiar dentro de mim?[shock vmax=15 time=400 count=3][wait canskip=0 time=200] Wha, [wait canskip=0 time=150][shock vmax=30 time=900 count=3]ngh, Senpai!"[lr]::
34921::$$$message_0263_0108_0001$$$::Os quadris de Sakura deslizam para baixo, e meu sêmen borbulha em sua vagina.[lr]::
34922::$$$message_0263_0108_0002$$$::Sujeitos espalmam-se do lugar onde estamos unidos.[lr]::
34923::$$$message_0263_0108_0003$$$::Meus quadris tremem como se tivessem uma mente própria.::
34924::$$$message_0263_0109_0000$$$::"Hah, que maravilha, Senpai...[lr]::
34925::$$$message_0263_0109_0001$$$::Entendi., Senpai[shock vmax=-20 hmax=10 time=1000 count=3]Se você se cansar, terei que punir você mais., Senpai[wait canskip=0 time=200]Você pode quebrar, Senpai[shock vmax=-20 hmax=10 time=1000 count=3]aha... Ngh, Senpai[wait canskip=0 time=200]haah..., Senpai"[movefg opacity=0 time=1500 pos=c accel=0 storage=特殊黒 textoff=0]::
34926::$$$message_0263_0110_0000$$$::Sakura faz uma ameaça lasciva.[lr]::
34927::$$$message_0263_0110_0001$$$::Nossas partes corporais sobrepostas continuam se movendo. Meus fluidos misturam-se com os "suco de amor" de Sakura, escorrendo para baixo.::
34928::$$$message_0263_0111_0000$$$::"Ufufu, eu cuidarei de você mesmo que quebre, Senpai. Pode ser um brinquedo só para mim, [wait canskip=0 time=300] então... por favor, mova-se, [wait canskip=0 time=300] forte, [wait canskip=0 time=300] [se storage=se028 nowait=1] [shock vmax=20 time=300 count=2] [movefg opacity=255 time=100 pos=c accel=0 storage=white textoff=0] [wm canskip=0] [movefg opacity=0 time=300 pos=c accel=0 storage=white textoff=0] [wm canskip=0] me segure, [shock vmax=20 time=300 count=2] [se storage=se028 nowait=1] me espete! Haaa[movefg opacity=255 time=200 pos=c accel=0 storage=white textoff=0] [wm canskip=0] [movefg opacity=0 time=300 pos=c accel=0 storage=white textoff=0] [wm canskip=0] [se storage=se028 nowait=1] [shock vmax=20 time=800 count=6] aaaa[movefg opacity=255 time=100 pos=c accel=0 storage=white textoff=0] [wm canskip=0] [movefg opacity=0 time=200 pos=c accel=0 storage=white textoff=0] [wm canskip=0] aahn!"[movefg opacity=255 time=1500 pos=c accel=0 storage=white textoff=0][lr]::
34929::$$$message_0263_0111_0001$$$::Sakura grita.[lr]::
34930::$$$message_0263_0111_0002$$$::Nossas pernas estão entrelaçadas. Seus quadris mergulham profundamente nos meus.[lr]::
34931::$$$message_0263_0111_0003$$$::Os olhos de Sakura brilham com mentira lasciva.::
34932::$$$message_0263_0112_0000$$$::Isso está errado.[lr]::
34933::$$$message_0263_0112_0001$$$::As palavras escorrem dos meus lábios, mesmo enquanto a segurou.[lr]::
34934::$$$message_0263_0112_0002$$$::Minha razão encolhida move o mouse. É minha última ação de resistência contra esse lago infinito de êxtase.[lr]::
34935::$$$message_0263_0112_0003$$$::O cheiro de mentiras espalhadas ofende meus instintos.[lr]::
34936::$$$message_0263_0112_0004$$$::Isso é uma ilusão...?::
34937::$$$message_0263_0113_0000$$$::"Isso não está errado."[lr]::
34938::$$$message_0263_0113_0001$$$::Sua voz é fria e suave como a chuva do inverno.[lr]::
34939::$$$message_0263_0113_0002$$$::Eu ouço a voz da Rider, mas não sei de onde ela vem.::
34940::$$$message_0263_0114_0000$$$::"Se algo estiver errado, é você, Shirou."[lr]::
34941::$$$message_0263_0114_0001$$$::Sakura balança o corpo no meu quadril, parecendo estar apaixonada.[lr]::
34942::$$$message_0263_0114_0002$$$::"Mais, mais, Senpai, Senpai", seus lábios continuam murmurando. A luz em seus olhos está apagada. Isso não é Sakura.::
34943::$$$message_0263_0115_0000$$$::"Essa é a verdadeira Sakura. Pobre coisinha."[lr]::
34944::$$$message_0263_0115_0001$$$::A voz da Rider não soa em nada patética.[lr]::
34945::$$$message_0263_0115_0002$$$::Na verdade, sua voz parece zombar dela mesma. Ela não está depreciando a lascividade de Sakura.::
34946::$$$message_0263_0116_0000$$$::"A Sakura que você pensa conhecer é um ato. Ela é a própria imagem de uma mulher depravada que não pode viver sem amar um homem. Sakura se envergonha disso, e mesmo quando está nos seus braços, ela se veste com sua bela e falsa personalidade."[lr]::
34947::$$$message_0263_0116_0001$$$::Não consigo me mover enquanto estou conectado.[lr]::
34948::$$$message_0263_0116_0002$$$::A voz da Rider é vazia. Essa voz também não é genuína.::
34949::$$$message_0263_0117_0000$$$::"Se você é o amante de Sakura, deveria estar mais ciente disso e tocar sua verdadeira essência. Se sempre agir como um herói, Sakura sofrerá e esconderá sua lascividade... Não consigo suportar assistir a isso."[lr]::
34950::$$$message_0263_0117_0001$$$::"Haah... [wait canskip=0 time=200]Senpai... [wait canskip=0 time=200]Mais..."::
34951::$$$message_0263_0118_0000$$$::O que ela está tentando dizer?[lr]::
34952::$$$message_0263_0118_0001$$$::Mesmo enquanto escuto, o prazer que sinto dentro de Sakura não muda. Na verdade, me sinto apressado e com formigamento porque não consigo me mover.::
34953::$$$message_0263_0119_0000$$$::"Sim, faça isso mais... Faça Sakura sentir mais prazer. Quebre sua casca para que ela possa aceitar a si mesma como é.[lr]::
34954::$$$message_0263_0119_0001$$$::Isso não faria vocês dois felizes?"::
34955::$$$message_0263_0120_0000$$$::A voz dela ronrona com desejo bestial.[lr]::
34956::$$$message_0263_0120_0001$$$::Fácil felicidade, e uma falsa racionalidade sólida como poeira.::
34957::$$$message_0263_0121_0000$$$::"Você também deveria se quebrar. Só pense em Sakura. Se não sabe como, ficarei feliz em te ensinar."::
34958::$$$message_0263_0122_0000$$$::"É por isso que estou aqui."[lr]::
34959::$$$message_0263_0122_0001$$$::Meu corpo e alma estão sendo invadidos.[lr]::
34960::$$$message_0263_0122_0002$$$::Um vínculo opressor surge do vazio.[lr]::
34961::$$$message_0263_0122_0003$$$::É como se rédeas, arreios, estribos e ferraduras estivessem sendo fixados no meu corpo.::
34962::$$$message_0263_0123_0000$$$::As correntes não são pesadas.[lr]::
34963::$$$message_0263_0123_0001$$$::Eu posso correr. Meu corpo arde, cada célula quer correr, cada nervo está anestesiado e aceso. Vou parar de ser humano e me tornar uma fera que corre, percorrendo milhares de quilômetros em um piscar de olhos, perdido no paisagem voando e contra o vento.::
34964::$$$message_0263_0124_0000$$$::Já esqueci minha voz. Minha garganta se estica com relinchos e rugidos.[lr]::
34965::$$$message_0263_0124_0001$$$::Meus braços se tornam pernas dianteiras, minhas pernas se tornam pernas traseiras, minhas unhas se tornam cascos e meus cabelos se tornam um rabo.[lr]::
34966::$$$message_0263_0124_0002$$$::Minha pele suja sangue, meus músculos estalam em ação, acelerando-me.[lr]::
34967::$$$message_0263_0124_0003$$$::Perdi toda distinção de si mesmo.[sestop time=3000 nowait=1][se storage=se417.wav][fadein time=800 storage=white textoff=0][stopmove][lr]::
34968::$$$message_0263_0124_0004$$$::[ruby text=ベルレフォーン char=5]é a mão que segura[line len=3]!::
34969::$$$message_0263_0125_0000$$$::"Hrrr... aaaagh!!!"[lr]::
34970::$$$message_0263_0125_0001$$$::"Senpai... Aah!"[lr]::
34971::$$$message_0263_0125_0002$$$::Empurro a Sakura.::
34972::$$$message_0263_0126_0000$$$::"Mulher, mulher, mulher" ecoa na minha cabeça. Essa mulher está em cio. Ela é virgem e quer meu sêmen.::
34973::$$$message_0263_0127_0000$$$::"Cai, garoto. Hehe, que lindo bebê."[lr]::
34974::$$$message_0263_0127_0001$$$::Ela puxa meus estribos, me impedindo de saltar.[lr]::
34975::$$$message_0263_0127_0002$$$::Treino o pescoço, saliva quente escorrendo dos lábios.[lr]::
34976::$$$message_0263_0127_0003$$$::"Agora, Shirou... É hora de te quebrar. Vou te ensinar tudo o que há a saber sobre Sakura."::
34977::$$$message_0263_0128_0000$$$::"Não... Haah, Senpai..."[lr]::
34978::$$$message_0263_0128_0001$$$::Eu me inclino sobre Sakura de costas. Meu pênis invade sua vagina com um som úmido.[lr]::
34979::$$$message_0263_0128_0002$$$::A montaria me pisa nos estribos e a dor dos punhos faz minha costas inferior começar a tremer.::
34980::$$$message_0263_0129_0000$$$::"Sakura gosta de ser pega por trás assim."[lr]::
34981::$$$message_0263_0129_0001$$$::Rider pega meus rédeas, mostrando-me o ritmo certo.[lr]::
34982::$$$message_0263_0129_0002$$$::Avanço para dentro de Sakura. Curvada, ela já não me ameaça nem de brincadeira.::
34983::$$$message_0263_0130_0000$$$::"Aha... aah, ngh...!"[lr]::
34984::$$$message_0263_0130_0001$$$::"Veja como ela está balançando as nádegas, convidando você? Sincronize seus movimentos com a dela. Aí, assim."[lr]::
34985::$$$message_0263_0130_0002$$$::Adicionei um movimento de torção.[lr]::
34986::$$$message_0263_0130_0003$$$::Meu corpo é manipulado para se mover de maneiras que normalmente não conseguiria. Maior e mais forte, ele viola Sakura.::
34987::$$$message_0263_0131_0000$$$::"Lá, bom, recue e empurre."[lr]::
34988::$$$message_0263_0131_0001$$$::"Não, não, não lá, Senpai, stooop..."[lr]::
34989::$$$message_0263_0131_0002$$$::"Você não precisa parar. É isso que ela mais gosta."[lr]::
34990::$$$message_0263_0131_0003$$$::Eu puxo para trás e passo minha glande contra suas paredes vaginais.[lr]::
34991::$$$message_0263_0131_0004$$$::Ela gira os quadris sedutoramente. Seu mel escorre fora.[lr]::
34992::$$$message_0263_0131_0005$$$::Respiro pelo nariz, exalando quente pela garganta.::
34993::$$$message_0263_0132_0000$$$::"Assim, sim.[lr]::
34994::$$$message_0263_0132_0001$$$::Eu sabia que você conseguia. Por que não fez isso antes? Onde está sua coragem, Shirou?"[lr]::
34995::$$$message_0263_0132_0002$$$::"Eeeegh... aaah, yaaaaah!"[lr]::
34996::$$$message_0263_0132_0003$$$::"Continue a massage nela, e Sakura vai jorrar tudo em você. É hora de pagar a ela."::
34997::$$$message_0263_0133_0000$$$::Eu bato nos quadris sem ser solicitado.[lr]::
34998::$$$message_0263_0133_0001$$$::Movimento flexível, como se meus ossos estivessem deslocados, devorando Sakura do interior sem cessar. Empurro, arrasto e a faço sofrer.::
34999::$$$message_0263_0134_0000$$$::"Não, Senpai, eu não gosto... huaaaah!"[lr]::
35000::$$$message_0263_0134_0001$$$::"Ela não aguenta mais. Não é linda? Ela te convidou para fazer isso com ela desde o início."[lr]::
35001::$$$message_0263_0134_0002$$$::Minhas nádegas balançam, Palavras chicoteiam meus ouvidos.[lr]::
35002::$$$message_0263_0134_0003$$$::As sussurros doces de Sakura, e os comandos suaves de Rider.[lr]::
35003::$$$message_0263_0134_0004$$$::Dei um jato inesgotável, meu sêmen suplementado com sangue.::
35004::$$$message_0263_0135_0000$$$::"Aaaaaaahhh!"[lr]::
35005::$$$message_0263_0135_0001$$$::Líquido sujo escorre sobre suas coxas internas.[lr]::
35006::$$$message_0263_0135_0002$$$::A costas de Sakura treme repetidamente.[lr]::
35007::$$$message_0263_0135_0003$$$::Ela está deitada de costas, o cheiro do seu cabelo me incomodando a cabeça.::
35008::$$$message_0263_0136_0000$$$::"Ahhh. Senpai, você ainda vem para o meu...[lr]::
35009::$$$message_0263_0136_0001$$$::Aaaah..."[lr]::
35010::$$$message_0263_0136_0002$$$::"Sakura se sente melhor quando você joga sêmen nela enquanto ela está chegando. E..."[lr]::
35011::$$$message_0263_0136_0003$$$::Minhas patas dianteiras[line len=2]minhas mãos se movem.[lr]::
35012::$$$message_0263_0136_0004$$$::Eles se envolvem ao redor da sua cintura e tocam onde estamos conectados. Meus dedos tocam seus lábios molhados, desordenados e inchados clítoris.::
35013::$$$message_0263_0137_0000$$$::"Eeegh, [wait canskip=0 time=400]não, [wait canskip=0 time=100][shock vmax=10 hmax=-5 time=600 count=3]ow... Aaah!"[lr]::
35014::$$$message_0263_0137_0001$$$::"Veja? Sakura fica feliz quando você explora ela enquanto ela está desatenta assim. Bom menino."[lr]::
35015::$$$message_0263_0137_0002$$$::"Aaah, [wait canskip=0 time=200]Senpai, não, [wait canskip=0 time=400]você não pode, [wait canskip=0 time=400][shock vmax=10 hmax=-5 time=800 count=5]TAG3__hyaaaah!"[lr]::
35016::$$$message_0263_0137_0003$$$::Seu corpo macio se contorcesse. Tremores vindo de dentro e de fora sacudiam o corpo de Sakura.[lr]::
35017::$$$message_0263_0137_0004$$$::Eu passo meu queixo contra a costas dela, misturando meu suor com o dela.::
35018::$$$message_0263_0138_0000$$$::"Agh... Hah, Senpai, não..."[lr]::
35019::$$$message_0263_0138_0001$$$::"Hehehe. Sakura tenta esconder seu tremular ao chegar. É por isso..."[lr]::
35020::$$$message_0263_0138_0002$$$::"Haahn, [wait canskip=0 time=400][shock vmax=25 hmax=-10 time=500 count=-2]aah, [wait canskip=0 time=400][shock vmax=25 hmax=-10 time=500 count=-2]aahn, [wait canskip=0 time=400][shock vmax=30 hmax=-10 time=800 count=-4]aaaah!"::
35021::$$$message_0263_0139_0000$$$::"Heh. Veja, ela diz que não quer, mas está tão feliz em ter você, tão gulosa para engolir você, tanto no corpo quanto na mente. Ela está bêbada de prazer e não consegue se conter."[lr]::
35022::$$$message_0263_0139_0001$$$::Meus quadris colidem com força suficiente para fazer barulho.[lr]::
35023::$$$message_0263_0139_0002$$$::A bunda branca e pura de Sakura balança e vibra. O espaço entre seus quadris treme e arrepia-se molhado.::
35024::$$$message_0263_0140_0000$$$::"E, ainda assim, ela esconde o prazer com petulância.[lr]::
35025::$$$message_0263_0140_0001$$$::Shirou, por favor deixe que Sakura seja quem ela é hoje."::
35026::$$$message_0263_0141_0000$$$::Mas quem quer isso de verdade?[lr]::
35027::$$$message_0263_0141_0001$$$::Ouço uma voz através das rédeas.[lr]::
35028::$$$message_0263_0141_0002$$$::O mundo em movimento começa a desaparecer.[lr]::
35029::$$$message_0263_0141_0003$$$::Este eu é uma ilusão. É modelado após o meu eu passado e a alma de Sakura.::
35030::$$$message_0263_0142_0000$$$::"O que há de errado? Continue correndo, Shirou.[lr]::
35031::$$$message_0263_0142_0001$$$::Isso não vai satisfazer Sakura."[lr]::
35032::$$$message_0263_0142_0002$$$::...Eles anseiam pela mesma coisa.[lr]::
35033::$$$message_0263_0142_0003$$$::Escuto um coração batendo.[lr]::
35034::$$$message_0263_0142_0004$$$::Estou ligado a Bellerophon, e o coração da minha cavaleira ressoa com o meu.[lr]::
35035::$$$message_0263_0142_0005$$$::Este é um estado de espírito, uma fusão perfeita de cavaleira e montaria induzida por um Fantasma Nobre, e ela usou isso para me aprisionar.::
35036::$$$message_0263_0143_0000$$$::Mas ela não é permitida procurar pelo que ama.[lr]::
35037::$$$message_0263_0143_0001$$$::"Pare."[lr]::
35038::$$$message_0263_0143_0002$$$::"Shirou!?"[lr]::
35039::$$$message_0263_0143_0003$$$::O instante em que percebo que isso está errado, abro a caixa que contém minha mente racional.[lr]::
35040::$$$message_0263_0143_0004$$$::Isso tudo é um sonho.::
35041::$$$message_0263_0144_0000$$$::O sonho de Rider[line len=2]não, uma ilusão criada com seu Fantasma Nobre, Breaker Gorgon.[lr]::
35042::$$$message_0263_0144_0001$$$::Isso é tudo o que preciso saber.[lr]::
35043::$$$message_0263_0144_0002$$$::Não preciso pensar por que ela usou esse Campo Limitado em mim e, de todo modo, já estou preso nele.[lr]::
35044::$$$message_0263_0144_0003$$$::Tudo o que consigo captar são suas memórias de pesadelo[lr]::
35045::$$$message_0263_0144_0004$$$::que romperam este Campo Limitado.::
35046::$$$message_0263_0145_0000$$$::Ideias distantes e antigas queimam meus pensamentos, mas a dor é temporária.[lr]::
35047::$$$message_0263_0145_0001$$$::"Ngh! Não, pare, Shirou!"[lr]::
35048::$$$message_0263_0145_0002$$$::A Projecção é fácil.[lr]::
35049::$$$message_0263_0145_0003$$$::Isso não é realidade, mas sua mente. Como não existe de verdade, não é fácil ler ou reescrevê-la.::
35050::$$$message_0263_0146_0000$$$::Viro a sacola Kibisis do avesso.[lr]::
35051::$$$message_0263_0146_0001$$$::Se Breaker Gorgon suga pessoas do lado de fora para dentro dele,[lr]::
35052::$$$message_0263_0146_0002$$$::Então a bolsa da deusa reflete o interior para o exterior.[lr]::
35053::$$$message_0263_0146_0003$$$::Inverto novamente o interior da Górgona, recriando o mito do Fantasma Nobre capaz de inverter um Campo Limitado.[lr]::
35054::$$$message_0263_0146_0004$$$::"...!"[lr]::
35055::$$$message_0263_0146_0005$$$::Estou envolvido pela corrupção do sonho, junto com seu grito silencioso.::
35056::$$$message_0263_0147_0000$$$::"Ah... ngh."[lr]::
35057::$$$message_0263_0147_0001$$$::Estou de volta a esse mundo.[lr]::
35058::$$$message_0263_0147_0002$$$::Estou segurando a Rider, não a Sakura. Suas nádegas lisas e cabelo brilhante deslizam pelo seu corpo.::
35059::$$$message_0263_0148_0000$$$::"Shirou... [wait canskip=0 time=200]Aah!?"[lr]::
35060::$$$message_0263_0148_0001$$$::Recupero minha vontade, após ver Rider montada em cima de mim em um estado de embriaguez.[lr]::
35061::$$$message_0263_0148_0002$$$::"Por que estou aqui... [wait canskip=0 time=400][dash mx=0 opacity=255 layer=base irot=-0.0 cx=377 imag=3.3 time=300 cy=42 mag=2.9 my=0 storage=fd_ライダー桜h08c rot=-0.0 accel=0][wdash canskip=0][se storage=se288.wav][shock vmax=20 time=300 count=2] Ugh!"[lr]::
35062::$$$message_0263_0148_0003$$$::Diabo se sabe.[lr]::
35063::$$$message_0263_0148_0004$$$::Ela foi quem me transformou em um boneco no início.::
35064::$$$message_0263_0149_0000$$$::"Para, Shirou... Kuh!"[lr]::
35065::$$$message_0263_0149_0001$$$::Rider tenta colocar força nos membros, mas não tem força suficiente para movê-los na realidade.[lr]::
35066::$$$message_0263_0149_0002$$$::Aqui, seus Olhos Místicos e Força Monstruosa estão selados.[lr]::
35067::$$$message_0263_0149_0003$$$::Breaker Gorgon nos capturou a ambos.::
35068::$$$message_0263_0150_0000$$$::"Ah... Não... Não pode ser..."[lr]::
35069::$$$message_0263_0150_0001$$$::Suavemente, abraço a Rider e a deixo cair.[lr]::
35070::$$$message_0263_0150_0002$$$::Sente-se tão bem dentro dela também que, por um momento, sinto prazer semelhante à náusea.[lr]::
35071::$$$message_0263_0150_0003$$$::Eu puxo meu pênis e passo a ponta coberta de mel contra sua vulva.::
35072::$$$message_0263_0151_0000$$$::"Heegh... Aahh, haah...!"[lr]::
35073::$$$message_0263_0151_0001$$$::Com meus glândulas, eu passo contra suas dobras, assim como Sakura fez comigo.[lr]::
35074::$$$message_0263_0151_0002$$$::Seu lugar secreto onde ela sente prazer, escorrendo líquidos claros de amor. Seu traseiro está tremendo e sacudindo.::
35075::$$$message_0263_0152_0000$$$::"Isso não pode... aah... Shirou... ngh..."[lr]::
35076::$$$message_0263_0152_0001$$$::Meu prepócio se enterra pela metade na sua fenda.[lr]::
35077::$$$message_0263_0152_0002$$$::Eu sinto seu tremor enquanto ela se contorce, molhada com néctar que jorra.[lr]::
35078::$$$message_0263_0152_0003$$$::...Movendo vagamente os quadris para alguém.[lr]::
35079::$$$message_0263_0152_0004$$$::Sou movido pelo prazer, mas a mantenho por um sentimento igualmente quente.::
35080::$$$message_0263_0153_0000$$$::"Haaah... Você [wait canskip=0 time=100]não pode... Eu, [wait canskip=0 time=100]eu [wait canskip=0 time=100]não deveria..."[lr]::
35081::$$$message_0263_0153_0001$$$::Ela não está recusando-me por si mesma.[lr]::
35082::$$$message_0263_0153_0002$$$::Eu suavemente passo o dedo pelo topo do clitóris dela.[lr]::
35083::$$$message_0263_0153_0003$$$::O nub sensível está encaixado entre seus ossos púbicos.::
35084::$$$message_0263_0154_0000$$$::"Heeegh, [wait canskip=0 time=300]aaah..."[lr]::
35085::$$$message_0263_0154_0001$$$::Ela arqueia a costas e o cabelo dança.[lr]::
35086::$$$message_0263_0154_0002$$$::Os óculos dela quase caem, mas os olhos melancólicos de Rider ainda me encaram.::
35087::$$$message_0263_0155_0000$$$::"Shirou, [wait canskip=0 time=300]no, [wait canskip=0 time=100]você não pode, [line len=3]estou [wait canskip=0 time=100]não [wait canskip=0 time=200]Sakura..."[lr]::
35088::$$$message_0263_0155_0001$$$::Ela não parece mais Sakura.[lr]::
35089::$$$message_0263_0155_0002$$$::Ela está no limite das lágrimas.[lr]::
35090::$$$message_0263_0155_0003$$$::Paro de falar e seguro seus nacos brancos redondos.[lr]::
35091::$$$message_0263_0155_0004$$$::Guia minha masculinidade para sua vulva, e a entrada macia é convidativa.::
35092::$$$message_0263_0156_0000$$$::"Hah, ngh, aah...!"[lr]::
35093::$$$message_0263_0156_0001$$$::Eu abraço a Rider e a atravesso.[lr]::
35094::$$$message_0263_0156_0002$$$::Eu sinto as paredes vaginais que não são muito apertadas nem muito macias. O sêmen acumula-se no meu escroto inchado, esperando para ser expulso.::
35095::$$$message_0263_0157_0000$$$::"Aaaah, kuah... Haaah!"[lr]::
35096::$$$message_0263_0157_0001$$$::Rider levanta a cabeça.[lr]::
35097::$$$message_0263_0157_0002$$$::Suas paredes vaginais se movem, úmidas, para me envolver, e meus quadris sentem um prazer que faz a nuca latejar.[lr]::
35098::$$$message_0263_0157_0003$$$::Levo os quadris para cima, empurrando-a do lado de baixo.::
35099::$$$message_0263_0158_0000$$$::"Haah, [wait canskip=0 time=200]aah, [wait canskip=0 time=200]aaah, [wait canskip=0 time=200]kuaaah!"[lr]::
35100::$$$message_0263_0158_0001$$$::Não posso esperar uma dança de quadris desenfreada de Sakura da Rider.[lr]::
35101::$$$message_0263_0158_0002$$$::...Mas está tudo bem. Se ela se mover ainda mais depois de apertar assim, não vou conseguir aguentar.[lr]::
35102::$$$message_0263_0158_0003$$$::Eu empurro para cima entre suas coxas, e seus quadris balançam.[lr]::
35103::$$$message_0263_0158_0004$$$::Rider balança os quadris, revelando as depressões de suas nádegas. Seu cabelo roxo balança como uma crina.::
35104::$$$message_0263_0159_0000$$$::"Ngh, [wait canskip=0 time=200]aah... Shirou, [wait canskip=0 time=200]para de fazer isso...[lr]::
35105::$$$message_0263_0159_0001$$$::Você deveria fazer isso com... [wait canskip=0 time=200]mim... não eu... [wait canskip=0 time=200]Quero dizer, Sakura...[lr]::
35106::$$$message_0263_0159_0002$$$::Não consigo ouvir suas súplicas misturadas aos seus ofegos.[lr]::
35107::$$$message_0263_0159_0003$$$::Ela está falando de si mesma.[lr]::
35108::$$$message_0263_0159_0004$$$::Sofregamente escondendo o que deseja, por assim dizer.::
35109::$$$message_0263_0160_0000$$$::"Nngh...! [wait canskip=0 time=200] Ahaa![wait canskip=0 time=200] Aah!"[lr]::
35110::$$$message_0263_0160_0001$$$::Como com Sakura, paro em um ponto específico da parede vaginal dela.[lr]::
35111::$$$message_0263_0160_0002$$$::Uso a parte de trás do meu prepúcio para rolar contra ela em vez de empurrar até o fim.[line len=2]uma técnica que ela me ensinou.::
35112::$$$message_0263_0161_0000$$$::"Não...[lr]::
35113::$$$message_0263_0161_0001$$$::Shirou, [wait canskip=0 time=200]Estou...[lr]::
35114::$$$message_0263_0161_0002$$$::Aah, [wait canskip=0 time=200]nngh, [wait canskip=0 time=200]haaah!"[lr]::
35115::$$$message_0263_0161_0003$$$::Mesmo que eu esteja liderando, o prazer que ressoa em meus genitais não é normal.[lr]::
35116::$$$message_0263_0161_0004$$$::O interior ferve com sangue.[lr]::
35117::$$$message_0263_0161_0005$$$::Eu sinto que posso continuar torturando essas magníficas pernas infinitamente, mesmo sem rédeas ou estribo para me guiar.::
35118::$$$message_0263_0162_0000$$$::"Não, não assim, aaah, aaaah!"[lr]::
35119::$$$message_0263_0162_0001$$$::Os gemidos da Rider param de sair como palavras.[lr]::
35120::$$$message_0263_0162_0002$$$::Minha nuca e costas tremem, e minhas coxas se contraem, repetidamente. Quando eu seguro seus quadris e pressiono contra ela, um tremor percorre meu estômago.::
35121::$$$message_0263_0163_0000$$$::"Ah... Aaaah..."[lr]::
35122::$$$message_0263_0163_0001$$$::Rider parece triste.[lr]::
35123::$$$message_0263_0163_0002$$$::Uma gota de água morna escorre entre nossos corpos. O líquido inodoro molha-me intermitentemente.[lr]::
35124::$$$message_0263_0163_0003$$$::Ignoro a umidez e inicio meus exercícios profundos.[lr]::
35125::$$$message_0263_0163_0004$$$::A sensação de aperto e engolir é tão intensa que ejaculo dentro de Rider.::
35126::$$$message_0263_0164_0000$$$::"Heegh... Eegh...ah..."[lr]::
35127::$$$message_0263_0164_0001$$$::Os lábios da Rider tremem.[lr]::
35128::$$$message_0263_0164_0002$$$::Climaxo, jato meu desejo quente bem dentro. Fico duro mesmo depois disso e sinto vontade de abraçá-la.::
35129::$$$message_0263_0165_0000$$$::"Aaaah, [wait canskip=0 time=200]urgh, [wait canskip=0 time=200]haah... kuh, [wait canskip=0 time=200]aaah, [wait canskip=0 time=200]haah...!"[lr]::
35130::$$$message_0263_0165_0001$$$::O corpo da Rider salta para cima, como se estivesse prestes a escapar.[lr]::
35131::$$$message_0263_0165_0002$$$::Mas ela ainda está montada em mim, amarrada nos meus estribos.[lr]::
35132::$$$message_0263_0165_0003$$$::Ela é a que disse que gosta de ser observada de costas.::
35133::$$$message_0263_0166_0000$$$::"Heegh, [wait canskip=0 time=200]Shirou, [wait canskip=0 time=200]você é tão bruto...[lr]::
35134::$$$message_0263_0166_0001$$$::Você é duro dentro de mim, não, [wait canskip=0 time=200]haaah..."[lr]::
35135::$$$message_0263_0166_0002$$$::Eu alcanço e passo minhas mãos por sua pele branca balançando, do quadril até os lados, do cotovelo até o peito...[lr]::
35136::$$$message_0263_0166_0003$$$::...Ah, ela me disse para explorar um pouco o seu corpo quando ela estiver em um estado de tontura.::
35137::$$$message_0263_0167_0000$$$::"Aah, hegh, haah... Aah, mm..."[lr]::
35138::$$$message_0263_0167_0001$$$::Eu uso meus dedos para brincar com seus seios voluptuosos.[lr]::
35139::$$$message_0263_0167_0002$$$::Eu aperto seus seios, sacudindo e fazendo com que ela balance, de trás. Eu aperto e espremo seus mamilos, fazendo com que seu corpo se tensione.::
35140::$$$message_0263_0168_0000$$$::"Aaahn, [wait canskip=0 time=200]mm, [wait canskip=0 time=200]haah, [wait canskip=0 time=200]kyaah, ah..."[lr]::
35141::$$$message_0263_0168_0001$$$::Ela parece prestes a cair várias vezes, mas é levantada pelas rédeas.[lr]::
35142::$$$message_0263_0168_0002$$$::Como uma bela fêmea fera.[lr]::
35143::$$$message_0263_0168_0003$$$::Sempre em busca de prazer, ela me busca, e eu lhe concedo.[lr]::
35144::$$$message_0263_0168_0004$$$::Eu sinto outro coração se formando entre nossas costelas, espalhando sêmen, não sangue.::
35145::$$$message_0263_0169_0000$$$::"Heegh... kyah, [wait canskip=0 time=200]augh... [wait canskip=0 time=200]Mmm!"[lr]::
35146::$$$message_0263_0169_0001$$$::Eu me movo com força enquanto ejaculo. Rider balança a cabeça de vergonha ao chegar ao orgasmo, mas continuo avançando, querendo ir além da vagina ou do útero, até seus órgãos.::
35147::$$$message_0263_0170_0000$$$::"Aaaah, [wait canskip=0 time=200] aha... ahh, [wait canskip=0 time=200] uagh, [wait canskip=0 time=200] yaaah..."[lr]::
35148::$$$message_0263_0170_0001$$$::Chegamos de verdade a um ponto de clímax infinito, repetitivo.[lr]::
35149::$$$message_0263_0170_0002$$$::Às vezes distraio ela tocando seus genitais ou pescoço.[lr]::
35150::$$$message_0263_0170_0003$$$::Meu pulso dispara em descompasso, e meus quadris estão molhados por um líquido que poderia ser de qualquer um de nós.::
35151::$$$message_0263_0171_0000$$$::O som molhado, úmido e obsceno se repete.[lr]::
35152::$$$message_0263_0171_0001$$$::Quantas vezes orgasmei?[lr]::
35153::$$$message_0263_0171_0002$$$::Ela arqueia especialmente alto nessa vez.[lr]::
35154::$$$message_0263_0171_0003$$$::Seu cabelo roxo dança no ar.::
35155::$$$message_0263_0172_0000$$$::"Hah...ah..."[lr]::
35156::$$$message_0263_0172_0001$$$::Que sensação misteriosa. Não sei quantas vezes meu corpo atingiu o clímax, mas minha mente nunca chegou a isso.[lr]::
35157::$$$message_0263_0172_0002$$$::Quero saber algo, enquanto a segurou assim.::
35158::$$$message_0263_0173_0000$$$::"Ah... haaa... Ah, ha..."[lr]::
35159::$$$message_0263_0173_0001$$$::Ela se move lentamente sobre meus quadris.[lr]::
35160::$$$message_0263_0173_0002$$$::Seu corpo está quente. Quase vejo vapor subir dele.[lr]::
35161::$$$message_0263_0173_0003$$$::Ela aperta ritmicamente, mas de alguma forma, falta algo.::
35162::$$$message_0263_0174_0000$$$::"..."[lr]::
35163::$$$message_0263_0174_0001$$$::Do lado de trás, observo-a enquanto ela senta-se em cima de mim.[lr]::
35164::$$$message_0263_0174_0002$$$::Seu corpo está flácido e mole. Quando movo os quadris, ela balança com a mesma amplitude.::
35165::$$$message_0263_0175_0000$$$::"Mm... "P[lr]::
35166::$$$message_0263_0175_0001$$$::O barulho da sua narina é fraco e suave.[lr]::
35167::$$$message_0263_0175_0002$$$::Não há mais uma linha clara e única correndo pela sua costela.::
35168::$$$message_0263_0176_0000$$$::Empurro minhas nádegas para cima e balanço ela.[lr]::
35169::$$$message_0263_0176_0001$$$::Seu corpo balança para cima. Ela é calma, não completamente passiva, mas também não expressa sua antecipação.[lr]::
35170::$$$message_0263_0176_0002$$$::Como uma criança, encarando um presente.::
35171::$$$message_0263_0177_0000$$$::"Hmm... hmm... hmm..."[lr]::
35172::$$$message_0263_0177_0001$$$::Ela começa a se enroscar e balançar os quadris.[lr]::
35173::$$$message_0263_0177_0002$$$::É melancólico e sedutoramente convidativo.[lr]::
35174::$$$message_0263_0177_0003$$$::Não consigo ficar sentado. Estou tão quente por dentro dela que não consigo conter.::
35175::$$$message_0263_0178_0000$$$::"Ah...mm...mmgh..."[lr]::
35176::$$$message_0263_0178_0001$$$::Isso é prazer de um tipo diferente.[lr]::
35177::$$$message_0263_0178_0002$$$::Em vez de dançar com um corpo animado, aprecio sua forma habilidosa e madura.::
35178::$$$message_0263_0179_0000$$$::...Ela não está sendo sincera.[lr]::
35179::$$$message_0263_0179_0001$$$::Ela ainda tenta esconder o que sente de verdade.::
35180::$$$message_0263_0180_0000$$$::"Não, [wait canskip=0 time=200]não sou... assim, [wait canskip=0 time=200]isso está errado..."[lr]::
35181::$$$message_0263_0180_0001$$$::Ela repete as negações.[lr]::
35182::$$$message_0263_0180_0002$$$::Ela continua chorando, como se estivesse voltando à infância.::
35183::$$$message_0263_0181_0000$$$::"Não... não... Eu, eu... mm..."[lr]::
35184::$$$message_0263_0181_0001$$$::O vento sopra, fazendo o véu dançar.[lr]::
35185::$$$message_0263_0181_0002$$$::Não é um vento suave.[lr]::
35186::$$$message_0263_0181_0003$$$::"Rider? Senpai?"[lr]::
35187::$$$message_0263_0181_0004$$$::Uma voz suave e quente. É nostálgica e acalma meus ouvidos.::
35188::$$$message_0263_0182_0000$$$::"Você veio, Senpai."[lr]::
35189::$$$message_0263_0182_0001$$$::Sakura me beija em saudação.[lr]::
35190::$$$message_0263_0182_0002$$$::Ela sorri e projeta a língua.::
35191::$$$message_0263_0183_0000$$$::"Sakura, por que... O que você está fazendo aqui?[lr]::
35192::$$$message_0263_0183_0001$$$::"Bem, você não seria honesto.[lr]::
35193::$$$message_0263_0183_0002$$$::e aceite o Senpai...[lr]::
35194::$$$message_0263_0183_0003$$$::Então eu decidi que precisava ajudar."[lr]::
35195::$$$message_0263_0183_0004$$$::Sakura sorri.[lr]::
35196::$$$message_0263_0183_0005$$$::Não é só um sorriso gentil; nele ainda resta a lascívia de antes.::
35197::$$$message_0263_0184_0000$$$::"Hmm.[lr]::
35198::$$$message_0263_0184_0001$$$::Você ficou tão incerto assim?[lr]::
35199::$$$message_0263_0184_0002$$$::de ti mesmo que não conseguia[lr]::
35200::$$$message_0263_0184_0003$$$::Diga seus sentimentos verdadeiros. Então eu ensinarei.[lr]::
35201::$$$message_0263_0184_0004$$$::Ele falou sobre você, no seu lugar."[lr]::
35202::$$$message_0263_0184_0005$$$::Ela resiste ao encanto, lábios vazios.::
35203::$$$message_0263_0185_0000$$$::"Sakura... pare..."[lr]::
35204::$$$message_0263_0185_0001$$$::"Não se preocupe. O Senpai é forte e gentil. Agora... vamos deixar você à vontade, Rider."[lr]::
35205::$$$message_0263_0185_0002$$$::Sakura ri de modo sugestivo.[lr]::
35206::$$$message_0263_0185_0003$$$::Ela pressiona suavemente os seios contra meu peito.[lr]::
35207::$$$message_0263_0185_0004$$$::Ela riu em voz baixa, e nós nos lambemos os lábios, um ao outro. Fragrantemente, Sakura começa a falar.::
35208::$$$message_0263_0186_0000$$$::"Sabe, Senpai? [lr]::
35209::$$$message_0263_0186_0001$$$::Rider ama você de verdade., Senpai"[lr]::
35210::$$$message_0263_0186_0002$$$::...Ela ressoa fortemente com Sakura.[lr]::
35211::$$$message_0263_0186_0003$$$::Sabia ou não sabia? Ou fingi não saber?::
35212::$$$message_0263_0187_0000$$$::"Mas com respeito por mim...[lr]::
35213::$$$message_0263_0187_0001$$$::Ela mostrou a você aquele sonho[lr]::
35214::$$$message_0263_0187_0002$$$::Então odiou a si mesma e tentou esquecê-lo.[lr]::
35215::$$$message_0263_0187_0003$$$::Ela só não consegue ser honesta consigo mesma."[lr]::
35216::$$$message_0263_0187_0004$$$::Os membros da Rider começam a tremer.::
35217::$$$message_0263_0188_0000$$$::"Às vezes, a Rider pergunta sobre[lr]::
35218::$$$message_0263_0188_0001$$$::Senpai, Você, você sabe.[lr]Senpai, ::
35219::$$$message_0263_0188_0002$$$::Quando estivermos sozinhos, ela vai[lr]::
35220::$$$message_0263_0188_0003$$$::E aí, o que você tá fazendo?[lr]::
35221::$$$message_0263_0188_0004$$$::até..."[lr]::
35222::$$$message_0263_0188_0005$$$::"Não..."::
35223::$$$message_0263_0189_0000$$$::"Ela quer sair com você em um encontro secreto sem me contar, você sabe. Ela se pergunta se vestir roupas fofas faria você feliz, e passa a olhar catálogos de moda sozinha, escolhendo seus próprios acessórios, Senpai."::
35224::$$$message_0263_0190_0000$$$::"Ela gosta de você tanto que não aguentou mais. Depois de tudo, ela só fez isso com você..."[lr]::
35225::$$$message_0263_0190_0001$$$::Nossas línguas úmidas se entrelaçam. Saliva escorre até meus lábios.::
35226::$$$message_0263_0191_0000$$$::"Essa alegria faz Rider se sentir humilhadamente, infinitamente feliz."[lr]::
35227::$$$message_0263_0191_0001$$$::Palavras e o gosto do desejo ameaçam derreter meu cérebro.::
35228::$$$message_0263_0192_0000$$$::"Para... Para, por favor, Sakura..."[lr]::
35229::$$$message_0263_0192_0001$$$::"Você entendeu, né? Que sonho obsceno foi obra de Rider. Você sabe por que ela fez isso?"[lr]::
35230::$$$message_0263_0192_0002$$$::"Para, por favor... [wait canskip=0 time=200]Sakuraa..."::
35231::$$$message_0263_0193_0000$$$::A voz da Rider sobe para um grito.[lr]::
35232::$$$message_0263_0193_0001$$$::Estou prestes a dizer "isso é suficiente", quando meus lábios são selados.[lr]::
35233::$$$message_0263_0193_0002$$$::Os olhos de Sakura sorriem encantadoramente. Rider olha para nós, no limite das lágrimas.[lr]::
35234::$$$message_0263_0193_0003$$$::...Isso acende meu desejo.[lr]::
35235::$$$message_0263_0193_0004$$$::Meu membro conectado começa a pulsar forte.::
35236::$$$message_0263_0194_0000$$$::"...Senpai?"[lr]::
35237::$$$message_0263_0194_0001$$$::"Pare..."::
35238::$$$message_0263_0195_0000$$$::"Ah, Rider. Ela tem bebido seu sangue, você sabe, Senpai."::
35239::$$$message_0263_0196_0000$$$::Rider balança a cabeça, como se não quisesse que eu soubesse.[lr]::
35240::$$$message_0263_0196_0001$$$::Sua vagina conectada grita com urgência.::
35241::$$$message_0263_0197_0000$$$::"Você é tão obsceno, Rider.[lr]::
35242::$$$message_0263_0197_0001$$$::Não acredito que você mostrou ao Senpai sonhos sujos[lr]::
35243::$$$message_0263_0197_0002$$$::Senpai, Enquanto você bebia seu sangue."[lr]Senpai, ::
35244::$$$message_0263_0197_0003$$$::"Para, [wait canskip=0 time=200]estou suplicando, Sakura, [wait canskip=0 time=200]pare... isso...!"::
35245::$$$message_0263_0198_0000$$$::Lágrimas escorrem de seus olhos.[lr]::
35246::$$$message_0263_0198_0001$$$::Ela deve estar envergonhada por ter sua feiura exposta.[lr]::
35247::$$$message_0263_0198_0002$$$::Mas mesmo Sakura é só sua sombra agora, culpando-a assim.[lr]::
35248::$$$message_0263_0198_0003$$$::Negação e culpa estão entrelaçadas em sua mente.::
35249::$$$message_0263_0199_0000$$$::"Você sabia disso?[lr]::
35250::$$$message_0263_0199_0001$$$::Rider fica extremamente excitada quando[lr]::
35251::$$$message_0263_0199_0002$$$::Ela bebe sangue. Não consegue engolir tudo, então[lr]::
35252::$$$message_0263_0199_0003$$$::Ela tem guardado seu sangue na boca, Senpai."::
35253::$$$message_0263_0200_0000$$$::"Para."[lr]::
35254::$$$message_0263_0200_0001$$$::"Ela continua rolando na língua e o rosto dela só derrete...[lr]::
35255::$$$message_0263_0200_0002$$$::Não é fofo? Espero que você possa usá-lo, Senpai."::
35256::$$$message_0263_0201_0000$$$::Começo a me mover dentro da Rider.[lr]::
35257::$$$message_0263_0201_0001$$$::Impulsionado por Sakura, movo-me para me distrair.::
35258::$$$message_0263_0202_0000$$$::"Ela vai fazer o que depois, Senpai?"[lr]::
35259::$$$message_0263_0202_0001$$$::"Para, Sakura... Isso é suficiente."::
35260::$$$message_0263_0203_0000$$$::"Hehe. Ela fica excitada, e então...[lr]::
35261::$$$message_0263_0203_0001$$$::Ela começa a se masturbar.[lr]::
35262::$$$message_0263_0203_0002$$$::Senpai, Ela não consegue segurar quando está embriagada do seu sangue."::
35263::$$$message_0263_0204_0000$$$::Meu sangue pulsa atrás das orelhas.[lr]::
35264::$$$message_0263_0204_0001$$$::Ela se masturba. Sinto meu corpo esquentar no abraço de Sakura.::
35265::$$$message_0263_0205_0000$$$::"Não, não... não..."::
35266::$$$message_0263_0206_0000$$$::"Senpai, Ela deixa seu sangue escorrer pelos lábios, depois o lêva novamente.[lr]Senpai, ::
35267::$$$message_0263_0206_0001$$$::Ela deixa que escorra sobre seus dedos, e depois as coxas internas[lr]::
35268::$$$message_0263_0206_0002$$$::dos seus jeans apertados. Ela até deixa que chegue até suas calças..."::
35269::$$$message_0263_0207_0000$$$::Sakura estende a mão e guia a dela para trás das pernas de Rider.[lr]::
35270::$$$message_0263_0207_0001$$$::Seus dedos se arrastam para o local secreto de Rider e o abrem.::
35271::$$$message_0263_0208_0000$$$::"Mm, [wait canskip=0 time=00]aaaugh, aaah!"[lr]::
35272::$$$message_0263_0208_0001$$$::"Senpai, Ela passa os dedos molhados com seu sangue pelo clitóris úmido. Assim."[lr]Senpai, ::
35273::$$$message_0263_0208_0002$$$::Ela faz sons molhados com a mão para que eu possa ouvir.::
35274::$$$message_0263_0209_0000$$$::"Ela faz um caos assim e depois vem. Não é um pervertido, Senpai?"[lr]::
35275::$$$message_0263_0209_0001$$$::"Para, por favor... pare... estou suplicando..."::
35276::$$$message_0263_0210_0000$$$::Ela suplica, suas lágrimas escorrendo.[lr]::
35277::$$$message_0263_0210_0001$$$::Enquanto isso, eu a penetro, e Sakura acaricia seu corpo lúcido, tremulando. Seu aroma se espalha no ar.::
35278::$$$message_0263_0211_0000$$$::"Ela fica excitada ouvindo sua voz do corredor,, Senpai[lr]::
35279::$$$message_0263_0211_0001$$$::e toca-se a si mesma ali."[lr]::
35280::$$$message_0263_0211_0002$$$::"Não, não..."[lr]::
35281::$$$message_0263_0211_0003$$$::"Senpai, Ela se arrasta para sua cama e brinca com a si mesma lá..."[lr]Senpai, ::
35282::$$$message_0263_0211_0004$$$::"Eu disse que não!"[lr]::
35283::$$$message_0263_0211_0005$$$::"Ela quer você, Senpai, mas mantém isso para si, sussurrando: "Quero você também, Shirou."::
35284::$$$message_0263_0212_0000$$$::Ela diz meu nome com um outro acento.[lr]::
35285::$$$message_0263_0212_0001$$$::Tem um som encantador, como se contivesse sentimentos que ela não consegue conter.::
35286::$$$message_0263_0213_0000$$$::"Para, por favor. Isso não é verdade.[lr]::
35287::$$$message_0263_0213_0001$$$::Eu não...[lr]::
35288::$$$message_0263_0213_0002$$$::Não posso amar como as pessoas comuns fazem."[lr]::
35289::$$$message_0263_0213_0003$$$::Rider soluçou.[lr]::
35290::$$$message_0263_0213_0004$$$::Ela se move, seu coração e corpo a minha mercê.[lr]::
35291::$$$message_0263_0213_0005$$$::Quando vejo isso...[lr]::
35292::$$$message_0263_0213_0006$$$::Minha racionalidade selada acha isso lindo.::
35293::$$$message_0263_0214_0000$$$::"Ela chama seu nome quando está sozinha...[lr]::
35294::$$$message_0263_0214_0001$$$::Mesmo quando você diz para ela não dizer assim,[lr]::
35295::$$$message_0263_0214_0002$$$::Ela sussurra para si mesma.[lr]::
35296::$$$message_0263_0214_0003$$$::Você é tão lindo, Rider."::
35297::$$$message_0263_0215_0000$$$::"Não sou bonita. Sou miserável e impropria. Odiar-me por isso, pare,[lr]::
35298::$$$message_0263_0215_0001$$$::Uma mulher como eu só vai te desapontar.[lr]::
35299::$$$message_0263_0215_0002$$$::Vocês vão se decepcionar comigo."::
35300::$$$message_0263_0216_0000$$$::"Quem?[lr]::
35301::$$$message_0263_0216_0001$$$::De quem você tem medo de desapontar, Rider?[lr]::
35302::$$$message_0263_0216_0002$$$::Você ainda está dizendo isso diante de nós, depois que todos os mentiras foram reveladas?[lr]::
35303::$$$message_0263_0216_0003$$$::"Ah..."[lr]::
35304::$$$message_0263_0216_0004$$$::Sakura sorri gentilmente, apertando os lábios.[lr]::
35305::$$$message_0263_0216_0005$$$::Mesmo que esta Sakura seja só uma imagem, o sorriso é autêntico.::
35306::$$$message_0263_0217_0000$$$::"Essa é a Rider, então por favor[lr]::
35307::$$$message_0263_0217_0001$$$::Seja gentil com ela.[lr]::
35308::$$$message_0263_0217_0002$$$::É um pedido pessoal meu.[lr]::
35309::$$$message_0263_0217_0003$$$::Você precisa fazer a gente dois felizes."[lr]::
35310::$$$message_0263_0217_0004$$$::Concordo, mesmo que não consiga pensar.[lr]::
35311::$$$message_0263_0217_0005$$$::A desejabilidade, por mais indecente que seja, surge primeiro do amor.::
35312::$$$message_0263_0218_0000$$$::"Hehe. Você é maravilhoso mesmo, Senpai.[lr]::
35313::$$$message_0263_0218_0001$$$::Por favor, cuide de Rider. Não sou suficiente para fazê-la feliz."::
35314::$$$message_0263_0219_0000$$$::"...Ugh...aah..."[lr]::
35315::$$$message_0263_0219_0001$$$::Ela está chorando.[lr]::
35316::$$$message_0263_0219_0002$$$::Ela se esforça com emoção, e seus ombros tremem sob os cabelos.::
35317::$$$message_0263_0220_0000$$$::Sinto seu calor através da nossa conexão.[lr]::
35318::$$$message_0263_0220_0001$$$::Não queima, não incha nem dói.[lr]::
35319::$$$message_0263_0220_0002$$$::Abraça-me suavemente, batendo com calor.[lr]::
35320::$$$message_0263_0220_0003$$$::É uma sensação de plenitude, diferente de todos os estremecimentos e ejaculações.::
35321::$$$message_0263_0221_0000$$$::"...Você me perdoará?"[lr]::
35322::$$$message_0263_0221_0001$$$::Lágrimas escorrem pelo rosto dela.[lr]::
35323::$$$message_0263_0221_0002$$$::Eu nem sei o que ela fez de errado.::
35324::$$$message_0263_0222_0000$$$::"Não... [wait canskip=0 time=400]Esse é o jeito certo de dizer seu nome:[wait canskip=0 time=600][lr]::
35325::$$$message_0263_0222_0001$$$::[font italic=true]Shirou[font italic=false]."[lr]::
35326::$$$message_0263_0222_0002$$$::Eu me agarro aos membros macios da Rider.[lr]::
35327::$$$message_0263_0222_0003$$$::Começo a me mover em resposta ao desejo em sua voz.::
35328::$$$message_0263_0223_0000$$$::"Shirou, aaah..."::
35329::$$$message_0263_0224_0000$$$::A minha consciência vaga se transforma em um cenário de sonhos sustentado por uma febre.[lr]::
35330::$$$message_0263_0224_0001$$$::Este é o corpo de uma deusa, que mãos mortais não deveriam tocar.[lr]::
35331::$$$message_0263_0224_0002$$$::Acolhemos seres que devemos amar, mesmo que sejam malditos ou proibidos.::
35332::$$$message_0263_0225_0000$$$::"Mm, aah... Haah... Ah..."[lr]::
35333::$$$message_0263_0225_0001$$$::Ela está começando a se relaxar. Não estamos mais segurando um ao outro por qualquer rédea.[lr]::
35334::$$$message_0263_0225_0002$$$::Suavemente, seu corpo começa a se mover como ondas que beijam a areia ou uma brisa que envolve. Escuto os ecos primordiais distantes que nossos corpos lembram.::
35335::$$$message_0263_0226_0000$$$::"Aaaah... Haah... aah..."[lr]::
35336::$$$message_0263_0226_0001$$$::Só estar dentro dela é um sentimento confortante que parece esgotar toda a minha força.[lr]::
35337::$$$message_0263_0226_0002$$$::Ela não esconde mais seus sentimentos e balança o corpo em aceitação.::
35338::$$$message_0263_0227_0000$$$::Sinto a alegria de ser abraçado pela Terra Mãe.[lr]::
35339::$$$message_0263_0227_0001$$$::Quero mergulhar em seu corpo e afundar em ela, buscando memórias de um mundo fértil que lembro ao nível celular.::
35340::$$$message_0263_0228_0000$$$::"...Hmm...haah... Aaah...mgh."[lr]::
35341::$$$message_0263_0228_0001$$$::A costas, quadris, braços, coxas e belamente alinhados dedos dos pés da Rider são incrivelmente nostálgicos e lindos.::
35342::$$$message_0263_0229_0000$$$::"Shirou...[lr]::
35343::$$$message_0263_0229_0001$$$::Por que você está chorando..."[lr]::
35344::$$$message_0263_0229_0002$$$::Não sei como responder à sua pergunta.[lr]::
35345::$$$message_0263_0229_0003$$$::Eu nem sabia que estava chorando.[lr]::
35346::$$$message_0263_0229_0004$$$::Mas se estou chorando, então essas devem ser lágrimas de alegria.::
35347::$$$message_0263_0230_0000$$$::"...Você é tão problemático, você sabe disso?"::
35348::$$$message_0263_0231_0000$$$::Ela ri de leve. Finalmente, ela está sorrindo como sempre.::
35349::$$$message_0263_0232_0000$$$::"Ah... aah, haah..."[lr]::
35350::$$$message_0263_0232_0001$$$::Movimento lento e firme.[lr]::
35351::$$$message_0263_0232_0002$$$::Nossos corpos conectados se fundem um no outro.[lr]::
35352::$$$message_0263_0232_0003$$$::Em seu abraço, desejo estar exausto de corpo e alma.::
35353::$$$message_0263_0233_0000$$$::"Hah, ah, aah..."[lr]::
35354::$$$message_0263_0233_0001$$$::Gradualmente aumento a força dos meus empurrões.[lr]::
35355::$$$message_0263_0233_0002$$$::Não está mais claro se estou dentro dela ou se estou abraçando-a do lado de fora.[lr]::
35356::$$$message_0263_0233_0003$$$::Seu cabelo está emaranhado ao redor do corpo, dizendo-me que ela não quer soltar.::
35357::$$$message_0263_0234_0000$$$::"Hah, aah... Aah... Umph, ah..."[lr]::
35358::$$$message_0263_0234_0001$$$::A vagina dela envolve-me suavemente.[lr]::
35359::$$$message_0263_0234_0002$$$::Meu corpo está quente. Meu corpo e minha mente sentem-se como se pudessem ir tão alto quanto o céu, e eu abraço seu corpo enquanto meu pulso sobe.::
35360::$$$message_0263_0235_0000$$$::"Ngh, fuah, aaah... Haah, aaagh."[lr]::
35361::$$$message_0263_0235_0001$$$::A voz encantadora dela sobe de tom.[lr]::
35362::$$$message_0263_0235_0002$$$::Seu corpo saltarino é suave e não está tenso.::
35363::$$$message_0263_0236_0000$$$::Meu coração bate rápido.[lr]::
35364::$$$message_0263_0236_0001$$$::Agradamos um ao outro e seus cabelos me envolvem ainda mais.[lr]::
35365::$$$message_0263_0236_0002$$$::Os limites da nossa pele se confundem, e sinto como se quisesse me tornar uma só e me fundir naquilo que nos aquece.::
35366::$$$message_0263_0237_0000$$$::"...Ngh, ha, Rin..."[lr]::
35367::$$$message_0263_0237_0001$$$::Mas eu nem consigo dizer o seu nome.[lr]::
35368::$$$message_0263_0237_0002$$$::Isso provavelmente é sua última e maior vontade.::
35369::$$$message_0263_0238_0000$$$::"Ah... Fuah, yah, mm...[lr]::
35370::$$$message_0263_0238_0001$$$::Sim, está tudo bem... Obrigado..."[lr]::
35371::$$$message_0263_0238_0002$$$::Ela balança os quadris, às vezes roçando profundamente, às vezes superficialmente, seus olhos encharcados de lágrimas chorando.::
35372::$$$message_0263_0239_0000$$$::Sinto um arrepio, um tremor no meu núcleo.[lr]::
35373::$$$message_0263_0239_0001$$$::Meus intestinos estão derretendo de prazer, querendo escapar e derramar-se dos nossos corpos conectados.[lr]::
35374::$$$message_0263_0239_0002$$$::Sinto uma euforia ausente, embriagadora.[lr]::
35375::$$$message_0263_0239_0003$$$::Os limites do meu eu se tornam vagos, e nossos corpos se tornam um...::
35376::$$$message_0263_0240_0000$$$::"Shirou..."[lr]::
35377::$$$message_0263_0240_0001$$$::Sua sussurro faz meus lábios e ouvidos tremerem.[lr]::
35378::$$$message_0263_0240_0002$$$::Como se fosse provocado, lanço tudo.[lr]::
35379::$$$message_0263_0240_0003$$$::Meu corpo e mente fluem para seu útero.::
35380::$$$message_0263_0241_0000$$$::"..., ..., ..."[lr]::
35381::$$$message_0263_0241_0001$$$::Esforcei-me totalmente.[lr]::
35382::$$$message_0263_0241_0002$$$::Não consigo mais sustentar meu corpo superior, e me desmaio sobre o colchão macio.::
35383::$$$message_0263_0242_0000$$$::Ela levanta o corpo também e me abraça.[lr]::
35384::$$$message_0263_0242_0001$$$::Seus olhos roxos estão em mim.[lr]::
35385::$$$message_0263_0242_0002$$$::"...Mgh."[lr]::
35386::$$$message_0263_0242_0003$$$::E ela esfrega seus dentes na minha garganta.::
35387::$$$message_0263_0243_0000$$$::"..."[lr]::
35388::$$$message_0263_0243_0001$$$::Não me ocorre sequer perguntar por quê.[lr]::
35389::$$$message_0263_0243_0002$$$::De fato, parece uma coisa natural fazer.::
35390::$$$message_0263_0244_0000$$$::É nosso primeiro e último, quente e doloroso, beijo derretendo.::
35391::$$$message_0263_0245_0000$$$::A vazio após o sexo é coberto pelo anestésico residual do seu sangue sugado.::
35392::$$$message_0263_0246_0000$$$::A névoa espessa dança selvagemente.[lr]::
35393::$$$message_0263_0246_0001$$$::Minconsciência e memórias estão se desconectando.[lr]::
35394::$$$message_0263_0246_0002$$$::Pouco antes de mergulhar no esquecimento...[lr]::
35395::$$$message_0263_0246_0003$$$::"Até logo. ...Sueños dulces, Shirou."[lr]::
35396::$$$message_0263_0246_0004$$$::Tudo retorna à sua forma original.::
35397::$$$message_0263_0247_0000$$$::"...?"[lr]::
35398::$$$message_0263_0247_0001$$$::Hmm... Eu dormi?[lr]::
35399::$$$message_0263_0247_0002$$$::Caramba, deixei o Sol do outono me adormecer. Não posso agir como Saber ou Fuji-Nee.[lr]::
35400::$$$message_0263_0247_0003$$$::"Bom dia, Shirou."::
35401::$$$message_0263_0248_0000$$$::"Hmm. Você estava me observando dormir, Rider?"[lr]::
35402::$$$message_0263_0248_0001$$$::Olho para cima e vejo a Rider olhando para baixo para mim.[lr]::
35403::$$$message_0263_0248_0002$$$::Não estou salivando, mas passo a mão na boca de qualquer forma e me levanto.::
35404::$$$message_0263_0249_0000$$$::"Sim, eu achei que deveria te acordar. Você não queria atrasar e se envergonhar diante de Sakura."[lr]::
35405::$$$message_0263_0249_0001$$$::"Ah... certo. Melhor eu ir embora.[lr]::
35406::$$$message_0263_0249_0002$$$::Vou encontrar a Sakura no Shinto e iremos de compras juntas.::
35407::$$$message_0263_0250_0000$$$::"Você também podia vir, Rider."[lr]::
35408::$$$message_0263_0250_0001$$$::"Eu não queria estragar o clima. [chgfg storage=ライダー私服01c(中) time=400 textoff=0]Se você sair agora, ainda pode pegar o ônibus para Shinto."::
35409::$$$message_0263_0251_0000$$$::"[font italic=true]Shirou."[font italic=false][lr]::
35410::$$$message_0263_0251_0001$$$::"Hmm."[lr]::
35411::$$$message_0263_0251_0002$$$::"...Quero dizer, Shirou. Você vai atrasar se não sair logo. Tenha um bom dia."[lr]::
35412::$$$message_0263_0251_0003$$$::Fiquei surpreso ao ouvi-la dizer meu nome com um tom estranho.[lr]::
35413::$$$message_0263_0251_0004$$$::Coloquei os sapatos e devolvi o calçador para a Rider.::
35414::$$$message_0263_0252_0000$$$::"Vou, então. Volto à noite."[lr]::
35415::$$$message_0263_0252_0001$$$::"Sim. Divirta-se com a Sakura por nós dois."[lr]::
35416::$$$message_0263_0252_0002$$$::"Desculpa. Vou trazer alguma coisa para você."::
35417::$$$message_0263_0253_0000$$$::Vou correndo até o ponto de ônibus.[lr]::
35418::$$$message_0263_0253_0001$$$::Agora, o que será que vai acontecer hoje...::
