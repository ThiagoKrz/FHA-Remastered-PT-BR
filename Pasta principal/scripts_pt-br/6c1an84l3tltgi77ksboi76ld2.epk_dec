DAT
id=qid::label=str::text=lstr::
27794::$$$message_0206_0000_0000$$$::   Certo.[lr]::
27795::$$$message_0206_0000_0001$$$::Muito aconteceu, mas é hora de tomar um banho!::
27796::$$$message_0206_0001_0000$$$::"Hmm. Finalmente, um descanso..."[lr]::
27797::$$$message_0206_0001_0001$$$::O dia acabou e repouso meu corpo cansado.[lr]::
27798::$$$message_0206_0001_0002$$$::Fazia meio ano que a população feminina aumentou na minha casa.[lr]::
27799::$$$message_0206_0001_0003$$$::Todo dia é divertido e vibrante, mas há momentos em que só quero relaxar sozinho.::
27800::$$$message_0206_0002_0000$$$::"Oh, Shirou?"[lr]::
27801::$$$message_0206_0002_0001$$$::"...Hmm?"::
27802::$$$message_0206_0003_0000$$$::"S-sinto muito!"[lr]::
27803::$$$message_0206_0003_0001$$$::Eu-me-estou distraindo...![lr]::
27804::$$$message_0206_0003_0002$$$::Sou normalmente tão cuidadosa! Como pude cometer o mesmo erro de novo!?::
27805::$$$message_0206_0004_0000$$$::"...Lamento profundamente.[lr]::
27806::$$$message_0206_0004_0001$$$::Não sei por que você veio se desculpar comigo, mas como pode ver, o banheiro está ocupado no momento."[lr]::
27807::$$$message_0206_0004_0002$$$::"Não vejo! Não estou olhando! As bolhas estão no caminho e só consigo ver o contorno geral de você, então você ainda está totalmente a salvo!"::
27808::$$$message_0206_0005_0000$$$::"Sim, então se não for urgente, podemos conversar depois."[lr]::
27809::$$$message_0206_0005_0001$$$::"Exato! Não fiz isso de propósito!"[lr]::
27810::$$$message_0206_0005_0002$$$::"Entendi."[lr]::
27811::$$$message_0206_0005_0003$$$::"É! Ufa, estou muito contente que você seja tão compreensivo!"::
27812::$$$message_0206_0006_0000$$$::Grito com alegria.[lr]::
27813::$$$message_0206_0006_0001$$$::Que bom. Se tivesse respondido um segundo mais devagar, teria acertado um Game Over instantâneo!::
27814::$$$message_0206_0007_0000$$$::"...Desculpe, não entendo."[lr]::
27815::$$$message_0206_0007_0001$$$::"Não, não, eu também não sabia que você já estava dentro."[lr]::
27816::$$$message_0206_0007_0002$$$::"Se tivesse checado o vestiário, teria se dado conta disso."[lr]::
27817::$$$message_0206_0007_0003$$$::"...Argh."::
27818::$$$message_0206_0008_0000$$$::Estamos ambos nus, mas ela é a única que permanece calma.[lr]::
27819::$$$message_0206_0008_0001$$$::Ainda não consegui me livrar do choque inicial.::
27820::$$$message_0206_0009_0000$$$::"S-sinto muito, não percebi. Vou embora agora mesmo."[lr]::
27821::$$$message_0206_0009_0001$$$::A única salvação foi que ela não era Sakura nem Tohsaka.[lr]::
27822::$$$message_0206_0009_0002$$$::Se tivesse sido um deles, haveria gritos e calamidade cairia sobre esta casa.::
27823::$$$message_0206_0010_0000$$$::"R-right, eu me desculpo outro dia."[lr]::
27824::$$$message_0206_0010_0001$$$::Viro-me de costas de forma incômoda para sair.[lr]::
27825::$$$message_0206_0010_0002$$$::"...!?"[lr]::
27826::$$$message_0206_0010_0003$$$::Apenas minha coxa gira.[lr]::
27827::$$$message_0206_0010_0004$$$::Por algum motivo, o outro pé não vem junto.::
27828::$$$message_0206_0011_0000$$$::"Shirou?"[lr]::
27829::$$$message_0206_0011_0001$$$::Dramaticamente perco o equilíbrio e me preparo para o sofrimento que sentiria ao colidir com o chão.[lr]::
27830::$$$message_0206_0011_0002$$$::Mas de alguma forma, eu não caio, como se os calcanhares estivessem grudados nas lajes...::
27831::$$$message_0206_0012_0000$$$::"Não... há jeito."[lr]::
27832::$$$message_0206_0012_0001$$$::Eles estão de fato presos.[lr]::
27833::$$$message_0206_0012_0002$$$::Não sinto nada abaixo das coxas e meus pés parecem estar crescendo diretamente do chão.::
27834::$$$message_0206_0013_0000$$$::"O que há de errado, Shirou?"::
27835::$$$message_0206_0014_0000$$$::"Rider...[wvl canskip=0 time=400]...[wvl canskip=0 time=400] Onde estão seus óculos?"[lr]::
27836::$$$message_0206_0014_0001$$$::"Ah, você quer dizer os Mestres da Visão Mística?"[lr]::
27837::$$$message_0206_0014_0002$$$::"É isso."[lr]::
27838::$$$message_0206_0014_0003$$$::"Eles ficam embaçados no banho, então eu os tirei."::
27839::$$$message_0206_0015_0000$$$::"Ahh... faz sentido.[lr]::
27840::$$$message_0206_0015_0001$$$::Seria difícil ver no banho com óculos na."::
27841::$$$message_0206_0016_0000$$$::"Sim, e geralmente não há ninguém aqui que pudesse acidentalmente olhar nos meus Olhos Místicos, então não haveria perigo em tirá-los."[lr]::
27842::$$$message_0206_0016_0001$$$::Hahaha. Além de intrusos tolos como eu.::
27843::$$$message_0206_0017_0000$$$::"...Ugh. Acho que não sou eu só que fica perdido no banho."[lr]::
27844::$$$message_0206_0017_0001$$$::"Olhos Místicos[wvl canskip=0 time=400]...[cacheimage storage=white][wvl canskip=0 time=400]...ah. [movefg opacity=255 time=400 pos=c accel=0 storage=white textoff=0 rule=円形(中から外へ)][wm canskip=0][se storage=se132.wav][cacheimage storage=fd21f][wvl canskip=0 time=600][stopdash][fadein time=800 storage=fd21f cleardash=1]Shirou!?"[lr]::
27845::$$$message_0206_0017_0002$$$::Os olhos dela estão arregalados de surpresa, algo que eu não vejo muito frequentemente.[lr]::
27846::$$$message_0206_0017_0003$$$::"Idi...! Pára aí, não me olhe, Rider!"::
27847::$$$message_0206_0018_0000$$$::Não importa se eu fechar os olhos.[lr]::
27848::$$$message_0206_0018_0001$$$::O encanto de petrificação da Rider afeta tudo que ela olha.::
27849::$$$message_0206_0019_0000$$$::"...Não, já é tarde demais.[lr]::
27850::$$$message_0206_0019_0001$$$::Fechei os olhos, mas as partes petrificadas não se curarão."[lr]::
27851::$$$message_0206_0019_0002$$$::"Você está brincando...!"[lr]::
27852::$$$message_0206_0019_0003$$$::"...Prefiro que você não eleve a voz.[lr]::
27853::$$$message_0206_0019_0004$$$::Se Sakura vier correndo, ela vai mal compreender."::
27854::$$$message_0206_0020_0000$$$::"Ah, sim... Ei, [wvl][shock vmax=20 time=600 count=-3] já está até a cintura![lr]::
27855::$$$message_0206_0020_0001$$$::Mesmo a toalha que eu estava usando agora é pedra... Como é que funciona, afinal?"[lr]::
27856::$$$message_0206_0020_0002$$$::"Tudo bem. Embora o efeito varie de pessoa para pessoa, geralmente causa o mesmo fenômeno em todos.[lr]::
27857::$$$message_0206_0020_0003$$$::Você deve se sentir desconfortável por não entender seu mecanismo. Mas é um fenômeno natural, então não há motivo para se preocupar, sentir vergonha ou ficar ansioso."::
27858::$$$message_0206_0021_0000$$$::"O que você está falando!? Faça algo, por favor!"[lr]::
27859::$$$message_0206_0021_0001$$$::"Haah. Não me deixa escolha."[lr]::
27860::$$$message_0206_0021_0002$$$::Rider balança a cabeça, seu rio de cabelo roxo balançando. Ela se vira para encarar o espelho na parede.::
27861::$$$message_0206_0022_0000$$$::"Não gosto de espelhos, então sou relutante em fazer isso, mas..."[lr]::
27862::$$$message_0206_0022_0001$$$::No espelho, seus olhos ficam vermelhos.[lr]::
27863::$$$message_0206_0022_0002$$$::Então, a petrificação lenta para, como se tivesse sido cortada na fonte.::
27864::$$$message_0206_0023_0000$$$::"Hmm... Obrigado, Rider."[lr]::
27865::$$$message_0206_0023_0001$$$::"Nos estágios iniciais, pode ser dissipado do corpo humano por meio de meios mágicos. Você estaria em grande perigo se tivesse alcançado seu coração[line len=2][cacheimage storage=fd21c][wvl canskip=0 time=400][fadein time=400 storage=fd21c]Shirou?"[lr]::
27866::$$$message_0206_0023_0002$$$::Rider olha ao redor desamparadamente, depois timidamente se levanta.::
27867::$$$message_0206_0024_0000$$$::"O que há de errado?"[lr]::
27868::$$$message_0206_0024_0001$$$::"...Se você me desculpar, preciso de [line len=2]"[lr]::
27869::$$$message_0206_0024_0002$$$::"...!"[lr]::
27870::$$$message_0206_0024_0003$$$::"Cuidado!"[lr]::
27871::$$$message_0206_0024_0004$$$::Os pés de Rider, molhados, pisam em uma cesta... e seu corpo nu cai em direção a mim.::
27872::$$$message_0206_0025_0000$$$::"...Ah."[lr]::
27873::$$$message_0206_0025_0001$$$::Seu corpo ruborizado e quente envolve a metade superior de mim que não está petrificada.[lr]::
27874::$$$message_0206_0025_0002$$$::Estou esmagado sob seu peito volumoso. Sinto como balões de água cheios no banho.::
27875::$$$message_0206_0026_0000$$$::"Ngh..."[lr]::
27876::$$$message_0206_0026_0001$$$::A excitação incontrolável trava meu coração em um frenesi, empurrando o sangue que é forçado a subir do meu corpo petrificado para minha cabeça ao dobro da velocidade.::
27877::$$$message_0206_0027_0000$$$::"Desculpe, Shirou."[lr]::
27878::$$$message_0206_0027_0001$$$::"O espelho está ali! Você está se apoiando em mim!"[lr]::
27879::$$$message_0206_0027_0002$$$::"Parece que a petrificação está começando a desaparecer... Hmm, que textura estranha."[lr]::
27880::$$$message_0206_0027_0003$$$::"Isso é a banheira. Mais importante, o seu peito está[line len=2]uwaaah!"[lr]::
27881::$$$message_0206_0027_0004$$$::"Sim, eu sei. Por favor, fique calmo, Shirou."[lr]::
27882::$$$message_0206_0027_0005$$$::"Aquilo é a luz[wvl canskip=0 time=400]... [wvl canskip=0 time=400]Ei, você está fazendo isso de propósito?"::
27883::$$$message_0206_0028_0000$$$::Pego a mão fina dela, cuidando para não olhar para seu corpo descoberto.[lr]::
27884::$$$message_0206_0028_0001$$$::A Rider está franzindo os olhos para mim, mas parece estar focando no lugar errado.::
27885::$$$message_0206_0029_0000$$$::"Rider, quantos dedos estou segurando?"[lr]::
27886::$$$message_0206_0029_0001$$$::"Dois... Cinco...?"[lr]::
27887::$$$message_0206_0029_0002$$$::"Você realmente não consegue ver."::
27888::$$$message_0206_0030_0000$$$::"...Sim. Acabei de usar a Gorgon para suprimir minha energia mágica com o intuito de enfraquecer meus Olhos Místicos, mas cometi um erro de cálculo e isso prejudicou minha visão também."[lr]::
27889::$$$message_0206_0030_0001$$$::"Ah, é culpa minha."::
27890::$$$message_0206_0031_0000$$$::"Não é motivo de preocupação. Meus olhos voltarão a ver bem assim que eu dissipar a Gorgon.[lr]::
27891::$$$message_0206_0031_0001$$$::Shirou, lamento o incômodo, mas você poderia me guiar até o lavatório?"[lr]::
27892::$$$message_0206_0031_0002$$$::"Você não consegue dizer onde está nem mesmo de perto assim?"[lr]::
27893::$$$message_0206_0031_0003$$$::Sua noção de direção é tão ruim que você fica se perguntando como ela consegue se mover normalmente com um lenço nos olhos.::
27894::$$$message_0206_0032_0000$$$::"Ainda não. Você ainda não esfregou o xampu do cabelo.[lr]::
27895::$$$message_0206_0032_0001$$$::Você estava usando o banho primeiro, Rider, então vá em frente e termine seu banho. Eu vou manter os olhos fechados."[lr]::
27896::$$$message_0206_0032_0002$$$::"Com todo respeito, não consigo lavar o cabelo se não conseguir ver."[lr]::
27897::$$$message_0206_0032_0003$$$::...Rider, como você chegou tão longe se é tão desajeitada assim? [line len=2]Não, isso não é importante agora.::
27898::$$$message_0206_0033_0000$$$::"Mas como você não pode sair dessa sala sozinho, terei de ser eu a que saia primeiro."[lr]::
27899::$$$message_0206_0033_0001$$$::"...Não, eu foi eu que entrou de surpresa.[lr]::
27900::$$$message_0206_0033_0002$$$::Isso não compensa, mas como você estava no meio de lavar, vou lavar seu cabelo para você."::
27901::$$$message_0206_0034_0000$$$::"Você vai lavar... meus cabelos?"[lr]::
27902::$$$message_0206_0034_0001$$$::Assinto.[lr]::
27903::$$$message_0206_0034_0002$$$::Minha metade inferior está congelada, mas meus braços ainda movem-se perfeitamente.::
27904::$$$message_0206_0035_0000$$$::"...Entendi. Leva um certo esforço lavar meus cabelos sozinho. Poderia me ajudar, por favor?"[lr]::
27905::$$$message_0206_0035_0001$$$::"Claro. Sente-se bem aqui. Vire-se para esse lado para que eu possa ver sua costas inteira."[lr]::
27906::$$$message_0206_0035_0002$$$::"Mm...[wvl canskip=0 time=400]...[wvl canskip=0 time=400][se storage=se190.wav]... Ah, aqui está a cadeira."::
27907::$$$message_0206_0036_0000$$$::"Não, não, aquilo é o lavatório... [wvl canskip=0 time=400] Você caiu nele!?"[lr]::
27908::$$$message_0206_0036_0001$$$::"Ngh...! Isso é confuso demais."[lr]::
27909::$$$message_0206_0036_0002$$$::"Vai quebrar se você tentar arrancar à força desse jeito."::
27910::$$$message_0206_0037_0000$$$::"Então vou usar as unhas para arrancar dele a carne das minhas nádegas."[lr]::
27911::$$$message_0206_0037_0001$$$::"[font italic=true]Por quê!?"[font italic=false][lr]::
27912::$$$message_0206_0037_0002$$$::"Não há outro jeito."[lr]::
27913::$$$message_0206_0037_0003$$$::"Não não não não, vamos pensar nisso um pouco mais![lr]::
27914::$$$message_0206_0037_0004$$$::Eu sei, use o sabonete corporal para lubrificar-se!"::
27915::$$$message_0206_0038_0000$$$::"Acho que seria mais rápido cortar eu mesmo."[lr]::
27916::$$$message_0206_0038_0001$$$::"Não corte sua bunda ou sua cabeça!"[lr]::
27917::$$$message_0206_0038_0002$$$::"Pff."[lr]::
27918::$$$message_0206_0038_0003$$$::"Como está o seu traseiro, Rider?"::
27919::$$$message_0206_0039_0000$$$::"Sua agilidade salvei isso.[lr]::
27920::$$$message_0206_0039_0001$$$::[se storage=se190.wav]...Ah, então essa forma é a cadeira."[lr]::
27921::$$$message_0206_0039_0002$$$::"Yep... Espera, [wvl canskip=0 time=400][shock vmax=10 time=400 count=2]ah! Não fique de frente pra mim! Pare de abrir as pernas! [wvl canskip=0 time=400][shock vmax=10 time=600 count=5]Outra direção! Outra direção! Vire para o lado oposto!"::
27922::$$$message_0206_0040_0000$$$::"Haah, isso não importa para mim."[lr]::
27923::$$$message_0206_0040_0001$$$::"Mas sim, para mim! ...Serio, só me mostre a sua costas.[lr]::
27924::$$$message_0206_0040_0002$$$::E então... hum...?"::
27925::$$$message_0206_0041_0000$$$::Minha mão hesita sobre a floresta de garrafas.[lr]::
27926::$$$message_0206_0041_0001$$$::Saber, Tohsaka e Rin usam diferentes xampus. As garrafas pessoais de Illya e Fuji-Nee estão misturadas com elas, mesmo que nem vivam aqui.::
27927::$$$message_0206_0042_0000$$$::"Meu frasco é o bege."[lr]::
27928::$$$message_0206_0042_0001$$$::"O terceiro da direita?"[wvs][se storage=se712.wav][lr]::
27929::$$$message_0206_0042_0002$$$::"Isso... esse?"[lr]::
27930::$$$message_0206_0042_0003$$$::"Não, dois mais à esquerda. Aquela?"[lr]::
27931::$$$message_0206_0042_0004$$$::"Hm, esse aqui parece mesmo...[wvl][se storage=se713.wav] Pode ir."[lr]::
27932::$$$message_0206_0042_0005$$$::Tenho quase a sensação de estar movendo ela por controle remoto.::
27933::$$$message_0206_0043_0000$$$::"Certo... Não fica nervosa."[lr]::
27934::$$$message_0206_0043_0001$$$::Seu cabelo sedoso e escorregadio está molhado, brilhando como se fosse feito de fios de prata.::
27935::$$$message_0206_0044_0000$$$::Eles dizem que o cabelo de uma mulher é sua vida. Não é de se estranhar que sejam tão exigentes com o xampu.[lr]::
27936::$$$message_0206_0044_0001$$$::Como reage com o couro cabeludo, se é hidratante, se tem ingredientes 100% naturais, se é paraben-free...[lr]::
27937::$$$message_0206_0044_0002$$$::A Rider deve ser extremamente cuidadosa, com cabelo tão longo e belo.::
27938::$$$message_0206_0045_0000$$$::"O que há de errado, Shirou?"[lr]::
27939::$$$message_0206_0045_0001$$$::"Aaagh, idiota, pare de se importar tanto com ela... Um, isso é sabonete corporal."[lr]::
27940::$$$message_0206_0045_0002$$$::"Sim, uso isso para lavar todo o meu corpo."[lr]::
27941::$$$message_0206_0045_0003$$$::...Sinto que estou em um vestiário de academia.::
27942::$$$message_0206_0046_0000$$$::"Por que você está usando isso no seu cabelo!?"[lr]::
27943::$$$message_0206_0046_0001$$$::"Achei que isso já era suficiente... O que há de errado com isso?"[lr]::
27944::$$$message_0206_0046_0002$$$::Por favor, cuide melhor de si mesmo.[lr]::
27945::$$$message_0206_0046_0003$$$::Seria um desperdício imenso se ela arruinasse seus lindos cabelos brilhantes!::
27946::$$$message_0206_0047_0000$$$::"Ah, que inferno.[lr]::
27947::$$$message_0206_0047_0001$$$::Rider, me dê as terceira e quarta garrafas da esquerda."[lr]::
27948::$$$message_0206_0047_0002$$$::"Não são dessas de Rin?"[lr]::
27949::$$$message_0206_0047_0003$$$::"Permito hoje, como cabeça da casa."[lr]::
27950::$$$message_0206_0047_0004$$$::Eu vou usar o xampu caro da Tohsaka para lavar bem os cabelos do Rider.::
27951::$$$message_0206_0048_0000$$$::Eu esguicho os líquidos na minha mão.[lr]::
27952::$$$message_0206_0048_0001$$$::Acho que devo usar bastante para todo esse cabelo...[lr]::
27953::$$$message_0206_0048_0002$$$::Bem, um pouco mais não deve fazer mal.::
27954::$$$message_0206_0049_0000$$$::"Certo, vou começar por cima."[lr]::
27955::$$$message_0206_0049_0001$$$::"Por favor...[cacheimage storage=fd21b][wvl][se storage=se063.wav][shock vmax=15 time=400 count=2][fadein time=400 storage=fd21b cleardash=1][stopdash]...mm."[lr]::
27956::$$$message_0206_0049_0002$$$::Rider fica rígida, como se tivesse se surpreendido com o xampu gelado.[lr]::
27957::$$$message_0206_0049_0003$$$::Eu trabalho nele, cobrindo seu cabelo de forma uniforme, e agito com meus dedos.::
27958::$$$message_0206_0050_0000$$$::"Agora que estou segurando, você tem muitos cabelos, realmente."[lr]::
27959::$$$message_0206_0050_0001$$$::"Sim. Vira mais pesado quando está molhado.[lr]::
27960::$$$message_0206_0050_0002$$$::Basta dizer que me dá a sensação de que poderia arrancar minha cabeça dos ombros."::
27961::$$$message_0206_0051_0000$$$::"Isso é uma imagem surreal. Não é muito trabalho lavar isso sozinho?"[lr]::
27962::$$$message_0206_0051_0001$$$::"Bem, sim... Pode ser mais bruto com isso, se quiser.[lr]::
27963::$$$message_0206_0051_0002$$$::Sinta-se à vontade para parar se se cansar no meio. Podemos apenas esperar até que sua petrificação desapareça."::
27964::$$$message_0206_0052_0000$$$::"Não seja bobo. Vamos pegar um resfriado se ficarmos aqui por tanto tempo."[lr]::
27965::$$$message_0206_0052_0001$$$::"Eu não vou pegar um resfriado. Como você pode ver, meu corpo difere do de um humano."::
27966::$$$message_0206_0053_0000$$$::"Waaaah!?"[lr]::
27967::$$$message_0206_0053_0001$$$::"Uma brincadeira. Do lado de fora, não difiro de um humano."[lr]::
27968::$$$message_0206_0053_0002$$$::"Entendi já, então você não precisa me mostrar!"::
27969::$$$message_0206_0054_0000$$$::"...[lr]::
27970::$$$message_0206_0054_0001$$$::...Meu corpo desaponta você tanto assim?"[lr]::
27971::$$$message_0206_0054_0002$$$::"Hmm?"[lr]::
27972::$$$message_0206_0054_0003$$$::"Não, nada.[lr]::
27973::$$$message_0206_0054_0004$$$::Queria só te deixar feliz, como desculpa pelo seu incômodo."::
27974::$$$message_0206_0055_0000$$$::"Não se preocupe com isso.[lr]::
27975::$$$message_0206_0055_0001$$$::Isso tudo foi culpa minha desde o início, então é estranho que você seja quem está tentando se desculpar."[lr]::
27976::$$$message_0206_0055_0002$$$::"Mas..."[lr]::
27977::$$$message_0206_0055_0003$$$::"Além disso, estou me divertindo lavando seu cabelo."[lr]::
27978::$$$message_0206_0055_0004$$$::"Meu cabelo...? [cacheimage storage=fd21b][wvl canskip=0 time=200][fadein time=300 storage=fd21b textoff=0]Mmph."[lr]::
27979::$$$message_0206_0055_0005$$$::É a primeira vez que lavo o cabelo de alguém else, e tem bastante que vale a pena lavar.::
27980::$$$message_0206_0056_0000$$$::"E você?"[lr]::
27981::$$$message_0206_0056_0001$$$::"Hmm?"[lr]::
27982::$$$message_0206_0056_0002$$$::"É bom ter alguém else lavar seu cabelo?"[lr]::
27983::$$$message_0206_0056_0003$$$::"Eu... Fuh... [cacheimage storage=fd21b][wvl canskip=0 time=200][fadein time=300 storage=fd21b textoff=0]Mmmm..."::
27984::$$$message_0206_0057_0000$$$::Escuto a voz da Rider de perto, enquanto massajo suavemente seu couro cabeludo.[lr]::
27985::$$$message_0206_0057_0001$$$::Eu continuo mudando o tempo, como se estivesse acariciando um gato, divertindo-me com suas reações.::
27986::$$$message_0206_0058_0000$$$::"Sim... É bom quando você lava meus cabelos."[lr]::
27987::$$$message_0206_0058_0001$$$::"É mesmo? Bem feito."[lr]::
27988::$$$message_0206_0058_0002$$$::"Hmm... Hehehe..."::
27989::$$$message_0206_0059_0000$$$::Eu me torço para alcançar seu cabelo que desce até o chão.[lr]::
27990::$$$message_0206_0059_0001$$$::Eu jogo tudo por cima do braço esquerdo e passo com os dedos sujos de sabão.[lr]::
27991::$$$message_0206_0059_0002$$$::Eu continuo girando seu seda, como uma teia mágica de tear.::
27992::$$$message_0206_0060_0000$$$::O cabelo dela absorve todo o espuma, então eu adiciono mais xampu de vez em quando.[lr]::
27993::$$$message_0206_0060_0001$$$::Acho que usamos bastante o xampu da Tohsaka, mas não tem como evitar, já que o cabelo do Rider é muito denso.::
27994::$$$message_0206_0061_0000$$$::"Isso dói em algum lugar, senhorinha?"[lr]::
27995::$$$message_0206_0061_0001$$$::"Não muito, não... [cacheimage storage=fd21h][wvl canskip=0 time=200][fadein time=300 storage=fd21h textoff=0]Hehe, você é como um cabeleireiro."[lr]::
27996::$$$message_0206_0061_0002$$$::"É. Estou começando a entender isso."[lr]::
27997::$$$message_0206_0061_0003$$$::"E você? Não sente dor nas costas por ter que manter essa postura atual?"[lr]::
27998::$$$message_0206_0061_0004$$$::"Estou bem. Como minha parte inferior está tão dura agora, sinto como se estivesse sentado."[lr]::
27999::$$$message_0206_0061_0005$$$::"Entendi... [fadein time=300 storage=fd21b textoff=0]Huaah...mm..."::
28000::$$$message_0206_0062_0000$$$::"Hmm... heh... hehe..."[lr]::
28001::$$$message_0206_0062_0001$$$::Em algum momento, a tearia transforma-se em um brinquedo musical.[lr]::
28002::$$$message_0206_0062_0002$$$::O cabelo da Rider parece se estender sem fim, como música sem fim.::
28003::$$$message_0206_0063_0000$$$::"Hmm?"[lr]::
28004::$$$message_0206_0063_0001$$$::Algo me incomoda no punho.[lr]::
28005::$$$message_0206_0063_0002$$$::Os cabelos sujos deslizam e se movem de um jeito que não esperava.::
28006::$$$message_0206_0064_0000$$$::"...Hmm?"[lr]::
28007::$$$message_0206_0064_0001$$$::O cabelo está ondulando nos meus braços seguindo algum tipo de ritmo.[lr]::
28008::$$$message_0206_0064_0002$$$::Lamento-me e pego o som discordante, interrompendo a música que estava tocando na minha cabeça.::
28009::$$$message_0206_0065_0000$$$::"Eh? Oh..."[lr]::
28010::$$$message_0206_0065_0001$$$::Mas o cabelo parece ter uma vida própria, e escorrega para fora do meu controle.[lr]::
28011::$$$message_0206_0065_0002$$$::Eu persegui com as mãos, mas ele continua evitando entre minha mão esquerda e direita.::
28012::$$$message_0206_0066_0000$$$::...Então, percebo que não é apenas um punhado de seus cabelos.[lr]::
28013::$$$message_0206_0066_0001$$$::Os cabelos estão dançando ao redor de mim.::
28014::$$$message_0206_0067_0000$$$::"Hehe. Isso é engraçado. Shirou, posso lavar o meu corpo sozinho."[lr]::
28015::$$$message_0206_0067_0001$$$::"O que?"[lr]::
28016::$$$message_0206_0067_0002$$$::"Hmm... Haah, você até me toca ali? Como é ousado."[lr]::
28017::$$$message_0206_0067_0003$$$::"W-w-w-que!?[lr]::
28018::$$$message_0206_0067_0004$$$::N-não sou! Aah, onde diabos esse cabelo pervertido está indo!?"::
28019::$$$message_0206_0068_0000$$$::É como tentar pegar um ouriço.[lr]::
28020::$$$message_0206_0068_0001$$$::Não importa onde eu pego, o cabelo continua escorrendo entre meus dedos.[lr]::
28021::$$$message_0206_0068_0002$$$::Ah, sim. Não era o cabelo da Medusa...::
28022::$$$message_0206_0069_0000$$$::"Aah... Eles devem estar surpresos com o xampu."[lr]::
28023::$$$message_0206_0069_0001$$$::"Hmm? Uhu, aaaah, ohhh?"[lr]::
28024::$$$message_0206_0069_0002$$$::"Eles devem estar envergonhados por você ter estado tocando neles tão suavemente."::
28025::$$$message_0206_0070_0000$$$::Rider riu afavelmente.[lr]::
28026::$$$message_0206_0070_0001$$$::Eu abraço o cabelo que se movimenta e se enrola nos meus braços, não sei bem o que fazer com ele, literalmente comendo bolhas em confusão.::
28027::$$$message_0206_0071_0000$$$::"Rider?[lr]::
28028::$$$message_0206_0071_0001$$$::Desculpe, mas pode fazer algo..."[lr]::
28029::$$$message_0206_0071_0002$$$::"Por que, não estou certo. Não vejo nada, afinal de contas."[lr]::
28030::$$$message_0206_0071_0003$$$::"Você não está movendo essas coisas, está?"::
28031::$$$message_0206_0072_0000$$$::"Que pensamento![lr]::
28032::$$$message_0206_0072_0001$$$::Você não está me tocando e tentando culpar o cabelo por isso, espero."[lr]::
28033::$$$message_0206_0072_0002$$$::"O quê...!?"[lr]::
28034::$$$message_0206_0072_0003$$$::Ela sabe muito bem que não sou! Que provocadora.::
28035::$$$message_0206_0073_0000$$$::"Ugh, chega. Tá bom..."[lr]::
28036::$$$message_0206_0073_0001$$$::Pouco a pouco, começo a entender como trabalhar com o cabelo dela.[lr]::
28037::$$$message_0206_0073_0002$$$::Estendo a mão para segurar o cabelo onde ele tenta escapar e evito apertar. [movefg opacity=255 left=0 top=0 time=2500 accel=0 storage=white textoff=0]Deixo repousar; se começa a cair, seguro com cuidado e apoio com os dois braços.[lr]::
28038::$$$message_0206_0073_0003$$$::Como lidar com uma serpente, basicamente.::
28039::$$$message_0206_0074_0000$$$::"Ai, [wvl canskip=0 time=400][se storage=se063.wav][shock vmax=15 hmax=5 time=500 count=3]ho, [wvl canskip=0 time=400][se storage=se063.wav][shock vmax=-15 hmax=10 time=600 count=3]oh, [wvl canskip=0 time=400][se storage=se063.wav][shock vmax=20 time=700 count=3]ooh...[wvl canskip=0 time=600][se storage=se063.wav][shock vmax=25 time=800 count=4] Como assim?"[lr]::
28040::$$$message_0206_0074_0001$$$::Não tenho mãos suficientes, então uso as costas para sustentar o cabelo.[lr]::
28041::$$$message_0206_0074_0002$$$::Assim que o cabelo para de se mover, eu também fico parado.[lr]::
28042::$$$message_0206_0074_0003$$$::Eu me viro como um manipulador de serpentes, fazendo o meu melhor para deixar que ele se acostume ao contato físico.[lr]::
28043::$$$message_0206_0074_0004$$$::...Então, como eu suposto começar a lavar de novo, exatamente?::
28044::$$$message_0206_0075_0000$$$::"Hehehe..."[lr]::
28045::$$$message_0206_0075_0001$$$::Rider sufoca a risada, ombros tremendo, como se soubesse dos meus sofrimentos.::
28046::$$$message_0206_0076_0000$$$::"Você realmente não vê nada?"[lr]::
28047::$$$message_0206_0076_0001$$$::"Nem um pouco. Então eu não teria a menor ideia de onde seus olhos estão fixos."[lr]::
28048::$$$message_0206_0076_0002$$$::"Stup[line len=2]I-I lhe disse, não estou olhando!"[lr]::
28049::$$$message_0206_0076_0003$$$::"Heh. Eu sei."::
28050::$$$message_0206_0077_0000$$$::O cabelo escapa dos meus dedos em uma nova direção, dessa vez direcionando-se para meus ombros.::
28051::$$$message_0206_0078_0000$$$::"Oof... Ah!"[lr]::
28052::$$$message_0206_0078_0001$$$::O cabelo sujo escorre pelo meu corpo, agindo mais como longos tentáculos do que como serpentes.[lr]::
28053::$$$message_0206_0078_0002$$$::Antes que eu perceba, minhas mãos estão completamente cobertas de pelos.::
28054::$$$message_0206_0079_0000$$$::"Rider, não consigo lavar você assim."[lr]::
28055::$$$message_0206_0079_0001$$$::O cabelo molhado é pesado, e mal consigo levantar os braços.[lr]::
28056::$$$message_0206_0079_0002$$$::Na verdade, todo o meu torso está envolvido neles.::
28057::$$$message_0206_0080_0000$$$::"Ngh!"[lr]::
28058::$$$message_0206_0080_0001$$$::Sem pensar, tento me virar.[lr]::
28059::$$$message_0206_0080_0002$$$::De repente, uma corrente inexplicável de prazer rusha pelo meu núcleo.[lr]::
28060::$$$message_0206_0080_0003$$$::O cabelo suavemente ondulante da Rider está lambendo minha costas.::
28061::$$$message_0206_0081_0000$$$::"Hmm, isso é estranho... Quase como se estivesse intoxicado."[lr]::
28062::$$$message_0206_0081_0001$$$::"Eh?"[lr]::
28063::$$$message_0206_0081_0002$$$::Rider se apoia em mim. A metade superior do meu corpo está coberta com seu cabelo, enquanto a metade inferior está completamente rígida e não consegue se mover.::
28064::$$$message_0206_0082_0000$$$::"E ainda assim nunca me sinto tonto, não importa quantos álcool eu consuma..."[lr]::
28065::$$$message_0206_0082_0001$$$::"Então é isso... Porque é da Tohsaka."[lr]::
28066::$$$message_0206_0082_0002$$$::"Haah, e Rin?"::
28067::$$$message_0206_0083_0000$$$::"O xampu que estou usando no seu cabelo é da Tohsaka.[lr]::
28068::$$$message_0206_0083_0001$$$::Ela me disse antes que o cabelo de uma feiticeira feminina pode ser seu último recurso."[lr]::
28069::$$$message_0206_0083_0002$$$::E que seus cintos são itens mágicos superbos que mantêm a energia mágica incorporada em seus cabelos armazenada.::
28070::$$$message_0206_0084_0000$$$::"Então talvez o xampu da Tohsaka tenha algo especial... [wvl] [se storage=se063.wav] [shock vmax=30 time=400 count=3] Qua, qua!"[lr]::
28071::$$$message_0206_0084_0001$$$::Os fins do seu cabelo escorregam para meus cotovelos.[lr]::
28072::$$$message_0206_0084_0002$$$::Seu cabelo espumante não me deixa desconfortado, exatamente. Até que gosto dele, de certa forma, mas [line len=2]isso está me esfregando bem forte.[lr]::
28073::$$$message_0206_0084_0003$$$::Metade do meu corpo está virada em pedra e imóvel, e ainda assim meu corpo continua se movendo.::
28074::$$$message_0206_0085_0000$$$::"Entendi... Boa... ideia."[lr]::
28075::$$$message_0206_0085_0001$$$::"Wuhh...qual ideia?"[lr]::
28076::$$$message_0206_0085_0002$$$::"Nós nem precisamos nos mover... e o cabelo vai se lavar sozinho... assim como o corpo... matando dois pássaros com uma pedra."[lr]::
28077::$$$message_0206_0085_0003$$$::Isso é lógica de vestiário... espera, não tem tempo para isso agora.[lr]::
28078::$$$message_0206_0085_0004$$$::"Isso é tão desorganizado...[wvl canskip=0 time=300][se storage=se063.wav][shock vmax=25 time=400 count=3] Waaah!"::
28079::$$$message_0206_0086_0000$$$::O enxame de cabelos engole meus dedos. Ah, estou comendo.[playstop time=2500 nowait=1][lr]::
28080::$$$message_0206_0086_0001$$$::...Metáforicamente, sim. Estou envolto em seus cabelos agora. De algum modo, um grito de surpresa escapa.::
28081::$$$message_0206_0087_0000$$$::"Hehe... Quer ouvir mais disso, Shirou."[lr]::
28082::$$$message_0206_0087_0001$$$::Eu nem consigo perguntar o que.[lr]::
28083::$$$message_0206_0087_0002$$$::Basicamente, a Rider é uma caixa de música e eu sou o cilindro dentro...::
28084::$$$message_0206_0088_0000$$$::"Ah..."[lr]::
28085::$$$message_0206_0088_0001$$$::Os engrenagens continuam girando.[lr]::
28086::$$$message_0206_0088_0002$$$::Os dentes da escova que cobre todo o meu corpo passam por todas as superfícies, arrancando sons de mim. Vozes tontas. Vozes surpresas.::
28087::$$$message_0206_0089_0000$$$::"Rider...ngh!"[lr]::
28088::$$$message_0206_0089_0001$$$::Os engrenagens continuam girando.[lr]::
28089::$$$message_0206_0089_0002$$$::No banheiro quente, fico tocado e surpreso, fazendo barulho ao perceber que é o cabelo que está fazendo isso comigo. Meu cérebro fica em branco.::
28090::$$$message_0206_0090_0000$$$::"Hmm... não, quero mais do que só sua voz...[lr]::
28091::$$$message_0206_0090_0001$$$::Mostra-me mais do teu rosto... Shirou."[lr]::
28092::$$$message_0206_0090_0002$$$::A circulação sanguínea da Rider está ficando mais rápida? Ela está se intoxicando mais?[lr]::
28093::$$$message_0206_0090_0003$$$::Ela frisa e pressiona a cabeça contra mim.::
28094::$$$message_0206_0091_0000$$$::"Hmm... Huah... Shirou, exatamente ali... Estou..."[lr]::
28095::$$$message_0206_0091_0001$$$::O cabelo da Rider toca meus dedos abertos, que tentam sustentar o corpo dela.[lr]::
28096::$$$message_0206_0091_0002$$$::Tento firmar os dedos. É como tentar segurar um fardo de feno.::
28097::$$$message_0206_0092_0000$$$::"Shirou... [wvl][se storage=se712.wav]Shirou..."[lr]::
28098::$$$message_0206_0092_0001$$$::Rider balança a cabeça, como se tentasse[se storage=se063.wav] se recompor.[lr]::
28099::$$$message_0206_0092_0002$$$::Sua garganta pálida arqueia para trás. Naturalmente, seus cabelos movem-se em sincronia com sua cabeça.[lr]::
28100::$$$message_0206_0092_0003$$$::O cabelo que envolve todo o meu corpo escorrega. Pica, ou talvez doa. Não sei mais.::
28101::$$$message_0206_0093_0000$$$::Meu racional está se apagando.[lr]::
28102::$$$message_0206_0093_0001$$$::Se isso continuar...::
28103::$$$message_0206_0094_0000$$$::"Hehe... Mmgh."[lr]::
28104::$$$message_0206_0094_0001$$$::Rider adiciona mais xampu sozinha.[lr]::
28105::$$$message_0206_0094_0002$$$::As serpentes lubrificadas recém-ajustadas movem-se ainda mais intensamente.::
28106::$$$message_0206_0095_0000$$$::"...Ngh, fuh...ngh!"[lr]::
28107::$$$message_0206_0095_0001$$$::Não sei o que está acontecendo, mas acho que a dor está piorando. É como se todo o meu corpo estivesse sendo esquartejado vivo.[lr]::
28108::$$$message_0206_0095_0002$$$::Todos meus nervos sentem-se áridos, [movefg opacity=255 time=4000 pos=c accel=0 storage=white textoff=0] e sinto uma sensação como rachaduras se espalhando pelo meu corpo supostamente petrificado e anestesiado.::
28109::$$$message_0206_0096_0000$$$::"Hngh, nngh...!"[lr]::
28110::$$$message_0206_0096_0001$$$::Eu mastigo forte, esmagando meus molares.[lr]::
28111::$$$message_0206_0096_0002$$$::A palidez continua apagando minha mente, e meu cérebro está tão quente que vai evaporar, nesse ritmo...[sestop time=2000 nowait=1][playstop time=2000 nowait=1][lr]::
28112::$$$message_0206_0096_0003$$$::De repente, desmaio.::
28113::$$$message_0206_0097_0000$$$::"...Ngh."[lr]::
28114::$$$message_0206_0097_0001$$$::Acordo com o som da água. Percebo que estou deitado no chão.[lr]::
28115::$$$message_0206_0097_0002$$$::Em algum momento, fui liberado da prisão do cabelo.::
28116::$$$message_0206_0098_0000$$$::"Você acordou, Shirou?"[lr]::
28117::$$$message_0206_0098_0001$$$::"Hmm...?"[lr]::
28118::$$$message_0206_0098_0002$$$::"Minha visão recuperou-se."[lr]::
28119::$$$message_0206_0098_0003$$$::"Oh... E a petrificação?"::
28120::$$$message_0206_0099_0000$$$::"Não, a Gorgon ainda está em efeito. A perda de visão foi apenas temporária.[lr]::
28121::$$$message_0206_0099_0001$$$::Sua petrificação deve acabar em breve."::
28122::$$$message_0206_0100_0000$$$::A Rider diz, estou começando a sentir sensações voltarem para minhas pernas.[lr]::
28123::$$$message_0206_0100_0001$$$::Ainda não consigo mover os meus membros, mas devo conseguir caminhar em breve.::
28124::$$$message_0206_0101_0000$$$::"Oh... Desculpe. Estava no meio de lavar seus cabelos."[lr]::
28125::$$$message_0206_0101_0001$$$::"Não, eu exagerei também no meu brincadeira... [fadein time=300 storage=fd21f]Mas, hum, Shirou..."[lr]::
28126::$$$message_0206_0101_0002$$$::Rider olha para outro lado de forma constrangida.[lr]::
28127::$$$message_0206_0101_0003$$$::Olho para baixo para meu corpo inferior em recuperação...::
28128::$$$message_0206_0102_0000$$$::"GAHHHHH!"[lr]::
28129::$$$message_0206_0102_0001$$$::...e cobri-lo imediatamente com a cesta de lavar.::
28130::$$$message_0206_0103_0000$$$::"...!"[lr]::
28131::$$$message_0206_0103_0001$$$::Água fria do balde molha minha metade inferior.[lr]::
28132::$$$message_0206_0103_0002$$$::A distorção e o estalo da expansão térmica atingem meu cérebro, e as sensações intensas súbitas me fazem ver branco.[lr]::
28133::$$$message_0206_0103_0003$$$::Que exibição vergonhosa.::
28134::$$$message_0206_0104_0000$$$::"Não! Isso não é o que você pensa!"[lr]::
28135::$$$message_0206_0104_0001$$$::"Certo..."[lr]::
28136::$$$message_0206_0104_0002$$$::"Isso, um, isso fica assim se algo tocar nele!"[lr]::
28137::$$$message_0206_0104_0003$$$::"Hmm..."::
28138::$$$message_0206_0105_0000$$$::"Então eu definitivamente não estou reagindo a você ou qualquer coisa do tipo!"[lr]::
28139::$$$message_0206_0105_0001$$$::"Um... seu olhar me deixou desconfortável."[lr]::
28140::$$$message_0206_0105_0002$$$::"Ah, gah, desculpa!"[lr]::
28141::$$$message_0206_0105_0003$$$::"Não..."::
28142::$$$message_0206_0106_0000$$$::"Um, mas eu achei que você disse que não se importava que eu olhasse..."[lr]::
28143::$$$message_0206_0106_0001$$$::"...Seja eu um humano ou um Espírito Heroico, meu corpo continua sendo o de uma mulher, então, no fim, tenho dificuldade em superar a vergonha sexual."[lr]::
28144::$$$message_0206_0106_0002$$$::"Hmm?"[lr]::
28145::$$$message_0206_0106_0003$$$::"Lembrei disso por causa de como você foi gentil comigo."::
28146::$$$message_0206_0107_0000$$$::"Um..."[lr]::
28147::$$$message_0206_0107_0001$$$::"..."[lr]::
28148::$$$message_0206_0107_0002$$$::"O que você quer dizer?"[lr]::
28149::$$$message_0206_0107_0003$$$::"..."::
28150::$$$message_0206_0108_0000$$$::"...Shirou, você é um pervertido."[lr]::
28151::$$$message_0206_0108_0001$$$::"Nn!?"[lr]::
28152::$$$message_0206_0108_0002$$$::Minha mandíbula cai aberta com aquela resposta inesperada.::
28153::$$$message_0206_0109_0000$$$::"Obrigado por hoje. Vamos fazer isso outra vez."[lr]::
28154::$$$message_0206_0109_0001$$$::Rider espreme a água do cabelo e se levanta.[lr]::
28155::$$$message_0206_0109_0002$$$::Ela desliza com elegância ao redor de mim com seu corpo bem proporcionado, e o meu eu imóvel e estupefato continua apenas encarando-a.[lr]::
28156::$$$message_0206_0109_0003$$$::"!"[lr]::
28157::$$$message_0206_0109_0004$$$::Atrás dela, o cabelo molhado dela então me acaricia o ombro em saudação.::
28158::$$$message_0206_0110_0000$$$::...Alguns minutos depois, eu estava completamente liberado da petrificação.[lr]::
28159::$$$message_0206_0110_0001$$$::"Hmm... isso é estranho."[lr]::
28160::$$$message_0206_0110_0002$$$::Meu corpo ainda sente um estranho coceito. Não sei se é por causa do cabelo do Rider ou do xampu da Tohsaka.[lr]::
28161::$$$message_0206_0110_0003$$$::Sinto estranho quando coloco a camisa.::
28162::$$$message_0206_0111_0000$$$::"Ah, Senpai. Você terminou de tomar banho?"[lr]::
28163::$$$message_0206_0111_0001$$$::"AHHHH!"[lr]::
28164::$$$message_0206_0111_0002$$$::Ela quase toca meu ombro, fazendo centenas de formigas correrem pela minha pele.::
28165::$$$message_0206_0112_0000$$$::"...!?"[lr]::
28166::$$$message_0206_0112_0001$$$::Tento agarrar as incontáveis pernas que estão rastejando sob minha pele, só para perceber que estou me abraçando.::
28167::$$$message_0206_0113_0000$$$::"Senpai...?"[lr]::
28168::$$$message_0206_0113_0001$$$::"UHHWOOAH!?"[lr]::
28169::$$$message_0206_0113_0002$$$::A palma de Sakura no meu ombro envia uma corrente elétrica em mim que faz minha coluna querer dançar.[lr]::
28170::$$$message_0206_0113_0003$$$::Meu corpo inteiro arqueia instantaneamente para trás, como um brinquedo de relógio.::
28171::$$$message_0206_0114_0000$$$::"..."[lr]::
28172::$$$message_0206_0114_0001$$$::"Haah, haah...!?"[lr]::
28173::$$$message_0206_0114_0002$$$::Sakura mete um dedo no meu [shock vmax=30 time=800 count=2][se storage=se042.wav]peito estendido e...[lr]::
28174::$$$message_0206_0114_0003$$$::"OAHYAAAGH![wvl canskip=0 time=400] Shakuryah!"[lr]::
28175::$$$message_0206_0114_0004$$$::A linha central do meu corpo coça como se estivesse sendo aberta devagar por um bisturi, e eu solto uma voz sufocada, quase enlouquecida.::
28176::$$$message_0206_0115_0000$$$::"Haah, haah, Sakura, não me toque, espera..."[lr]::
28177::$$$message_0206_0115_0001$$$::"O-okay..."[lr]::
28178::$$$message_0206_0115_0002$$$::"Heeek, heeek, minha pele é super sensível..."[lr]::
28179::$$$message_0206_0115_0003$$$::"S-sinto muito."[lr]::
28180::$$$message_0206_0115_0004$$$::"Haah, hoo, não, tudo bem, phew."::
28181::$$$message_0206_0116_0000$$$::"Um... O que aconteceu?"[lr]::
28182::$$$message_0206_0116_0001$$$::"Hmm, bem, eu acho que o meu corpo não gostou da nova sabonete que eu tentei."[lr]::
28183::$$$message_0206_0116_0002$$$::"...Hmm."[lr]::
28184::$$$message_0206_0116_0003$$$::"Hmm, preciso descansar um pouco. Phew."[lr]::
28185::$$$message_0206_0116_0004$$$::"Senpai..."[lr]::
28186::$$$message_0206_0116_0005$$$::"Hmm?"::
28187::$$$message_0206_0117_0000$$$::"Senpai... Ah... Você é engraçado."[lr]::
28188::$$$message_0206_0117_0001$$$::Sakura me olha com um ar travesso.::
28189::$$$message_0206_0118_0000$$$::"Uah, b-boa noite, Sakura!"[lr]::
28190::$$$message_0206_0118_0001$$$::"Senpai[line len=2]hã!?"::
28191::$$$message_0206_0119_0000$$$::"Sniff, sniff, senti cheiro de sadismo.[lr]::
28192::$$$message_0206_0119_0001$$$::É como quando seu avô, na cama de morte, disse, [cacheimage storage=イリヤ06c(中),藤fd特殊03_右構えb(中),藤fd特殊03_右ジャブb(中),i衛宮邸_渡り廊下-(夜),藤fd特殊02c(中),white][wvl][rep fliplr=0 tops=136,, storages=イリヤ06c(中),藤fd特殊03_右構えb(中),藤fd特殊03_右ジャブb(中) time=300 flipud=0 lefts=598,, poss=,c,c bg=i衛宮邸_渡り廊下-(夜) indexes=1000,2000,3000 opacities=0,255,0][move time=140 path=(215,93,255)(215,61,255)(215,93,255)(215,61,255) storage=藤fd特殊03_右構えb(中) accel=-2][wm canskip=0][rep fliplr=0 tops=136,, storages=イリヤ06c(中),藤fd特殊03_右構えb(中),藤fd特殊03_右ジャブb(中) time=100 flipud=0 lefts=598,, poss=,c,c bg=i衛宮邸_渡り廊下-(夜) indexes=1000,2000,3000 opacities=0,0,255][se storage=se101.wav][move time=100 path=(-50,61,255)(16,61,255)(4,61,0) storage=藤fd特殊03_右ジャブb(中) accel=-2][wait canskip=0 time=100][rep fliplr=0 tops=136,, storages=イリヤ06c(中),藤fd特殊03_右構えb(中),藤fd特殊03_右ジャブb(中) time=100 flipud=0 lefts=598,, poss=,c,c bg=i衛宮邸_渡り廊下-(夜) indexes=1000,2000,3000 opacities=0,255,0][wm canskip=0][rep fliplr=0 tops=136,, storages=イリヤ06c(中),藤fd特殊03_右構えb(中),藤fd特殊03_右ジャブb(中) time=100 flipud=0 lefts=598,, poss=,c,c bg=i衛宮邸_渡り廊下-(夜) indexes=1000,2000,3000 opacities=0,0,255][se storage=se101.wav][move time=150 path=(-50,61,255)(16,61,255)(4,61,0) storage=藤fd特殊03_右ジャブb(中) accel=-2][wait canskip=0 time=100][rep fliplr=0 tops=136,, storages=イリヤ06c(中),藤fd特殊03_右構えb(中),藤fd特殊03_右ジャブb(中) time=100 flipud=0 lefts=598,, poss=,c,c bg=i衛宮邸_渡り廊下-(夜) indexes=1000,2000,3000 opacities=0,255,0][wm canskip=0][move time=180 path=(215,93,255)(215,61,255)(215,93,255)(215,61,255) storage=藤fd特殊03_右構えb(中) accel=-2][wm canskip=0][wait canskip=0 time=400][se storage=se325.wav][shock vmax=25 time=600 count=4][rep fliplr=0 tops=,136, storages=藤fd特殊02c(中),イリヤ06c(中),white time=300 flipud=0 lefts=,593,c poss=c,, bg=i衛宮邸_渡り廊下-(夜) indexes=1000,2000,3000 opacities=255,0,0]'leve o mundo pela mão!' e deixou um estranho herança. Não te lembra do sonho que você teve naquele dia?"::
28193::$$$message_0206_0120_0000$$$::"Ding [cacheimage storage=イリヤ刻印01c(中)][wvl][se storage=se717.wav][movefg opacity=0 time=200 pos=r accel=0 storage=イリヤ刻印01c(中) textoff=0][wm canskip=0][movefg opacity=180 time=300 pos=r accel=0 storage=イリヤ刻印01c(中) textoff=0][wm canskip=0]ding, [wvl canskip=0 time=600][clfg time=300 storage=イリヤ刻印01c(中) textoff=0]o radar acabou de captar o grito de Shirou. [cacheimage storage=イリヤ06f(中)][wvl][chgfg time=300 storage=イリヤ06f(中)][move time=195 path=(422,167,255)(459,136,255)(494,167,255)(459,136,255) storage=イリヤ06f(中) accel=0 spline=1 textoff=0]O que está acontecendo? O que está acontecendo?"[wm canskip=0][lr]::
28194::$$$message_0206_0120_0001$$$::"O dueto hilário!? OAHYAAAGH!"::
28195::$$$message_0206_0121_0000$$$::"Tch! O que?[lr]::
28196::$$$message_0206_0121_0001$$$::...Ahaha, [cacheimage storage=イリヤ03b(中),イリヤ03b(近)][wvl][chgfg time=300 storage=イリヤ03b(中)][move time=120 path=(350,20,255)(350,0,255)(350,28,255)(350,0,255) storage=イリヤ03b(中) accel=0 textoff=0][wm canskip=0][chgfg time=300 storage=イリヤ03b(近)b textoff=0 left=180][shock vmax=30 time=600 count=3][se storage=se040.wav]oh, Shirou! Pega isso!"[lr]::
28197::$$$message_0206_0121_0002$$$::"Illya, para aí! YEEAEEAAAAARGH!"::
28198::$$$message_0206_0122_0000$$$::"E-aí, que barulho absurdo você está fazendo, Shirou![lr]::
28199::$$$message_0206_0122_0001$$$::Eu não me lembro de ter te ensinado a agir assim!"[lr]::
28200::$$$message_0206_0122_0002$$$::"Haaagh! Fuji-Nee!?"::
28201::$$$message_0206_0123_0000$$$::"Ah, Senpai!?"[lr]::
28202::$$$message_0206_0123_0001$$$::"Hyagh, Sakura, kuh, esses dois..."[lr]::
28203::$$$message_0206_0123_0002$$$::"Não é justo! Também não é!"[lr]::
28204::$$$message_0206_0123_0003$$$::"[font italic=true]Mas por quê!?[font italic=false]"::
28205::$$$message_0206_0124_0000$$$::"..."[lr]::
28206::$$$message_0206_0124_0001$$$::"Rider, ajuda! Rider!"[lr]::
28207::$$$message_0206_0124_0002$$$::"...Isso não é da minha conta."[lr]::
28208::$$$message_0206_0124_0003$$$::"Nooo, meu salvador...!"::
28209::$$$message_0206_0125_0000$$$::"Nufu, você não vai escapar, Shirou! Prepare-se para atirar!"[lr]::
28210::$$$message_0206_0125_0001$$$::"Vamos com [font italic=true]isso[font italic=false], né, Taiga? Pronto!"::
28211::$$$message_0206_0126_0000$$$::"Técnica Suprema do Clube de Arco e Flecha! Tope Einzbern!"[lr]::
28212::$$$message_0206_0126_0001$$$::"Iuhu! Onii-chaaan!"[wvs][wait canskip=0 time=200][lr]::
28213::$$$message_0206_0126_0002$$$::Fuji-Nee agarra os tornozelos de Illya e dá uma virada nela, depois lança-a como se estivesse jogando um martelo.[lr]::
28214::$$$message_0206_0126_0003$$$::E o kyudo tem a ver com isso!?::
28215::$$$message_0206_0127_0000$$$::"AAAYHYAAAROOOOGH!"[lr]::
28216::$$$message_0206_0127_0001$$$::"Consegui! [cacheimage storage=イリヤ04b(近)][wvl][chgfg time=300 storage=イリヤ04b(近)][move time=150 path=(176,174,255)(145,156,255)(176,174,255)(208,156,255)(239,175,255)(271,157,255)(239,175,255)(208,156,255) storage=イリヤ04b(近) accel=0 spline=1 textoff=0]Olha, olha!"[wm canskip=0][lr]::
28217::$$$message_0206_0127_0002$$$::"Ahyahyahya, hey, hyahyahya, para..."::
28218::$$$message_0206_0128_0000$$$::"Mas por quê?"[cacheimage storage=イリヤ03b(近)b][wvs][wm canskip=0][wm canskip=0][chgfg time=100 storage=イリヤ03b(近)b opacity=0 textoff=0][lr]::
28219::$$$message_0206_0128_0001$$$::"Mas por quê!"[wm canskip=0][wm canskip=0][lr]::
28220::$$$message_0206_0128_0002$$$::"Para parar de me copiar, AHYAHYAHYAHYAHYAAAOOH!"[lr]::
28221::$$$message_0206_0128_0003$$$::Illya se deixa levar e [wm canskip=0][wm canskip=0][wm canskip=0][wait canskip=0 time=300][movefg opacity=200 left=-90 top=-268 time=1500 accel=-2 storage=シネスコw1000a textoff=0][movefg opacity=200 left=-94 top=370 time=1500 accel=-2 storage=シネスコw1000b textoff=0][movefg opacity=180 left=-160 top=0 time=1000 accel=0 storage=特殊白2a textoff=0]pula em cima da minha costas, [wm canskip=0][wm canskip=0][wm canskip=0][wait canskip=0 time=300]começa a me dar o [wait canskip=0 time=100]coochie-coochie-coo[movefg opacity=255 left=-103 top=-200 time=2000 accel=-2 storage=シネスコw1000a textoff=0][movefg opacity=255 left=-94 top=300 time=2000 accel=-2 storage=シネスコw1000b textoff=0][movefg opacity=255 left=-160 top=0 time=1000 accel=0 storage=特殊白2a textoff=0][wait canskip=0 time=300][line len=3]oh [wait canskip=0 time=200]não[wait canskip=0 time=200], [wait canskip=0 time=300]Eu [wait canskip=0 time=200]não[wait canskip=0 time=200]...!::
28222::$$$message_0206_0129_0000$$$::"Ah... [wvl canskip=0 time=400]Ele parou de se mover, Senpai."[lr]::
28223::$$$message_0206_0129_0001$$$::"KO! Isso é patético, Shirou!"[wvs][se storage=se452.wav][wait canskip=0 time=400]::

