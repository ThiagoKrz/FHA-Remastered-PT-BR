DAT
id=qid::label=str::text=lstr::
2178::$$$message_0011_0000_0000$$$::"Oiii, chegamos!"[lr]::
2179::$$$message_0011_0000_0001$$$::"Chegamos, Shirou."[lr]::
2180::$$$message_0011_0000_0002$$$::"Ei, bem-vindas de volta."[lr]::
2181::$$$message_0011_0000_0003$$$::A nossa família de comilonas voltou.[lr]::
2182::$$$message_0011_0000_0004$$$::Ela está segurando uma sacola de papel desconhecida.::
2183::$$$message_0011_0001_0000$$$::"Nós fomos a Shinto."[lr]::
2184::$$$message_0011_0001_0001$$$::"Sim, valeu a pena levar a Saber pela cidade. Todo mundo nos deu um monte de coisas de graça."[lr]::
2185::$$$message_0011_0001_0002$$$::"Aposto que você só levou ela em lugares esquisitos de novo. Você não tem jeito mesmo."::
2186::$$$message_0011_0002_0000$$$::"Isso não é muito gentil da sua parte.[lr]::
2187::$$$message_0011_0002_0001$$$::Parece que todo mundo sempre dá crédito para a Saber por tudo de bom que acontece e me culpa por tudo de ruim."::
2188::$$$message_0011_0003_0000$$$::"Hmph! Vamos, Saber.[lr]::
2189::$$$message_0011_0003_0001$$$::O Shirou não entende como as garotas pensam. Deixe ele limpar a casa até o sol se pôr."[lr]::
2190::$$$message_0011_0003_0002$$$::"Hum, Taiga... Shirou? Nós, hum..."::
2191::$$$message_0011_0004_0000$$$::"...Tudo bem. Fico imaginando o que vocês fizeram em Shinto, no entanto."[lr]::
2192::$$$message_0011_0004_0001$$$::Estou curioso sobre a sacola de papel.[lr]::
2193::$$$message_0011_0004_0002$$$::Será que devo tentar descobrir disfarçadamente assim que terminar de limpar a entrada...?::
2194::$$$message_0011_0005_0000$$$::"Se eu for interrogá-la, vou precisar disto, sim."[lr]::
2195::$$$message_0011_0005_0001$$$::Eu colocaria três presentes tentadores na mesa vazia: uma tigela de lombo de porco à milanesa, uma tigela de enguia de água doce e lamen.[lr]::
2196::$$$message_0011_0005_0002$$$::Mas a hora do almoço já passou faz tempo, então preparo um chá e umas trufas de chocolate em vez disso.::
2197::$$$message_0011_0006_0000$$$::Essas duas provavelmente foram para o quarto da Saber.[lr]::
2198::$$$message_0011_0006_0001$$$::Eu as ouvi fazendo barulho no corredor.::
2199::$$$message_0011_0007_0000$$$::"Chegamos!"[lr]::
2200::$$$message_0011_0007_0001$$$::"Com licença."[lr]::
2201::$$$message_0011_0007_0002$$$::Ah, a Rider e a Sakura voltaram.[lr]::
2202::$$$message_0011_0007_0003$$$::Não fiz chá suficiente para todos... Terei que fazer a parte da Sakura e da Rider depois.::
2203::$$$message_0011_0008_0000$$$::"Ei vocês duas, fiz chá!"[lr]::
2204::$$$message_0011_0008_0001$$$::Eu me movo rápido.[lr]::
2205::$$$message_0011_0008_0002$$$::Como sempre, deslizo para dentro do quarto e fecho a porta.::
2206::$$$message_0011_0009_0000$$$::"..."[lr]::
2207::$$$message_0011_0009_0001$$$::É praticamente um milagre eu não deixar a bandeja cair.::
2208::$$$message_0011_0010_0000$$$::"...Hum. Desculpe, Saber. Erro meu."[lr]::
2209::$$$message_0011_0010_0001$$$::Meu cérebro paralisado reage mecanicamente.[lr]::
2210::$$$message_0011_0010_0002$$$::"..."[lr]::
2211::$$$message_0011_0010_0003$$$::Tento não derrubar a bandeja.[lr]::
2212::$$$message_0011_0010_0004$$$::Alcanço a porta o mais calmamente possível.::
2213::$$$message_0011_0011_0000$$$::"Eu deveria ter batido. Eu vou sair agora."[lr]::
2214::$$$message_0011_0011_0001$$$::"Por favor, espere. Hum...[lr]::
2215::$$$message_0011_0011_0002$$$::...Eu estava prestes a colocar um traje de banho."::
2216::$$$message_0011_0012_0000$$$::"Nós fomos a Shinto hoje para comprar um traje de banho.[lr]::
2217::$$$message_0011_0012_0001$$$::A Taiga me levou a várias lojas, e os balconistas elogiaram a minha aparência... Mas ainda não estou confiante e quero ver como eu realmente fico."::
2218::$$$message_0011_0013_0000$$$::"A-ah. Bem, desculpe interromper. Certificar-me-ei de bater na próxima vez[line len=2]"[lr]::
2219::$$$message_0011_0013_0001$$$::"Então...[lr]::
2220::$$$message_0011_0013_0002$$$::Eu queria que você me visse com ele também."[lr]::
2221::$$$message_0011_0013_0003$$$::"Ah... Aaaah, tá bom. Bem, me avise quando terminar de se trocar...!"::
902203::$$$message_9011_0008_0000$$$::"Ei vocês duas, fiz chá!"[r]::

