DAT
id=qid::label=str::text=lstr::
43167::$$$message_0361_0000_0000$$$::"Souichirou-sama..."::
43168::$$$message_0361_0000_0001$$$::"Mrgh."::
43169::$$$message_0361_0000_0002$$$::"Ahh, finalmente não há ninguém entre nós..."::
43170::$$$message_0361_0000_0003$$$::"Ei, Kotomine. Tem certeza de que é aqui?"::
43171::$$$message_0361_0000_0004$$$::"Hahahahaha. Engano meu.[lr]::
43172::$$$message_0361_0000_0005$$$::Fui atraído pelo odor da felicidade."::
43173::$$$message_0361_0000_0006$$$::"Ah..."::
43174::$$$message_0361_0000_0007$$$::"Hmph. Então sigamos em frente. Não há sentido em permanecer aqui."::
43175::$$$message_0361_0000_0008$$$::"Assassin! Venha cá! E extermine estas pragas!"::
43176::$$$message_0361_0000_0009$$$::"(bocejo) Espera[line len=2][hffacechg chara=ランサー face=驚 time=200][hfangry layer=0]EI, ESSA PASSOU RASPANDO, PORRA!"::
43177::$$$message_0361_0000_0010$$$::"Oh, aquele golpe não bastou para despachá-lo?"::
43178::$$$message_0361_0000_0011$$$::"Que saudação selvagem."::
43179::$$$message_0361_0000_0012$$$::"N-[hfchance layer=1]não é assim que se lida normalmente com visitas indesejadas!?"::
43180::$$$message_0361_0000_0013$$$::"Ora, que coincidência absoluta e completa."::
43181::$$$message_0361_0000_0014$$$::"Então por que você parece tão feliz?"::
43182::$$$message_0361_0000_0015$$$::"Hahahahaha.[lr]::
43183::$$$message_0361_0000_0016$$$::Você compreendeu mal, Lancer-kun."::
43184::$$$message_0361_0000_0017$$$::"Certamente não pensa que deixarei você sair vivo deste lugar."::
43185::$$$message_0361_0000_0018$$$::"Vai se opor a mim, bufão?"::
43186::$$$message_0361_0000_0019$$$::"Quer dizer, acho que qualquer um ficaria irritado."::
43187::$$$message_0361_0000_0020$$$::"Heh. A culpa é sua por estar em meu caminho. Não é a postura natural do homem prostrar-se e abrir passagem ao rei?"::
43188::$$$message_0361_0000_0021$$$::"Ora, isso certamente não é coisa que se ouça de um invasor."::

