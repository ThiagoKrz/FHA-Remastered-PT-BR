DAT
id=qid::label=str::text=lstr::
45179::$$$message_0408_0000_0000$$$::"Vencemos!"::
45180::$$$message_0408_0000_0001$$$::"Naturalmente."::
45181::$$$message_0408_0000_0002$$$::"..."::
45182::$$$message_0408_0000_0003$$$::"...Anime-se, Lancer. Essa história de que chorar faz nascer pintas sob os olhos é só superstição."::
45183::$$$message_0408_0000_0004$$$::"Meu desejo... finalmente se realizou. [br]Não, ele já estava realizado desde que fui invocado a esta terra..."::
45184::$$$message_0408_0000_0005$$$::"Ha! Não se precipite. Quando voltarmos para casa, esta guerra ridícula não passará de uma nota de rodapé. Ainda tenho muito trabalho para você."::
45185::$$$message_0408_0000_0006$$$::"Como desejar, meu lorde."::
45186::$$$message_0408_0000_0007$$$::"Agora, avancemos em triunfo para minha nova oficina."::
45187::$$$message_0408_0000_0008$$$::"E para o onsen também. Não se esqueça do banho misto."::
45188::$$$message_0408_0000_0009$$$::"Claro, meu amor."::

