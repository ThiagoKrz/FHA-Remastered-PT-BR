DAT
id=qid::label=str::text=lstr::
45763::$$$message_0439_0000_0000$$$::"...Urgh."::
45764::$$$message_0439_0000_0001$$$::"Urgh..."::
45765::$$$message_0439_0000_0002$$$::"..."::
45766::$$$message_0439_0000_0003$$$::"Ohh... Ohh, ohhh, OOOOHHHH!"::
45767::$$$message_0439_0000_0004$$$::"Lá vem."::
45768::$$$message_0439_0000_0005$$$::"JEANNE! JEANNE, JEANNE, JEANNE, JEANNE,[wvl][hfangry layer=0] JEANNNNNNNNNE!"::
45769::$$$message_0439_0000_0006$$$::"Eu já disse, não sou Jeanne!"::
45770::$$$message_0439_0000_0007$$$::"Não adianta, Saber. A Corrupção Mental dele não tem cura."::
45771::$$$message_0439_0000_0008$$$::(Está no rank A... Ele ouve o que as pessoas dizem, mas não consegue compreendê-las de verdade.)::
45772::$$$message_0439_0000_0009$$$::(Ainda assim, ele deve ter intelecto o bastante para seguir ordens.)::
45773::$$$message_0439_0000_0010$$$::"Ora! Não me diga que também veio ao onsen fazer um pedido!? Que tragédia!"::
45774::$$$message_0439_0000_0011$$$::"Você rezou a Deus, mas nunca quis nada para si! Teria desenvolvido desejos próprios...? Oh, céus!"::
45775::$$$message_0439_0000_0012$$$::"Como já disse inúmeras vezes, meu único desejo é a salvação da Britânia[line len=2]"::
45776::$$$message_0439_0000_0013$$$::"Maravilhoso! Então, Jeanne, deseje destruir Deus e todos os humanos que a traíram!"::
45777::$$$message_0439_0000_0014$$$::"Eu, Gilles de Rais, tornarei isso realidade![wvl canskip=false time=200][hffgchg2 chara=キャスター4th face=笑顔3 pos=left time=300 twno=1][hfangry layer=0] Ph'nglui mglw’nafh Cthulhu..."[skip_next_tag]::
45778::$$$message_0439_0000_0015$$$::"Ahh! Pare de invocar essa coisa-deus horrível aqui!"::
45779::$$$message_0439_0000_0016$$$::(A informação estava correta. Caster idolatra Saber... Será que podemos usar isso para manipulá-lo...?)::
45780::$$$message_0439_0000_0017$$$::(Será difícil convencer Iri... Mas Servos são descartáveis. Ela não reclamará se der resultado.)::
45781::$$$message_0439_0000_0018$$$::"De qualquer forma! Como mãe de uma filha, eu não permitirei[line len=2]"::
45783::$$$message_0439_0000_0020$$$::"Hã? Ei, madame, você tem uma filha!? Quantos anos ela tem!? Ela parece com você!? Apresenta a gente, Onee-san!"::
45784::$$$message_0439_0000_0021$$$::"..."::
45785::$$$message_0439_0000_0022$$$::"Hm. Tenho certeza de que, se expuséssemos a filha dela em uma galeria, ela seria muito bem-avaliada."::
45786::$$$message_0439_0000_0023$$$::"..."::
45787::$$$message_0439_0000_0024$$$::"...Maiya. Desculpe, mas preciso que contate um ex-soldado soviético. [wvl canskip=false time=300][hffgchg2 chara=切嗣 face=怒 pos=center time=300 twno=2][hfburstblood layer=2 ox=-80 oy=40][hfchance layer=2]De um submarino nuclear, vamos disparar um SLBM e obliterar Caster junto com Fuyuki inteira!"::
45788::$$$message_0439_0000_0025$$$::"Irisviel! Acho que seu marido acabou de murmurar algo absurdo!"::
45789::$$$message_0439_0000_0026$$$::"Hehehehe. O que se diz numa hora dessas? Uma garota de maria-chiquinhas e meias até o joelho me ensinou esta expressão."::
45790::$$$message_0439_0000_0027$$$::"MATE ELE MORTO!"::
45791::$$$message_0439_0000_0028$$$::"Meu Deus! Agora você pisou numa mina terrestre!"::
45792::$$$message_0439_0000_0029$$$::"Hmm. Não entendi bem o que houve, mas parece que querem acabar conosco."::
45793::$$$message_0439_0000_0030$$$::"Que pena, Jeanne. Antes de conceder seu desejo..."::
45794::$$$message_0439_0000_0031$$$::"Temos que realizar o nosso primeiro! Hora do show!"::

