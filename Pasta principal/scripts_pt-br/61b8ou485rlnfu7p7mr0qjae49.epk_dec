DAT
id=qid::label=str::text=lstr::
45763::$$$message_0439_0000_0000$$$::"...Ugh."::
45764::$$$message_0439_0000_0001$$$::"Ugh..."::
45765::$$$message_0439_0000_0002$$$::"..."::
45766::$$$message_0439_0000_0003$$$::"Ohh... Ohh, ohhh, OOOOH!"::
45767::$$$message_0439_0000_0004$$$::"Aqui vai."::
45768::$$$message_0439_0000_0005$$$::"JEANNE! JEANNE, JEANNE, JEANNE, JEANNE,[wvl][hfangry layer=0] JEANNNNNNNNE!"::
45769::$$$message_0439_0000_0006$$$::"Já lhe disse, não sou Jeanne!"::
45770::$$$message_0439_0000_0007$$$::"Não adianta, Saber. Não há como curar sua Corrupção Mental."::
45771::$$$message_0439_0000_0008$$$::(É de rank A... Ele pode ouvir o que as pessoas dizem, mas não consegue entender verdadeiramente elas.)::
45772::$$$message_0439_0000_0009$$$::(Ele provavelmente tem inteligência suficiente para seguir ordens.)::
45773::$$$message_0439_0000_0010$$$::"Meu! Não me diga que você também veio aqui para fazer um desejo no onsen!? Que trágico!"::
45774::$$$message_0439_0000_0011$$$::"Você rezou a Deus, mas nunca quis nada por si mesmo! Você desenvolveu seus próprios desejos...? Oh, oh, que bom!"::
45775::$$$message_0439_0000_0012$$$::"Como já disse muitas vezes, minha única vontade é a salvação da Inglaterra[line len=2]"::
45776::$$$message_0439_0000_0013$$$::"Isso é maravilhoso! Agora, Jeanne, faça seu desejo de destruir a Deus, e todos os humanos que o traíram!"::
45777::$$$message_0439_0000_0014$$$::"Eu, Gilles de Rais, vou torná-lo realidade![wvl canskip=false time=200][hffgchg2 chara=キャスター4th face=笑顔3 pos=left time=300 twno=1][hfangry layer=0] Ph'nglui mglw’nafh Cthulhu..."[skip_next_tag]::
45778::$$$message_0439_0000_0015$$$::"Ah! Pare de invocar aquele horrível ser divino aqui!"::
45779::$$$message_0439_0000_0016$$$::(A inteligência estava certa. Caster adora Saber... Acho que podemos usar isso para manipulá-lo...)::
45780::$$$message_0439_0000_0017$$$::Será difícil convencer a Iri... Mas Servos são dispensáveis. Ela não reclamará desde que obtenha resultados.::
45781::$$$message_0439_0000_0018$$$::"Bem! Como mãe de uma filha, não permitirei que...[line len=2]"::
45783::$$$message_0439_0000_0020$$$::"Huh? Hey, lady, você tem uma filha!? Quantos anos ela tem!? Ela parece você!? Introduza-nos!"::
45784::$$$message_0439_0000_0021$$$::"..."::
45785::$$$message_0439_0000_0022$$$::"Hmm. Estou certo de que, se exibíssemos sua filha em uma galeria, seria muito bem avaliada."::
45786::$$$message_0439_0000_0023$$$::"..."::
45787::$$$message_0439_0000_0024$$$::"...Maiya. Desculpe, mas preciso que você convoque um soldado ex-soviético. [wvl canskip=false time=300][hffgchg2 chara=切嗣 face=怒 pos=center time=300 twno=2][hfburstblood layer=2 ox=-80 oy=40][hfchance layer=2]Em um submarino nuclear, vamos lançar um míssil SLBM e destruir Caster junto com toda Fuyuki!"::
45788::$$$message_0439_0000_0025$$$::"Irisviel! Acho que seu marido acabou de murmurar algo absurdo!"::
45789::$$$message_0439_0000_0026$$$::"Hehehehe. O que devo dizer em um momento como este? Uma garota com duas caudas de porco e meias até o joelho me ensinou essa expressão."::
45790::$$$message_0439_0000_0027$$$::"MATA-LO!"::
45791::$$$message_0439_0000_0028$$$::"Oh, meu Deus! Você realmente acabou de pisar em uma mina, agora!"::
45792::$$$message_0439_0000_0029$$$::"Hmm. Não sei o que está acontecendo, mas eles estão com a gente em mira."::
45793::$$$message_0439_0000_0030$$$::"Isso é muito ruim, Jeanne. Antes que eu conceda seu desejo..."::
45794::$$$message_0439_0000_0031$$$::"Temos que cumprir nosso desejo primeiro! É showtime!"::

