DAT
id=qid::label=str::text=lstr::
45763::$$$message_0439_0000_0000$$$::"...Ugh."::
45764::$$$message_0439_0000_0001$$$::"Ugh..."::
45765::$$$message_0439_0000_0002$$$::"..."::
45766::$$$message_0439_0000_0003$$$::"Ohh... Ohh, ohhh, OOOOHHHH!"::
45767::$$$message_0439_0000_0004$$$::"Lá vem."::
45768::$$$message_0439_0000_0005$$$::"JEANNE! JEANNE, JEANNE, JEANNE, JEANNE,[wvl][hfangry layer=0] JEANNNNNNNNNE!"::
45769::$$$message_0439_0000_0006$$$::"Eu já falei para o senhor, eu não sou nenhuma Jeanne!"::
45770::$$$message_0439_0000_0007$$$::"Não adianta, Saber. A Corrupção Mental dele não tem cura."::
45771::$$$message_0439_0000_0008$$$::(O nível é no rank A... Ele pode escutar os outros falando, mas nunca vai entendê-las de verdade.)::
45772::$$$message_0439_0000_0009$$$::(Ainda assim, ele deve ter intelecto o bastante para seguir ordens.)::
45773::$$$message_0439_0000_0010$$$::"Nossa! Não me diga que também veio aqui no onsen para pedir por um desejo!? Mas que tragédia!"::
45774::$$$message_0439_0000_0011$$$::"Você rezou para Deus, mas jamais desejou algo a si mesma! Será que andou criando seus próprios desejos...? Oh, meu Deus!"::
45775::$$$message_0439_0000_0012$$$::"Como já disse tantas vezes antes, meu único desejo baseia-se na salvação da Britânia[line len=2]"::
45776::$$$message_0439_0000_0013$$$::"Isso é ótimo! Sendo assim, Jeanne, faça do seu desejo um fim a Deus e a todos os seres humanos que lhe traíram!"::
45777::$$$message_0439_0000_0014$$$::"E eu, Gilles de Rais, irei realizar tudo isso em realidade![wvl canskip=false time=200][hffgchg2 chara=キャスター4th face=笑顔3 pos=left time=300 twno=1][hfangry layer=0] Ph'nglui mglw’nafh Cthulhu..."[skip_next_tag]::
45778::$$$message_0439_0000_0015$$$::"Ahh! Pare já de invocar essa sua criatura divina e terrível para cá!"::
45779::$$$message_0439_0000_0016$$$::(As minhas fontes não mentiram. O Caster de fato é um devoto da Saber... Imagino se há a chance de o usar por meio disso...)::
45780::$$$message_0439_0000_0017$$$::(Vai dar um trabalho tentar convencer a Iri... Mas os Servos em si são bem descartáveis. Ela não fará corpo mole caso isso der os devidos resultados finais.)::
45781::$$$message_0439_0000_0018$$$::"Não me importa! Como uma mãe que carrega a sua filha, eu jamais permitirei que[line len=2]"::
45783::$$$message_0439_0000_0020$$$::"Hã? Peraí, dondoca, você tem uma filha por acaso!? E quantos anos ela tem!? Ela é a sua cara!? Apresenta ela para nós!"::
45784::$$$message_0439_0000_0021$$$::"..."::
45785::$$$message_0439_0000_0022$$$::"Hm. Eu aposto de todas as certezas de que se viermos a exibir a filha dela lá em alguma galeria de quadros, eu sei que ela receberia ótimas avaliações."::
45786::$$$message_0439_0000_0023$$$::"..."::
45787::$$$message_0439_0000_0024$$$::"...Maiya. Sinto te dizer, mas preciso que arranje uma ligação para me chamar algum soldado ex-soviético. [wvl canskip=false time=300][hffgchg2 chara=切嗣 face=怒 pos=center time=300 twno=2][hfburstblood layer=2 ox=-80 oy=40][hfchance layer=2]Nós vamos logo disparar um SLBM de dentro de um submarino nuclear bem na cabeça do Caster para obliterar ele e também o resto de Fuyuki toda junto!"::
45788::$$$message_0439_0000_0025$$$::"Irisviel! Acho que o seu marido acabou de resmungar aí alguma baboseira sem tamanho!"::
45789::$$$message_0439_0000_0026$$$::"Hehehehe. O que mesmo eu deveria de fato estar dizendo numa exata hora dessas? Lembro de uma certa garota de meias no joelho e de chiquinhas tendo me ensinado essa expressão."::
45790::$$$message_0439_0000_0027$$$::"MATE ELE COM TUDO E ATÉ A MORTE!"::
45791::$$$message_0439_0000_0028$$$::"Ai, meu Deus! Você agora enfiou a porra do pé inteiro numa bomba terrestre mesmo!"::
45792::$$$message_0439_0000_0029$$$::"Hmm. Eu não estou entendo nada, mas parece que eles já pegaram a gente de alvo na linha."::
45793::$$$message_0439_0000_0030$$$::"Mas isso é mesmo uma grande pena, Jeanne. Um pouco antes de eu poder realizar o seu desejo..."::
45794::$$$message_0439_0000_0031$$$::"A gente vai ter que ir realizar os nossos primeiros antes disso! É a hora do show!"::

