DAT
id=qid::label=str::text=lstr::
1680::$$$message_0008_0000_0000$$$::"Certo, Saber. Por enquanto, eu..."[lr]::
1681::$$$message_0008_0000_0001$$$::"Sim, vou mudar imediatamente, então você poderia esperar aqui, Shirou?"[lr]::
1682::$$$message_0008_0000_0002$$$::"Hmm!? Direto aqui!?"::
1683::$$$message_0008_0001_0000$$$::"Sim. Acabarei logo.[lr]::
1684::$$$message_0008_0001_0001$$$::Tenho a sensação de que, assim que você for embora, encontrará algum motivo para me evitar..."[lr]::
1685::$$$message_0008_0001_0002$$$::"N-não, eu não vou."[lr]::
1686::$$$message_0008_0001_0003$$$::"Por favor, fique."::
1687::$$$message_0008_0002_0000$$$::...ela insiste. Na verdade, não combina nada com a Saber fazer tanto caso para trocar de roupa.::
1688::$$$message_0008_0003_0000$$$::"Sh-Shirou...!"[lr]::
1689::$$$message_0008_0003_0001$$$::"E-eu?"::
1690::$$$message_0008_0004_0000$$$::"Meu cinto soltou...[lr]::
1691::$$$message_0008_0004_0001$$$::Você sabe para onde é que vai?"[lr]::
1692::$$$message_0008_0004_0002$$$::"Uma fita!? Como eu deveria saber!?"::
1693::$$$message_0008_0005_0000$$$::"Não fique assim. Só quero que você olhe..."[lr]::
1694::$$$message_0008_0005_0001$$$::"Eu não posso!"::
1695::$$$message_0008_0006_0000$$$::"Gah, não consigo mais com isso![lr]::
1696::$$$message_0008_0006_0001$$$::Olha, só coloque algo no... Ah, sim!"::
1697::$$$message_0008_0007_0000$$$::"Saber, coloque seu armadura."[lr]::
1698::$$$message_0008_0007_0001$$$::"Eh...? Por que? Não tem inimigo pra lutar aqui."[lr]::
1699::$$$message_0008_0007_0002$$$::"Possa usar algo..."::
1700::$$$message_0008_0008_0000$$$::"Isso vai dar?"[lr]::
1701::$$$message_0008_0008_0001$$$::"...Ahhh...obrigado a Deus."[lr]::
1702::$$$message_0008_0008_0002$$$::Minha tensão escorre de mim de uma só vez, e quero me desmaiar no chão.::
1703::$$$message_0008_0009_0000$$$::"...Shirou?"[lr]::
1704::$$$message_0008_0009_0001$$$::"Hmm?"[lr]::
1705::$$$message_0008_0009_0002$$$::"Suponho que esse traje de batalha me convém depois de tudo."::
1706::$$$message_0008_0010_0000$$$::"O que?"[lr]::
1707::$$$message_0008_0010_0001$$$::"Isso é o que sempre fui.[lr]::
1708::$$$message_0008_0010_0002$$$::Eu nunca fui feito para usar tamanha splendor, como trajes de banho e vestidos..."::
1709::$$$message_0008_0011_0000$$$::"H-[wvl][shock vmax=20 time=400 count=-3]espera!"[lr]::
1710::$$$message_0008_0011_0001$$$::"Não, não tente me consolar.[lr]::
1711::$$$message_0008_0011_0002$$$::Após ver sua consternação e depois sua alívio, é tão claro para mim."::
1712::$$$message_0008_0012_0000$$$::"Você está se enganando. Qualquer pessoa ficaria paníctica ao ver você nua!"[lr]::
1713::$$$message_0008_0012_0001$$$::"É mesmo? Eu não..."::
1714::$$$message_0008_0013_0000$$$::Ela não saber como se vê aos olhos dos outros me deixa sem fala.[lr]::
1715::$$$message_0008_0013_0001$$$::Maldito, o que eu posso dizer para acalmá-la?::
1716::$$$message_0008_0014_0000$$$::[font italic=1]"Hmm hm hmm, oh yeah, o Grande Irm?o est? nos vendo, o Grande Irm?o est? nos ouvindo~"[rf]::
1717::$$$message_0008_0015_0000$$$::...Que diabos é isso que está sussurrando?[lr]::
1718::$$$message_0008_0015_0001$$$::A única pessoa que faria isso é óbvio...[lr]::
1719::$$$message_0008_0015_0002$$$::"É a Taiga. Ela está vindo aqui."[lr]::
1720::$$$message_0008_0015_0003$$$::"Que..."::
1721::$$$message_0008_0016_0000$$$::[font italic=1]"Somos todos filhos do Grande Irmão, então amamos o Grande Irmão, mas todos sabemos que na noite em que falamos do nosso amor, um carro preto virá~"[rf]::
1722::$$$message_0008_0017_0000$$$::"S-S-Saber! Seu traje!"[lr]::
1723::$$$message_0008_0017_0001$$$::"Sim...? [cacheimage storage=セイバー鎧08a(中)][wvl][chgfg textoff=0 time=200 storage=セイバー鎧08a(中)]Oh no, ela não pode me ver assim!"::
1724::$$$message_0008_0018_0000$$$::[font italic=1]"Vamos todos para a prisão, e aprendemos nas paredes cinzentas, que somos todos humanos, não somos os filhos do Grande Irmão, mas..."[rf]::
1725::$$$message_0008_0019_0000$$$::"Saber! Esconda-se aqui!"[lr]::
1726::$$$message_0008_0019_0001$$$::Eu empurro Saber para dentro do armário.[lr]::
1727::$$$message_0008_0019_0002$$$::"Shirou!?"::
1728::$$$message_0008_0020_0000$$$::"Oh no oh no, ratos, pare os ratos, ratos ratos! Oh no! Ratos![lr]::
1729::$$$message_0008_0020_0001$$$::Saber, você está aqui!?"::
1730::$$$message_0008_0021_0000$$$::"...Hmm? Shirou?"[lr]::
1731::$$$message_0008_0021_0001$$$::"[shock vmax=20 time=300 count=-3]Ei. Saber não está aqui."[lr]::
1732::$$$message_0008_0021_0002$$$::A voz nervosa quase quebra.::
1733::$$$message_0008_0022_0000$$$::"De verdade? Eu queria conversar com ela sobre compras hoje, Saber-chan.[lr]::
1734::$$$message_0008_0022_0001$$$::[chgfg textoff=0 storage=藤05b(中) time=300]Parece que você acha que só vamos fazer uma aventura épica provando comidas por aí, embora."[lr]::
1735::$$$message_0008_0022_0002$$$::"Hmm. Mas não é bom fazer isso de vez em quando?"::
1736::$$$message_0008_0023_0000$$$::"Ah. Você está de repente muito mais compreensivo do que antes.[lr]::
1737::$$$message_0008_0023_0001$$$::Boa criança, você cresceu tanto nos últimos trinta minutos [humming]"[lr]::
1738::$$$message_0008_0023_0002$$$::"É isso. Por isso é preciso vigiar bem os meninos.[lr]::
1739::$$$message_0008_0023_0003$$$::Bem, volta para o living, Fuji-Nee."::
1740::$$$message_0008_0024_0000$$$::"Ah ha ha, farei se você exigir.[lr]::
1741::$$$message_0008_0024_0001$$$::Mas o que você está fazendo no quarto da Saber-chan?"::
1742::$$$message_0008_0025_0000$$$::...Maldito, não consigo me livrar disso.[lr]::
1743::$$$message_0008_0025_0001$$$::Achei que tinha uma chance contra a Fuji-Nee, apesar disso!::
1744::$$$message_0008_0026_0000$$$::"Hmm, bem, vim trazer chá para a Saber.[lr]::
1745::$$$message_0008_0026_0001$$$::Acho que ela foi embora... Oh, por que não vai ver no dojô?"[lr]::
1746::$$$message_0008_0026_0002$$$::"Você trouxe chá e chocolates para ela, hein..."::
1747::$$$message_0008_0027_0000$$$::...Ela ignorou eu.[lr]::
1748::$$$message_0008_0027_0001$$$::Ah, espera. Como é mesmo aquele ditado sobre transformar desastre em sorte?[lr]::
1749::$$$message_0008_0027_0002$$$::Tenho um estoque secreto de trufas de chocolate. É um Fantasma Nobre limitado, mais do que suficiente para distrair a Fuji-Nee...!::
1750::$$$message_0008_0028_0000$$$::"Eu sei, por que não tomamos chá, Fuji-Nee?[lr]::
1751::$$$message_0008_0028_0001$$$::Se tivermos chá no terraço, o chocolate pode atrair Saber para fora."[lr]::
1752::$$$message_0008_0028_0002$$$::"..."::
1753::$$$message_0008_0029_0000$$$::Fuji-Nee olha para dentro do quarto.[lr]::
1754::$$$message_0008_0029_0001$$$::Segui seu olhar...[lr]::
1755::$$$message_0008_0029_0002$$$::A tábua sobre a mesa, uma bolsa de papel aberta no chão, e as roupas de Saber dobradas com cuidado no canto da sala.::
1756::$$$message_0008_0030_0000$$$::"!!!!!!!!!"::
1757::$$$message_0008_0031_0000$$$::"...Shirou?"[lr]::
1758::$$$message_0008_0031_0001$$$::Um tiro no pé, para dizer o que é.[lr]::
1759::$$$message_0008_0031_0002$$$::Ah... Queria ter anemia e desmaiar agora mesmo...::
1760::$$$message_0008_0032_0000$$$::"Meus grandes olhos de Onee-chan espionam a roupa que Saber-chan estava acabando de usar."[lr]::
1761::$$$message_0008_0032_0001$$$::"S-sim?[lr]::
1762::$$$message_0008_0032_0002$$$::Talvez ela tenha vários conjuntos dos roupões de Tohsaka porque gosta deles..."::
1763::$$$message_0008_0033_0000$$$::"Não. Ainda estão quentes, o que significa que ela só os tirou há pouco.[lr]::
1764::$$$message_0008_0033_0001$$$::Por que Saber-chan mudou de roupa?"[lr]::
1765::$$$message_0008_0033_0002$$$::"M-[wvl][shock vmax=15 time=300 count=-3]talvez ela esteja tomando banho?"[lr]::
1766::$$$message_0008_0033_0003$$$::"Ela foi para o banho nua?"[lr]::
1767::$$$message_0008_0033_0004$$$::"Hmm, hum..."::
1768::$$$message_0008_0034_0000$$$::"Ela está nessa sala, não está?"[lr]::
1769::$$$message_0008_0034_0001$$$::"..."[lr]::
1770::$$$message_0008_0034_0002$$$::"SHIIIIIIROOOOOOOU!!!"[rf]::
1771::$$$message_0008_0035_0000$$$::"Você vai atrair os vizinhos, Fuji-Nee!"[lr]::
1772::$$$message_0008_0035_0001$$$::"Cala a boca![lr]::
1773::$$$message_0008_0035_0002$$$::Os vizinhos são pessoas de bem, então não vão reclamar, mesmo que o barulho seja péssimo![lr]::
1774::$$$message_0008_0035_0003$$$::Mesmo que espadas estejam colidindo ou fogos de artifício estourando!"[lr]::
1775::$$$message_0008_0035_0004$$$::Isso é maravilhoso.[lr]::
1776::$$$message_0008_0035_0005$$$::Eles devem ser tão bons em se preocupar com seus próprios assuntos quanto os moradores da cidade.::
1777::$$$message_0008_0036_0000$$$::"Não, eu apostaria que eles desistiram porque você nunca para de fazer barulhos estranhos, Fuji-Nee!"[lr]::
1778::$$$message_0008_0036_0001$$$::"Não tente desviar da pergunta![lr]::
1779::$$$message_0008_0036_0002$$$::Atos sexuais impuros detectados![lr]::
1780::$$$message_0008_0036_0003$$$::Vamos, silenciosamente!"[lr]::
1781::$$$message_0008_0036_0004$$$::"Acabei de trazer o chá para ela! Você está entendendo errado!"::
1782::$$$message_0008_0037_0000$$$::"Ideia errada, shmong ideia!!![lr]::
1783::$$$message_0008_0037_0001$$$::Você tramou algum plano sujo para fazer a Saber-chan tirar a roupa, [cacheimage storage=藤05b(中)][wvl][chgfg textoff=0 time=300 storage=藤05b(中)]mas eu, serva da justiça, apareci, [cacheimage storage=藤10b(中)][wvl][chgfg textoff=0 time=300 storage=藤10b(中)]e vocês pensaram: "Já sei!" e enfiaram a Saber-chan no armário! [cacheimage storage=white,藤07a頬腕b(中),i衛宮邸_セイバー部屋][wvl][fadein time=100 storage=white][shock vmax=30 time=400 count=3][se storage=se106.wav][rep fliplr=0 storages=藤07a頬腕b(中) time=800 flipud=0 poss=c bg=i衛宮邸_セイバー部屋 indexes=1000]Isso está óbvio para mim há um minuto e vinte segundos...!"::
1784::$$$message_0008_0038_0000$$$::Errado! Tudo isso está errado, exceto por você estar certo sobre o armário![lr]::
1785::$$$message_0008_0038_0001$$$::Também, o que é com a quantidade de tempo tão específica!?::
1786::$$$message_0008_0039_0000$$$::"Bem, vou checar o armário.[lr]::
1787::$$$message_0008_0039_0001$$$::Eeehehehe. Espero que você esteja pronto para isso, Shirou."[lr]::
1788::$$$message_0008_0039_0002$$$::"..."[lr]::
1789::$$$message_0008_0039_0003$$$::Pronto para o quê?[lr]::
1790::$$$message_0008_0039_0004$$$::Urgh, eu queria só sumir...::
1791::$$$message_0008_0040_0000$$$::"Tudo bem agora, Saber-chan!"[lr]::
1792::$$$message_0008_0040_0001$$$::Um Servo normal se desmaterializaria.[lr]::
1793::$$$message_0008_0040_0002$$$::Mas Saber não pode se transformar em forma espiritual, então...::
1794::$$$message_0008_0041_0000$$$::"Hmm?"[lr]::
1795::$$$message_0008_0041_0001$$$::Argh, já tô acabado.[line len=2][lr]::
1796::$$$message_0008_0041_0002$$$::Isso também funciona.::
1797::$$$message_0008_0042_0000$$$::"Desculpe, adormeci.[lr]::
1798::$$$message_0008_0042_0001$$$::O que aconteceu, Taiga?"[lr]::
1799::$$$message_0008_0042_0002$$$::"Essa voz... É você, Saber-chan?"::
1800::$$$message_0008_0043_0000$$$::"O que você está fazendo no armário com um impermeável?"[lr]::
1801::$$$message_0008_0043_0001$$$::"Heh... Às vezes tenho vontade de fazê-lo."[lr]::
1802::$$$message_0008_0043_0002$$$::Que clima é esse?::
1803::$$$message_0008_0044_0000$$$::"Ó-óhhh, você está aí, Saber.[lr]::
1804::$$$message_0008_0044_0001$$$::Ha ha ha. Não percebi nada."[lr]::
1805::$$$message_0008_0044_0002$$$::"Hmm... Entendi."::
1806::$$$message_0008_0045_0000$$$::"Você estava tão envergonhado que escondeu-se de Shirou? Oh, Saber-chan, você é tão frágil assim!"[lr]::
1807::$$$message_0008_0045_0001$$$::"O que...?"[lr]::
1808::$$$message_0008_0045_0002$$$::"Mas eu gosto desse lado inocente seu."[lr]::
1809::$$$message_0008_0045_0003$$$::"E-eu estou falando sobre o que, Fuji-Nee?"::
1810::$$$message_0008_0046_0000$$$::"Então é hora de mostrá-lo para ele![lr]::
1811::$$$message_0008_0046_0001$$$::Shirou está destinado a estar interessado na minha opinião de Onee-chan! [cacheimage storage=藤06a(中)][wvl canskip=0 time=200][chgfg textoff=0 time=300 storage=藤06a(中)]Vá em frente, Saber-chan!"::
1812::$$$message_0008_0047_0000$$$::"Eu recuso."[lr]::
1813::$$$message_0008_0047_0001$$$::"Ói, Saber-chan!"::
1814::$$$message_0008_0048_0000$$$::"Parece que terei que usar força, Onee-chan."[lr]::
1815::$$$message_0008_0048_0001$$$::"Por favor, não. Você sabe muito bem que não é minha igual, Taiga."[lr]::
1816::$$$message_0008_0048_0002$$$::A atenção de Saber me pergunta o que fazer em seguida.::
1817::$$$message_0008_0049_0000$$$::"..."[lr]::
1818::$$$message_0008_0049_0001$$$::É uma escolha difícil.[lr]::
1819::$$$message_0008_0049_0002$$$::Mas não podemos deixar que Fuji-Nee descubra quem a Saber é de verdade.[lr]::
1820::$$$message_0008_0049_0003$$$::Fuji-Nee, Isso também é por ela.[lr]::
1821::$$$message_0008_0049_0004$$$::Faço o sinal de "vai" para ela, dizendo que está tudo bem.::
1822::$$$message_0008_0050_0000$$$::"Yaaaaah!"[lr]::
1823::$$$message_0008_0050_0001$$$::Com um esforço repentino, Fuji-Nee ataca Saber![lr]::
1824::$$$message_0008_0050_0002$$$::"Desculpe, Taiga."::
1825::$$$message_0008_0051_0000$$$::Os dois se empurram no cômodo apertado.[lr]::
1826::$$$message_0008_0051_0001$$$::Saber tem a vantagem absoluta na força de combate, mas...::
1827::$$$message_0008_0052_0000$$$::"Hehehe. Você me subestima, Saber-chan![lr]::
1828::$$$message_0008_0052_0001$$$::Pega isso! Técnica DOA em estilo Fujimura!"::
1829::$$$message_0008_0053_0000$$$::"Hmm, "Lançamento de Trufa Secreta"!"[lr]::
1830::$$$message_0008_0053_0001$$$::Um bloco preto traça uma parábola no ar.[lr]::
1831::$$$message_0008_0053_0002$$$::Isso é um dos bombons de chocolate!?::
1832::$$$message_0008_0054_0000$$$::"Nnn!"[lr]::
1833::$$$message_0008_0054_0001$$$::Habilidades físicas e visão excessivamente superiores são sua ruína.[lr]::
1834::$$$message_0008_0054_0002$$$::Saber persegue inconscientemente o chocolate.::
1835::$$$message_0008_0055_0000$$$::"Você está aberto! HIIIIIIYA!"::
1836::$$$message_0008_0056_0000$$$::"Ah[line len=2]!"[lr]::
1837::$$$message_0008_0056_0001$$$::...Acabou.::
1838::$$$message_0008_0057_0000$$$::"Hmm?"[lr]::
1839::$$$message_0008_0057_0001$$$::"Por que você está desperdiçando comida, Taiga!?"[lr]::
1840::$$$message_0008_0057_0002$$$::Saber, acelere e perceba.[lr]::
1841::$$$message_0008_0057_0003$$$::Agora, como vou explicar o armadura para a Fuji-Nee... É, não. Não consigo pensar em nada.::
1842::$$$message_0008_0058_0000$$$::"Saber-chan, você estava usando algo assim?"[lr]::
1843::$$$message_0008_0058_0001$$$::"O que você quer dizer com "isso"[line len=2][cacheimage storage=セイバー鎧06b(中)][wvl][chgfg textoff=0 time=200 storage=セイバー鎧06b(中)]! !![cacheimage storage=セイバー鎧10c(中)][wvl canskip=0 time=600][chgfg textoff=0 time=300 storage=セイバー鎧10c(中)]..."::
1844::$$$message_0008_0059_0000$$$::"...Um, Fuji-Nee. Isso é, er..."[lr]::
1845::$$$message_0008_0059_0001$$$::"Hmm. Acho que você se sentiria envergonhado de ser visto assim por Shirou. [cacheimage storage=藤08a(中)][wvl][chgfg textoff=0 storage=藤08a(中) time=300]Entendi, entendi."[lr]::
1846::$$$message_0008_0059_0002$$$::Hmm?::
1847::$$$message_0008_0060_0000$$$::"Fuji-Nee...você não está surpresa?"[lr]::
1848::$$$message_0008_0060_0001$$$::"Por que?"[lr]::
1849::$$$message_0008_0060_0002$$$::"Bem... é armadura.[lr]::
1850::$$$message_0008_0060_0003$$$::Armadura de placas, nesse caso."[lr]::
1851::$$$message_0008_0060_0004$$$::"Hmm. Excelente cosplayer, eu devo dizer."::
1852::$$$message_0008_0061_0000$$$::"Cos...play. ..?"[lr]::
1853::$$$message_0008_0061_0001$$$::"Ah..."::
1854::$$$message_0008_0062_0000$$$::"Você vê isso nas notícias às vezes.[lr]::
1855::$$$message_0008_0062_0001$$$::Isso deve ser um desses cosplays que estão na moda hoje, Onee-chan."[lr]::
1856::$$$message_0008_0062_0002$$$::É uma ideia pacífica que só alguém de um país pacífico e pacífico poderia ter.[lr]::
1857::$$$message_0008_0062_0003$$$::Não é maravilhoso a paz?::
1858::$$$message_0008_0063_0000$$$::"R...[wvl][shock vmax=10 time=300 count=-3]certo, é isso! É cosplay![lr]::
1859::$$$message_0008_0063_0001$$$::Isso não está bem feito?"[lr]::
1860::$$$message_0008_0063_0002$$$::"Serio. Até usar metal real."[lr]::
1861::$$$message_0008_0063_0003$$$::"Muita atenção foi dada aos detalhes!"[lr]::
1862::$$$message_0008_0063_0004$$$::"Temos alguém aqui com habilidade suficiente para fazer isso em Fuyuki?"[lr]::
1863::$$$message_0008_0063_0005$$$::"Cheguei! [wvl][shock vmax=20 time=300 count=-3]No celeiro!"::
1864::$$$message_0008_0064_0000$$$::"Faz sentido. Você é bom o suficiente com as mãos e também é paciente."[lr]::
1865::$$$message_0008_0064_0001$$$::"Foi difícil. Havia muitas vezes em que quase desisti."[lr]::
1866::$$$message_0008_0064_0002$$$::"Isso é notável! Estou orgulhoso de você como seu Guardião, Onee-chan.[lr]::
1867::$$$message_0008_0064_0003$$$::Pelo jeito, por que trabalhou tanto nisso?"[lr]::
1868::$$$message_0008_0064_0004$$$::"É um...algo que eles pediram no festival cultural."::
1869::$$$message_0008_0065_0000$$$::"Isso tem que ser mentira."[lr]::
1870::$$$message_0008_0065_0001$$$::"Nn!?"::
1871::$$$message_0008_0066_0000$$$::"Eu quero dizer, Saber-chan, você sempre usou aquilo."[lr]::
1872::$$$message_0008_0066_0001$$$::...O que?::
1873::$$$message_0008_0067_0000$$$::"Quando é que eu usei isso diante de você...?"[lr]::
1874::$$$message_0008_0067_0001$$$::"Quando você assiste a dramas históricos no almoço, ou quando está jogando jogos eletrônicos.[lr]::
1875::$$$message_0008_0067_0002$$$::[chgfg storage=藤04a(中) time=300]É como se você estivesse usando roupas de competição quando se mete de verdade em algo, Saber-chan."::
1876::$$$message_0008_0068_0000$$$::Então, um...[lr]::
1877::$$$message_0008_0068_0001$$$::Saber tem estado se deixando levar e transformando sem nem mesmo perceber...::
1878::$$$message_0008_0069_0000$$$::"É. E acho que fica bom em você, Saber-chan.[lr]::
1879::$$$message_0008_0069_0001$$$::Mas as garotas também precisam parecer fofas.[lr]::
1880::$$$message_0008_0069_0002$$$::[chgfg textoff=0 storage=藤10a(中) time=300]Você se deu ao trabalho de comprar um maiô, depois de tudo."[lr]::
1881::$$$message_0008_0069_0003$$$::"...Sim."::
1882::$$$message_0008_0070_0000$$$::"Faça com que ela fique com ele quando o momento chegar, Shirou.[lr]::
1883::$$$message_0008_0070_0001$$$::Mesmo Saber-chan ficaria incomodada se você fosse [font italic=true]demasiado[font italic=false] atrasado para florescer."[lr]::
1884::$$$message_0008_0070_0002$$$::"...Sim, senhora."::
1885::$$$message_0008_0071_0000$$$::Saber e eu somos repreendidos juntos.[lr]::
1886::$$$message_0008_0071_0001$$$::De qualquer forma, escapamos da desgraça e evitamos um mal-entendido... cobrindo-o com outro ainda mais estranho.::
1887::$$$message_0008_0072_0000$$$::"Agora, eu venci a Saber-chan em algo por uma vez, e estou de bom humor.[lr]::
1888::$$$message_0008_0072_0001$$$::[chgfg textoff=0 storage=藤06a(中) time=300]Ah, Shirou, estou levando o chá e os chocolates!"[lr]::
1889::$$$message_0008_0072_0002$$$::"...Claro."::
1890::$$$message_0008_0073_0000$$$::Fuji-Nee pega um copo de chá com entusiasmo.[lr]::
1891::$$$message_0008_0073_0001$$$::Tudo o que podemos fazer é assistir enquanto ela leva todas as trufas de chocolate.::
1892::$$$message_0008_0074_0000$$$::"Hmm, cosplay, hein... Acho que também está na moda aqui em casa..."[lr]::
1893::$$$message_0008_0074_0001$$$::"..."::
1894::$$$message_0008_0075_0000$$$::"Às vezes vejo a Sakura-chan usando pijamas pretos com listras vermelhas, e o Rider-san tem aquele maiô roxo apertado.[lr]::
1895::$$$message_0008_0075_0001$$$::[chgfg textoff=0 storage=藤08d(遠) time=300] talvez eu deva pensar em algo também... O que pareceria bom... Talvez aquele personagem mascarado..."::
1896::$$$message_0008_0076_0000$$$::"...Shirou."[lr]::
1897::$$$message_0008_0076_0001$$$::"Ah... É como um tic, né? Não tem jeito."[lr]::
1898::$$$message_0008_0076_0002$$$::"Sim, cuidarei a partir de agora..."::
1899::$$$message_0008_0077_0000$$$::"Não se culpe por isso.[lr]::
1900::$$$message_0008_0077_0001$$$::Ah, sim, então sobre aquele biquíni..."[lr]::
1901::$$$message_0008_0077_0002$$$::"Sim."[lr]::
1902::$$$message_0008_0077_0003$$$::"Tem um lugar mais apropriado para me mostrar do que este, certo?[lr]::
1903::$$$message_0008_0077_0004$$$::Quer ir à piscina em Shinto na próxima vez?"::
1904::$$$message_0008_0078_0000$$$::"..."[lr]::
1905::$$$message_0008_0078_0001$$$::Isso não combina comigo.[lr]::
1906::$$$message_0008_0078_0002$$$::Digo isso de repente, e depois passo a mão no queixo após o fato.::
1907::$$$message_0008_0079_0000$$$::"Bem, hum, ouvi dizer que tinha um novo piscina no Shinto, então..."[lr]::
1908::$$$message_0008_0079_0001$$$::Fica quieto por um momento.[lr]::
1909::$$$message_0008_0079_0002$$$::Saber inspira levemente.::
1910::$$$message_0008_0080_0000$$$::"Sim. Estaria feliz em acompanhá-la."[lr]::
1911::$$$message_0008_0080_0001$$$::E assim, ela aceita meu convite.::
901800::$$$message_9008_0043_0000$$$::"O que você está fazendo no armário com um impermeável?"[r]::
