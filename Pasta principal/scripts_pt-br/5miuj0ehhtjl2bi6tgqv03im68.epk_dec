DAT
id=qid::label=str::text=lstr::
42114::$$$message_0232_0000_0000$$$::"Ufa. Finalmente chegamos."::
42115::$$$message_0232_0001_0000$$$::"...[se storage=se551.wav]A conta está feita entre nós, por enquanto.[lr]::
42116::$$$message_0232_0001_0001$$$::Até a próxima, Executor. Ainda respeito sua força, mesmo sabendo o que você é agora."::
42117::$$$message_0232_0002_0000$$$::"Sella, Sella. Acabei de ouvir uma notícia incrível."::
42118::$$$message_0232_0002_0001$$$::"Ei, já terminou com o primeiro banho?[lr]::
42119::$$$message_0232_0002_0002$$$::Estou entrando se você já fez seu desejo!"::
42120::$$$message_0232_0003_0000$$$::"Ook-ook eek-eek!"::
42121::$$$message_0232_0003_0001$$$::"Ook-ook eek?"::
42122::$$$message_0232_0003_0002$$$::"Ei![lr]::
42123::$$$message_0232_0003_0003$$$::Eu nunca disse que você podia entrar...!"::
42124::$$$message_0232_0003_0004$$$::"Não consigo ouvir você![lr]::
42125::$$$message_0232_0003_0005$$$::É um banho misto, de qualquer forma! Não há razão para que um cara não possa participar do divertimento!"::
42126::$$$message_0232_0004_0000$$$::"Eek! Kee kee, shah shah shah!"::
42127::$$$message_0232_0004_0001$$$::"Angra, espera...!"::
42128::$$$message_0232_0004_0002$$$::"Onde está minha toalha?"::
42129::$$$message_0232_0004_0003$$$::"Hehehe, muito mole, muito lento, estou vindo pra saltar nos seus ossos! ...Espera, [hffacechg chara=アヴェンジャー face=呆 layer=1 time=200] [hfangry layer=1] [hfquake layer=message1 time=600 vmax=5 hmax=5 wait=0] que diabos!?"[nolr]::
42130::$$$message_0232_0005_0000$$$::"O mundo ficou escuro![lr]::
42131::$$$message_0232_0005_0001$$$::É a nossa vez finalmente?"::
42132::$$$message_0232_0005_0002$$$::"Kee! Kekeke, kee!"[lr]::
42133::$$$message_0232_0005_0003$$$::Você não se feriu, senhorita gentil? Em nome dos meus companheiros, lhe ofereço minhas sinceras desculpas.[nolr]::
42134::$$$message_0232_0006_0000$$$::"Ah, haah... Quase morri... [small]Isso é algum novo tipo de casca...?[rf]"[nolr]::
42135::$$$message_0232_0006_0001$$$::"Gah! Ninguém te convidou![lr]::
42136::$$$message_0232_0006_0002$$$::Cala a boca, seu maldito macaco!"::
42137::$$$message_0232_0006_0003$$$::"Kee! Ook ook eek!"[lr]::
42138::$$$message_0232_0006_0004$$$::Caralho, isso é um pênis minúsculo. Estou decepcionado, cara.[nolr]::
42139::$$$message_0232_0006_0005$$$::"Oh?"[nolr]::
42140::$$$message_0232_0007_0000$$$::"Parece que estamos falando disso, você esse maldito!?[lr]::
42141::$$$message_0232_0007_0001$$$::Também estou em modo de sobrevivência! Ainda não tive minha fase de crescimento!"::
42142::$$$message_0232_0007_0002$$$::"Tsc."[lr]::
42143::$$$message_0232_0007_0003$$$::Heh. Aqueles que são inseguros sempre falam assim.::
42144::$$$message_0232_0007_0004$$$::"...................................................[hffacechg chara=バゼット face=ニヤリ layer=1 time=200][se storage=se063.wav][hfsigh layer=1]Entendi."::
42145::$$$message_0232_0007_0005$$$::"Que nod de compaixão é esse!?[lr]::
42146::$$$message_0232_0007_0006$$$::Que vergonha! Nunca me senti tão envergonhada!"::
42147::$$$message_0232_0007_0007$$$::"Eek. Ook eek." [lr](Uma bela investida, senhorita. Vamos desfazer esse cão em cio. Por favor, aproveite o resort a seu belprazer.)::
42148::$$$message_0232_0007_0008$$$::"R-right... Obrigado."::
42149::$$$message_0232_0007_0009$$$::"Espere, tem ainda mais desses!?[lr]::
42150::$$$message_0232_0007_0010$$$::Foi eu!? [hfangry layer=1][se storage=se555.wav]Isso é culpa minha!?[lr]::
42151::$$$message_0232_0007_0011$$$::Eles estão loucos por eu ter tido vantagem!?"::
42152::$$$message_0232_0007_0012$$$::"...Isso mostra o que é, Aŋra.[lr]::
42153::$$$message_0232_0007_0013$$$::Estou sendo esmagado pelos próprios cadáveres... Tenho um Servo terrível, de fato."::
42154::$$$message_0232_0008_0000$$$::"...Então.[lr]::
42155::$$$message_0232_0008_0001$$$::Devo... [hfsweat layer=1] ajudá-lo?"::

