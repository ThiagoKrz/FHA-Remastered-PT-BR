DAT
id=qid::label=str::text=lstr::
42114::$$$message_0232_0000_0000$$$::"Ufa. Finalmente chegamos."::
42115::$$$message_0232_0001_0000$$$::"...[se storage=se551.wav]Por enquanto, estamos quites.[lr]::
42116::$$$message_0232_0001_0001$$$::Adeus, Executora. Ainda respeito sua força, mesmo agora sabendo o que você é."::
42117::$$$message_0232_0002_0000$$$::"Sella, Sella. Acabei de ouvir uma novidade incrível."::
42118::$$$message_0232_0002_0001$$$::"Ei, já terminou o primeiro banho!?[lr]::
42119::$$$message_0232_0002_0002$$$::Se já fez o seu pedido, eu vou entrar!"::
42120::$$$message_0232_0003_0000$$$::"Uuk-uuk iik-iik!"::
42121::$$$message_0232_0003_0001$$$::"Uuk-uuk iik?"::
42122::$$$message_0232_0003_0002$$$::"E-espera aí![lr]::
42123::$$$message_0232_0003_0003$$$::Eu não disse que você podia entrar...!"::
42124::$$$message_0232_0003_0004$$$::"Não consigo te ouvir![lr]::
42125::$$$message_0232_0003_0005$$$::De qualquer modo, o banho é misto! Não tem motivo para um cara ficar de fora da diversão!"::
42126::$$$message_0232_0004_0000$$$::"Iik! Kii kii, shaa shaa shaa!"::
42127::$$$message_0232_0004_0001$$$::"Aŋra, espera...!"::
42128::$$$message_0232_0004_0002$$$::"Cadê a m-minha toalha!?"::
42129::$$$message_0232_0004_0003$$$::"Hehehe, mole demais, lenta demais, tô chegando pra cair matando! ...Espera,[hffacechg chara=アヴェンジャー face=呆 layer=1 time=200][hfangry layer=1][hfquake layer=message1 time=600 vmax=5 hmax=5 wait=0] mas que diabos!?"[nolr]::
42130::$$$message_0232_0005_0000$$$::"O-o mundo escureceu![lr]::
42131::$$$message_0232_0005_0001$$$::A nossa hora finalmente chegou!?"::
42132::$$$message_0232_0005_0002$$$::"Kii! Kekeke, kii!"[lr]::
42133::$$$message_0232_0005_0003$$$::(Tradução: Estais ilesa, bela mademoiselle? Em nome de meus companheiros, apresento minhas sinceras desculpas.)[nolr]::
42134::$$$message_0232_0006_0000$$$::"Ah, haah... E-essa foi por pouco... [small]Isso é algum tipo novo de casca...?[rf]"[nolr]::
42135::$$$message_0232_0006_0001$$$::"Gah! Ninguém convidou vocês![lr]::
42136::$$$message_0232_0006_0002$$$::Saiam de cima de mim, seus macacos malditos!"::
42137::$$$message_0232_0006_0003$$$::"Kii! Uuk uuk iik!"[lr]::
42138::$$$message_0232_0006_0004$$$::(Tradução: Putz, que coisinha minúscula. Tô decepcionado, parceiro.)[nolr]::
42139::$$$message_0232_0006_0005$$$::"Ah?"[nolr]::
42140::$$$message_0232_0007_0000$$$::"Peraí, por que a gente tá falando disso, seu merdinha!?[lr]::
42141::$$$message_0232_0007_0001$$$::Além disso, eu tô em modo de sobrevivência! Ainda nem tive meu estirão de crescimento!"::
42142::$$$message_0232_0007_0002$$$::"Iik."[lr]::
42143::$$$message_0232_0007_0003$$$::(Tradução: Heh. Homem inseguro sempre fala isso.)::
42144::$$$message_0232_0007_0004$$$::"...................................................[hffacechg chara=バゼット face=ニヤリ layer=1 time=200][se storage=se063.wav][hfsigh layer=1]Entendo."::
42145::$$$message_0232_0007_0005$$$::"Que foi esse aceno de pena!?[lr]::
42146::$$$message_0232_0007_0006$$$::Que humilhação! Nunca senti tanta vergonha!"::
42147::$$$message_0232_0007_0007$$$::"Iik. Uuk iik." [lr](Tradução: Belo golpe, mademoiselle. Daremos fim a este cão no cio. Por favor, desfrute do resort à vontade.)::
42148::$$$message_0232_0007_0008$$$::"C-certo... Obrigada."::
42149::$$$message_0232_0007_0009$$$::"Espera, ainda tem mais deles!?[lr]::
42150::$$$message_0232_0007_0010$$$::Fui eu!? [hfangry layer=1][se storage=se555.wav]Isso é culpa minha!?[lr]::
42151::$$$message_0232_0007_0011$$$::Eles tão bravos porque eu larguei na frente!?"::
42152::$$$message_0232_0007_0012$$$::"...Isso só mostra uma coisa, Aŋra.[lr]::
42153::$$$message_0232_0007_0013$$$::Massacrado pelas próprias cascas... Tenho mesmo um Servo temível."::
42154::$$$message_0232_0008_0000$$$::"...Então.[lr]::
42155::$$$message_0232_0008_0001$$$::Será que...[hfsweat layer=1]eu devia ajudar?"::

