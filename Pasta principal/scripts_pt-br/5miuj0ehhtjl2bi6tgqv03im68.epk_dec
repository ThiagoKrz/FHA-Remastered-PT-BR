DAT
id=qid::label=str::text=lstr::
42114::$$$message_0232_0000_0000$$$::"Ufa. Finalmente chegamos."::
42115::$$$message_0232_0001_0000$$$::"...[se storage=se551.wav]Por enquanto, estamos quites.[lr]::
42116::$$$message_0232_0001_0001$$$::Adeus, Executora. Eu ainda respeito sua força, mesmo sabendo o que você é agora."::
42117::$$$message_0232_0002_0000$$$::"Sella, Sella. Eu acabei de ouvir uma novidade incrível."::
42118::$$$message_0232_0002_0001$$$::"Ei, você já terminou aí no primeiro banho!?[lr]::
42119::$$$message_0232_0002_0002$$$::Estou entrando se você já fez o seu pedido!"::
42120::$$$message_0232_0003_0000$$$::"Uuk-uuk iik-iik!"::
42121::$$$message_0232_0003_0001$$$::"Uuk-uuk iik?"::
42122::$$$message_0232_0003_0002$$$::"E-espera aí![lr]::
42123::$$$message_0232_0003_0003$$$::Eu não disse que você podia entrar...!"::
42124::$$$message_0232_0003_0004$$$::"Não consigo te ouvir![lr]::
42125::$$$message_0232_0003_0005$$$::De qualquer modo, o banho é misto! Não há motivos de um cara não poder se juntar à diversão!"::
42126::$$$message_0232_0004_0000$$$::"Iik! Kii kii, shaa shaa shaa!"::
42127::$$$message_0232_0004_0001$$$::"Aŋra, espera...!"::
42128::$$$message_0232_0004_0002$$$::"Cadê a m-minha toalha!?"::
42129::$$$message_0232_0004_0003$$$::"Hehehe, macia demais, devagar demais, tô chegando pra pular nos seus ossos! ...Espera,[hffacechg chara=アヴェンジャー face=呆 layer=1 time=200][hfangry layer=1][hfquake layer=message1 time=600 vmax=5 hmax=5 wait=0] mas o que diabos!?"[nolr]::
42130::$$$message_0232_0005_0000$$$::"O-o mundo escureceu![lr]::
42131::$$$message_0232_0005_0001$$$::A nossa hora finalmente chegou!?"::
42132::$$$message_0232_0005_0002$$$::"Kii! Kekeke, kii!"[lr]::
42133::$$$message_0232_0005_0003$$$::(Tradução: Estás ilesa, bela senhorita? Em nome de meus semelhantes, estendo minhas mais sinceras desculpas.)[nolr]::
42134::$$$message_0232_0006_0000$$$::"Ah, haah... E-essa foi por pouco... [small]Esse é algum tipo novo de casca...?[rf]"[nolr]::
42135::$$$message_0232_0006_0001$$$::"Gah! Ninguém convidou vocês![lr]::
42136::$$$message_0232_0006_0002$$$::Saiam de cima de mim, seus macacos malditos!"::
42137::$$$message_0232_0006_0003$$$::"Kii! Uuk uuk iik!"[lr]::
42138::$$$message_0232_0006_0004$$$::(Tradução: Que droga, é uma minhoquinha minúscula. Estou decepcionado, irmão.)[nolr]::
42139::$$$message_0232_0006_0005$$$::"Ah?"[nolr]::
42140::$$$message_0232_0007_0000$$$::"Pera, por que estamos falando sobre isso, seu merdinha!?[lr]::
42141::$$$message_0232_0007_0001$$$::Além disso, eu estou no modo de sobrevivência! Eu ainda não tive meu estirão de crescimento!"::
42142::$$$message_0232_0007_0002$$$::"Iik."[lr]::
42143::$$$message_0232_0007_0003$$$::(Tradução: Heh. Caras inseguros sempre falam isso.)::
42144::$$$message_0232_0007_0004$$$::"...................................................[hffacechg chara=バゼット face=ニヤリ layer=1 time=200][se storage=se063.wav][hfsigh layer=1]Entendo."::
42145::$$$message_0232_0007_0005$$$::"Qualé a desse aceno de cabeça de pena!?[lr]::
42146::$$$message_0232_0007_0006$$$::Que desgraça! Eu nunca me senti tão envergonhado!"::
42147::$$$message_0232_0007_0007$$$::"Iik. Uuk iik." [lr](Tradução: Um belo golpe, mademoiselle. Iremos descartar este cão no cio. Por favor, desfrute do resort quando quiser.)::
42148::$$$message_0232_0007_0008$$$::"C-certo... Obrigada."::
42149::$$$message_0232_0007_0009$$$::"Espera, tem ainda mais deles!? [lr]::
42150::$$$message_0232_0007_0010$$$::Fui eu!? [hfangry layer=1][se storage=se555.wav]Isso é culpa minha!?[lr]::
42151::$$$message_0232_0007_0011$$$::Eles estão bravos que eu ganhei uma vantagem!?"::
42152::$$$message_0232_0007_0012$$$::"...Isso só serve para te mostrar, Aŋra.[lr]::
42153::$$$message_0232_0007_0013$$$::Sendo massacrado pelas suas próprias cascas... Tenho um Servo temível, de fato."::
42154::$$$message_0232_0008_0000$$$::"...Então.[lr]::
42155::$$$message_0232_0008_0001$$$::Será que...[hfsweat layer=1]Eu devo ajudar ele?"::

