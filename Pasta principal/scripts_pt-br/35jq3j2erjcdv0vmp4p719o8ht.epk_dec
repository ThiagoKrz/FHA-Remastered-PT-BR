DAT
id=qid::label=str::text=lstr::
44979::$$$message_0399_0000_0000$$$::"Ah, é você, Rider."::
44980::$$$message_0399_0000_0001$$$::"Ah, Saber! Que coincidência...[wvl canskip=false time=100][hffgchg2 chara=ライダー4th face=真剣 pos=right time=300 twno=1] Ou talvez não."::
44981::$$$message_0399_0000_0002$$$::"Ei, é o garotinho."::
44982::$$$message_0399_0000_0003$$$::"..."::
44983::$$$message_0399_0000_0004$$$::"Qual é o problema?"::
44984::$$$message_0399_0000_0005$$$::"...Está falando de mim?"::
44985::$$$message_0399_0000_0006$$$::"Bom, é claro que não estou falando do Rider."::
44986::$$$message_0399_0000_0007$$$::"Que grosseria! Eu tenho nome, sabia! É Waver Velvet!"::
44987::$$$message_0399_0000_0008$$$::"Aww, você é uma graça. A Illya é fofa, mas eu também teria gostado de ter um filho..."::
44988::$$$message_0399_0000_0009$$$::"Nnrrrgh..."::
44989::$$$message_0399_0000_0010$$$::"Não baixe a guarda, Iri."::
44990::$$$message_0399_0000_0011$$$::"Kiritsugu?"::
44991::$$$message_0399_0000_0012$$$::"Ao contrário do que parece, o Mestre de Rider é cauteloso e audacioso..."::
44992::$$$message_0399_0000_0013$$$::"...homem?[wvl canskip=false time=300] Você é homem, certo?"::
44993::$$$message_0399_0000_0014$$$::"[font italic=true]Como isso sequer vira pergunta!?[font italic=false] Sim, sou cem por cento homem!"::
44994::$$$message_0399_0000_0015$$$::"Veja bem, garoto. Não é bom ser baixo. Você precisa ganhar mais uns trinta centímetros... E botar um pouco de carne nesses ossos também."::
44995::$$$message_0399_0000_0016$$$::"Grrrrrr..."::
44996::$$$message_0399_0000_0017$$$::"Não, Rider! Aí ele deixaria de ser fofo!"::
44997::$$$message_0399_0000_0018$$$::"O garoto não precisa ser adorável. Precisa treinar o corpo até ficar duro como aço!"::
44998::$$$message_0399_0000_0019$$$::"Isso seria um desperdício! O pequeno Waver deve continuar adorável para sempre![wvl canskip=false time=100][hffgchg2 chara=アイリ face=喜 pos=left time=400 twno=1]Você não acha, Saber!?"::
44999::$$$message_0399_0000_0020$$$::"Hã? Ah, hum, eu não ligo muito..."::
45000::$$$message_0399_0000_0021$$$::"Pessoalmente, acho que ele deveria mudar o penteado."::
45001::$$$message_0399_0000_0022$$$::"Hã?"::
45002::$$$message_0399_0000_0023$$$::"...Receio acabar confundindo você com minha assistente, Maiya."::
45003::$$$message_0399_0000_0024$$$::"Ah..."::
45004::$$$message_0399_0000_0025$$$::"AAARGH! CHEGA! Vocês acham que podem falar o que quiserem de mim!?"::
45005::$$$message_0399_0000_0026$$$::"Vamos lutar! Joguem logo suas cartas!"::
45006::$$$message_0399_0000_0027$$$::"Fico com pena dele, mesmo sendo nosso inimigo..."::
