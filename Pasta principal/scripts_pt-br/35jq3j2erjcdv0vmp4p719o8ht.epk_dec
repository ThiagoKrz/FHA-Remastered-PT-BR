DAT
id=qid::label=str::text=lstr::
44979::$$$message_0399_0000_0000$$$::"Oh, é você, Rider."::
44980::$$$message_0399_0000_0001$$$::"Ah, Saber! Que coincidência... [wvl canskip=false time=100] [hffgchg2 chara=ライダー4th face=真剣 pos=right time=300 twno=1] Ou talvez não."::
44981::$$$message_0399_0000_0002$$$::"Ei, é o meninozinho."::
44982::$$$message_0399_0000_0003$$$::"..."::
44983::$$$message_0399_0000_0004$$$::"O que há de errado?"::
44984::$$$message_0399_0000_0005$$$::"...Você está falando de mim?"::
44985::$$$message_0399_0000_0006$$$::"Bem, claro que não quero dizer Rider."::
44986::$$$message_0399_0000_0007$$$::"Isso é muito rude! Eu tenho um nome, sabe! É Waver Velvet!"::
44987::$$$message_0399_0000_0008$$$::"Aww, você é tão adorável. Illya é fofo, mas eu também teria gostado de ter um filho..."::
44988::$$$message_0399_0000_0009$$$::"Nnrrrgh..."::
44989::$$$message_0399_0000_0010$$$::"Não abaixe a guarda, Iri."::
44990::$$$message_0399_0000_0011$$$::"Kiritsugu?"::
44991::$$$message_0399_0000_0012$$$::"Contrário às aparências, o Mestre da Rider é cauteloso e ousado..."::
44992::$$$message_0399_0000_0013$$$::"...homem? [wvl canskip=false time=300] Você é um homem, certo?"::
44993::$$$message_0399_0000_0014$$$::"[font italic=true]Como é que essa é até uma pergunta!?[font italic=false] Sim, sou 100% homem!"::
44994::$$$message_0399_0000_0015$$$::"Veja, garoto? Não é bom ser baixo. Você precisa ganhar uns trinta centímetros mais... E colocar um pouco de carne nesses ossos também."::
44995::$$$message_0399_0000_0016$$$::"Grrrrrr..."::
44996::$$$message_0399_0000_0017$$$::"Não, Rider! Então ele não será mais fofo!"::
44997::$$$message_0399_0000_0018$$$::"A garota não precisa ser amável. Ela precisa treinar o corpo para ser tão dura quanto aço!"::
44998::$$$message_0399_0000_0019$$$::"Isso seria um desperdício! A pequena Waver deveria ficar adorável para sempre! [wvl canskip=false time=100][hffgchg2 chara=アイリ face=喜 pos=left time=400 twno=1]Você não acha, Saber!?"::
44999::$$$message_0399_0000_0020$$$::"Hmm? Ué, um, eu não me importo muito..."::
45000::$$$message_0399_0000_0021$$$::"Pessoalmente, acho que ele deveria mudar o cabelo."::
45001::$$$message_0399_0000_0022$$$::"Eh?"::
45002::$$$message_0399_0000_0023$$$::"...Tenho medo de ter te confundido com minha assistente Maiya."::
45003::$$$message_0399_0000_0024$$$::"Ah..."::
45004::$$$message_0399_0000_0025$$$::"ARRRGH! ACABEI COM ISSO! Vocês todos acham que podem dizer o que quiserem sobre mim!?!"::
45005::$$$message_0399_0000_0026$$$::"Vamos lutar! Jogue suas cartas!"::
45006::$$$message_0399_0000_0027$$$::"Sinto pena dele, mesmo que ele seja nosso inimigo..."::

