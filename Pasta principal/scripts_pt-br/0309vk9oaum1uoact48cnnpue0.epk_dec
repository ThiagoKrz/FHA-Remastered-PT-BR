DAT
id=qid::label=str::text=lstr::
45135::$$$message_0406_0000_0000$$$::"Você finalmente identificou o culpado, Kayneth."::
45136::$$$message_0406_0000_0001$$$::"Einzbern... Kiritsugu Emiya... Eu nunca vou perdoar você! Já chega com as cartas de flores! É a pena de morte.[line len=2]"::
45137::$$$message_0406_0000_0002$$$::"Kayneth. Você não veio para Fuyuki em busca de vingança, foi?"::
45138::$$$message_0406_0000_0003$$$::"Você não deveria se concentrar mais em si mesmo? Tente gerenciar o estresse, melhorar a circulação com massagens ou comer algas marinhas."::
45139::$$$message_0406_0000_0004$$$::"Alga? Espera, calma. Por que estou aqui, afinal?"::
45140::$$$message_0406_0000_0005$$$::"Senhora Sola-Ui. Talvez você deveria parar por aí."::
45141::$$$message_0406_0000_0006$$$::"Qualquer coisa além disso seria uma ofensa ao meu senhor. Como seu cavaleiro, não suportarei mais insultos."::
45142::$$$message_0406_0000_0007$$$::"Ah, não queria..."::
45143::$$$message_0406_0000_0008$$$::"Meu senhor escolheu o caminho mais [font italic=true]áspero e desolado[font italic=false] em busca de fortuna e glória."::
45144::$$$message_0406_0000_0009$$$::"Lamento... Não deveria ter dito isso, Kayneth. Você está tudo bem como é."::
45145::$$$message_0406_0000_0010$$$::"Vocês dois são realmente chatos, sabem disso?"::

