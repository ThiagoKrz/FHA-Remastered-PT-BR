DAT
id=qid::label=str::text=lstr::
45267::$$$message_0413_0000_0000$$$::"Vocês são..."::
45268::$$$message_0413_0000_0001$$$::"Oh?"::
45269::$$$message_0413_0000_0002$$$::"Mamãe!?"::
45270::$$$message_0413_0000_0003$$$::"Mrgh..."::
45271::$$$message_0413_0000_0004$$$::"Papai!"::
45272::$$$message_0413_0000_0005$$$::"O que vocês estão fazendo aqui...!? Pai, achei que você estivesse numa viagem de negócios no exterior."::
45273::$$$message_0413_0000_0006$$$::"Além disso, vocês dois parecem meio jovens..."::
45274::$$$message_0413_0000_0007$$$::"Estão nos confundindo com outras pessoas? Sinto muito, mocinhas, mas não somos seus pais."::
45275::$$$message_0413_0000_0008$$$::"Ela acabou de nos renegar!?"::
45276::$$$message_0413_0000_0009$$$::"Esse não é o seu tom bobo de sempre! Mesmo que seja brincadeira, é muito cruel, Mamãe!"::
45277::$$$message_0413_0000_0010$$$::"Como eu disse, estão enganadas. Embora eu tenha uma filha, ela é mais nova que vocês. Minha preciosa menininha é a coisa mais fofa do mundo."::
45278::$$$message_0413_0000_0011$$$::"Hm... E-eu devia ficar brava, ou envergonhada...?"::
45279::$$$message_0413_0000_0012$$$::"Espera, Mamãe! Já chega!"::
45280::$$$message_0413_0000_0013$$$::"Parem aí. Não cheguem mais perto."::
45281::$$$message_0413_0000_0014$$$::"Wah!?"::
45282::$$$message_0413_0000_0015$$$::"Para trás, Illya! Essa pessoa é... forte!"::
45283::$$$message_0413_0000_0016$$$::"Que diabos, Mamãe!? Não reconhece a gente!?"::
45284::$$$message_0413_0000_0017$$$::"Mamãe, Papai! Sou eu, Illya!"::
45285::$$$message_0413_0000_0018$$$::"Illya...? V-você se parece com ela, mas não pode ser..."::
45286::$$$message_0413_0000_0019$$$::"Não caia nessa, Iri. É desinformação inimiga. Aquela... não é a Illya."::
45287::$$$message_0413_0000_0020$$$::"C-certo. Não há como ela estar aqui...[wvl canskip=false time=400][hffgchg2 chara=アイリ face=喜 pos=right time=400 twno=1] Na verdade, agora que olho bem, ela não se parece nada com a Illya."::
45288::$$$message_0413_0000_0021$$$::"Ei!"::
45289::$$$message_0413_0000_0022$$$::"É só uma semelhança superficial. Mas, acima de tudo, nossa filha jamais usaria uma roupa tão escandalosa."::
45290::$$$message_0413_0000_0023$$$::"Eu sei que as roupas dela são constrangedoras, mas isso foi maldade, Papai!"::
45291::$$$message_0413_0000_0024$$$::"Não estamos vestidas assim porque queremos!"::
45292::$$$message_0413_0000_0025$$$::(Então elas acham mesmo essas roupas constrangedoras...)::
45293::$$$message_0413_0000_0026$$$::"Não sei qual Mestre vocês são, mas é vergonhoso fingirem ser nossas filhas. Mostrem-nos quem realmente são!"::
45294::$$$message_0413_0000_0027$$$::"Lá vêm eles, Illya!"::
45295::$$$message_0413_0000_0028$$$::"Waaah, será que nossa família vai se despedaçar!?"::
45296::$$$message_0413_0000_0029$$$::"Tá bom, se vão ser assim, então vamos mostrar a nossa fase rebelde!"::
