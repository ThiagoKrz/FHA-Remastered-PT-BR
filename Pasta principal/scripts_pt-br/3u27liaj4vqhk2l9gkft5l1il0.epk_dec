DAT
id=qid::label=str::text=lstr::
45267::$$$message_0413_0000_0000$$$::"Você..."::
45268::$$$message_0413_0000_0001$$$::"Oh?"::
45269::$$$message_0413_0000_0002$$$::"Mamãe!?"::
45270::$$$message_0413_0000_0003$$$::"Mrg..."::
45271::$$$message_0413_0000_0004$$$::"Papa!"::
45272::$$$message_0413_0000_0005$$$::"O que você está fazendo aqui...!? Pai, eu pensei que estivesse em uma viagem de negócios no exterior."::
45273::$$$message_0413_0000_0006$$$::"Também, vocês dois parecem um pouco novos..."::
45274::$$$message_0413_0000_0007$$$::"Você está nos confundindo com alguém else? Lamento, senhoras, mas não somos suas mães."::
45275::$$$message_0413_0000_0008$$$::"Ela nos deserdou então?"::
45276::$$$message_0413_0000_0009$$$::"O seu tom não é o usual de bobo! Mesmo que seja uma brincadeira, é realmente cruel, Mama!"::
45277::$$$message_0413_0000_0010$$$::"Como eu disse, você está errado. Embora eu tenha uma filha, ela é mais nova do que você. Minha preciosa bebê é a mais linda do mundo."::
45278::$$$message_0413_0000_0011$$$::"Um... Sh-estou furioso ou envergonhado...?"::
45279::$$$message_0413_0000_0012$$$::"Espere, mãe! Isso é suficiente!"::
45280::$$$message_0413_0000_0013$$$::"Para cá, não. Não se aproxime."::
45281::$$$message_0413_0000_0014$$$::"Ah!?"::
45282::$$$message_0413_0000_0015$$$::"Volte, Illya! Esta pessoa é... forte!"::
45283::$$$message_0413_0000_0016$$$::"Que diabos, Mama!? Não nos reconhece?"::
45284::$$$message_0413_0000_0017$$$::"Mamãe, papai! Sou eu, Illya!"::
45285::$$$message_0413_0000_0018$$$::"Illya...? Você parece com ela, mas não pode ser..."::
45286::$$$message_0413_0000_0019$$$::"Não caia nisso, Iri. Isso é disinformação inimiga. Aquilo...não é Illya."::
45287::$$$message_0413_0000_0020$$$::"R-right. Não há jeito algum de ela estar aqui... [wvl canskip=false time=400] [hffgchg2 chara=アイリ face=喜 pos=right time=400 twno=1] Na verdade, agora que consigo ver bem nela, ela não parece em nada Illya."::
45288::$$$message_0413_0000_0021$$$::"Ei!"::
45289::$$$message_0413_0000_0022$$$::"É apenas uma semelhança superficial. Mas, acima de tudo, nossa filha jamais usaria um figurino tão escandaloso."::
45290::$$$message_0413_0000_0023$$$::"Eu sei que suas roupas são envergonhantes, mas isso é cruel, Papai!"::
45291::$$$message_0413_0000_0024$$$::"Nós não estamos usando essas coisas porque queremos!"::
45292::$$$message_0413_0000_0025$$$::Então eles acham seus trajes envergonhantes...::
45293::$$$message_0413_0000_0026$$$::"Eu não sei qual é o seu Mestre, mas é desonrosa a sua pretensão de ser nosso filho. Mostre-nos quem você realmente é!"::
45294::$$$message_0413_0000_0027$$$::"Eles estão aqui, Illya!"::
45295::$$$message_0413_0000_0028$$$::"Waaah, nossa família vai se desmanchar então!?"::
45296::$$$message_0413_0000_0029$$$::"Bem, se vai ser assim, então mostraremos nossa fase rebeldes!"::

