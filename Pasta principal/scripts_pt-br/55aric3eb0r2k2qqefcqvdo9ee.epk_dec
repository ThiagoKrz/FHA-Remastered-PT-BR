DAT
id=qid::label=str::text=lstr::
45146::$$$message_0407_0000_0000$$$::"Emiya Kiritsugu! Finalmente ousa aparecer diante de mim, seu canalha! Jamais deixarei que fique com o realizador de desejos! Isto é por ter incendiado minha oficina!"::
45147::$$$message_0407_0000_0001$$$::"É só encomendar outra."::
45148::$$$message_0407_0000_0002$$$::"VÁ SE FERRAR! [wvl canskip=false time=400][hffgchg2 chara=ケイネス face=怒2 pos=left time=400 twno=2][hfangry layer=0]Como ousa! Lixo como você não merece vencer! Provarei com este hanafuda que eu sou o melhor!"::
45149::$$$message_0407_0000_0003$$$::"Obrigado por vir até aqui. Desculpa, Iri."::
45150::$$$message_0407_0000_0004$$$::"Eu sei, Kiritsugu. Vamos começar destruindo a Projeção de Realidade na testa dele."::
45151::$$$message_0407_0000_0005$$$::"REEEEEE!"::
45152::$$$message_0407_0000_0006$$$::"Kayneth, o inimigo tem cabelo longo! Quer dizer, longo alcance! Um passo em falso e seus folículos, digo, seu couro cabeludo, ah, er..."::
45153::$$$message_0407_0000_0007$$$::"Você também não, Sola-Ui!"::
45154::$$$message_0407_0000_0008$$$::"Ansiava por este momento... Somos os dois últimos Servos! É hora de resolver isto, Lancer!"::
45155::$$$message_0407_0000_0009$$$::"Nada me faria mais feliz, Saber!"::
45156::$$$message_0407_0000_0010$$$::"Espere, Lancer. Seu papel aqui terminou. Eu disse que lutarei."::
45157::$$$message_0407_0000_0011$$$::"Mas, meu senhor!"::
45158::$$$message_0407_0000_0012$$$::"Se Lancer não empunhar suas lanças, não tenho razão para erguer minha espada."::
45159::$$$message_0407_0000_0013$$$::"O quê..?[wvl canskip=false time=400][hffgchg2 chara=切嗣 face=笑顔 pos=center time=300 twno=1][hfsigh layer=2] Certo. Então vou usar um Selo de Comando para obrigar você a acabar com ele."::
45160::$$$message_0407_0000_0014$$$::"Kiritsugu! Não acredito nisso!"::
45161::$$$message_0407_0000_0015$$$::"Hmm, não sei se Selos de Comando funcionam neste jogo, mas já não temos nenhum."::
45162::$$$message_0407_0000_0016$$$::"Oh?"::
45163::$$$message_0407_0000_0017$$$::"Estávamos num restaurante de sushi, churrasco e patas de caranguejo à vontade, então precisei usar todos para arrastar a Saber para longe. A comida era boa, pelo menos."::
45164::$$$message_0407_0000_0018$$$::"Ma..."::
45165::$$$message_0407_0000_0019$$$::"Maiya! Preciso de você aqui, Maiya!"::
45166::$$$message_0407_0000_0020$$$::"Lorde Kayneth, por favor, reconsidere!"::
45167::$$$message_0407_0000_0021$$$::"Hmph. De que serve uma cavalaria vazia? Meus feitos provaram que sou digno de ser seu Mestre?"::
45168::$$$message_0407_0000_0022$$$::"Lorde Kayneth..."::
45169::$$$message_0407_0000_0023$$$::"Você me serviu bem, Diarmuid Ua Duibhne. Agora é minha vez de retribuir sua lealdade. Um nobre deve carregar o peso de todos que o servem, pondo-se na linha de frente."::
45170::$$$message_0407_0000_0024$$$::"Não me peça que abandone minha cavalaria."::
45171::$$$message_0407_0000_0025$$$::"Senhor..."::
45172::$$$message_0407_0000_0026$$$::"...Não posso obedecer, meu senhor. Nada é mais importante para mim que o juramento de lhe trazer a vitória."::
45173::$$$message_0407_0000_0027$$$::"Por favor, perdoe a insolência de lutar ao seu lado!"::
45174::$$$message_0407_0000_0028$$$::"Tolo cego. Faça como quiser."::
45175::$$$message_0407_0000_0029$$$::"Que alegria inesperada. Você escolheu o homem errado para servir, Saber!"::
45176::$$$message_0407_0000_0030$$$::"Isso eu já sei! E daí!?"::
45177::$$$message_0407_0000_0031$$$::"Digo que sua cavalaria trágica não é digna de cruzar lâminas com minha lança. Esta toupeira basta."::
45178::$$$message_0407_0000_0032$$$::"Aww..."::

