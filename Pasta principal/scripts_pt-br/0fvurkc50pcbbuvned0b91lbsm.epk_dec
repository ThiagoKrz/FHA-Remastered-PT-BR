DAT
id=qid::label=str::text=lstr::
42319::$$$message_0333_0000_0000$$$::"Hahaha, isso foi moleza![lr]::
42320::$$$message_0333_0000_0001$$$::Deixando de lado por que nos atacaram sem motivo nenhum, foi fácil demais!"::
42321::$$$message_0333_0000_0002$$$::"Parecia mais que eles tinham vindo acertar uma rusga pessoal do que disputar o onsen, mas deve ter sido impressão minha."::
42322::$$$message_0333_0000_0003$$$::"Urgh."::
42323::$$$message_0333_0001_0000$$$::"Achei vocês, trio terrível!"::
42324::$$$message_0333_0002_0000$$$::"...! Pra trás, Yukika!"::
42325::$$$message_0333_0002_0001$$$::"Aaaah!"::
42326::$$$message_0333_0003_0000$$$::"...Foi por pouco.[lr]::
42327::$$$message_0333_0003_0001$$$::Só um pouquinho mais perto e você teria virado panqueca."::
42328::$$$message_0333_0004_0000$$$::"Ora, se não são as criadas que vivem lá pela casa do Emiya.[lr]::
42329::$$$message_0333_0004_0001$$$::Vocês também estão atrás do onsen?"::
42330::$$$message_0333_0004_0002$$$::"...Sim. Finalmente ganhamos um dia de folga.[lr]::
42331::$$$message_0333_0004_0003$$$::A Sella está ansiosa para experimentar um onsen japonês."::
42332::$$$message_0333_0004_0004$$$::"Ah? Se vocês duas também entraram nisso, então talvez o boato de que desejos se realizam não seja só conversa fiada..."::
42333::$$$message_0333_0004_0005$$$::"Que tal? A gente não quer brigar com vocês. Por que não fazemos um acordo, como coadjuvantes que somos?"::
42334::$$$message_0333_0004_0006$$$::".........Que insolência.[lr]::
42335::$$$message_0333_0004_0007$$$::Não temos tempo a desperdiçar cooperando com vocês."::
42336::$$$message_0333_0004_0008$$$::"(Assente)[lr]::
42337::$$$message_0333_0004_0009$$$::Valentões devem morrer. [wvl canskip=0 time=600][hffacechg chara=リズ face=喜 layer=0 time=200][hfpop layer=0]Mas mandaram bem fazendo a Sella chorar."::
42338::$$$message_0333_0004_0010$$$::"...Depois posso ficar com esses negativos?"::
42339::$$$message_0333_0004_0011$$$::"Cale-se, Leysritt!"::
42340::$$$message_0333_0004_0012$$$::"...Chega de conversa.[lr]::
42341::$$$message_0333_0004_0013$$$::Vamos vencer esta luta e destruir as provas. Prepare-se, Yukika Saegusa!"::
42342::$$$message_0333_0004_0014$$$::"Hã?"::
42343::$$$message_0333_0004_0015$$$::"Mrrgh?"::
42344::$$$message_0333_0004_0016$$$::"Hum... [wvl canskip=0 time=400]Você está apontando para mim?"�{hn