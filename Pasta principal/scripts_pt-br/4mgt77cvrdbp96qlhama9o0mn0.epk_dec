DAT
id=qid::label=str::text=lstr::
42842::$$$message_0353_0000_0000$$$::"Hm? Será que virei na rua errada?[lr]::
42843::$$$message_0353_0000_0001$$$::Parece que eu perambulei para o antigo covil dos Edelfelt..."::
42844::$$$message_0353_0000_0002$$$::"Esta é a mansão daquelas famosas magas gêmeas?[lr]::
42845::$$$message_0353_0000_0003$$$::Eu sinto algo sinistro... Como se sua neta tivesse passado algum tempo aqui."::
42846::$$$message_0353_0000_0004$$$::"Hm. Ela esteve aqui. Posso sentir isso em meus ossos."::
42847::$$$message_0353_0000_0005$$$::"Bom, fazer o quê. Isto foi um erro. Vamos para a caverna do dragão, Assassin."::
42848::$$$message_0353_0000_0006$$$::"Isto é, assim que lidarmos com aquele estorvo de cavaleira."[nolr]::
42849::$$$message_0353_0000_0007$$$::"Então você me notou.[lr]::
42850::$$$message_0353_0000_0008$$$::Você não perdeu o seu toque apesar da sua idade, Zolgen Makiri."::
42851::$$$message_0353_0000_0009$$$::"Olha, mas que nome que eu não escuto a muitos anos.[lr]::
42852::$$$message_0353_0000_0010$$$::Isso deve fazer de você alguém do Ramo Vermelho..."::
42853::$$$message_0353_0000_0011$$$::"Hm? Mm? Hmmm?"::
42854::$$$message_0353_0000_0012$$$::"O-o quê?[lr]::
42855::$$$message_0353_0000_0013$$$::Por que está encarando o meu rosto?"::
42856::$$$message_0353_0000_0014$$$::"Hmm. Você me parece familiar... Onde é que eu te vi... Foi recentemente, acho eu..."::
42857::$$$message_0353_0001_0000$$$::"Você aí, [hfwww layer=1]jovem. Dê-me uma dica."::
42858::$$$message_0353_0001_0001$$$::"Cara, que chatice... Eu vou derreter."::
42859::$$$message_0353_0001_0002$$$::"Ah, cê tá falando comigo, vovô?[lr]::
42860::$$$message_0353_0001_0003$$$::Ué, ele não é...[lr]::
42861::$$$message_0353_0001_0004$$$::Um dos clientes regulares do maid cafe perto da estação?"[seloop storage=se254.wav]::
42862::$$$message_0353_0001_0005$$$::"Sim, é isso mesmo! Eu me lembrei, Assassin! [hfwww layer=1]Aquela senhora cavaleira é a maid desastrada que eu mencionei antes!"::
42863::$$$message_0353_0001_0006$$$::"O quê!? Ah, ahhh![lr]::
42864::$$$message_0353_0001_0007$$$::Agora que você mencionou, você é daquela vez...!"::
42865::$$$message_0353_0001_0008$$$::"Oh? Então você está dizendo que ela colocou uma roupa de maid que não combinava nem um pouco com o seu caráter feminino..."::
42866::$$$message_0353_0001_0009$$$::"Tal como uma anfitriã de um clube que instantaneamente transforma um inocente espaço floral num pub de cosplay erótico para velhos."[nolr]::
42867::$$$message_0353_0002_0000$$$::[hfl][cm][hfu][cm]"N[hfl]"[hfu]n[hfl]N[hfu]n[hfl]ngh[hfu]ngh[hfl]...[hfu]...[hfl]...[hfu]...[hfl]...[hfu]...[hfl]...[hfu]...[hfl]...[hfu]...[hfl]...[hfu]...[hfl]...[hfu]...[hfl]...[hfu]![hfl]![hfu]"[hfl]"[lr]::
42868::$$$message_0353_0002_0001$$$::[hfu][br backlog=0](t[hfl](t[hfu]re[hfl]re[hfu]me[hfl]me[hfu] [hfl] [hfu]vi[hfl]vi[hfu]ol[hfl]ol[hfu]en[hfl]en[hfu]ta[hfl]ta[hfu]me[hfl]me[hfu]nt[hfl]nt[hfu]e[hfl]e[hfu])[hfl])[nolr]::
42869::$$$message_0353_0002_0002$$$::"Ah, aquilo sim que era uma visão para se apreciar![lr]::
42870::$$$message_0353_0002_0003$$$::Você se destacou muito, cercada por todas aquelas coisinhas jovens e amáveis!"::
42871::$$$message_0353_0002_0004$$$::"Tipo a Tokyo Tower, ou a Tsutenkaku![lr]::
42872::$$$message_0353_0002_0005$$$::Cê sabe, toda vermelha!"::
42873::$$$message_0353_0002_0006$$$::"Então...[lr]::
42874::$$$message_0353_0002_0007$$$::Você foi demitida, se não me engano?"::
42875::$$$message_0353_0002_0008$$$::"É. Ela voltou pra casa chorando depois de dois dias. Mas ainda assim, essa foi uma temporada muito boa pra minha Mestra."::
42876::$$$message_0353_0002_0009$$$::"Não morda a língua, Avenger!"::
42877::$$$message_0353_0002_0010$$$::"Cinco toneladas[line len=2]hurgh!?"[rf][p][hfmsg2layer src=0 dest=2][nolr]::
42878::$$$message_0353_0002_0011$$$::"(Essa Mestra tem passado por poucas e boas...)"::
42879::$$$message_0353_0002_0012$$$::"Qual é a graça!?"::
42880::$$$message_0353_0002_0013$$$::"E-eu não estou rindo."::
42881::$$$message_0353_0002_0014$$$::"Aiiii... [wait canskip=0 time=400][hffacechg chara=アヴェンジャー face=喜 layer=0 time=300]Aí Mestra. Esse é só o jeito que é a cara dele. [hfwww layer=0]Você não deveria tirar sarro da aparência das pessoas."::
42882::$$$message_0353_0002_0015$$$::"...![lr]::
42883::$$$message_0353_0002_0016$$$::(Eu acho que nós podemos ser amigos!)"::
42884::$$$message_0353_0002_0017$$$::"E-eles nos insultaram primeiro! Vamos nessa, Avenger!"::
42885::$$$message_0353_0003_0000$$$::"Eu vou arrancar, na base da porrada, a memória de todos os clientes que me viram naquele maid cafe!"::
42886::$$$message_0353_0003_0001$$$::"...Droga. Ela tá atacando as pessoas por outro motivo maluco."::

