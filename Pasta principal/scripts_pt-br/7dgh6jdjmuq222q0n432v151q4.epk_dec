DAT
id=qid::label=str::text=lstr::
43016::$$$message_0355_0000_0000$$$::"...Está congelando.[lr]::
43017::$$$message_0355_0000_0001$$$::Lorde mago? Hm, achei que ele tivesse ido na frente..."::
43018::$$$message_0355_0000_0002$$$::"(...Oh, já tem alguém aqui.[lr]::
43019::$$$message_0355_0000_0003$$$::Não o reconheço. Talvez ele pertença ao templo...)"::
43020::$$$message_0355_0000_0004$$$::"Olá. Posso me juntar a você?"::
43021::$$$message_0355_0000_0005$$$::"Fique à vontade. Este é um banho de fonte termal natural.[lr]::
43022::$$$message_0355_0000_0006$$$::Não seria nada elegante da minha parte reivindicá-lo como meu."::
43023::$$$message_0355_0000_0007$$$::"(Ele é um bom homem!)"::
43024::$$$message_0355_0000_0008$$$::"Então, com sua licença...[lr]::
43025::$$$message_0355_0000_0009$$$::Ah, você se importa se eu tirar a minha máscara?"::
43026::$$$message_0355_0000_0010$$$::"Vá em frente.[lr]::
43027::$$$message_0355_0000_0011$$$::Afinal, seria um tanto sem cerimônia usar óculos no banho."::
43028::$$$message_0355_0000_0012$$$::"(Não é apenas um homem decente; é um exemplo de virtude!)"::
43029::$$$message_0355_0000_0013$$$::"Com licença, então.[lr]::
43030::$$$message_0355_0000_0014$$$::Ah, está me faltando um pouco de pele no rosto. Espero que não se importe."::
43031::$$$message_0355_0000_0015$$$::"De forma alguma.[lr]::
43032::$$$message_0355_0000_0016$$$::Não é como se os seus órgãos internos estivessem à mostra. Não me arranca pedaço, se é que me entende."[nolr]::
43033::$$$message_0355_0000_0017$$$::"..."::
43034::$$$message_0355_0000_0018$$$::"..."::
43035::$$$message_0355_0000_0019$$$::"...Hum.[lr]::
43036::$$$message_0355_0000_0020$$$::Você viu mais alguém entrar neste banho?"::
43037::$$$message_0355_0000_0021$$$::"Não. Acredito que sejamos os únicos aqui."::
43038::$$$message_0355_0001_0000$$$::"Ahh, este é um belo banho.[lr]::
43039::$$$message_0355_0001_0001$$$::Não estou acostumado com estas terras, mas estou impressionado com a paisagem."::
43040::$$$message_0355_0001_0002$$$::"Oh!?[lr]::
43041::$$$message_0355_0001_0003$$$::N-não me diga, você é..."::
43042::$$$message_0355_0001_0004$$$::"Ufa. Devo dizer que isso é maravilhoso.[lr]::
43043::$$$message_0355_0001_0005$$$::Sinto como se tivesse voltado à vida... [hfwww layer=1]Não, como se tivesse recuperado a minha juventude perdida."::
43044::$$$message_0355_0001_0006$$$::"E-Ele realmente voltou a ser um homem jovem!"[nolr]::
�