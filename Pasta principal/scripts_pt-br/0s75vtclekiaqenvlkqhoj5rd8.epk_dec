DAT
id=qid::label=str::text=lstr::
45009::$$$message_0401_0000_0000$$$::"Urgh..."::
45010::$$$message_0401_0000_0001$$$::"O que foi, garoto?"::
45011::$$$message_0401_0000_0002$$$::"Estou com um pressentimento péssimo sobre isso..."::
45012::$$$message_0401_0000_0003$$$::"Ha ha ha. Aposto que sim, Waver Velvet."::
45013::$$$message_0401_0000_0004$$$::"Eep..."::
45014::$$$message_0401_0000_0005$$$::"Encontrar a mim, Kayneth El-Melloi Archibald, deve ser o pior encontro que você poderia imaginar."::
45015::$$$message_0401_0000_0006$$$::"Urgh, ahh..."::
45016::$$$message_0401_0000_0007$$$::"Ora, se não é o Mestre de Lancer. Ainda se dando ares de importância, como sempre."::
45017::$$$message_0401_0000_0008$$$::"Hmph! ...Lancer."::
45018::$$$message_0401_0000_0009$$$::"Aqui estou, meu senhor."::
45019::$$$message_0401_0000_0010$$$::"É o Lancer!"::
45020::$$$message_0401_0000_0011$$$::"Creio que este será nosso primeiro duelo, Rider. Minhas lanças ainda não provaram sangue esta noite... Elas têm sede do seu."::
45021::$$$message_0401_0000_0012$$$::(Meudeus. Lancer, você é tão incrível!)::
45023::$$$message_0401_0000_0014$$$::"Enquanto Lancer e Rider lutam, que tal termos uma conversa amistosa, de professor para aluno?"::
45024::$$$message_0401_0000_0015$$$::"Aaaah...eeek..."::
45025::$$$message_0401_0000_0016$$$::(E Kayneth... implicância combina muito mal com você.)::
45026::$$$message_0401_0000_0017$$$::"Sinta-se livre para se virar e fugir, deixando tudo inacabado como convém a linhagens de sangue inferior."::
45027::$$$message_0401_0000_0018$$$::"..."::
45028::$$$message_0401_0000_0019$$$::"Ou prefere cair de joelhos e implorar por misericórdia?[wvl canskip=false time=200][hffgchg2 chara=ケイネス face=怒2 pos=right time=400 twno=1][hfangry layer=1] Em qualquer caso, seu destino está selado. Arrependa-se da sua vida enquanto morre!"::
45029::$$$message_0401_0000_0020$$$::"Kh...grr...."::
45030::$$$message_0401_0000_0021$$$::"Grr...gah...rrrgh..."::
45031::$$$message_0401_0000_0022$$$::"...Waver Velvet?"::
45032::$$$message_0401_0000_0023$$$::"C...C...CALA A BOCA, SEU BABACA![wvl][hfwww layer=0] Você não é nada comparado a um Servo!"::
45033::$$$message_0401_0000_0024$$$::"O quê!?"::
45034::$$$message_0401_0000_0025$$$::"Isso mesmo! Eu lutei contra um Berserker num caça e contra um monstro marinho gigante!"::
45035::$$$message_0401_0000_0026$$$::"Por que eu teria medo de você, seu idiota enorme!"::
45036::$$$message_0401_0000_0027$$$::"Hahahahaha! Isso mesmo, meu Mestre enfrentou muitos campos de batalha ao meu lado!"::
45037::$$$message_0401_0000_0028$$$::"Ele provou sua sabedoria, sua habilidade e seu valor, ao contrário de certo Mestre que se esconde nas sombras!"::
45038::$$$message_0401_0000_0029$$$::"Como ousa falar comigo desse jeito!"::
45039::$$$message_0401_0000_0030$$$::"Prof[line len=2]Não,[wvl][hfangry layer=0] Kayneth El-Melloi Archibald! Eu o desafio para um duelo!"::
45040::$$$message_0401_0000_0031$$$::"Como OUSA! Seu lixo absoluto! Você está abaixo até de um mago de terceira categoria!"::
45041::$$$message_0401_0000_0032$$$::"Hmph. Desculpe, Mestre de Lancer. Parece que terá que desistir de curar essa linha do cabelo recuando."::
45042::$$$message_0401_0000_0033$$$::"N-n-não estamos falando disso agora!!!"::
45043::$$$message_0401_0000_0034$$$::"Então isso o incomoda..."::
45044::$$$message_0401_0000_0035$$$::"Isso o incomoda..."::
45045::$$$message_0401_0000_0036$$$::"Não se preocupe, meu senhor! Sua linha do cabelo ainda está intacta! Ainda há bastante cabelo para perder!"::
45046::$$$message_0401_0000_0037$$$::"NINGUÉM PERGUNTOU A VOCÊ! Droga, agora sei o que vou desejar! Vou matar todo mundo que for mais bonito que euuuu!"::
45047::$$$message_0401_0000_0038$$$::"Ora, Kayneth. Acabei de ouvir você dizer uma bobagem? Retire isso ou eu o mato."::
45048::$$$message_0401_0000_0039$$$::"...Ei, afinal vamos duelar ou não?"::

