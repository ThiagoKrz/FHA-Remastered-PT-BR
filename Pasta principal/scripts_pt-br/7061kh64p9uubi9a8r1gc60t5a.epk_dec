DAT
id=qid::label=str::text=lstr::
45239::$$$message_0411_0000_0000$$$::"Tem mesmo um onsen mais adiante?"::
45240::$$$message_0411_0000_0001$$$::"Tem. Minha intuição, ou algo parecido, está dizendo que sim. Acho."::
45241::$$$message_0411_0000_0002$$$::"Intuição deveria ser vaga desse jeito?"::
45242::$$$message_0411_0000_0003$$$::"Espera. Tem alguém adiante."::
45243::$$$message_0411_0000_0004$$$::"Hm?"::
45244::$$$message_0411_0000_0005$$$::"Ah?"::
45245::$$$message_0411_0000_0006$$$::"Ah, ingredientes."::
45246::$$$message_0411_0000_0007$$$::"Ahhh!"::
45247::$$$message_0411_0000_0008$$$::"I-Illya!?"::
45248::$$$message_0411_0000_0009$$$::"Nossa, essa doeu, criança. É falta de educação gritar só de ver o rosto de um cara."::
45249::$$$message_0411_0000_0010$$$::"Acredito que esta seja a situação em que se usa a frase: 'O que seus pais pensariam?'"::
45250::$$$message_0411_0000_0011$$$::"D-desculpa! É que, hum... seu rosto dá medo..."::
45251::$$$message_0411_0000_0012$$$::"Não há motivo para se preocupar, Ryunosuke."::
45252::$$$message_0411_0000_0013$$$::"Mesmo que sua estrutura facial faça crianças soltarem gritos agudos, eu gosto dela."::
45253::$$$message_0411_0000_0014$$$::"Valeu, grandão. ...Hehe, assim eu fico sem graça."::
45254::$$$message_0411_0000_0015$$$::(Mas não foi ele que me fez gritar!)::
45255::$$$message_0411_0000_0016$$$::"Minha... minha intuição agora está gritando que tem alguma coisa definitivamente errada com esses caras!"::
45256::$$$message_0411_0000_0017$$$::"Sinto que acabamos de encontrar as últimas pessoas que deveríamos encontrar!"::
45257::$$$message_0411_0000_0018$$$::"Ei, grandão. Estou me perguntando: qual é a dessa garota?"::
45258::$$$message_0411_0000_0019$$$::"Hã? E-eu?"::
45259::$$$message_0411_0000_0020$$$::"Ela não tem cor nem voz. Está viva mesmo?"::
45260::$$$message_0411_0000_0021$$$::"Ooh, uma garota monocromática...[wvl canskip=false time=200][hffgchg2 chara=キャスター4th face=喜 pos=center time=300][hfsigh layer=2] Nunca vi uma antes. Hehe. Estamos com sorte, Ryunosuke."::
45261::$$$message_0411_0000_0022$$$::"Eh? Hã?"::
45262::$$$message_0411_0000_0023$$$::"Que achado raro! Mal posso esperar para ver se as entranhas dela também são em preto e branco...!"::
45263::$$$message_0411_0000_0024$$$::"Q-que diabos há com essas pessoas!?"::

