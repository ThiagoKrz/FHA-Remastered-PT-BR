DAT
id=qid::label=str::text=lstr::
10561::$$$message_0081_0000_0000$$$::"...Cara, tô cansado."[lr]::
10562::$$$message_0081_0000_0001$$$::"As luzes da casa estão acesas. Todo mundo já deve ter voltado a essa altura."[lr]::
10563::$$$message_0081_0000_0002$$$::"Voltei andando pra casa sem motivo algum, mas faz bastante frio depois que o Sol se põe."[lr]::
10564::$$$message_0081_0000_0003$$$::"Por enquanto, eu deveria jantar, tomar um banho e descansar o corpo antes de pensar no que fazer[line len=2]::
10565::$$$message_0081_0001_0000$$$::"Shirou, bem-vindo de volta."[lr]::
10566::$$$message_0081_0001_0001$$$::"Ah, oi, Saber. Você ia sair agora?"[lr]::
10567::$$$message_0081_0001_0002$$$::"Não, eu estava esperando pelo seu retorno."[lr]::
10568::$$$message_0081_0001_0003$$$::"..."[lr]::
10569::$$$message_0081_0001_0004$$$::Ah, isso explica tudo. Fui pego um pouco de surpresa.[lr]::
10570::$$$message_0081_0001_0005$$$::É uma cena um tanto inesperada, vê-la esperando de forma tão diligente...::
10571::$$$message_0081_0002_0000$$$::"Você é o dono da casa. Acho justo receber você de volta como se deve.[lr]::
10572::$$$message_0081_0002_0001$$$::É estranho querer demonstrar o meu apreço pelos seus esforços?"[lr]::
10573::$$$message_0081_0002_0002$$$::"Não, você tem razão quanto a isso.[lr]::
10574::$$$message_0081_0002_0003$$$::Obrigado. Cheguei, Saber."::
10575::$$$message_0081_0003_0000$$$::"Sim, bem-vindo ao lar, Shirou.[lr]::
10576::$$$message_0081_0003_0001$$$::O jantar está pronto. Entre."[lr]::
10577::$$$message_0081_0003_0002$$$::Passo pelo portão da residência Emiya com a Saber.[lr]::
10578::$$$message_0081_0003_0003$$$::Como se eu percebesse que as coisas que damos como certas só mostram o seu valor depois que acabam...[lr]::
10579::$$$message_0081_0003_0004$$$::Provavelmente olharei para trás e me lembrarei desta recepção como uma memória especial algum dia.::

