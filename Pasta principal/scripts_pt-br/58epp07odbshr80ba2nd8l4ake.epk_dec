DAT
id=qid::label=str::text=lstr::
43078::$$$message_0357_0000_0000$$$::"Rin, lá estão elas! É a Caster!"::
43079::$$$message_0357_0000_0001$$$::"Boa vista, Archer! Isso é que é Clarividência!"::
43080::$$$message_0357_0000_0002$$$::"Hm, parece que há algum tumulto."::
43081::$$$message_0357_0000_0003$$$::"Tohsaka."::
43082::$$$message_0357_0000_0004$$$::"Nada pessoal, Caster, mas você vem comigo."::
43083::$$$message_0357_0000_0005$$$::"Posso ao menos perguntar por quê?"::
43084::$$$message_0357_0000_0006$$$::"Bom, nem eu sei."::
43085::$$$message_0357_0001_0000$$$::"Mas preciso que venha comigo, porque ninguém sabe o que a Saber pode aprontar... caso contrário."::
43086::$$$message_0357_0001_0001$$$::"O que você fez, Caster?[lr]::
43087::$$$message_0357_0001_0002$$$::A Saber está furiosa de um jeito fora do comum."::
43088::$$$message_0357_0001_0003$$$::"Sério... Ela disse que ia dar uma Excaliblast na casa se a gente não obedecesse, e que nem veríamos o golpe vindo de dentro do Campo Limitado."::
43089::$$$message_0357_0001_0004$$$::"Falando nisso, Sakura e Rider também saíram correndo pela porta... Ela deve ter ameaçado as duas de algum jeito."::
43090::$$$message_0357_0001_0005$$$::"O Rei dos Cavaleiros me impressiona. Ela não mede esforços para alcançar seus objetivos... apesar da aparência."::
43091::$$$message_0357_0001_0006$$$::"Responda, Caster. O que você fez à Saber?"::
43092::$$$message_0357_0001_0007$$$::"Por que não pergunta a ela diretamente?"::
43093::$$$message_0357_0001_0008$$$::"Eu perguntei! Mas ela me encarou com uma intensidade absurda. Shirou parecia saber de alguma coisa, mas só ficava tremendo ao lado dela."::
43094::$$$message_0357_0001_0009$$$::"Ele parecia meio abatido."::
43095::$$$message_0357_0001_0010$$$::"Heh. Ah, pequena Saber. Ela iria mesmo tão longe por rancor?"::
43096::$$$message_0357_0001_0011$$$::"...Então foi obra sua, afinal."::
43097::$$$message_0357_0001_0012$$$::"Bah! Isso não importa![lr]::
43098::$$$message_0357_0001_0013$$$::Cuide disso, Assassin!"::
43099::$$$message_0357_0001_0014$$$::"...Céus."::
�