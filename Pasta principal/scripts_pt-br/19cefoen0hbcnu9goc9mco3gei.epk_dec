DAT
id=qid::label=str::text=lstr::
43122::$$$message_0359_0000_0000$$$::"Que horror. Que desastre."::
43123::$$$message_0359_0000_0001$$$::"Hmm. Contenha-se no futuro."::
43124::$$$message_0359_0000_0002$$$::"Sim, claro![lr]::
43125::$$$message_0359_0000_0003$$$::...Estou muito lisonjado. Não pretendia causar problema, Souichirou."::
43126::$$$message_0359_0000_0004$$$::"Hmm."::
43127::$$$message_0359_0000_0005$$$::"Pois bem... essa é a primeira vez que estou em banho misto... fico bem assim?"::
43128::$$$message_0359_0000_0006$$$::"Bem, Caster, meus óculos ficaram embaçados, então não vejo nada."::
43129::$$$message_0359_0000_0007$$$::"Que pena. Banhos como esses têm um charme que você não pode experimentar normalmente."::
43130::$$$message_0359_0000_0008$$$::"Assassino! Por que você veio até aqui com a gente!?"::
43131::$$$message_0359_0000_0009$$$::"Que pergunta estranha."::
43132::$$$message_0359_0001_0000$$$::"Você me libertou da minha ligação à porta, e agora estou preso aos óculos de Souichirou."::
43133::$$$message_0359_0001_0001$$$::"Hmm."::
43134::$$$message_0359_0001_0002$$$::"Então eu vou pegar essas lentes e colocar em algum lugar longe[line len=2]"::
43135::$$$message_0359_0001_0003$$$::"Ah, você tem certeza disso? A toalha que cobre o seu corpo pode soltar."::
43136::$$$message_0359_0001_0004$$$::"E-e-e-que diabos você acabou de dizer, seu falso samurai!?"::
43137::$$$message_0359_0001_0005$$$::"Além disso, eu poderia ter ficado simplesmente invisível, mas isso não se encaixaria no clima refinado e libertador dessa banheira."::
43138::$$$message_0359_0002_0000$$$::"Espero que o fato de ter me revelado prove minha sinceridade."::
43139::$$$message_0359_0002_0001$$$::"Hmm.[lr]::
43140::$$$message_0359_0002_0002$$$::Você já ouviu falar em tato? É algo que deveria aprender a exercitar ao meu redor e ao de Souichirou."::
43141::$$$message_0359_0002_0003$$$::"O que você quer dizer? Não estou aqui porque quero. Preciso te lembrar quem me arrastou para essa saída?"::
43142::$$$message_0359_0002_0004$$$::"Rrrgh! Você me põe tão nos nervos![lr]::
43143::$$$message_0359_0002_0005$$$::Vai trocar de lugar com a Saber, [hfchance layer=1]você esse samurai desengonçado!"::
43144::$$$message_0359_0002_0006$$$::"...Hmm. Isso é um bom banho."::