DAT
id=qid::label=str::text=lstr::
43122::$$$message_0359_0000_0000$$$::"Francamente. Que desastre."::
43123::$$$message_0359_0000_0001$$$::"Mm-hm. Da próxima vez, contenha-se."::
43124::$$$message_0359_0000_0002$$$::"S-sim, claro![lr]::
43125::$$$message_0359_0000_0003$$$::...Sinto muito. Não queria causar problemas, Souichirou-sama."::
43126::$$$message_0359_0000_0004$$$::"Mm."::
43127::$$$message_0359_0000_0005$$$::"A propósito... é a primeira vez que entro num banho misto... eu estou bem assim?"::
43128::$$$message_0359_0000_0006$$$::"Bom, Caster, meus óculos embaçaram, então não consigo ver."::
43129::$$$message_0359_0000_0007$$$::"Que pena. Banhos assim têm um encanto que normalmente não dá para experimentar."::
43130::$$$message_0359_0000_0008$$$::"Assassin! Por que veio até aqui junto conosco!?"::
43131::$$$message_0359_0000_0009$$$::"Que pergunta estranha."::
43132::$$$message_0359_0001_0000$$$::"Você me libertou do vínculo com o portão, e agora estou preso aos óculos de Souichirou."::
43133::$$$message_0359_0001_0001$$$::"Hm."::
43134::$$$message_0359_0001_0002$$$::"Então vou pegar esses óculos e colocá-los em algum lugar bem longe[line len=2]"::
43135::$$$message_0359_0001_0003$$$::"Oh, tem certeza? A toalha que cobre seu corpo pode se soltar."::
43136::$$$message_0359_0001_0004$$$::"O-o-o-o que acabou de dizer, seu samurai fajuto!?"::
43137::$$$message_0359_0001_0005$$$::"Além disso, eu poderia simplesmente ter permanecido invisível, mas isso não combinaria com a atmosfera refinada e libertadora desta casa de banhos."::
43138::$$$message_0359_0002_0000$$$::"Espero que o fato de eu ter me revelado prove minha sinceridade."::
43139::$$$message_0359_0002_0001$$$::"...Hmph.[lr]::
43140::$$$message_0359_0002_0002$$$::Já ouviu falar em tato? É algo que deveria aprender a exercer perto de mim e de Souichirou."::
43141::$$$message_0359_0002_0003$$$::"O que quer dizer? Não estou aqui porque quero. Preciso lembrá-la de quem me arrastou para este passeio?"::
43142::$$$message_0359_0002_0004$$$::"Rrrgh! Você realmente me tira do sério![lr]::
43143::$$$message_0359_0002_0005$$$::Vá trocar de lugar com a Saber, [hfchance layer=1]seu samurai varapau!"::
43144::$$$message_0359_0002_0006$$$::"...Mm. Este banho é bom."::

