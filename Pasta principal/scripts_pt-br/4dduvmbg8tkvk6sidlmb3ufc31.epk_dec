DAT
id=qid::label=str::text=lstr::
42177::$$$message_0329_0000_0000$$$::"De acordo com o convite, há um resort de fontes termais por aqui perto..."::
42178::$$$message_0329_0000_0001$$$::"...?[lr]::
42179::$$$message_0329_0000_0002$$$::Sella, tem alguma coisa errada.[lr]::
42180::$$$message_0329_0000_0003$$$::Tem um poder mágico que parece ser o da Illyaaa[line len=2]"[nolr]::
42181::$$$message_0329_0000_0004$$$::"Hehe. Estão procurando por alguma coisa, beldades?[lr]::
42182::$$$message_0329_0000_0005$$$::E eu também tô com uma baita dor de estômago."::
42183::$$$message_0329_0000_0006$$$::"Quem está aí!?"::
42184::$$$message_0329_0000_0007$$$::"...Ah, mas se não é o filho dos Makiri."::
42185::$$$message_0329_0001_0000$$$::"Nós estamos com pressa, não temos tempo nem disposição para brincar com você."::
42186::$$$message_0329_0001_0001$$$::"É. A gente tem que ir pra onsen."::
42187::$$$message_0329_0001_0002$$$::"Hahaha. E a primeira coisa de que se queixam é de uma onsen?"[lr]::
42188::$$$message_0329_0001_0003$$$::"Então, deixem-me ver se entendi.[lr]::
42189::$$$message_0329_0001_0004$$$::Vocês por acaso são uma dupla de idiotas fantasiadas de empregadas?[lr]::
42190::$$$message_0329_0001_0005$$$::Ou será que estão planejando tentar abrir um resort de onsen de temática de empregadas no meio do nada?"::
42191::$$$message_0329_0001_0006$$$::"Ahhh, não vou aguentar, minha barriga tá até doendo de tanto rir! Não tem nenhuma fonte termal no meio dessas montanhas sombrias!"::
42192::$$$message_0329_0002_0000$$$::"Vocês estão sendo enganadas, [hfchance layer=0]assim como eu!"::
42193::$$$message_0329_0002_0001$$$::"...Sella. Posso esmagá-lo?"::
42194::$$$message_0329_0002_0002$$$::"Só um momento.[lr]::
42195::$$$message_0329_0002_0003$$$::...Filho preguiçoso dos Makiri. O que você quer dizer que estamos sendo enganadas?"::
42196::$$$message_0329_0002_0004$$$::"Eu acabei de lhes contar que não existe nenhuma onsen por aqui!"::
42197::$$$message_0329_0002_0005$$$::"Maldito seja, que perda de tempo tremenda ter que passar essa noitada de graça! Não tem nenhum harém não importa para onde eu olhe!"::
42198::$$$message_0329_0002_0006$$$::"Argh, minhas costelas tão doendo tanto! Essa dorzinha na barriga está me matando![lr]::
42199::$$$message_0329_0002_0007$$$::Tô perdido! Quero voltar pra casa!"::
42200::$$$message_0329_0002_0008$$$::"...Leysritt."::
42201::$$$message_0329_0002_0009$$$::"É. Hora do castigo grandão."::
