DAT
id=qid::label=str::text=lstr::
18873::$$$message_0104_0000_0000$$$::"Um onsen?"::
18874::$$$message_0104_0000_0001$$$::"É o termo local para banhos alimentados por fontes termais naturais, Senhora: água acima de 25 graus Celsius ou com certos minerais dissolvidos."::
18875::$$$message_0104_0000_0002$$$::"Ah. Mas por que você está falando disso agora?"::
18876::$$$message_0104_0000_0003$$$::"Sella, com frio. Onsen, esquenta. Talvez."::
18877::$$$message_0104_0000_0004$$$::"Não se preocupe comigo. [wait canskip=0 time=600][hffacechg chara=セラ face=楽 layer=1 time=200][l][say storage=HIRI1_SER_0030 _name=セラ]Chegou esta carta para você."::
18878::$$$message_0104_0000_0005$$$::"Se você já leu, basta me dizer o que está escrito. Se não for interessante, pode jogar fora."::
18879::$$$message_0104_0000_0006$$$::"Sim, Senhora. Em resumo: o primeiro Mestre que chegar à estância termal indicada aqui receberá um cupom de estadia gratuita."::
18880::$$$message_0104_0000_0007$$$::"De quem?"::
18881::$$$message_0104_0000_0008$$$::"Kotomine Kirei, o Supervisor da Guerra do Santo Graal."::
18882::$$$message_0104_0001_0000$$$::"É uma chance de repousar, e diz que o Rei dos Heróis ganhou o cupom por acaso numa loteria..."::
18883::$$$message_0104_0001_0001$$$::"Hmm... [hffacechg chara=イリヤ face=喜 layer=0 time=200][l][say storage=HIRI1_IRI_0060 _name=イリヤ]Pode ser divertido se os outros Mestres aparecerem. Vou lá matar o tempo."::
18884::$$$message_0104_0001_0002$$$::"Divirta-se."::
18885::$$$message_0104_0001_0003$$$::"Vou sim. Vamos, Berserker!"::
18886::$$$message_0104_0001_0004$$$::"[wacky len=5][line len=3]!!!"::

