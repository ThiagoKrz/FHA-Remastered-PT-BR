DAT
id=qid::label=str::text=lstr::
44118::$$$message_0377_0000_0000$$$::"..."::
44119::$$$message_0377_0000_0001$$$::"AEEE PORRAAAAA!"[rf]::
44120::$$$message_0377_0001_0000$$$::"Dourado e Lancer derrubados de uma vez! Vitória total para nós, sem reclamações, Nii-san!"::
44121::$$$message_0377_0001_0001$$$::"Isso foi incrível! BUM! Este é o momento em que transcendemos a história humana!"::
44122::$$$message_0377_0001_0002$$$::"Que bando de fracotes."::
44123::$$$message_0377_0001_0003$$$::"Eu me recuso a aceitar isso![lr]::
44124::$$$message_0377_0001_0004$$$::Eu sou o Rei dos Heróis da humanidade, o mais velho e o maior! Esse joguinho de criança não é uma verdadeira batalha!"::
44125::$$$message_0377_0001_0005$$$::"Hã!? [l][hfchance layer=1][say storage=HSTR7A_TIG_0040 _name=藤ねえ]Não brinca, o dojô tá sumindo![lr]::
44126::$$$message_0377_0001_0006$$$::Aquele Dourado tá ficando tão assassino quanto era na história principal!"[wt canskip=0][current withback=false]::
44127::$$$message_0377_0001_0007$$$::"Ahhhh! Isso tá trazendo de volta meu trauma do outro jogo!"::
44128::$$$message_0377_0002_0000$$$::"[hfangry layer=1]Mestre, meu coração está batendo forte de novo! Isso deve ser amor!"::
44129::$$$message_0377_0002_0001$$$::"Quem precisa de um amor assim!?[lr]::
44130::$$$message_0377_0002_0002$$$::Não temos tempo pra isso agora! Estamos encrencadas!"::
44131::$$$message_0377_0002_0003$$$::"Droga, não tenho escolha a não ser acionar o Interruptor de Prótons que escondi dentro da minha Espada de Bambu do Tigre...!?"::
44132::$$$message_0377_0002_0004$$$::"Tolas! Acharam mesmo que podiam se igualar ao meu poder de fogo!? Só tiveram chance porque eu tropecei primeiro!"::
44133::$$$message_0377_0002_0005$$$::"Ahhhh! Um novo romance para completar![lr]::
44134::$$$message_0377_0002_0006$$$::[hfwww layer=1]Seja a Taiga ou o homem dourado quem vença, Fuyuki está condenada!"::
44135::$$$message_0377_0002_0007$$$::"O tempo acabou para a humanidade![lr]::
44136::$$$message_0377_0002_0008$$$::Morram comigo! MORRAAAM!"::
44137::$$$message_0377_0002_0009$$$::"Você acabou de dizer a mesma coisa duas vezes![lr]::
44138::$$$message_0377_0002_0010$$$::Ahhhh! Alguém me ajude!"[nolr][p]::
44139::$$$message_0377_0002_0011$$$::"...Rrgh. Adeus para mim."[nolr][p]::
44140::$$$message_0377_0002_0012$$$::"...[hfsigh layer=0]Cara, por que eu sempre me envolvo nessas merdas?"::
44141::$$$message_0377_0002_0013$$$::"Lancer...? Você veio nos salvar?"::
44142::$$$message_0377_0002_0014$$$::"Ninguém está salvando ninguém. Se eu deixar esse idiota em paz, ele vai me arrastar para isso também. Só estou cortando essa crise pela raiz."::
44143::$$$message_0377_0002_0015$$$::"Pegue isso, garota. Você venceu esta rodada."::
44144::$$$message_0377_0002_0016$$$::"Tem certeza...?[lr]::
44145::$$$message_0377_0002_0017$$$::Se eu pegar isso, significa que terei vencido a Guerra do Santo Graal de verdade."::
44146::$$$message_0377_0002_0018$$$::"Vá em frente. Meu próprio credo é mais importante para mim do que o Santo Graal."::
44147::$$$message_0377_0002_0019$$$::"...Os vencedores levam e os perdedores perdem.[lr]::
44148::$$$message_0377_0002_0020$$$::[hfsigh layer=0]...Eu sou antiquado, sabe. É algo que eu simplesmente não consigo esconder."::
44149::$$$message_0377_0002_0021$$$::"Lancer, mano... Você é um personagem tão bom dessa vez. Depois do homem dourado. Hngh, meu peito tá ficando todo apertado."::
44151::$$$message_0377_0003_0000$$$::"Eeek! Cuidado, Lancer, você vai morrer! Se você aumentar os pontos de afeto da Illya-chan um pouco mais, ela vai te matar, Nii-san!"::
44152::$$$message_0377_0003_0001$$$::"Com certeza. Venham me visitar de novo se estiverem livres algum dia."::
44153::$$$message_0377_0003_0002$$$::"Mas primeiro, você precisa resolver seus assuntos."::
44154::$$$message_0377_0004_0000$$$::"Agora, vá enquanto ele está distraído. Ele disse algo sobre o local de invocação ser atrás do Templo Ryudou."::
44155::$$$message_0377_0005_0000$$$::"Você nos fez um favor, Lancer.[lr]::
44156::$$$message_0377_0005_0001$$$::Nós vamos indo. Vamos brincar de novo se tivermos a chance."::
44157::$$$message_0377_0005_0002$$$::"Adeus, Nii-san! Nós voltaremos algum dia pra comer um pouco daquele peixe que você pesca!"[nolr][p]::
44158::$$$message_0377_0005_0003$$$::"Claro. Vão com Deus.[lr]::
44159::$$$message_0377_0005_0004$$$::Agora, o que fazer... Acho que vou pensar nisso depois de limpar isso aqui."[nolr][p]::

