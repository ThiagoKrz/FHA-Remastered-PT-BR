DAT
id=qid::label=str::text=lstr::
45300::$$$message_0415_0000_0000$$$::"Bem, isso acaba com isso."::
45301::$$$message_0415_0000_0001$$$::"Não achei que um onsen realmente resolveria o problema..."::
45302::$$$message_0415_0000_0002$$$::"Um onsen mágico que concede desejos... Pensar que algo assim realmente exista..."::
45303::$$$message_0415_0000_0003$$$::"Nunca duvide da minha intuição. Seja captivado pela minha pele bela e pela minha voz! [wvl][hfwww layer=2]Ohh ho ho ho ho!"::
45304::$$$message_0415_0000_0004$$$::"Foi uma impressão de Luvia?"::
45305::$$$message_0415_0000_0005$$$::"É desagradável ouvir."::
45306::$$$message_0415_0000_0006$$$::"Rrgh. Esperava que dissesse que não soa como ela, mas isso foi cruel."::
45307::$$$message_0415_0000_0007$$$::"Mesmo que mágico ou não, esse é um onsen agradável. Sinto que está deixando minha pele toda suave."::
45308::$$$message_0415_0000_0008$$$::"Talvez seja uma fonte alcalina. Se for, o motivo pelo qual sua pele se sente mais suave é devido às proteínas da água alcalina penetrando sua pele.[line len=2]"::
45309::$$$message_0415_0000_0009$$$::"É, é. Podemos não ter aula de ciência enquanto estamos aproveitando um banho?"::
45310::$$$message_0415_0000_0010$$$::"Essa é uma onsen que concede desejos. Também é boa para a pele. Vamos deixar assim."::
45311::$$$message_0415_0000_0011$$$::"Sim, minha pele é suave como a de um bebê...[wvl canskip=false time=400][hfsweat layer=2 ox=-130 oy=50]bot...tom?"::
45312::$$$message_0415_0000_0012$$$::"Ch-Chloe?"::
45313::$$$message_0415_0000_0013$$$::"A-vc tá ok, Chloe!? Não está esquentando demais, está?"::
45314::$$$message_0415_0000_0014$$$::"Hmm? Estou bem, o que você quer dizer?"::
45315::$$$message_0415_0000_0015$$$::"P- mas todos vocês estão vermelhos...!"::
45316::$$$message_0415_0000_0016$$$::"Vermelho? Deixe-me ver... Eu não sou vermelho em absoluto. Na verdade, eu sou meio verde."::
45317::$$$message_0415_0000_0017$$$::"Por que eu estou verde!?"::
45318::$$$message_0415_0000_0018$$$::"Hei! Você é como um alienígena do espaço!"::
45319::$$$message_0415_0000_0019$$$::"E-que diabos está acontecendo!?"::
45320::$$$message_0415_0000_0020$$$::"Ah, que alívio, estou de volta ao meu tom normal... esp[line len=2]era, agora minha voz está estranha!"::
45321::$$$message_0415_0000_0021$$$::"Soa muito mais denso!"::
45322::$$$message_0415_0000_0022$$$::"Achei que esse onsen era pra conceder desejos!"::
45323::$$$message_0415_0000_0023$$$::"Um onsen que concede desejos..."::
45324::$$$message_0415_0000_0024$$$::"...Chloe. O que você desejava quando entrou no banho?"::
45325::$$$message_0415_0000_0025$$$::"Hmm? Pedi minha cor e voz de volta, óbvio."::
45326::$$$message_0415_0000_0026$$$::"E você, Illya?"::
45327::$$$message_0415_0000_0027$$$::"Eu queria que a cor e a voz de Chloe voltassem ao normal..."::
45328::$$$message_0415_0000_0028$$$::"Também eu."::
45329::$$$message_0415_0000_0029$$$::"...Espere. Não me diga..."::
45330::$$$message_0415_0000_0030$$$::"Os três nossos desejos se sobrepuseram... e combinaram?"::
45331::$$$message_0415_0000_0031$$$::"Muito provavelmente."::
45332::$$$message_0415_0000_0032$$$::"Isso..."::
45333::$$$message_0415_0000_0033$$$::"Isso é louco!!!"::
45334::$$$message_0415_0000_0034$$$::"Você é muito assustador quando grita com aquela voz e cor!"::
45335::$$$message_0415_0000_0035$$$::"Você... é um ogro..."::
45336::$$$message_0415_0000_0036$$$::"Cancela! Cancela seus desejos! Vocês dois precisam desfazer isso!"::
45337::$$$message_0415_0000_0037$$$::"Eu não tenho certeza se é tão simples assim..."::
45338::$$$message_0415_0000_0038$$$::"Isso está começando a se tornar um incômodo."::
45339::$$$message_0415_0000_0039$$$::"Waaaah! Por que isso está acontecendo comigo!?!"::
45340::$$$message_0415_0000_0040$$$::"Agora, agora, não chore, Velho."::
45341::$$$message_0415_0000_0041$$$::"Quem você acha que é, velho?"::
45342::$$$message_0415_0000_0042$$$::"(...) Quero só voltar pra casa e jantar."::
45343::$$$message_0415_0000_0043$$$::"Urh, já chega! Por que isso sempre acontece comigo!?!"::
45344::$$$message_0415_0000_0044$$$::"Moral da história: cuide do que deseja! Right?"::
45345::$$$message_0415_0000_0045$$$::"De..."::
45346::$$$message_0415_0000_0046$$$::"...não é possível!!!"::
45347::$$$message_0415_0000_0047$$$::"...! (Ao ver uma estrela cadente, ela faz um desejo.)"